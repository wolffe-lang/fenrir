#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
export TMPDIR=${TMPDIR:-$root/target/tmp}
mkdir -p "$TMPDIR" target/evidence
step() {
    local name=$1
    shift
    local started=$SECONDS
    printf 'START %s\n' "$name"
    set +e
    "$@" > "target/evidence/$name.log" 2>&1
    local status=$?
    if [[ $status -eq 0 ]]; then
        tools/check-skips --strict --log "target/evidence/$name.log" >> "target/evidence/$name.log.strict" 2>&1
        status=$?
        cat "target/evidence/$name.log.strict" >> "target/evidence/$name.log"
    fi
    set -e
    sed 's/^/  /' "target/evidence/$name.log"
    printf 'END %s exit=%s secs=%s\n' "$name" "$status" "$((SECONDS-started))"
    if [[ $status -ne 0 ]]; then exit "$status"; fi
}
step unit python3 -I tests/frame.py
step oracle-unit python3 -I tests/oracle_unit.py
step oracle-readonly python3 -I tests/oracle_readonly.py
if [[ $(uname -s) == Linux ]]; then step inventory-scaling python3 -I tests/scaling.py; fi
step subset tools/check-subset
step diagnostics tools/check-diagnostics
step build tools/build
step toolchain-tools tools/build-tools
step driver python3 -I tests/driver.py
step front-unit python3 -I tests/front/check.py "$root/target/fenrir" --work "$root/target/front-unit"
step front-grammar python3 -I tests/front/check.py "$root/target/fenrir" --rows tests/front/grammar.json --work "$root/target/front-grammar"
step front-coverage python3 -I tests/front/coverage.py .wolf-bin/reference/spec --self-test
step front-unicode python3 -I tests/front/unicode.py --check
step front-record-output python3 -I tests/front/record_output_test.py
step front-api python3 -I tests/front/api.py
step front-corpus python3 -I tests/front/corpus.py "$root/target/fenrir" .wolf-bin/reference/corpus --sources src --report "$root/target/evidence/front-corpus.jsonl"
if [[ $(uname -s) == Linux ]]; then
    step front-capped-stress python3 -I tests/front/stress.py "$root/target/fenrir" --work "$root/target/front-stress"
fi
step types-prelude tools/gen-prelude --check
step types-census-unit python3 -I tests/types/census_unit.py
step types-coverage python3 -I tests/types/coverage.py .wolf-bin/reference/spec --self-test
step types-rows python3 -I tests/types/check.py "$root/target/fenrir" --work "$root/target/types-rows"
step types-api python3 -I tests/types/api.py
step types-reference python3 -I tests/types/reference.py --work "$root/target/types-reference"
step types-census tools/census check
step types-determinism python3 -I tests/types/determinism.py "$root/target/fenrir"
if [[ $(uname -s) == Linux ]]; then
    step types-capped-stress python3 -I tests/types/stress.py "$root/target/fenrir" --work "$root/target/types-stress"
fi
step determinism tools/check-determinism
step strict-skips tools/check-skips --strict
if [[ ${1:-} == --oracle ]]; then step oracle-freshness tools/differ check; fi
