#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
export TMPDIR=${TMPDIR:-$root/target/tmp}
mkdir -p "$TMPDIR" target/evidence
step() {
    local name=$1
    shift
    local started=$SECONDS
    printf 'START %s\n' "$name"
    set +e
    "$@" > "target/evidence/$name.log" 2>&1
    local status=$?
    if [[ $status -eq 0 ]]; then
        tools/check-skips --strict --log "target/evidence/$name.log" >> "target/evidence/$name.log.strict" 2>&1
        status=$?
        cat "target/evidence/$name.log.strict" >> "target/evidence/$name.log"
    fi
    set -e
    sed 's/^/  /' "target/evidence/$name.log"
    printf 'END %s exit=%s secs=%s\n' "$name" "$status" "$((SECONDS-started))"
    if [[ $status -ne 0 ]]; then
        if [[ -n ${FENRIR_CI_KEEP_GOING:-} ]]; then failed+=("$name"); else exit "$status"; fi
    fi
}
# FENRIR_CI_KEEP_GOING=1 (a record's take): run every step and name each red one, then exit 1.
failed=()
step unit python3 -I tests/frame.py
step oracle-unit python3 -I tests/oracle_unit.py
step oracle-readonly python3 -I tests/oracle_readonly.py
step linux-readiness-unit python3 -I tests/backend/linux_readiness_unit.py
step backend-parts python3 -I tests/backend/run_linux_parts.py --self-test
step corpus-shards-unit python3 -I tests/lower/corpus_shards_unit.py
if [[ $(uname -s) == Linux ]]; then step inventory-scaling python3 -I tests/scaling.py; fi
step subset-counts tools/check-subset --counts
step diagnostics tools/check-diagnostics
step build tools/build
step subset tools/check-subset
step toolchain-tools tools/build-tools
step driver python3 -I tests/driver.py
step interpreter-smoke python3 -I tests/backend/interpreter.py "$root/target/fenrir" --out "$root/target/evidence/interpreter-smoke" --mode smoke
step interpreter-api python3 -I tests/backend/interpreter_api.py
step numeric-semantics python3 -I tests/numeric/semantics.py --out "$root/target/evidence/numeric-semantics"
step numeric-fir python3 -I tests/numeric/fir.py --compiler "$root/target/fenrir" --out "$root/target/evidence/numeric-fir"
step float-fir python3 -I tests/numeric/float_fir.py --compiler "$root/target/fenrir" --out "$root/target/evidence/float-fir"
step float-cases-table python3 -I tests/numeric/float_cases.py table
step interpreter-scaling-unit python3 -I tests/backend/interpreter_scaling_unit.py
step enum-api python3 -I tests/backend/enums.py --out "$root/target/evidence/enum-api" --api-only
step enum-interpreter python3 -I tests/backend/enums.py --out "$root/target/evidence/enum-interpreter" --compiler "$root/target/fenrir"
step collections python3 -I tests/backend/collections.py "$root/target/fenrir" --out "$root/target/evidence/collections"
step recursive python3 -I tests/backend/recursive.py "$root/target/fenrir" --out "$root/target/evidence/recursive" --reference
step mode-cases-table python3 -I tests/memory/mode_cases.py table
step mode-cases-paths python3 -I tests/memory/mode_cases.py paths
step region-cases-table python3 -I tests/memory/region_cases.py table
step region-cases-paths python3 -I tests/memory/region_cases.py paths
step copy-scaling-self-test python3 -I tests/memory/copy_scaling.py --self-test
step region-scaling-self-test python3 -I tests/memory/region_scaling.py --self-test
step copy-width-size python3 -I tests/backend/copy_width.py size "$root/target/fenrir" --out "$root/target/evidence/copy-width-size"
step copy-width-curve python3 -I tests/backend/copy_width.py curve "$root/target/fenrir" --out "$root/target/evidence/copy-width-curve"
step copy-width-cases python3 -I tests/backend/copy_width.py cases "$root/target/fenrir" --out "$root/target/evidence/copy-width-cases" --reference
step mode-cases python3 -I tests/memory/mode_cases.py check --compiler "$root/target/fenrir" --engine interpreter --out "$root/target/evidence/mode-cases"
step region-cases python3 -I tests/memory/region_cases.py check --compiler "$root/target/fenrir" --engine interpreter --out "$root/target/evidence/region-cases"
step outer-write python3 -I tests/memory/outer_write.py check --compiler "$root/target/fenrir" --engine interpreter --out "$root/target/outer-write" --reference
step string-fir python3 -I tests/backend/strings.py "$root/target/fenrir" --out "$root/target/evidence/string-fir"
step string-views python3 -I tests/strings/views.py "$root/target/fenrir" --out "$root/target/evidence/string-views"
step string-formats python3 -I tests/strings/format.py "$root/target/fenrir" --out "$root/target/evidence/string-formats" --reference
step value-rendering python3 -I tests/strings/render.py "$root/target/fenrir" --out "$root/target/evidence/value-rendering" --reference
step text-iteration python3 -I tests/strings/iteration.py "$root/target/fenrir" --out "$root/target/evidence/text-iteration" --reference
step source-traps python3 -I tests/strings/traps.py "$root/target/fenrir" --out "$root/target/evidence/source-traps" --reference
step binding-alternatives python3 -I tests/strings/patterns.py "$root/target/fenrir" --out "$root/target/evidence/binding-alternatives" --reference
step map-tier-unit python3 -I tests/strings/map_refusals_unit.py
step map-refusals python3 -I tests/strings/map_refusals.py "$root/target/fenrir" --out "$root/target/evidence/map-refusals" --reference
step string-corpus-lower python3 -I tests/strings/corpus.py --compiler "$root/target/fenrir" --mode lower --out "$root/target/evidence/string-corpus-lower"
step integer-corpus-typed python3 -I tests/numeric/corpus.py --compiler "$root/target/fenrir" --mode typed --out "$root/target/evidence/integer-corpus-typed"
step integer-corpus-lower python3 -I tests/numeric/corpus.py --compiler "$root/target/fenrir" --mode lower --out "$root/target/evidence/integer-corpus-lower"
step front-unit python3 -I tests/front/check.py "$root/target/fenrir" --work "$root/target/front-unit"
step front-grammar python3 -I tests/front/check.py "$root/target/fenrir" --rows tests/front/grammar.json --work "$root/target/front-grammar"
step front-coverage python3 -I tests/front/coverage.py .wolf-bin/reference/spec --self-test
step front-unicode python3 -I tests/front/unicode.py --check
step front-record-output python3 -I tests/front/record_output_test.py
step front-api python3 -I tests/front/api.py
step front-corpus python3 -I tests/front/corpus.py "$root/target/fenrir" .wolf-bin/reference/corpus --sources src --report "$root/target/evidence/front-corpus.jsonl"
if [[ $(uname -s) == Linux ]]; then
    step front-capped-stress python3 -I tests/front/stress.py "$root/target/fenrir" --work "$root/target/front-stress"
fi
step types-prelude tools/gen-prelude --check
step types-census-unit python3 -I tests/types/census_unit.py
step types-coverage python3 -I tests/types/coverage.py .wolf-bin/reference/spec --self-test
step types-outside-unit python3 -I tests/types/outside_unit.py
step types-rows python3 -I tests/types/check.py "$root/target/fenrir" --work "$root/target/types-rows"
step types-api python3 -I tests/types/api.py
if [[ $(uname -s) == Linux ]]; then
    step coverage-kernel python3 -I tests/types/coverage_api.py --bounded
else
    step coverage-kernel python3 -I tests/types/coverage_api.py
fi
step types-reference-unit python3 -I tests/types/reference_unit.py
step types-reference python3 -I tests/types/reference.py --work "$root/target/types-reference"
step types-resolve-patterns python3 -I tests/types/resolve_patterns.py
step types-pattern-invariants-unit python3 -I tests/types/pattern_invariants_unit.py
step types-patterns python3 -I tests/types/patterns.py --fenrir "$root/target/fenrir" --work "$root/target/types-patterns"
step types-patterns-reference python3 -I tests/types/patterns.py --reference --work "$root/target/types-patterns-reference"
step types-collections python3 -I tests/types/patterns.py --rows collection_rows --fenrir "$root/target/fenrir" --work "$root/target/types-collections"
step types-collections-reference python3 -I tests/types/patterns.py --rows collection_rows --reference --work "$root/target/types-collections-reference"
for rows in string_rows format_rows string_range_rows ruled_rows or_rows row_context_rows; do
    step "types-$rows" python3 -I tests/types/patterns.py --rows "$rows" --fenrir "$root/target/fenrir" --work "$root/target/evidence/types-$rows"
    step "types-$rows-reference" python3 -I tests/types/patterns.py --rows "$rows" --reference --work "$root/target/evidence/types-$rows-reference"
done
step types-analysis python3 -I tests/types/analysis.py --fenrir "$root/target/fenrir" --work "$root/target/types-analysis"
step types-census tools/census check
step numeric-membership python3 -I tests/numeric/membership.py --verdicts tests/lower/core-verdicts.json --self-test
step numeric-delta python3 -I tests/numeric/delta.py --self-test
step types-determinism python3 -I tests/types/determinism.py "$root/target/fenrir"
if [[ $(uname -s) == Linux ]]; then
    step types-capped-stress python3 -I tests/types/stress.py "$root/target/fenrir" --work "$root/target/types-stress"
fi
step determinism tools/check-determinism
step strict-skips tools/check-skips --strict
if [[ ${1:-} == --oracle ]]; then step oracle-freshness tools/differ check; fi
if [[ ${#failed[@]} -gt 0 ]]; then echo "FAILED STEPS: ${failed[*]}"; exit 1; fi
