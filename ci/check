#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
export TMPDIR=${TMPDIR:-$root/target/tmp}
mkdir -p "$TMPDIR" target/evidence
step() {
    local name=$1
    shift
    local started=$SECONDS
    printf 'START %s\n' "$name"
    set +e
    "$@" > "target/evidence/$name.log" 2>&1
    local status=$?
    if [[ $status -eq 0 ]]; then
        tools/check-skips --strict --log "target/evidence/$name.log" >> "target/evidence/$name.log.strict" 2>&1
        status=$?
        cat "target/evidence/$name.log.strict" >> "target/evidence/$name.log"
    fi
    set -e
    sed 's/^/  /' "target/evidence/$name.log"
    printf 'END %s exit=%s secs=%s\n' "$name" "$status" "$((SECONDS-started))"
    if [[ $status -ne 0 ]]; then exit "$status"; fi
}
step unit python3 -I tests/frame.py
step oracle-unit python3 -I tests/oracle_unit.py
if [[ $(uname -s) == Linux ]]; then step inventory-scaling python3 -I tests/scaling.py; fi
step subset tools/check-subset
step diagnostics tools/check-diagnostics
step build tools/build
step driver python3 -I tests/driver.py
step determinism tools/check-determinism
step strict-skips tools/check-skips --strict
if [[ ${1:-} == --oracle ]]; then step oracle-freshness tools/differ check; fi
