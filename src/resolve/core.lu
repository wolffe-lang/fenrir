//! member: true

use front

// The core's syntactic extent (docs/TYPED.md): F1, enums and `match`, lists,
// `Map`, tuples, error rows and their handling. One preorder walk in source
// order names the first construct outside it; resolution and typing refuse
// the few that need names or types to tell (a prelude entry outside the core,
// a method no list or map has, a generic type that is neither).

struct Core { what: str, node: int, nested: bool }

fn kind_of(s: front.Syntax, n: int) -> str { s.nodes[n].kind }
fn first_of(s: front.Syntax, n: int) -> int { s.nodes[n].first }
fn next_of(s: front.Syntax, n: int) -> int { s.nodes[n].next }
fn last_of(s: front.Syntax, n: int) -> int { s.nodes[n].last }
fn token_of(s: front.Syntax, n: int) -> str { s.tokens[s.nodes[n].token].kind }
fn spell_of(s: front.Syntax, n: int) -> str {
    let t = s.nodes[n].token
    s.text[s.tokens[t].span.start..s.tokens[t].span.end]
}

fn out(mut c: Core, what: str, n: int) {
    if c.node < 0 { c.what = what; c.node = n }
}

fn expression_name(k: str) -> str {
    if k == "FromEnd" { return "from-end index" }
    if k == "Range" { return "range" }
    if k == "Select" { return "`select`" }
    if k == "Closure" { return "closure" }
    if k == "Region" { return "region" }
    if k == "RegionValue" { return "region value" }
    if k == "InRegion" { return "in-region block" }
    if k == "Scope" { return "`scope`" }
    if k == "Spawn" { return "`spawn`" }
    if k == "When" { return "`when`" }
    if k == "Unsafe" { return "`unsafe`" }
    if k == "InlineC" { return "inline C" }
    if k == "Asm" { return "`asm`" }
    if k == "Borrow" { return "borrow" }
    ""
}

fn item_name(k: str) -> str {
    if k == "Enum" { return "`enum`" }
    if k == "Trait" { return "`trait`" }
    if k == "Impl" { return "`impl`" }
    if k == "TypeAlias" { return "type alias" }
    if k == "ErrorAlias" { return "error alias" }
    if k == "Use" { return "`use`" }
    if k == "ImportC" { return "`import c`" }
    if k == "Constant" { return "`const`" }
    if k == "ExternBinding" { return "extern binding" }
    if k == "Bindings" { return "module binding" }
    "item `{k}`"
}

fn core_binary(op: str) -> bool {
    op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "==" || op == "!=" ||
        op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" ||
        op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"
}

fn core_assign(op: str) -> bool {
    op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" ||
        op == "&=" || op == "|=" || op == "^=" || op == "<<=" || op == ">>="
}

fn core_unit(s: front.Syntax, mut c: Core) {
    var item = first_of(s, s.root)
    while item >= 0 && c.node < 0 {
        if kind_of(s, item) == "InnerAttribute" {
            // `#![index(0|1)]`, only as the file's first construct ([gram.attr.index]).
            if item != first_of(s, s.root) || index_marker(s, item) < 0 { out(mut c, "attribute", item) }
        }
        else { core_item(s, mut c, item) }
        item = next_of(s, item)
    }
}

// ---- attributes ([gram.attr.index], [diag.level.attr]) ---------------------
// The core takes two well-formed attributes: the subscript origin marker and,
// on an item, `allow`. Every other attribute, and every malformed or repeated
// marker (E0211, E0813 in the reference), stays outside the core by name.

/// `index(0)` or `index(1)` as an attribute's only entry: its origin, else -1.
pub fn index_marker(s: front.Syntax, attr: int) -> int {
    let entry = first_of(s, attr)
    if entry < 0 || next_of(s, entry) >= 0 || kind_of(s, entry) != "AttributeEntry" { return -1 }
    let path = first_of(s, entry)
    if !single_name(s, path, "index") { return -1 }
    let arg = next_of(s, path)
    if arg < 0 || next_of(s, arg) >= 0 || kind_of(s, arg) != "Literal" { return -1 }
    let text = spell_of(s, arg)
    if text == "0" { return 0 }
    if text == "1" { return 1 }
    -1
}

// `allow` or `allow(code, …)` as an attribute's only entry, each code a bare
// name. An empty or unknown allow is inert (W0303, W0302); none changes code.
fn allow_marker(s: front.Syntax, attr: int) -> bool {
    let entry = first_of(s, attr)
    if entry < 0 || next_of(s, entry) >= 0 || kind_of(s, entry) != "AttributeEntry" { return false }
    let path = first_of(s, entry)
    if !single_name(s, path, "allow") { return false }
    var code = next_of(s, path)
    while code >= 0 {
        if kind_of(s, code) != "AttributeEntry" { return false }
        let inner = first_of(s, code)
        if next_of(s, inner) >= 0 || kind_of(s, inner) != "Path" || next_of(s, first_of(s, inner)) >= 0 { return false }
        code = next_of(s, code)
    }
    true
}

/// Whether `allow` on the item `n` names `code` (compared without case).
pub fn allows(s: front.Syntax, n: int, code: str) -> bool {
    var a = first_of(s, n)
    while a >= 0 {
        if kind_of(s, a) == "Attribute" && allow_marker(s, a) {
            var arg = next_of(s, first_of(s, first_of(s, a)))
            while arg >= 0 {
                if spell_of(s, first_of(s, first_of(s, arg))).upper() == code { return true }
                arg = next_of(s, arg)
            }
        }
        a = next_of(s, a)
    }
    false
}

fn single_name(s: front.Syntax, path: int, name: str) -> bool {
    kind_of(s, path) == "Path" && next_of(s, first_of(s, path)) < 0 && spell_of(s, first_of(s, path)) == name
}

// [ct.attr.public]: `#[consttime(public(…))]` on a module function, as its only consttime attribute,
// naming each of the function's parameters once. With every parameter public there is no taint
// source ([ct.attr.secret], [ct.taint.source]) and nothing for a verifier to rule on; the function
// stays a call boundary ([ct.attr.barrier]), as every fenrir function is. Any other spelling (bare,
// a parameter left secret, a name the function does not declare) needs the verifier and stays
// refused as an attribute ([ct.taint.verify]).
fn all_public(s: front.Syntax, item: int, a: int) -> bool {
    let entry = first_of(s, a)
    if entry < 0 || next_of(s, entry) >= 0 || kind_of(s, entry) != "AttributeEntry" { return false }
    let path = first_of(s, entry)
    if !single_name(s, path, "consttime") { return false }
    let arg = next_of(s, path)
    if arg < 0 || next_of(s, arg) >= 0 || kind_of(s, arg) != "AttributeEntry" { return false }
    let head = first_of(s, arg)
    if !single_name(s, head, "public") { return false }
    var f = first_of(s, item)
    while f >= 0 && kind_of(s, f) != "Function" { f = next_of(s, f) }
    if f < 0 { return false }
    var params = List[str]()
    var c = first_of(s, f)
    while c >= 0 {
        if kind_of(s, c) == "Parameters" {
            var p = first_of(s, c)
            while p >= 0 {
                var pn = first_of(s, p)
                while pn >= 0 && kind_of(s, pn) != "Name" { pn = next_of(s, pn) }
                if pn < 0 { return false }
                (mut params).push(spell_of(s, pn))
                p = next_of(s, p)
            }
        }
        c = next_of(s, c)
    }
    var named = List[str]()
    var e = next_of(s, head)
    while e >= 0 {
        if kind_of(s, e) != "AttributeEntry" { return false }
        let name = first_of(s, e)
        if next_of(s, name) >= 0 || kind_of(s, name) != "Path" || next_of(s, first_of(s, name)) >= 0 { return false }
        let text = spell_of(s, first_of(s, name))
        if listed(named, text) || !listed(params, text) { return false }
        (mut named).push(text)
        e = next_of(s, e)
    }
    named.len == params.len && params.len > 0
}

fn listed(xs: List[str], x: str) -> bool {
    for y in xs { if y == x { return true } }
    false
}

// An item's or statement's attributes: `index` at most once, `allow` only
// where `items` says so.
fn core_attribute(s: front.Syntax, mut c: Core, a: int, items: bool, markers: int) -> int {
    if index_marker(s, a) >= 0 && markers == 0 { return 1 }
    if items && allow_marker(s, a) { return markers }
    out(mut c, "attribute", a)
    markers
}

/// Per node, whether its subscripts are 1-origin ([gram.expr.index.origin]):
/// the file's marker, then each item's or statement's, the innermost winning.
pub fn origins(s: front.Syntax) -> List[bool] {
    var one = List[bool]()
    var i: int = 0
    while i < s.nodes.len { (mut one).push(false); i += 1 }
    let first = first_of(s, s.root)
    let base = first >= 0 && kind_of(s, first) == "InnerAttribute" && index_marker(s, first) == 1
    origin_walk(s, mut one, s.root, base)
    one
}

fn origin_walk(s: front.Syntax, mut one: List[bool], n: int, outer: bool) {
    var here = outer
    let k = kind_of(s, n)
    if k == "Item" || k == "Statement" {
        var a = first_of(s, n)
        while a >= 0 {
            if kind_of(s, a) == "Attribute" {
                let m = index_marker(s, a)
                if m >= 0 { here = m == 1 }
            }
            a = next_of(s, a)
        }
    }
    one[n] = here
    var child = first_of(s, n)
    while child >= 0 { origin_walk(s, mut one, child, here); child = next_of(s, child) }
}

fn core_item(s: front.Syntax, mut c: Core, n: int) {
    var markers: int = 0
    var consttime: int = 0
    var d = first_of(s, n)
    while d >= 0 && c.node < 0 {
        let k = kind_of(s, d)
        if k == "Attribute" && consttime == 0 && all_public(s, n, d) { consttime = 1 }
        else if k == "Attribute" { markers = core_attribute(s, mut c, d, true, markers) }
        else if k == "Function" { core_function(s, mut c, d) }
        else if k == "Struct" || (k == "TypeAlias" && struct_body(s, d) >= 0) { core_struct(s, mut c, d) }
        else if k == "Enum" || (k == "TypeAlias" && enum_body(s, d) >= 0) { core_enum(s, mut c, d) }
        else if k == "TypeAlias" && adapter_body(s, d) >= 0 { core_adapter(s, mut c, d) }
        else if k == "ErrorAlias" { core_row(s, mut c, last_of(s, d)) }
        else if k != "Visibility" { out(mut c, item_name(k), d) }
        d = next_of(s, d)
    }
}

fn core_function(s: front.Syntax, mut c: Core, n: int) {
    var body = false
    var d = first_of(s, n)
    while d >= 0 && c.node < 0 {
        let k = kind_of(s, d)
        if k == "Qualifier" { out(mut c, "`{spell_of(s, d)}` fn", d) }
        else if k == "Generics" { out(mut c, "generics", d) }
        else if k == "Parameters" { core_parameters(s, mut c, d) }
        else if k == "ReturnType" {
            // [type.fn.never]: `never` is written only as a function's return type.
            let rt = first_of(s, d)
            if !never_type_name(s, rt) { core_type(s, mut c, rt) }
        }
        else if k == "Block" { body = true; core_block(s, mut c, d) }
        d = next_of(s, d)
    }
    if !body { out(mut c, "bodyless fn", n) }
}

fn core_parameters(s: front.Syntax, mut c: Core, n: int) {
    var p = first_of(s, n)
    while p >= 0 && c.node < 0 {
        if kind_of(s, p) == "Variadic" { out(mut c, "variadic", p) }
        var q = first_of(s, p)
        while q >= 0 && c.node < 0 {
            let k = kind_of(s, q)
            // [mem.tier0.mode]: `mut` and `take` parameters are in the core (F3b).
            if k == "Mode" { }
            else if k == "ViewSet" { out(mut c, "view set", q) }
            else if k == "Name" { if spell_of(s, q) == "self" { out(mut c, "`self` receiver", q) } }
            else { core_type(s, mut c, q) }
            q = next_of(s, q)
        }
        p = next_of(s, p)
    }
}

fn core_struct(s: front.Syntax, mut c: Core, n: int) {
    var d = first_of(s, n)
    while d >= 0 && c.node < 0 {
        let k = kind_of(s, d)
        if k == "Generics" { out(mut c, "generics", d) }
        else if k == "Fields" {
            var f = first_of(s, d)
            while f >= 0 && c.node < 0 {
                var g = first_of(s, f)
                while g >= 0 && c.node < 0 {
                    let kg = kind_of(s, g)
                    if kg == "Attribute" { out(mut c, "attribute", g) }
                    else if kg != "Visibility" && kg != "Name" { core_type(s, mut c, g) }
                    g = next_of(s, g)
                }
                f = next_of(s, f)
            }
        }
        d = next_of(s, d)
    }
}

fn never_type_name(s: front.Syntax, n: int) -> bool {
    if kind_of(s, n) != "NamedType" { return false }
    let path = first_of(s, n)
    next_of(s, path) < 0 && next_of(s, first_of(s, path)) < 0 && spell_of(s, first_of(s, path)) == "never"
}

fn core_type(s: front.Syntax, mut c: Core, n: int) {
    let k = kind_of(s, n)
    if never_type_name(s, n) { out(mut c, "type `never`", n); return }
    if k == "NamedType" {
        let path = first_of(s, n)
        if next_of(s, first_of(s, path)) >= 0 { out(mut c, "qualified type", n); return }
        let arguments = next_of(s, path)
        if arguments >= 0 {
            let head = spell_of(s, first_of(s, path))
            if head != "List" && head != "Map" && head != "wrapping" { out(mut c, "generic type `{head}`", n); return }
            var a = first_of(s, arguments)
            while a >= 0 && c.node < 0 { core_type_argument(s, mut c, a); a = next_of(s, a) }
        }
        return
    }
    if k == "TupleType" {
        var e = first_of(s, n)
        while e >= 0 && c.node < 0 { core_type(s, mut c, e); e = next_of(s, e) }
        return
    }
    if k == "PrefixType" {
        if spell_of(s, n) != "!" { out(mut c, "`{spell_of(s, n)}` type", n); return }
        core_type(s, mut c, first_of(s, n))
        return
    }
    if k == "ErrorType" {
        let inner = first_of(s, n)
        core_type(s, mut c, inner)
        let row = next_of(s, inner)
        if row >= 0 && kind_of(s, row) == "ErrorRow" { core_row(s, mut c, row) }
        else if row >= 0 && next_of(s, first_of(s, row)) >= 0 { out(mut c, "qualified row alias", row) }
        return
    }
    if k == "FunctionType" { out(mut c, "fn type", n); return }
    // A region value's type is in the core with regions (F3c).
    if k == "BuiltinType" { if spell_of(s, n) != "region" { out(mut c, "`{spell_of(s, n)}` type", n) }; return }
    out(mut c, "type `{k}`", n)
}

// A type written as an expression: a `List[…]` or `Map[…]` argument, or the
// arguments of the generic application `List[T]()` and `Map[K, V]()`.
fn core_type_argument(s: front.Syntax, mut c: Core, n: int) {
    let k = kind_of(s, n)
    if k == "Name" {
        if spell_of(s, n) == "never" { out(mut c, "type `never`", n) }
        return
    }
    if k == "Index" {
        let head = first_of(s, n)
        let text = if kind_of(s, head) == "Name" then spell_of(s, head) else ""
        if text != "List" && text != "Map" && text != "wrapping" { out(mut c, "generic type `{text}`", n); return }
        var a = first_of(s, next_of(s, head))
        while a >= 0 && c.node < 0 { core_type_argument(s, mut c, last_of(s, a)); a = next_of(s, a) }
        return
    }
    if k == "Argument" { core_type_argument(s, mut c, last_of(s, n)); return }
    if k == "Tuple" {
        var e = first_of(s, n)
        while e >= 0 && c.node < 0 { core_type_argument(s, mut c, e); e = next_of(s, e) }
        return
    }
    core_type(s, mut c, n)
}

// An error row's entries: a tag with optional payload types, or an alias.
fn core_row(s: front.Syntax, mut c: Core, n: int) {
    var entry = first_of(s, n)
    while entry >= 0 && c.node < 0 {
        if kind_of(s, entry) == "RowEntry" {
            let path = first_of(s, entry)
            if next_of(s, first_of(s, path)) >= 0 { out(mut c, "qualified row tag", path); return }
            var ty = next_of(s, path)
            while ty >= 0 && c.node < 0 { core_type(s, mut c, ty); ty = next_of(s, ty) }
        }
        entry = next_of(s, entry)
    }
}

// A `let`, `var` or `for` pattern: a name, `_`, or a tuple of those; in a
// `let` or `var` also a struct pattern, its fields shorthand or `field:
// pattern` with an optional closing `..` ([gram.pat.struct]). The released
// native compiler refuses a destructuring `for` over structs, so fenrir keeps
// that form out of its core.
fn core_binding_pattern(s: front.Syntax, mut c: Core, pat: int, structs: bool) {
    let kp = kind_of(s, pat)
    if kp == "NamePattern" {
        if next_of(s, first_of(s, first_of(s, pat))) >= 0 { out(mut c, "qualified pattern", pat) }
    } else if kp == "TuplePattern" {
        var p = first_of(s, pat)
        while p >= 0 && c.node < 0 { core_binding_pattern(s, mut c, p, structs); p = next_of(s, p) }
    } else if kp == "StructPattern" && structs {
        let path = first_of(s, pat)
        if next_of(s, first_of(s, path)) >= 0 { out(mut c, "qualified pattern", pat); return }
        var f = next_of(s, path)
        while f >= 0 && c.node < 0 {
            if kind_of(s, f) == "FieldPattern" {
                let sub = next_of(s, first_of(s, f))
                if sub >= 0 { core_binding_pattern(s, mut c, sub, structs) }
            } else if kind_of(s, f) != "RestPattern" { out(mut c, "pattern `{kind_of(s, f)}`", f) }
            f = next_of(s, f)
        }
    } else if kp != "WildcardPattern" { out(mut c, "pattern `{kp}`", pat) }
}

fn core_block(s: front.Syntax, mut c: Core, n: int) {
    var st = first_of(s, n)
    while st >= 0 && c.node < 0 {
        var markers: int = 0
        var d = first_of(s, st)
        while d >= 0 && c.node < 0 {
            let k = kind_of(s, d)
            if k == "Attribute" { markers = core_attribute(s, mut c, d, false, markers) }
            else if kind_of(s, st) == "Tail" { core_expression(s, mut c, d) }
            else if k == "Item" { core_statement_item(s, mut c, d) }
            else if k == "Assignment" { core_assignment(s, mut c, d) }
            else if k == "Defer" { core_defer(s, mut c, d) }
            else if k == "Assume" { out(mut c, "`assume`", d) }
            else { core_expression(s, mut c, d) }
            d = next_of(s, d)
        }
        st = next_of(s, st)
    }
}

// `defer e` and `errdefer e` ([mem.model.order]). A deferred expression that
// would leave its scope by a jump, or that defers again, stays outside the core.
fn core_defer(s: front.Syntax, mut c: Core, n: int) {
    let e = last_of(s, n)
    let blocker = deferred_blocker(s, e)
    if blocker >= 0 {
        let what = if kind_of(s, blocker) == "Defer" then "a `defer` inside a deferred expression" else "a jump inside a deferred expression"
        out(mut c, what, blocker)
        return
    }
    core_expression(s, mut c, e)
}

fn deferred_blocker(s: front.Syntax, n: int) -> int {
    let k = kind_of(s, n)
    if k == "Defer" || k == "Jump" { return n }
    var child = first_of(s, n)
    while child >= 0 {
        let found = deferred_blocker(s, child)
        if found >= 0 { return found }
        child = next_of(s, child)
    }
    -1
}

fn core_statement_item(s: front.Syntax, mut c: Core, n: int) {
    var d = first_of(s, n)
    while d >= 0 && c.node < 0 {
        let k = kind_of(s, d)
        if k == "Attribute" { out(mut c, "attribute", d) }
        else if k == "Bindings" { core_bindings(s, mut c, d) }
        else if k == "Function" { core_nested_function(s, mut c, d) }
        else if k != "Visibility" { out(mut c, "nested item", d) }
        d = next_of(s, d)
    }
}

// A `fn` item in a function body is in the core when it is non-generic, unqualified and holds no
// `fn` item itself; the resolver keeps it to its own names and module items, called after its
// declaration ([gram.item.fn]). Anything else about it stays `nested item`.
fn core_nested_function(s: front.Syntax, mut c: Core, n: int) {
    if c.nested { out(mut c, "nested item", n); return }
    var d = first_of(s, n)
    while d >= 0 {
        if kind_of(s, d) == "Generics" || kind_of(s, d) == "Qualifier" { out(mut c, "nested item", n); return }
        // The reference refuses a nested `fn` whose result carries an error row.
        if kind_of(s, d) == "ReturnType" {
            let rt = first_of(s, d)
            if kind_of(s, rt) == "ErrorType" || (kind_of(s, rt) == "PrefixType" && spell_of(s, rt) == "!") { out(mut c, "nested item", n); return }
        }
        d = next_of(s, d)
    }
    c.nested = true
    core_function(s, mut c, n)
    c.nested = false
}

fn core_bindings(s: front.Syntax, mut c: Core, n: int) {
    let bk = first_of(s, n)
    if spell_of(s, bk) == "const" { out(mut c, "`const`", bk); return }
    var b = next_of(s, bk)
    while b >= 0 && c.node < 0 {
        let pat = first_of(s, b)
        core_binding_pattern(s, mut c, pat, true)
        var q = next_of(s, pat)
        while q >= 0 && c.node < 0 {
            if next_of(s, q) >= 0 { core_type(s, mut c, q) } else { core_expression(s, mut c, q) }
            q = next_of(s, q)
        }
        b = next_of(s, b)
    }
}

fn core_assignment(s: front.Syntax, mut c: Core, n: int) {
    let place = first_of(s, n)
    let kp = kind_of(s, place)
    if kp == "Member" || kp == "Name" || kp == "Index" { core_expression(s, mut c, place) }
    else {
        core_expression(s, mut c, place)
        out(mut c, "assignment place", place)
    }
    let op = next_of(s, place)
    if !core_assign(spell_of(s, op)) { out(mut c, "assignment `{spell_of(s, op)}`", op) }
    var d = next_of(s, op)
    while d >= 0 && c.node < 0 {
        if kind_of(s, d) != "Mode" { core_expression(s, mut c, d) }
        d = next_of(s, d)
    }
}

fn core_expression(s: front.Syntax, mut c: Core, n: int) {
    if c.node >= 0 { return }
    let k = kind_of(s, n)
    if k == "Cast" {
        core_expression(s, mut c, first_of(s, n))
        core_type(s, mut c, last_of(s, n))
        return
    }
    // [mem.region.create.1], [mem.region.create.3]: the sugar block, a region value and `in r` are in the core
    // (F3c), each with an optional `cap:` budget; a region strategy (`rc`, `pool(T)`) is F3d's.
    if k == "Region" || k == "RegionValue" {
        var d = first_of(s, n)
        while d >= 0 && c.node < 0 {
            let dk = kind_of(s, d)
            if dk == "RegionStrategy" { out(mut c, "expression `RegionStrategy`", d); return }
            if dk == "RegionCapacity" { core_expression(s, mut c, first_of(s, d)) }
            else if dk == "Block" { core_block(s, mut c, d) }
            d = next_of(s, d)
        }
        return
    }
    if k == "InRegion" {
        core_expression(s, mut c, first_of(s, n))
        core_block(s, mut c, last_of(s, n))
        return
    }
    let named = expression_name(k)
    if named != "" { out(mut c, named, n); return }
    if k == "Name" { return }
    if k == "Match" { core_match(s, mut c, n); return }
    if k == "Literal" {
        let t = token_of(s, n)
        if t != "int" && t != "float" && t != "true" && t != "false" && t != "raw" && t != "char" { out(mut c, "{t} literal", n) }
        return
    }
    if k == "String" {
        let multi = token_of(s, n) == "multi-open"
        var d = first_of(s, n)
        while d >= 0 && c.node < 0 {
            if kind_of(s, d) == "Interpolation" {
                if multi { out(mut c, "interpolation in a multiline string", d); return }
                let value = first_of(s, d)
                var format = next_of(s, value)
                while format >= 0 {
                    if kind_of(s, format) == "FormatArgument" { out(mut c, "computed format spec", format); return }
                    format = next_of(s, format)
                }
                core_expression(s, mut c, value)
            }
            d = next_of(s, d)
        }
        return
    }
    if k == "Group" { core_expression(s, mut c, first_of(s, n)); return }
    if k == "Prefix" {
        let op = first_of(s, n)
        let operand = next_of(s, op)
        let o = spell_of(s, op)
        // [mem.tier0.move]: `move x` and `copy x` are in the core (F3b); `&`, `&mut`, `*` and `freeze` are not.
        let core_prefix = o == "-" || o == "!" || o == "move" || o == "copy"
        if !core_prefix || kind_of(s, operand) == "Mode" { out(mut c, "prefix `{o}`", n); return }
        // [mem.region.copyout]: `copy region { … }` is F3d's.
        if o == "copy" && kind_of(s, operand) == "Region" { out(mut c, "copy region block", n); return }
        core_expression(s, mut c, operand)
        return
    }
    if k == "Binary" {
        let left = first_of(s, n)
        let op = next_of(s, left)
        core_expression(s, mut c, left)
        if !core_binary(spell_of(s, op)) { out(mut c, "operator `{spell_of(s, op)}`", op); return }
        core_expression(s, mut c, next_of(s, op))
        return
    }
    if k == "Call" {
        let callee = first_of(s, n)
        let kc = kind_of(s, callee)
        if kc == "Index" {
            // `List[T]()` and `Map[K, V]()`; any other application is generic.
            let head = first_of(s, callee)
            let text = if kind_of(s, head) == "Name" then spell_of(s, head) else ""
            if text != "List" && text != "Map" { out(mut c, "generic application", n); return }
            var t = first_of(s, next_of(s, head))
            while t >= 0 && c.node < 0 { core_type_argument(s, mut c, last_of(s, t)); t = next_of(s, t) }
        } else if kc == "Member" {
            let receiver = first_of(s, callee)
            if kind_of(s, receiver) == "Receiver" { core_receiver(s, mut c, receiver) }
            else if kind_of(s, receiver) != "Name" { core_expression(s, mut c, receiver) }
        } else if kc != "Name" { out(mut c, "call of a computed value", n); return }
        var a = first_of(s, next_of(s, callee))
        while a >= 0 && c.node < 0 {
            var v = first_of(s, a)
            if kind_of(s, v) == "Mode" { v = next_of(s, v) }
            if kc == "Member" && spell_of(s, last_of(s, callee)) == "get" && kind_of(s, v) == "Range" { core_slice_range(s, mut c, v) }
            else { core_expression(s, mut c, v) }
            a = next_of(s, a)
        }
        return
    }
    if k == "StructLiteral" {
        let head = first_of(s, n)
        if kind_of(s, head) != "Name" { out(mut c, "qualified struct literal", head); return }
        var f = next_of(s, head)
        while f >= 0 && c.node < 0 {
            let value = next_of(s, first_of(s, f))
            // `[]` is in the core as a field's whole initializer, where the field's type gives the
            // element type; typing keeps it to a `List`-typed field.
            let empty = value >= 0 && kind_of(s, value) == "List" && first_of(s, value) < 0
            if value >= 0 && !empty { core_expression(s, mut c, value) }
            f = next_of(s, f)
        }
        return
    }
    if k == "Member" {
        let receiver = first_of(s, n)
        if kind_of(s, receiver) == "Receiver" { core_receiver(s, mut c, receiver) }
        else { core_expression(s, mut c, receiver) }
        return
    }
    if k == "List" || k == "Tuple" || k == "Propagate" {
        if k == "List" && first_of(s, n) < 0 { out(mut c, "an empty list literal", n); return }
        var e = first_of(s, n)
        while e >= 0 && c.node < 0 { core_expression(s, mut c, e); e = next_of(s, e) }
        return
    }
    if k == "Index" {
        core_expression(s, mut c, first_of(s, n))
        var a = first_of(s, next_of(s, first_of(s, n)))
        while a >= 0 && c.node < 0 {
            let v = first_of(s, a)
            if kind_of(s, v) == "Mode" { out(mut c, "index mode `{spell_of(s, v)}`", v); return }
            if kind_of(s, v) == "Range" { core_slice_range(s, mut c, v) } else { core_expression(s, mut c, v) }
            a = next_of(s, a)
        }
        return
    }
    if k == "Default" {
        let left = first_of(s, n)
        core_expression(s, mut c, left)
        let fallback = last_of(s, n)
        if kind_of(s, fallback) == "Handler" {
            core_pattern(s, mut c, first_of(s, fallback))
            core_expression(s, mut c, last_of(s, fallback))
        } else { core_expression(s, mut c, fallback) }
        return
    }
    if k == "Receiver" { out(mut c, "moded receiver", n); return }
    if k == "If" {
        var d = first_of(s, n)
        while d >= 0 && c.node < 0 {
            if kind_of(s, d) == "Block" { core_block(s, mut c, d) } else { core_expression(s, mut c, d) }
            d = next_of(s, d)
        }
        return
    }
    if k == "Block" { core_block(s, mut c, n); return }
    if k == "Loop" {
        let lk = first_of(s, n)
        let word = spell_of(s, lk)
        if word == "for" {
            let pat = next_of(s, lk)
            core_binding_pattern(s, mut c, pat, false)
            let header = next_of(s, pat)
            if kind_of(s, header) == "Range" { core_range(s, mut c, header) } else { core_expression(s, mut c, header) }
            core_block(s, mut c, next_of(s, header))
            return
        }
        if word == "loop" { core_block(s, mut c, next_of(s, lk)); return }
        if word != "while" { out(mut c, "`{word}` loop", n); return }
        let header = next_of(s, lk)
        core_expression(s, mut c, header)
        core_block(s, mut c, next_of(s, header))
        return
    }
    if k == "Jump" {
        let jk = first_of(s, n)
        let operand = next_of(s, jk)
        if operand >= 0 {
            if spell_of(s, jk) != "return" { out(mut c, "`{spell_of(s, jk)}` value", n); return }
            core_expression(s, mut c, operand)
        }
        return
    }
    out(mut c, "expression `{k}`", n)
}

// A range where one is spelled: a `for` header or a slice subscript. Both
// endpoints are present; the open and end-relative spellings are refused.
fn core_slice_range(s: front.Syntax, mut c: Core, n: int) {
    var endpoint = first_of(s, n)
    while endpoint >= 0 {
        if kind_of(s, endpoint) == "FromEnd" { core_expression(s, mut c, last_of(s, endpoint)) }
        else if kind_of(s, endpoint) != "Operator" { core_expression(s, mut c, endpoint) }
        endpoint = next_of(s, endpoint)
    }
}

fn core_range(s: front.Syntax, mut c: Core, n: int) {
    let first = first_of(s, n)
    if kind_of(s, first) == "Operator" || kind_of(s, last_of(s, n)) == "Operator" { out(mut c, "an open range", n); return }
    core_expression(s, mut c, first)
    core_expression(s, mut c, last_of(s, n))
}

// `(mut xs)` before a member: a list or map method's mutable receiver. Only
// `mut` is in scope; the checker decides whether the method takes it.
fn core_receiver(s: front.Syntax, mut c: Core, n: int) {
    let mode = first_of(s, n)
    if spell_of(s, mode) != "mut" { out(mut c, "`{spell_of(s, mode)}` receiver", n); return }
    core_expression(s, mut c, last_of(s, n))
}

/// The first construct outside the core, as (what, node); node -1 if none.
fn core_scope(s: front.Syntax) -> Core {
    var c = Core { what: "", node: -1, nested: false }
    core_unit(s, mut c)
    c
}
