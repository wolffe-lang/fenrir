//! member: true

use front

// The core's syntactic extent (docs/TYPED.md): F1, enums and `match`, lists,
// `Map`, tuples, error rows and their handling. One preorder walk in source
// order names the first construct outside it; resolution and typing refuse
// the few that need names or types to tell (a prelude entry outside the core,
// a method no list or map has, a generic type that is neither).

struct Core { what: str, node: int }

fn kind_of(s: front.Syntax, n: int) -> str { s.nodes[n].kind }
fn first_of(s: front.Syntax, n: int) -> int { s.nodes[n].first }
fn next_of(s: front.Syntax, n: int) -> int { s.nodes[n].next }
fn last_of(s: front.Syntax, n: int) -> int { s.nodes[n].last }
fn token_of(s: front.Syntax, n: int) -> str { s.tokens[s.nodes[n].token].kind }
fn spell_of(s: front.Syntax, n: int) -> str {
    let t = s.nodes[n].token
    s.text[s.tokens[t].span.start..s.tokens[t].span.end]
}

fn out(mut c: Core, what: str, n: int) {
    if c.node < 0 { c.what = what; c.node = n }
}

fn expression_name(k: str) -> str {
    if k == "FromEnd" { return "from-end index" }
    if k == "Cast" { return "cast `as`" }
    if k == "Range" { return "range" }
    if k == "Select" { return "`select`" }
    if k == "Closure" { return "closure" }
    if k == "Region" { return "region" }
    if k == "RegionValue" { return "region value" }
    if k == "InRegion" { return "in-region block" }
    if k == "Scope" { return "`scope`" }
    if k == "Spawn" { return "`spawn`" }
    if k == "When" { return "`when`" }
    if k == "Unsafe" { return "`unsafe`" }
    if k == "InlineC" { return "inline C" }
    if k == "Asm" { return "`asm`" }
    if k == "Borrow" { return "borrow" }
    ""
}

fn item_name(k: str) -> str {
    if k == "Enum" { return "`enum`" }
    if k == "Trait" { return "`trait`" }
    if k == "Impl" { return "`impl`" }
    if k == "TypeAlias" { return "type alias" }
    if k == "ErrorAlias" { return "error alias" }
    if k == "Use" { return "`use`" }
    if k == "ImportC" { return "`import c`" }
    if k == "Constant" { return "`const`" }
    if k == "ExternBinding" { return "extern binding" }
    if k == "Bindings" { return "module binding" }
    "item `{k}`"
}

fn core_binary(op: str) -> bool {
    op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "==" || op == "!=" ||
        op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||"
}

fn core_assign(op: str) -> bool {
    op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%="
}

fn core_unit(s: front.Syntax, mut c: Core) {
    var item = first_of(s, s.root)
    while item >= 0 && c.node < 0 {
        if kind_of(s, item) == "InnerAttribute" { out(mut c, "attribute", item) }
        else { core_item(s, mut c, item) }
        item = next_of(s, item)
    }
}

fn core_item(s: front.Syntax, mut c: Core, n: int) {
    var d = first_of(s, n)
    while d >= 0 && c.node < 0 {
        let k = kind_of(s, d)
        if k == "Attribute" { out(mut c, "attribute", d) }
        else if k == "Function" { core_function(s, mut c, d) }
        else if k == "Struct" { core_struct(s, mut c, d) }
        else if k == "Enum" || (k == "TypeAlias" && enum_body(s, d) >= 0) { core_enum(s, mut c, d) }
        else if k == "ErrorAlias" { core_row(s, mut c, last_of(s, d)) }
        else if k != "Visibility" { out(mut c, item_name(k), d) }
        d = next_of(s, d)
    }
}

fn core_function(s: front.Syntax, mut c: Core, n: int) {
    var body = false
    var d = first_of(s, n)
    while d >= 0 && c.node < 0 {
        let k = kind_of(s, d)
        if k == "Qualifier" { out(mut c, "`{spell_of(s, d)}` fn", d) }
        else if k == "Generics" { out(mut c, "generics", d) }
        else if k == "Parameters" { core_parameters(s, mut c, d) }
        else if k == "ReturnType" { core_type(s, mut c, first_of(s, d)) }
        else if k == "Block" { body = true; core_block(s, mut c, d) }
        d = next_of(s, d)
    }
    if !body { out(mut c, "bodyless fn", n) }
}

fn core_parameters(s: front.Syntax, mut c: Core, n: int) {
    var p = first_of(s, n)
    while p >= 0 && c.node < 0 {
        if kind_of(s, p) == "Variadic" { out(mut c, "variadic", p) }
        var q = first_of(s, p)
        while q >= 0 && c.node < 0 {
            let k = kind_of(s, q)
            if k == "Mode" { out(mut c, "parameter mode `{spell_of(s, q)}`", q) }
            else if k == "ViewSet" { out(mut c, "view set", q) }
            else if k == "Name" { if spell_of(s, q) == "self" { out(mut c, "`self` receiver", q) } }
            else { core_type(s, mut c, q) }
            q = next_of(s, q)
        }
        p = next_of(s, p)
    }
}

fn core_struct(s: front.Syntax, mut c: Core, n: int) {
    var d = first_of(s, n)
    while d >= 0 && c.node < 0 {
        let k = kind_of(s, d)
        if k == "Generics" { out(mut c, "generics", d) }
        else if k == "Fields" {
            var f = first_of(s, d)
            while f >= 0 && c.node < 0 {
                var g = first_of(s, f)
                while g >= 0 && c.node < 0 {
                    let kg = kind_of(s, g)
                    if kg == "Attribute" { out(mut c, "attribute", g) }
                    else if kg != "Visibility" && kg != "Name" { core_type(s, mut c, g) }
                    g = next_of(s, g)
                }
                f = next_of(s, f)
            }
        }
        d = next_of(s, d)
    }
}

fn core_type(s: front.Syntax, mut c: Core, n: int) {
    let k = kind_of(s, n)
    if k == "NamedType" {
        let path = first_of(s, n)
        if next_of(s, first_of(s, path)) >= 0 { out(mut c, "qualified type", n); return }
        let arguments = next_of(s, path)
        if arguments >= 0 {
            let head = spell_of(s, first_of(s, path))
            if head != "List" && head != "Map" { out(mut c, "generic type `{head}`", n); return }
            var a = first_of(s, arguments)
            while a >= 0 && c.node < 0 { core_type_argument(s, mut c, a); a = next_of(s, a) }
        }
        return
    }
    if k == "TupleType" {
        var e = first_of(s, n)
        while e >= 0 && c.node < 0 { core_type(s, mut c, e); e = next_of(s, e) }
        return
    }
    if k == "PrefixType" {
        if spell_of(s, n) != "!" { out(mut c, "`{spell_of(s, n)}` type", n); return }
        core_type(s, mut c, first_of(s, n))
        return
    }
    if k == "ErrorType" {
        let inner = first_of(s, n)
        core_type(s, mut c, inner)
        let row = next_of(s, inner)
        if row >= 0 && kind_of(s, row) == "ErrorRow" { core_row(s, mut c, row) }
        else if row >= 0 && next_of(s, first_of(s, row)) >= 0 { out(mut c, "qualified row alias", row) }
        return
    }
    if k == "FunctionType" { out(mut c, "fn type", n); return }
    if k == "BuiltinType" { out(mut c, "`{spell_of(s, n)}` type", n); return }
    out(mut c, "type `{k}`", n)
}

// A type written as an expression: a `List[…]` or `Map[…]` argument, or the
// arguments of the generic application `List[T]()` and `Map[K, V]()`.
fn core_type_argument(s: front.Syntax, mut c: Core, n: int) {
    let k = kind_of(s, n)
    if k == "Name" { return }
    if k == "Index" {
        let head = first_of(s, n)
        let text = if kind_of(s, head) == "Name" then spell_of(s, head) else ""
        if text != "List" && text != "Map" { out(mut c, "generic type `{text}`", n); return }
        var a = first_of(s, next_of(s, head))
        while a >= 0 && c.node < 0 { core_type_argument(s, mut c, last_of(s, a)); a = next_of(s, a) }
        return
    }
    if k == "Argument" { core_type_argument(s, mut c, last_of(s, n)); return }
    if k == "Tuple" {
        var e = first_of(s, n)
        while e >= 0 && c.node < 0 { core_type_argument(s, mut c, e); e = next_of(s, e) }
        return
    }
    core_type(s, mut c, n)
}

// An error row's entries: a tag with optional payload types, or an alias.
fn core_row(s: front.Syntax, mut c: Core, n: int) {
    var entry = first_of(s, n)
    while entry >= 0 && c.node < 0 {
        if kind_of(s, entry) == "RowEntry" {
            let path = first_of(s, entry)
            if next_of(s, first_of(s, path)) >= 0 { out(mut c, "qualified row tag", path); return }
            var ty = next_of(s, path)
            while ty >= 0 && c.node < 0 { core_type(s, mut c, ty); ty = next_of(s, ty) }
        }
        entry = next_of(s, entry)
    }
}

// A `let`, `var` or `for` pattern: a name, `_`, or a tuple of those.
fn core_binding_pattern(s: front.Syntax, mut c: Core, pat: int) {
    let kp = kind_of(s, pat)
    if kp == "NamePattern" {
        if next_of(s, first_of(s, first_of(s, pat))) >= 0 { out(mut c, "qualified pattern", pat) }
    } else if kp == "TuplePattern" {
        var p = first_of(s, pat)
        while p >= 0 && c.node < 0 { core_binding_pattern(s, mut c, p); p = next_of(s, p) }
    } else if kp != "WildcardPattern" { out(mut c, "pattern `{kp}`", pat) }
}

fn core_block(s: front.Syntax, mut c: Core, n: int) {
    var st = first_of(s, n)
    while st >= 0 && c.node < 0 {
        var d = first_of(s, st)
        while d >= 0 && c.node < 0 {
            let k = kind_of(s, d)
            if k == "Attribute" { out(mut c, "attribute", d) }
            else if kind_of(s, st) == "Tail" { core_expression(s, mut c, d) }
            else if k == "Item" { core_statement_item(s, mut c, d) }
            else if k == "Assignment" { core_assignment(s, mut c, d) }
            else if k == "Defer" { out(mut c, "`{spell_of(s, d)}`", d) }
            else if k == "Assume" { out(mut c, "`assume`", d) }
            else { core_expression(s, mut c, d) }
            d = next_of(s, d)
        }
        st = next_of(s, st)
    }
}

fn core_statement_item(s: front.Syntax, mut c: Core, n: int) {
    var d = first_of(s, n)
    while d >= 0 && c.node < 0 {
        let k = kind_of(s, d)
        if k == "Attribute" { out(mut c, "attribute", d) }
        else if k == "Bindings" { core_bindings(s, mut c, d) }
        else if k != "Visibility" { out(mut c, "nested item", d) }
        d = next_of(s, d)
    }
}

fn core_bindings(s: front.Syntax, mut c: Core, n: int) {
    let bk = first_of(s, n)
    if spell_of(s, bk) == "const" { out(mut c, "`const`", bk); return }
    var b = next_of(s, bk)
    while b >= 0 && c.node < 0 {
        let pat = first_of(s, b)
        core_binding_pattern(s, mut c, pat)
        var q = next_of(s, pat)
        while q >= 0 && c.node < 0 {
            if next_of(s, q) >= 0 { core_type(s, mut c, q) } else { core_expression(s, mut c, q) }
            q = next_of(s, q)
        }
        b = next_of(s, b)
    }
}

fn core_assignment(s: front.Syntax, mut c: Core, n: int) {
    let place = first_of(s, n)
    let kp = kind_of(s, place)
    if kp == "Member" || kp == "Name" || kp == "Index" { core_expression(s, mut c, place) }
    else {
        core_expression(s, mut c, place)
        out(mut c, "assignment place", place)
    }
    let op = next_of(s, place)
    if !core_assign(spell_of(s, op)) { out(mut c, "assignment `{spell_of(s, op)}`", op) }
    var d = next_of(s, op)
    while d >= 0 && c.node < 0 {
        if kind_of(s, d) == "Mode" { out(mut c, "moded store", d) } else { core_expression(s, mut c, d) }
        d = next_of(s, d)
    }
}

fn core_expression(s: front.Syntax, mut c: Core, n: int) {
    if c.node >= 0 { return }
    let k = kind_of(s, n)
    let named = expression_name(k)
    if named != "" { out(mut c, named, n); return }
    if k == "Name" { return }
    if k == "Match" { core_match(s, mut c, n); return }
    if k == "Literal" {
        let t = token_of(s, n)
        if t != "int" && t != "true" && t != "false" && t != "raw" && t != "char" { out(mut c, "{t} literal", n) }
        return
    }
    if k == "String" {
        let multi = token_of(s, n) == "multi-open"
        var d = first_of(s, n)
        while d >= 0 && c.node < 0 {
            if kind_of(s, d) == "Interpolation" {
                if multi { out(mut c, "interpolation in a multiline string", d); return }
                let value = first_of(s, d)
                var format = next_of(s, value)
                while format >= 0 {
                    if kind_of(s, format) == "FormatArgument" { out(mut c, "computed format spec", format); return }
                    format = next_of(s, format)
                }
                core_expression(s, mut c, value)
            }
            d = next_of(s, d)
        }
        return
    }
    if k == "Group" { core_expression(s, mut c, first_of(s, n)); return }
    if k == "Prefix" {
        let op = first_of(s, n)
        let operand = next_of(s, op)
        let o = spell_of(s, op)
        if (o != "-" && o != "!") || kind_of(s, operand) == "Mode" { out(mut c, "prefix `{o}`", n); return }
        core_expression(s, mut c, operand)
        return
    }
    if k == "Binary" {
        let left = first_of(s, n)
        let op = next_of(s, left)
        core_expression(s, mut c, left)
        if !core_binary(spell_of(s, op)) { out(mut c, "operator `{spell_of(s, op)}`", op); return }
        core_expression(s, mut c, next_of(s, op))
        return
    }
    if k == "Call" {
        let callee = first_of(s, n)
        let kc = kind_of(s, callee)
        if kc == "Index" {
            // `List[T]()` and `Map[K, V]()`; any other application is generic.
            let head = first_of(s, callee)
            let text = if kind_of(s, head) == "Name" then spell_of(s, head) else ""
            if text != "List" && text != "Map" { out(mut c, "generic application", n); return }
            var t = first_of(s, next_of(s, head))
            while t >= 0 && c.node < 0 { core_type_argument(s, mut c, last_of(s, t)); t = next_of(s, t) }
        } else if kc == "Member" {
            let receiver = first_of(s, callee)
            if kind_of(s, receiver) == "Receiver" { core_receiver(s, mut c, receiver) }
            else if kind_of(s, receiver) != "Name" { core_expression(s, mut c, receiver) }
        } else if kc != "Name" { out(mut c, "call of a computed value", n); return }
        var a = first_of(s, next_of(s, callee))
        while a >= 0 && c.node < 0 {
            let v = first_of(s, a)
            if kind_of(s, v) == "Mode" { out(mut c, "argument mode `{spell_of(s, v)}`", v); return }
            if kc == "Member" && spell_of(s, last_of(s, callee)) == "get" && kind_of(s, v) == "Range" { core_range(s, mut c, v) }
            else { core_expression(s, mut c, v) }
            a = next_of(s, a)
        }
        return
    }
    if k == "StructLiteral" {
        let head = first_of(s, n)
        if kind_of(s, head) != "Name" { out(mut c, "qualified struct literal", head); return }
        var f = next_of(s, head)
        while f >= 0 && c.node < 0 {
            let value = next_of(s, first_of(s, f))
            if value >= 0 { core_expression(s, mut c, value) }
            f = next_of(s, f)
        }
        return
    }
    if k == "Member" {
        let receiver = first_of(s, n)
        if kind_of(s, receiver) == "Receiver" { core_receiver(s, mut c, receiver) }
        else { core_expression(s, mut c, receiver) }
        return
    }
    if k == "List" || k == "Tuple" || k == "Propagate" {
        if k == "List" && first_of(s, n) < 0 { out(mut c, "an empty list literal", n); return }
        var e = first_of(s, n)
        while e >= 0 && c.node < 0 { core_expression(s, mut c, e); e = next_of(s, e) }
        return
    }
    if k == "Index" {
        core_expression(s, mut c, first_of(s, n))
        var a = first_of(s, next_of(s, first_of(s, n)))
        while a >= 0 && c.node < 0 {
            let v = first_of(s, a)
            if kind_of(s, v) == "Mode" { out(mut c, "index mode `{spell_of(s, v)}`", v); return }
            if kind_of(s, v) == "Range" { core_range(s, mut c, v) } else { core_expression(s, mut c, v) }
            a = next_of(s, a)
        }
        return
    }
    if k == "Default" {
        let left = first_of(s, n)
        core_expression(s, mut c, left)
        let fallback = last_of(s, n)
        if kind_of(s, fallback) == "Handler" {
            core_pattern(s, mut c, first_of(s, fallback))
            core_expression(s, mut c, last_of(s, fallback))
        } else { core_expression(s, mut c, fallback) }
        return
    }
    if k == "Receiver" { out(mut c, "moded receiver", n); return }
    if k == "If" {
        var d = first_of(s, n)
        while d >= 0 && c.node < 0 {
            if kind_of(s, d) == "Block" { core_block(s, mut c, d) } else { core_expression(s, mut c, d) }
            d = next_of(s, d)
        }
        return
    }
    if k == "Block" { core_block(s, mut c, n); return }
    if k == "Loop" {
        let lk = first_of(s, n)
        let word = spell_of(s, lk)
        if word == "for" {
            let pat = next_of(s, lk)
            core_binding_pattern(s, mut c, pat)
            let header = next_of(s, pat)
            if kind_of(s, header) == "Range" { core_range(s, mut c, header) } else { core_expression(s, mut c, header) }
            core_block(s, mut c, next_of(s, header))
            return
        }
        if word != "while" { out(mut c, "`{word}` loop", n); return }
        let header = next_of(s, lk)
        core_expression(s, mut c, header)
        core_block(s, mut c, next_of(s, header))
        return
    }
    if k == "Jump" {
        let jk = first_of(s, n)
        let operand = next_of(s, jk)
        if operand >= 0 {
            if spell_of(s, jk) != "return" { out(mut c, "`{spell_of(s, jk)}` value", n); return }
            core_expression(s, mut c, operand)
        }
        return
    }
    out(mut c, "expression `{k}`", n)
}

// A range where one is spelled: a `for` header or a slice subscript. Both
// endpoints are present; the open and end-relative spellings are refused.
fn core_range(s: front.Syntax, mut c: Core, n: int) {
    let first = first_of(s, n)
    if kind_of(s, first) == "Operator" || kind_of(s, last_of(s, n)) == "Operator" { out(mut c, "an open range", n); return }
    core_expression(s, mut c, first)
    core_expression(s, mut c, last_of(s, n))
}

// `(mut xs)` before a member: a list or map method's mutable receiver. Only
// `mut` is in scope; the checker decides whether the method takes it.
fn core_receiver(s: front.Syntax, mut c: Core, n: int) {
    let mode = first_of(s, n)
    if spell_of(s, mode) != "mut" { out(mut c, "`{spell_of(s, mode)}` receiver", n); return }
    core_expression(s, mut c, last_of(s, n))
}

/// The first construct outside the core, as (what, node); node -1 if none.
fn core_scope(s: front.Syntax) -> Core {
    var c = Core { what: "", node: -1 }
    core_unit(s, mut c)
    c
}
