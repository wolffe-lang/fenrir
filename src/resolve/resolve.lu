//! member: true

use front

/// One declaration; see docs/TYPED.md. `ty` is filled in by the checker.
pub struct Decl {
    pub kind: str
    pub name: str
    pub node: int
    pub ty: int
    pub owner: int
    pub index: int
    pub count: int
}

/// Resolution's tables, keyed like the AST's node arena.
pub struct Resolved {
    pub code: str
    pub message: str
    pub at: int
    pub decls: List[Decl]
    pub node_decl: List[int]
    pub node_site: List[int]
    pub node_name: List[int]
    pub names: Names
    pub fields: Pairs
    pub functions: List[int]
    pub structs: List[int]
    pub enums: List[int]
    pub previous: List[int]
    pub pattern_names: Pairs
    pub arm_bindings: List[int]
    pub arm_first: List[int]
    pub arm_count: List[int]
    pub fallible: List[bool]
    pub tag: List[bool]
    pub aliases: List[int]
    pub main: int
}

struct Scopes {
    module: List[int]
    prelude: List[int]
    local: List[int]
    undo: List[int]
    stamp: List[int]
    loops: int
    tail: int
    fallible: bool
}

/// The core prelude's declarations, in the pinned prelude's order.
fn core_prelude() -> List[str] { ["print", "assert", "bool", "str", "int", "uint", "i32", "i64", "u8", "u64", "char", "byte"] }

fn fail(mut r: Resolved, code: str, message: str, node: int) {
    if r.code == "" { r.code = code; r.message = message; r.at = node }
}

fn add(mut r: Resolved, kind: str, name: str, node: int, owner: int, index: int) -> int {
    let id = r.decls.len
    (mut r.decls).push(Decl { kind: kind, name: name, node: node, ty: -1, owner: owner, index: index, count: 0 })
    (mut r.previous).push(-1)
    if node >= 0 { r.node_decl[node] = id }
    id
}

fn name_child(s: front.Syntax, n: int) -> int {
    var c = first_of(s, n)
    while c >= 0 && kind_of(s, c) != "Name" { c = next_of(s, c) }
    c
}

// Declarations, numbered in source order over the whole unit at once.
fn declare(s: front.Syntax, mut r: Resolved, n: int, owner: int, kind: str) {
    let k = kind_of(s, n)
    if k == "Function" {
        let name = name_child(s, n)
        let f = add(mut r, "function", spell_of(s, name), n, -1, -1)
        r.node_decl[name] = f
        (mut r.functions).push(f)
        var c = first_of(s, n)
        while c >= 0 {
            if kind_of(s, c) == "Parameters" {
                var p = first_of(s, c)
                var i: int = 0
                while p >= 0 {
                    let pn = name_child(s, p)
                    let d = add(mut r, "param", spell_of(s, pn), p, f, i)
                    r.node_decl[pn] = d
                    i += 1
                    p = next_of(s, p)
                }
                r.decls[f].count = i
            } else if kind_of(s, c) == "ReturnType" {
                let t = first_of(s, c)
                (mut r.fallible).push((kind_of(s, t) == "PrefixType" && spell_of(s, t) == "!") || kind_of(s, t) == "ErrorType")
            } else if kind_of(s, c) == "Block" {
                declare(s, mut r, c, f, "")
            }
            c = next_of(s, c)
        }
        if r.fallible.len < r.functions.len { (mut r.fallible).push(false) }
        return
    }
    if k == "Enum" || (k == "TypeAlias" && enum_body(s, n) >= 0) {
        let name = name_child(s, n)
        let en = add(mut r, "enum", spell_of(s, name), n, -1, -1)
        r.node_decl[name] = en
        (mut r.enums).push(en)
        var v = first_of(s, enum_body(s, n))
        var index: int = 0
        while v >= 0 {
            let vn = first_of(s, v)
            let variant = add(mut r, "variant", spell_of(s, vn), v, en, index)
            r.node_decl[vn] = variant
            var ty = next_of(s, vn)
            while ty >= 0 { r.decls[variant].count += 1; ty = next_of(s, ty) }
            index += 1
            v = next_of(s, v)
        }
        r.decls[en].count = index
        return
    }
    if k == "Match" {
        let value = first_of(s, n)
        declare(s, mut r, value, owner, kind)
        var arm = next_of(s, value)
        while arm >= 0 {
            let pat = first_of(s, arm)
            r.arm_first[arm] = r.arm_bindings.len
            declare_pattern(s, mut r, pat, owner, arm)
            r.arm_count[arm] = r.arm_bindings.len - r.arm_first[arm]
            var body = next_of(s, pat)
            while body >= 0 { declare(s, mut r, body, owner, kind); body = next_of(s, body) }
            arm = next_of(s, arm)
        }
        return
    }
    if k == "ErrorAlias" {
        let name = first_of(s, n)
        let a = add(mut r, "alias", spell_of(s, name), n, -1, -1)
        r.node_decl[name] = a
        (mut r.aliases).push(a)
        return
    }
    if k == "Loop" && spell_of(s, first_of(s, n)) == "for" {
        // The loop's pattern binds for the body only; the header is outside.
        let pat = next_of(s, first_of(s, n))
        declare_binders(s, mut r, pat, owner, "let")
        var c = next_of(s, pat)
        while c >= 0 { declare(s, mut r, c, owner, kind); c = next_of(s, c) }
        return
    }
    if k == "Handler" {
        // `else |p| body` is one arm over the scrutinee's row.
        let pat = first_of(s, n)
        r.arm_first[n] = r.arm_bindings.len
        declare_pattern(s, mut r, pat, owner, n)
        r.arm_count[n] = r.arm_bindings.len - r.arm_first[n]
        declare(s, mut r, last_of(s, n), owner, kind)
        return
    }
    if k == "Struct" {
        let name = name_child(s, n)
        let st = add(mut r, "struct", spell_of(s, name), n, -1, -1)
        r.node_decl[name] = st
        (mut r.structs).push(st)
        var i: int = 0
        var c = first_of(s, n)
        while c >= 0 {
            if kind_of(s, c) == "Fields" {
                var f = first_of(s, c)
                while f >= 0 {
                    let fname = name_child(s, f)
                    let d = add(mut r, "field", spell_of(s, fname), f, st, i)
                    r.node_decl[fname] = d
                    i += 1
                    f = next_of(s, f)
                }
            }
            c = next_of(s, c)
        }
        r.decls[st].count = i
        return
    }
    var binding = kind
    if k == "Bindings" { binding = spell_of(s, first_of(s, n)) }
    if k == "Binder" {
        let pat = first_of(s, n)
        if kind_of(s, pat) == "NamePattern" {
            let pn = first_of(s, first_of(s, pat))
            let d = add(mut r, kind, spell_of(s, pn), n, owner, -1)
            r.node_decl[pn] = d
        } else if kind_of(s, pat) == "TuplePattern" {
            declare_binders(s, mut r, pat, owner, kind)
        }
    }
    var c = first_of(s, n)
    while c >= 0 {
        declare(s, mut r, c, owner, binding)
        c = next_of(s, c)
    }
}

// A destructuring or `for` pattern's names: each NamePattern declares one
// binding of `kind`, its declaring node the pattern itself.
fn declare_binders(s: front.Syntax, mut r: Resolved, pat: int, owner: int, kind: str) {
    declare_binders_in(s, mut r, pat, owner, kind, pat)
}

fn declare_binders_in(s: front.Syntax, mut r: Resolved, pat: int, owner: int, kind: str, root: int) {
    if r.code != "" { return }
    let kp = kind_of(s, pat)
    if kp == "NamePattern" {
        let pn = first_of(s, first_of(s, pat))
        let key = root * r.names.text.len + r.node_name[pn]
        let previous = paired(r.pattern_names, key)
        if previous >= 0 {
            let first = s.nodes[r.decls[previous].node].span
            let text = spell_of(s, pn)
            fail(mut r, "E0827", "pattern name `{text}` is bound twice; the first binding is at {first.line}:{first.col}", pn)
            return
        }
        let d = add(mut r, kind, spell_of(s, pn), pat, owner, -1)
        r.node_decl[pn] = d
        pair(mut r.pattern_names, key, d)
    } else if kp == "TuplePattern" {
        var c = first_of(s, pat)
        while c >= 0 && r.code == "" { declare_binders_in(s, mut r, c, owner, kind, root); c = next_of(s, c) }
    }
}

// Bind every name a `declare_binders` pattern declared.
fn bind_binders(s: front.Syntax, mut r: Resolved, mut sc: Scopes, pat: int) {
    let kp = kind_of(s, pat)
    if kp == "NamePattern" {
        let pn = first_of(s, first_of(s, pat))
        bind(mut sc, r.node_name[pn], r.node_decl[pn])
    } else if kp == "TuplePattern" {
        var c = first_of(s, pat)
        while c >= 0 { bind_binders(s, mut r, mut sc, c); c = next_of(s, c) }
    }
}

// The trap site of every node: its innermost enclosing Statement or Tail.
fn sites(s: front.Syntax, mut r: Resolved, n: int, site: int) {
    var here = site
    let k = kind_of(s, n)
    if k == "Statement" || k == "Tail" { here = n }
    r.node_site[n] = here
    var c = first_of(s, n)
    while c >= 0 {
        sites(s, mut r, c, here)
        c = next_of(s, c)
    }
}

fn restore(mut sc: Scopes, mark: int) {
    while sc.undo.len > mark {
        let previous = (mut sc.undo).pop() else -1
        let id = (mut sc.undo).pop() else -1
        sc.local[id] = previous
    }
}

fn bind(mut sc: Scopes, id: int, decl: int) {
    (mut sc.undo).push(id)
    (mut sc.undo).push(sc.local[id])
    sc.local[id] = decl
}

fn resolve_type(s: front.Syntax, mut r: Resolved, sc: Scopes, n: int) {
    let k = kind_of(s, n)
    if k == "PrefixType" { resolve_type(s, mut r, sc, first_of(s, n)); return }
    if k == "TupleType" {
        var e = first_of(s, n)
        while e >= 0 && r.code == "" { resolve_type(s, mut r, sc, e); e = next_of(s, e) }
        return
    }
    if k == "ErrorType" {
        let inner = first_of(s, n)
        resolve_type(s, mut r, sc, inner)
        let row = next_of(s, inner)
        if row >= 0 { resolve_row(s, mut r, sc, row) }
        return
    }
    if k == "Name" || k == "Index" || k == "Tuple" { resolve_type_argument(s, mut r, sc, n); return }
    if k != "NamedType" { return }
    let name = first_of(s, first_of(s, n))
    let id = r.node_name[name]
    let text = spell_of(s, name)
    let arguments = next_of(s, first_of(s, n))
    if arguments >= 0 {
        // `List[T]` and `Map[K, V]`, the prelude's containers, unless a module
        // item of that name hides them.
        if sc.module[id] >= 0 { fail(mut r, "F0001", "not yet in fenrir: generic type `{text}`", n); return }
        var a = first_of(s, arguments)
        while a >= 0 && r.code == "" { resolve_type_argument(s, mut r, sc, a); a = next_of(s, a) }
        return
    }
    var d = sc.module[id]
    if d >= 0 && r.decls[d].kind != "struct" && r.decls[d].kind != "enum" {
        fail(mut r, "E0301", "`{text}` is a function, not a type", name)
        return
    }
    if d < 0 {
        d = sc.prelude[id]
        if d == -2 || (d >= 0 && r.decls[d].kind != "prelude-type") {
            if d == -2 { fail(mut r, "F0001", "not yet in fenrir: type `{text}`", name) }
            else { fail(mut r, "E0301", "`{text}` is a function, not a type", name) }
            return
        }
    }
    if d < 0 { fail(mut r, "E0301", "nothing named `{text}` is in scope", name); return }
    r.node_decl[name] = d
    r.node_decl[n] = d
}

// A type spelled as an expression: a type argument, or the argument list of
// `List[T]()` and `Map[K, V]()`.
fn resolve_type_argument(s: front.Syntax, mut r: Resolved, sc: Scopes, n: int) {
    let k = kind_of(s, n)
    if k == "Argument" { resolve_type_argument(s, mut r, sc, last_of(s, n)); return }
    if k == "Tuple" {
        var e = first_of(s, n)
        while e >= 0 && r.code == "" { resolve_type_argument(s, mut r, sc, e); e = next_of(s, e) }
        return
    }
    if k == "Index" {
        let head = first_of(s, n)
        if sc.module[r.node_name[head]] >= 0 { fail(mut r, "F0001", "not yet in fenrir: generic type `{spell_of(s, head)}`", n); return }
        var a = first_of(s, next_of(s, head))
        while a >= 0 && r.code == "" { resolve_type_argument(s, mut r, sc, a); a = next_of(s, a) }
        return
    }
    if k != "Name" { resolve_type(s, mut r, sc, n); return }
    let id = r.node_name[n]
    let text = spell_of(s, n)
    var d = sc.module[id]
    if d >= 0 && r.decls[d].kind != "struct" && r.decls[d].kind != "enum" { fail(mut r, "E0301", "`{text}` is a function, not a type", n); return }
    if d < 0 {
        d = sc.prelude[id]
        if d == -2 { fail(mut r, "F0001", "not yet in fenrir: type `{text}`", n); return }
        if d >= 0 && r.decls[d].kind != "prelude-type" { fail(mut r, "E0301", "`{text}` is a function, not a type", n); return }
    }
    if d < 0 { fail(mut r, "E0301", "nothing named `{text}` is in scope", n); return }
    r.node_decl[n] = d
}

// A row's entries: payload types resolve; a tag is structural and resolves to
// nothing; an entry naming an error-set alias names the alias, and typing
// refuses a payload on it (E0601).
fn resolve_row(s: front.Syntax, mut r: Resolved, sc: Scopes, row: int) {
    if kind_of(s, row) != "ErrorRow" {
        let name = first_of(s, row)
        let d = sc.module[r.node_name[name]]
        if d >= 0 && r.decls[d].kind == "alias" { r.node_decl[name] = d; r.node_decl[row] = d }
        return
    }
    var entry = first_of(s, row)
    while entry >= 0 && r.code == "" {
        if kind_of(s, entry) == "RowEntry" {
            let path = first_of(s, entry)
            let name = first_of(s, path)
            var ty = next_of(s, path)
            let d = sc.module[r.node_name[name]]
            if d >= 0 && r.decls[d].kind == "alias" { r.node_decl[name] = d; r.node_decl[entry] = d }
            while ty >= 0 && r.code == "" { resolve_type(s, mut r, sc, ty); ty = next_of(s, ty) }
        }
        entry = next_of(s, entry)
    }
}

fn resolve_value(s: front.Syntax, mut r: Resolved, sc: Scopes, n: int, call: bool, tag: bool) {
    let id = r.node_name[n]
    let text = spell_of(s, n)
    var d = sc.local[id]
    if d < 0 { d = sc.module[id] }
    if d < 0 { d = sc.prelude[id] }
    if d == -2 { fail(mut r, "F0001", "not yet in fenrir: prelude `{text}`", n); return }
    if d < 0 {
        // A bare name nothing declares is an error tag's spelling when an
        // expected row declares it ([gram.expr.tagident]); typing decides,
        // and refuses it as E0301 where no row is expected.
        r.tag[n] = true
        return
    }
    let dk = r.decls[d].kind
    if dk == "struct" || dk == "enum" || dk == "prelude-type" { fail(mut r, "F0001", "not yet in fenrir: a type used as a value", n); return }
    if (dk == "function" || dk == "prelude-fn") && !call { fail(mut r, "F0001", "not yet in fenrir: a function used as a value", n); return }
    r.node_decl[n] = d
}

fn resolve_block(s: front.Syntax, mut r: Resolved, mut sc: Scopes, n: int) {
    let mark = sc.undo.len
    var st = first_of(s, n)
    while st >= 0 && r.code == "" {
        var d = first_of(s, st)
        while d >= 0 && r.code == "" {
            let k = kind_of(s, d)
            if k == "Item" { resolve_bindings(s, mut r, mut sc, first_of(s, d)) }
            else if k == "Assignment" { resolve_assignment(s, mut r, mut sc, d) }
            else if k != "Attribute" { resolve_expression(s, mut r, mut sc, d) }
            d = next_of(s, d)
        }
        st = next_of(s, st)
    }
    restore(mut sc, mark)
}

fn resolve_bindings(s: front.Syntax, mut r: Resolved, mut sc: Scopes, n: int) {
    var b = next_of(s, first_of(s, n))
    while b >= 0 && r.code == "" {
        let pat = first_of(s, b)
        var q = next_of(s, pat)
        while q >= 0 && r.code == "" {
            if next_of(s, q) >= 0 { resolve_type(s, mut r, sc, q) } else { resolve_expression(s, mut r, mut sc, q) }
            q = next_of(s, q)
        }
        if r.code == "" && kind_of(s, pat) == "NamePattern" {
            let pn = first_of(s, first_of(s, pat))
            bind(mut sc, r.node_name[pn], r.node_decl[b])
        } else if r.code == "" && kind_of(s, pat) == "TuplePattern" {
            bind_binders(s, mut r, mut sc, pat)
        }
        b = next_of(s, b)
    }
}

fn resolve_assignment(s: front.Syntax, mut r: Resolved, mut sc: Scopes, n: int) {
    let place = first_of(s, n)
    resolve_expression(s, mut r, mut sc, place)
    var root = place
    while kind_of(s, root) == "Member" || kind_of(s, root) == "Index" { root = first_of(s, root) }
    if r.code == "" && kind_of(s, root) == "Name" {
        let d = r.node_decl[root]
        if d < 0 { return }
        r.node_decl[n] = d
        let dk = r.decls[d].kind
        let text = spell_of(s, root)
        if dk == "let" {
            if root == place { fail(mut r, "E0410", "`{text}` is bound with `let`, so it cannot be assigned", place) }
            else { fail(mut r, "E0410", "`{text}` is bound with `let`, so its fields cannot be assigned either", place) }
        } else if dk == "param" {
            fail(mut r, "E1014", "`{text}` is `read` for the whole call, so it cannot be assigned", place)
        } else if dk != "var" && dk != "candidate" {
            fail(mut r, "E0401", "`{text}` is not a place that can be assigned", place)
        }
    } else if r.code == "" {
        fail(mut r, "F0001", "not yet in fenrir: assignment place", place)
    }
    var d = next_of(s, next_of(s, place))
    while d >= 0 && r.code == "" {
        resolve_expression(s, mut r, mut sc, d)
        d = next_of(s, d)
    }
}

fn resolve_struct_literal(s: front.Syntax, mut r: Resolved, mut sc: Scopes, n: int) {
    let head = first_of(s, n)
    let text = spell_of(s, head)
    let st = sc.module[r.node_name[head]]
    if st < 0 || r.decls[st].kind != "struct" {
        fail(mut r, "E0301", "no struct named `{text}` is in scope", head)
        return
    }
    r.node_decl[head] = st
    r.node_decl[n] = st
    var f = next_of(s, head)
    while f >= 0 && r.code == "" {
        let fname = first_of(s, f)
        let ftext = spell_of(s, fname)
        let field = paired(r.fields, st * r.names.text.len + r.node_name[fname])
        if field < 0 { fail(mut r, "E0403", "`{text}` has no field named `{ftext}`", fname); return }
        if sc.stamp[field] == n { fail(mut r, "E0408", "the field `{ftext}` is initialized twice", fname); return }
        sc.stamp[field] = n
        r.node_decl[f] = field
        let value = next_of(s, fname)
        if value >= 0 {
            r.node_decl[fname] = field
            resolve_expression(s, mut r, mut sc, value)
        } else {
            resolve_value(s, mut r, sc, fname, false, false)
        }
        f = next_of(s, f)
    }
    var i: int = 0
    while i < r.decls[st].count && r.code == "" {
        if sc.stamp[st + 1 + i] != n {
            fail(mut r, "E0408", "this `{text}` literal is missing the field `{r.decls[st + 1 + i].name}`", n)
        }
        i += 1
    }
}

fn resolve_expression(s: front.Syntax, mut r: Resolved, mut sc: Scopes, n: int) {
    if r.code != "" { return }
    let k = kind_of(s, n)
    if k == "Name" { resolve_value(s, mut r, sc, n, false, n == sc.tail); return }
    if k == "Call" {
        let callee = first_of(s, n)
        if kind_of(s, callee) == "Member" {
            // A variant constructor, or a list or map method the checker
            // resolves by the receiver's type.
            resolve_expression(s, mut r, mut sc, callee)
        } else if kind_of(s, callee) == "Index" {
            // `List[T]()` and `Map[K, V]()`.
            let head = first_of(s, callee)
            if kind_of(s, head) != "Name" || sc.module[r.node_name[head]] >= 0 || sc.local[r.node_name[head]] >= 0 {
                fail(mut r, "F0001", "not yet in fenrir: generic application", n)
                return
            }
            var t = first_of(s, next_of(s, head))
            while t >= 0 && r.code == "" { resolve_type_argument(s, mut r, sc, t); t = next_of(s, t) }
        } else { resolve_value(s, mut r, sc, callee, true, false) }
        r.node_decl[n] = r.node_decl[callee]
        var a = first_of(s, next_of(s, callee))
        while a >= 0 && r.code == "" {
            resolve_expression(s, mut r, mut sc, first_of(s, a))
            a = next_of(s, a)
        }
        return
    }
    if k == "Match" { resolve_match(s, mut r, mut sc, n); return }
    if k == "StructLiteral" { resolve_struct_literal(s, mut r, mut sc, n); return }
    if k == "Block" { resolve_block(s, mut r, mut sc, n); return }
    if k == "Loop" {
        if spell_of(s, first_of(s, n)) == "for" {
            let pat = next_of(s, first_of(s, n))
            let header = next_of(s, pat)
            resolve_expression(s, mut r, mut sc, header)
            let mark = sc.undo.len
            bind_binders(s, mut r, mut sc, pat)
            sc.loops += 1
            resolve_block(s, mut r, mut sc, next_of(s, header))
            sc.loops -= 1
            restore(mut sc, mark)
            return
        }
        let header = next_of(s, first_of(s, n))
        resolve_expression(s, mut r, mut sc, header)
        sc.loops += 1
        resolve_block(s, mut r, mut sc, next_of(s, header))
        sc.loops -= 1
        return
    }
    if k == "Handler" { resolve_handler(s, mut r, mut sc, n); return }
    if k == "Jump" {
        let jk = first_of(s, n)
        let word = spell_of(s, jk)
        if word != "return" && sc.loops == 0 { fail(mut r, "F0001", "not yet in fenrir: `{word}` outside a loop", n); return }
        let operand = next_of(s, jk)
        if operand >= 0 {
            if kind_of(s, operand) == "Name" { resolve_value(s, mut r, sc, operand, false, true) }
            else { resolve_expression(s, mut r, mut sc, operand) }
        }
        return
    }
    if k == "Member" {
        if !enum_member(s, mut r, sc, n) { resolve_expression(s, mut r, mut sc, first_of(s, n)) }
        return
    }
    if k == "Receiver" { resolve_expression(s, mut r, mut sc, last_of(s, n)); return }
    if k == "Range" {
        var e = first_of(s, n)
        while e >= 0 && r.code == "" {
            if kind_of(s, e) != "Operator" { resolve_expression(s, mut r, mut sc, e) }
            e = next_of(s, e)
        }
        return
    }
    if k == "Literal" || k == "Operator" || k == "MemberName" || k == "Text" { return }
    var c = first_of(s, n)
    while c >= 0 && r.code == "" {
        let kc = kind_of(s, c)
        if kc != "Operator" && kc != "Text" { resolve_expression(s, mut r, mut sc, c) }
        c = next_of(s, c)
    }
}

fn resolve_function(s: front.Syntax, mut r: Resolved, mut sc: Scopes, f: int, index: int) {
    let n = r.decls[f].node
    sc.fallible = r.fallible[index]
    let mark = sc.undo.len
    var c = first_of(s, n)
    while c >= 0 && r.code == "" {
        let k = kind_of(s, c)
        if k == "Parameters" {
            var p = first_of(s, c)
            while p >= 0 && r.code == "" {
                let pn = name_child(s, p)
                let previous = sc.local[r.node_name[pn]]
                if previous >= 0 && r.decls[previous].kind == "param" && r.decls[previous].owner == f {
                    let first = s.nodes[name_child(s, r.decls[previous].node)].span
                    let text = spell_of(s, pn)
                    fail(mut r, "E0827", "parameter `{text}` is bound twice; the first binding is at {first.line}:{first.col}", pn)
                } else {
                    resolve_type(s, mut r, sc, next_of(s, pn))
                    bind(mut sc, r.node_name[pn], r.node_decl[p])
                }
                p = next_of(s, p)
            }
        } else if k == "ReturnType" {
            resolve_type(s, mut r, sc, first_of(s, c))
        } else if k == "Block" {
            var last = first_of(s, c)
            while last >= 0 && next_of(s, last) >= 0 { last = next_of(s, last) }
            sc.tail = -1
            if last >= 0 && kind_of(s, last) == "Tail" {
                var e = first_of(s, last)
                while e >= 0 && kind_of(s, e) == "Attribute" { e = next_of(s, e) }
                sc.tail = e
            }
            resolve_block(s, mut r, mut sc, c)
            sc.tail = -1
        }
        c = next_of(s, c)
    }
    restore(mut sc, mark)
}

/// Resolve every name of one parsed unit inside the F1 core.
pub fn resolve(s: front.Syntax) -> Resolved {
    var r = Resolved { code: "", message: "", at: -1, decls: List[Decl](), node_decl: List[int](),
        node_site: List[int](), node_name: List[int](), names: names(), fields: pairs(),
        functions: List[int](), structs: List[int](), enums: List[int](), previous: List[int](),
        pattern_names: pairs(), arm_bindings: List[int](), arm_first: List[int](), arm_count: List[int](),
        fallible: List[bool](), tag: List[bool](), aliases: List[int](), main: -1 }
    (mut r.node_decl).reserve(s.nodes.len)
    (mut r.node_site).reserve(s.nodes.len)
    (mut r.node_name).reserve(s.nodes.len)
    var i: int = 0
    while i < s.nodes.len {
        (mut r.node_decl).push(-1)
        (mut r.node_site).push(-1)
        (mut r.node_name).push(-1)
        (mut r.arm_first).push(-1)
        (mut r.arm_count).push(0)
        (mut r.tag).push(false)
        i += 1
    }
    let ambient = prelude_names()
    let kinds = prelude_kinds()
    for name in ambient { let _ = intern(mut r.names, name) }
    i = 0
    while i < s.nodes.len {
        let k = s.nodes[i].kind
        if k == "Name" || k == "MemberName" { r.node_name[i] = intern(mut r.names, spell_of(s, i)) }
        i += 1
    }
    let count = r.names.text.len
    var sc = Scopes { module: empty(count), prelude: empty(count), local: empty(count),
        undo: List[int](), stamp: List[int](), loops: 0, tail: -1, fallible: false }
    i = 0
    while i < ambient.len { sc.prelude[i] = -2; i += 1 }
    for name in core_prelude() {
        let at = lookup(r.names, name)
        let d = add(mut r, if kinds[at] == "builtin_type" then "prelude-type" else "prelude-fn", name, -1, -1, -1)
        sc.prelude[at] = d
    }
    let core = core_scope(s)
    if core.node >= 0 {
        fail(mut r, "F0001", "not yet in fenrir: {core.what}", core.node)
        return r
    }
    declare(s, mut r, s.root, -1, "")
    sites(s, mut r, s.root, -1)
    i = 0
    while i < r.decls.len { (mut sc.stamp).push(-1); i += 1 }
    i = 0
    while i < r.decls.len && r.code == "" {
        let dk = r.decls[i].kind
        if dk == "function" || dk == "struct" || dk == "enum" || dk == "alias" {
            let name = name_child(s, r.decls[i].node)
            let id = r.node_name[name]
            if sc.module[id] >= 0 {
                let previous = sc.module[id]
                let first = s.nodes[name_child(s, r.decls[previous].node)].span
                let text = r.decls[i].name
                fail(mut r, "E0302", "the name `{text}` is defined twice in this module; the first declaration is at {first.line}:{first.col}", name)
            }
            else { sc.module[id] = i }
        }
        i += 1
    }
    let main_id = lookup(r.names, "main")
    if main_id >= 0 && sc.module[main_id] >= 0 && r.decls[sc.module[main_id]].kind == "function" { r.main = sc.module[main_id] }
    var si: int = 0
    while si < r.structs.len {
        let st = r.structs[si]
        si += 1
        var k: int = 0
        while k < r.decls[st].count && r.code == "" {
            let field = st + 1 + k
            let fname = name_child(s, r.decls[field].node)
            let key = st * count + r.node_name[fname]
            let previous = paired(r.fields, key)
            if previous >= 0 {
                let first = s.nodes[name_child(s, r.decls[previous].node)].span
                let text = spell_of(s, fname)
                fail(mut r, "E0302", "field `{text}` is declared twice; the first declaration is at {first.line}:{first.col}", fname)
            }
            pair(mut r.fields, key, field)
            resolve_type(s, mut r, sc, next_of(s, fname))
            k += 1
        }
    }
    var ei: int = 0
    while ei < r.enums.len {
        let en = r.enums[ei]
        ei += 1
        var k: int = 0
        while k < r.decls[en].count && r.code == "" {
            let variant = en + 1 + k
            let name = name_child(s, r.decls[variant].node)
            let key = en * count + r.node_name[name]
            let previous = paired(r.fields, key)
            if previous >= 0 {
                let first = s.nodes[name_child(s, r.decls[previous].node)].span
                let text = r.decls[variant].name
                fail(mut r, "E0302", "variant `{text}` is declared twice; the first declaration is at {first.line}:{first.col}", name)
            }
            pair(mut r.fields, key, variant)
            var ty = next_of(s, name)
            while ty >= 0 && r.code == "" { resolve_type(s, mut r, sc, ty); ty = next_of(s, ty) }
            k += 1
        }
    }
    var ai: int = 0
    while ai < r.aliases.len && r.code == "" {
        let a = r.aliases[ai]
        resolve_row(s, mut r, sc, last_of(s, r.decls[a].node))
        ai += 1
    }
    var index: int = 0
    while index < r.functions.len && r.code == "" {
        resolve_function(s, mut r, mut sc, r.functions[index], index)
        index += 1
    }
    r
}
