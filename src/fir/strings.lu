//! member: true

use sem

// Edition-4 text primitives. The source distinction between `byte` and
// `char` is checked before lowering; byte reads yield a nonnegative int word.
fn text_schema(m: Module, ins: Inst, types: List[int]) -> () ! {Bad(str)} {
    if ins.data.len < 2 { return Bad("FIR_ARITY text needs operation and mode") }
    let op = ins.data[0]
    if op < 0 || op > 13 { return Bad("FIR_OPCODE unknown text operation") }
    if op == 4 {
        arity(ins, 3, 1)?
        result(ins, 3)?
        let flavor = ins.data[2]
        if !sem.format_valid(ins.data[1], flavor) { return Bad("FIR_LITERAL invalid text rendering spec or flavor") }
        let ty = types[ins.uses[0]]
        if flavor == 0 { operand(ins, types, 0, 3)? }
        else if flavor == 3 { operand(ins, types, 0, 2)? }
        else if flavor == 4 { operand(ins, types, 0, 1)? }
        else if !integral(ty) { return Bad("FIR_TYPE text integer rendering needs an integer") }
        return
    }
    if ins.data.len != 2 { return Bad("FIR_ARITY text needs operation and mode") }
    let mode = ins.data[1]
    let high = if op == 3 || op == 5 || op == 13 then 1 else if op == 6 || op == 10 || op == 12 then 2 else 0
    if mode < 0 || mode > high { return Bad("FIR_LITERAL invalid text mode") }
    if op == 0 {
        arity(ins, 2, 1)?
        result(ins, 1)?
        operand(ins, types, 0, 3)?
    } else if op == 3 {
        arity(ins, 2, 2)?
        if mode == 0 { result(ins, 1)? }
        else if !option_of(m, ins.ty, 1) { return Bad("FIR_TYPE byte read needs an int option") }
        operand(ins, types, 0, 3)?
        operand(ins, types, 1, 1)?
    } else if op == 13 {
        arity(ins, 2, 3)?
        result(ins, 4)?
        operand(ins, types, 0, 3)?
        operand(ins, types, 1, 1)?
        operand(ins, types, 2, 1)?
    } else if op == 1 || op == 2 {
        arity(ins, 2, 3)?
        operand(ins, types, 0, 3)?
        operand(ins, types, 1, 1)?
        operand(ins, types, 2, 1)?
        if op == 1 { result(ins, 3)? }
        else if !option_of(m, ins.ty, 3) { return Bad("FIR_TYPE text get needs a str option") }
    } else if op == 11 {
        arity(ins, 2, 1)?
        operand(ins, types, 0, 3)?
        if !option_of(m, ins.ty, 1) { return Bad("FIR_TYPE text parse needs an int option") }
    } else if op == 12 {
        arity(ins, 2, 1)?
        operand(ins, types, 0, 3)?
        result(ins, 3)?
    } else if op == 9 {
        arity(ins, 2, 3)?
        result(ins, 3)?
        var i: int = 0
        while i < 3 { operand(ins, types, i, 3)?; i += 1 }
    } else {
        arity(ins, 2, 2)?
        operand(ins, types, 0, 3)?
        operand(ins, types, 1, if op == 8 then 1 else 3)?
        if op == 5 {
            if !option_of(m, ins.ty, 1) { return Bad("FIR_TYPE text find needs an int option") }
        } else if op == 6 { result(ins, 2)? }
        else if op == 7 { result(ins, 1)? }
        else if op == 8 { result(ins, 3)? }
        else if list_element(m, ins.ty) != 3 { return Bad("FIR_TYPE text split needs a list of str") }
    }
}
