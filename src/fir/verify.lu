//! member: true

use sem

fn valid_type(m: Module, ty: int, unit: bool) -> () ! {Bad(str)} {
    if ty < 0 || ty >= first_struct() + m.shapes.len || (!unit && ty == 0) { return Bad("FIR_TYPE invalid type") }
}

fn same_types(a: List[int], b: List[int]) -> bool {
    if a.len != b.len { return false }
    var i: int = 0
    while i < a.len { if a[i] != b[i] { return false }; i += 1 }
    true
}

fn arity(ins: Inst, data: int, uses: int) -> () ! {Bad(str)} {
    if ins.data.len != data || ins.uses.len != uses { return Bad("FIR_ARITY invalid {ins.op} arity") }
}

fn result(ins: Inst, ty: int) -> () ! {Bad(str)} {
    if ins.ty != ty { return Bad("FIR_TYPE {ins.op} result type") }
}

fn operand(ins: Inst, types: List[int], i: int, ty: int) -> () ! {Bad(str)} {
    if types[ins.uses[i]] != ty { return Bad("FIR_TYPE {ins.op} operand type") }
}

// Two operands of one type, which the caller's class admits; return that type.
fn pair(ins: Inst, types: List[int], strings: bool, bools: bool) -> int ! {Bad(str)} {
    arity(ins, 0, 2)?
    let ty = types[ins.uses[0]]
    let admitted = integral(ty) || (strings && ty == 3) || (bools && ty == 2)
    if !admitted || types[ins.uses[1]] != ty { return Bad("FIR_TYPE {ins.op} operand type") }
    ty
}

// The element type of operand `i`, which must be a list.
fn list_of(m: Module, types: List[int], ins: Inst, i: int) -> int ! {Bad(str)} {
    let e = list_element(m, types[ins.uses[i]])
    if e < 0 { return Bad("FIR_TYPE {ins.op} operand is not a list") }
    e
}

// The map type of operand 0, which must be a map.
fn map_of(m: Module, types: List[int], ins: Inst) -> int ! {Bad(str)} {
    let ty = types[ins.uses[0]]
    if !is_map(m, ty) { return Bad("FIR_TYPE {ins.op} operand is not a map") }
    ty
}

fn slot_place(m: Module, f: Function, ins: Inst) -> Place ! {Bad(str)} {
    if ins.data.len == 0 { return Bad("FIR_SLOT {ins.op} names no slot") }
    let s = ins.data[0]
    if s < 0 || s >= f.slots.len { return Bad("FIR_SLOT unknown slot") }
    place(m, f.slots[s], ins.data, 1)
}

fn edge(f: Function, ins: Inst, types: List[int], target: int, start: int, n: int) -> () ! {Bad(str)} {
    if target < 0 || target >= f.blocks.len { return Bad("FIR_BRANCH unknown block") }
    if n < 0 || start < 0 || start > ins.uses.len || n > ins.uses.len - start { return Bad("FIR_BRANCH argument range") }
    if f.blocks[target].params.len != n { return Bad("FIR_BRANCH argument count") }
    var i: int = 0
    while i < n {
        if types[ins.uses[start + i]] != f.blocks[target].params[i] { return Bad("FIR_BRANCH argument type") }
        i += 1
    }
}

fn instruction(m: Module, f: Function, ins: Inst, types: List[int]) -> () ! {Bad(str)} {
    let op = ins.op
    if op == "const" {
        arity(ins, 1, 0)?
        if ins.ty != 2 && !integral(ins.ty) { return Bad("FIR_TYPE constant type") }
        if ins.ty == 2 && ins.data[0] != 0 && ins.data[0] != 1 { return Bad("FIR_LITERAL boolean outside 0..1") }
        if ins.ty != 2 && !sem.holds(kind(ins.ty), ins.data[0]) { return Bad("FIR_LITERAL constant outside {kind(ins.ty)}") }
    } else if op == "string" {
        arity(ins, 1, 0)?; result(ins, 3)?
        if ins.data[0] < 0 || ins.data[0] >= m.blobs.len { return Bad("FIR_LITERAL unknown blob") }
    } else if sem.arithmetic(op) {
        let ty = pair(ins, types, false, false)?
        result(ins, ty)?
    } else if op == "eq" {
        pair(ins, types, true, true)?; result(ins, 2)?
    } else if op == "lt" {
        pair(ins, types, true, false)?; result(ins, 2)?
    } else if op == "not" {
        arity(ins, 0, 1)?
        let ty = types[ins.uses[0]]
        if ty != 2 && !integral(ty) { return Bad("FIR_TYPE not operand type") }
        result(ins, ty)?
    } else if op == "struct" {
        if ins.data.len != 0 || !shape_kind(m, ins.ty, "struct") { return Bad("FIR_TYPE struct shape") }
        let fields = m.shapes[ins.ty - first_struct()].fields
        if ins.uses.len != fields.len { return Bad("FIR_ARITY struct fields") }
        var i: int = 0
        while i < fields.len { operand(ins, types, i, fields[i])?; i += 1 }
    } else if op == "field" {
        arity(ins, 1, 1)?
        let ty = types[ins.uses[0]]
        if !shape_kind(m, ty, "struct") { return Bad("FIR_TYPE field of non-struct") }
        let k = ins.data[0]
        if k < 0 || k >= m.shapes[ty - first_struct()].fields.len { return Bad("FIR_TYPE unknown field") }
        result(ins, m.shapes[ty - first_struct()].fields[k])?
    } else if op == "enum" {
        arity(ins, 1, 1)?
        let payload = payload_type(m, ins.ty, ins.data[0])?
        operand(ins, types, 0, payload)?
    } else if op == "case" {
        if ins.data.len != 4 || ins.uses.len == 0 { return Bad("FIR_BRANCH malformed case") }
        result(ins, 0)?
        let payload = payload_type(m, types[ins.uses[0]], ins.data[0])?
        let n = ins.data[3]
        if n < 0 || n > ins.uses.len - 1 { return Bad("FIR_BRANCH invalid partition") }
        let yes = ins.data[1]
        if yes < 0 || yes >= f.blocks.len { return Bad("FIR_BRANCH unknown block") }
        if f.blocks[yes].params.len != n + 1 || f.blocks[yes].params[0] != payload { return Bad("FIR_BRANCH case payload parameter") }
        var i: int = 0
        while i < n {
            if types[ins.uses[1 + i]] != f.blocks[yes].params[1 + i] { return Bad("FIR_BRANCH argument type") }
            i += 1
        }
        edge(f, ins, types, ins.data[2], 1 + n, ins.uses.len - 1 - n)?
    } else if op == "load" {
        if ins.uses.len != 0 { return Bad("FIR_ARITY invalid load arity") }
        let at = slot_place(m, f, ins)?
        result(ins, at.ty)?
    } else if op == "store" {
        if ins.uses.len != 1 { return Bad("FIR_ARITY invalid store arity") }
        result(ins, 0)?
        let at = slot_place(m, f, ins)?
        operand(ins, types, 0, at.ty)?
    } else if op == "call" {
        if ins.data.len != 1 { return Bad("FIR_CALL missing callee") }
        let target = ins.data[0]
        if target < 0 || target >= m.functions.len { return Bad("FIR_CALL unknown function") }
        let callee = m.functions[target]
        if ins.uses.len != callee.params.len { return Bad("FIR_CALL argument count") }
        result(ins, callee.result)?
        var i: int = 0
        while i < ins.uses.len { operand(ins, types, i, callee.params[i])?; i += 1 }
    } else if op == "concat" {
        arity(ins, 0, 2)?; result(ins, 3)?
        operand(ins, types, 0, 3)?; operand(ins, types, 1, 3)?
    } else if op == "format" {
        if ins.data.len != 0 || ins.uses.len == 0 { return Bad("FIR_ARITY invalid format arity") }
        result(ins, 3)?
        for v in ins.uses {
            let ty = types[v]
            if ty != 2 && ty != 3 && !integral(ty) { return Bad("FIR_TYPE unrenderable format part") }
        }
    } else if op == "list" {
        arity(ins, 0, 0)?
        if list_element(m, ins.ty) < 0 { return Bad("FIR_TYPE list result type") }
    } else if op == "push" {
        arity(ins, 0, 2)?; result(ins, 0)?
        let e = list_of(m, types, ins, 0)?
        operand(ins, types, 1, e)?
    } else if op == "get" {
        arity(ins, 0, 2)?
        let e = list_of(m, types, ins, 0)?
        operand(ins, types, 1, 1)?; result(ins, e)?
    } else if op == "set" {
        arity(ins, 0, 3)?; result(ins, 0)?
        let e = list_of(m, types, ins, 0)?
        operand(ins, types, 1, 1)?; operand(ins, types, 2, e)?
    } else if op == "read" {
        arity(ins, 0, 2)?
        let e = list_of(m, types, ins, 0)?
        operand(ins, types, 1, 1)?
        if !option_of(m, ins.ty, e) { return Bad("FIR_TYPE read result is not the element's option") }
    } else if op == "pop" {
        arity(ins, 0, 1)?
        let e = list_of(m, types, ins, 0)?
        if !option_of(m, ins.ty, e) { return Bad("FIR_TYPE pop result is not the element's option") }
    } else if op == "slice" {
        arity(ins, 0, 3)?
        let _ = list_of(m, types, ins, 0)?
        operand(ins, types, 1, 1)?; operand(ins, types, 2, 1)?; result(ins, types[ins.uses[0]])?
    } else if op == "len" || op == "clear" {
        arity(ins, 0, 1)?
        let ty = types[ins.uses[0]]
        if list_element(m, ty) < 0 && !is_map(m, ty) { return Bad("FIR_TYPE {op} operand is not a list or map") }
        if op == "len" { result(ins, 1)? } else { result(ins, 0)? }
    } else if op == "map" {
        arity(ins, 0, 0)?
        if !is_map(m, ins.ty) { return Bad("FIR_TYPE map result type") }
    } else if op == "insert" {
        arity(ins, 0, 3)?; result(ins, 0)?
        let mt = map_of(m, types, ins)?
        operand(ins, types, 1, map_key(m, mt))?; operand(ins, types, 2, map_value(m, mt))?
    } else if op == "lookup" || op == "remove" {
        arity(ins, 0, 2)?
        let mt = map_of(m, types, ins)?
        operand(ins, types, 1, map_key(m, mt))?
        if !option_of(m, ins.ty, map_value(m, mt)) { return Bad("FIR_TYPE {op} result is not the value's option") }
    } else if op == "pairs" {
        arity(ins, 0, 1)?
        let mt = map_of(m, types, ins)?
        if !pairs_of(m, ins.ty, mt) { return Bad("FIR_TYPE pairs result is not a list of key and value records") }
    } else if op == "print" {
        arity(ins, 0, 1)?; result(ins, 0)?
        let ty = types[ins.uses[0]]
        if ty != 1 && ty != 2 && ty != 3 { return Bad("FIR_TYPE unprintable type") }
    } else if op == "jump" {
        if ins.data.len != 1 { return Bad("FIR_BRANCH missing target") }
        result(ins, 0)?
        edge(f, ins, types, ins.data[0], 0, ins.uses.len)?
    } else if op == "branch" {
        if ins.data.len != 3 || ins.uses.len == 0 { return Bad("FIR_BRANCH malformed branch") }
        result(ins, 0)?; operand(ins, types, 0, 2)?
        let n = ins.data[2]
        if n < 0 || n > ins.uses.len - 1 { return Bad("FIR_BRANCH invalid partition") }
        edge(f, ins, types, ins.data[0], 1, n)?
        edge(f, ins, types, ins.data[1], 1 + n, ins.uses.len - 1 - n)?
    } else if op == "return" {
        result(ins, 0)?
        if f.result == 0 { arity(ins, 0, 0)? } else { arity(ins, 0, 1)?; operand(ins, types, 0, f.result)? }
    } else if op == "trap" {
        if ins.data.len != 1 || ins.uses.len > 1 { return Bad("FIR_ARITY invalid trap arity") }
        result(ins, 0)?
        if !trap_kind(ins.data[0]) { return Bad("FIR_TRAP unknown trap kind") }
        if ins.uses.len == 1 {
            if ins.data[0] != 4 { return Bad("FIR_TRAP message on a trap other than assert") }
            operand(ins, types, 0, 3)?
        }
    } else { return Bad("FIR_OPCODE unknown instruction {op}") }
}

/// Map instructions stage one entry (the key, then the value) in the frame's
/// scratch area, as calls stage their arguments.
pub fn entry_op(op: str) -> bool { op == "insert" || op == "lookup" || op == "remove" }

/// Always enabled. Sealed blocks make dominance an earlier-definition check.
pub fn verify(m: Module) -> () ! {Bad(str)} {
    var t: int = 0
    for shape in m.shapes {
        var w: int = 0
        var field: int = 0
        if shape.offsets.len != shape.fields.len { return Bad("FIR_TYPE inconsistent field offsets") }
        if shape.kind == "enum" {
            // One tag word, then the widest payload record; tail words of a
            // narrower variant are padding, never typed values.
            if shape.fields.len == 0 { return Bad("FIR_TYPE enum without variants") }
            var widest: int = 0
            for ty in shape.fields {
                if ty >= first_struct() + t || !shape_kind(m, ty, "struct") { return Bad("FIR_TYPE enum payload is not an earlier struct") }
                if shape.offsets[field] != 1 { return Bad("FIR_TYPE inconsistent enum payload offset") }
                if words(m, ty) > widest { widest = words(m, ty) }
                field += 1
            }
            if widest > 1048575 || shape.words != 1 + widest { return Bad("FIR_TYPE inconsistent enum layout") }
            t += 1
            continue
        }
        if shape.kind == "list" || shape.kind == "map" {
            // One opaque runtime handle; its element, key and value types are
            // earlier non-unit types, and a list of `int` is the fixed type 4.
            let wanted = if shape.kind == "list" then 1 else 2
            if shape.fields.len != wanted || shape.words != 1 { return Bad("FIR_TYPE inconsistent {shape.kind} shape") }
            for ty in shape.fields {
                if !field_type(ty, first_struct() + t) { return Bad("FIR_TYPE invalid {shape.kind} element type") }
            }
            if shape.kind == "list" && shape.fields[0] == 1 { return Bad("FIR_TYPE List[int] is the fixed type 4") }
            // The runtime copies whole elements through caller words; an
            // element or value of no words has none to copy.
            if words(m, shape.fields[wanted - 1]) == 0 { return Bad("FIR_TYPE {shape.kind} element without words") }
            if shape.kind == "map" && !key_type(shape.fields[0]) { return Bad("FIR_TYPE map key is not str, bool or an integer kind") }
            t += 1
            continue
        }
        if shape.kind != "struct" { return Bad("FIR_TYPE unknown aggregate kind") }
        for ty in shape.fields {
            if !field_type(ty, first_struct() + t) { return Bad("FIR_TYPE invalid struct field") }
            let width = words(m, ty)
            if width > 1048576 - w { return Bad("FIR_TYPE excessive struct size") }
            if shape.offsets[field] != w { return Bad("FIR_TYPE inconsistent field offset") }
            field += 1
            w += width
        }
        if w != shape.words { return Bad("FIR_TYPE inconsistent struct layout") }
        t += 1
    }
    var file_ok = List[bool]()
    for blob in m.blobs {
        var valid = blob.len > 0
        for c in blob.bytes() {
            if c == 0 as byte || c == 10 as byte || c == 13 as byte { valid = false }
        }
        (mut file_ok).push(valid)
    }
    for site in m.sites {
        if site.file < 0 || site.file >= m.blobs.len || site.line <= 0 || site.column <= 0 { return Bad("FIR_SITE invalid source coordinates") }
        if !file_ok[site.file] { return Bad("FIR_SITE empty or invalid source file") }
    }
    if m.functions.len == 0 { return Bad("FIR_CALL missing entry function") }
    if m.functions[0].params.len != 0 || m.functions[0].result != 1 { return Bad("FIR_CALL entry must be () -> int") }
    // Validate every signature before any call or edge indexes it.
    for f in m.functions {
        valid_type(m, f.result, true)?
        for ty in f.params { valid_type(m, ty, false)? }
        if f.blocks.len == 0 { return Bad("FIR_TERMINATOR function without blocks") }
        if !same_types(f.params, f.blocks[0].params) { return Bad("FIR_CALL entry block parameters") }
        for b in f.blocks { for ty in b.params { valid_type(m, ty, false)? } }
        for ty in f.slots { valid_type(m, ty, false)? }
    }
    for f in m.functions {
        var frame_words: int = 2
        var scratch_words: int = 0
        for ty in f.slots {
            frame_words += words(m, ty)
            if frame_words > 134217728 { return Bad("FIR_LAYOUT frame exceeds displacement range") }
        }
        for b in f.blocks {
            for ty in b.params {
                frame_words += words(m, ty)
                if frame_words > 134217728 { return Bad("FIR_LAYOUT frame exceeds displacement range") }
            }
            if b.code.len == 0 { return Bad("FIR_TERMINATOR empty block") }
            var types = copy b.params
            var i: int = 0
            for ins in b.code {
                valid_type(m, ins.ty, true)?
                if ins.site < 0 || ins.site >= m.sites.len { return Bad("FIR_SITE instruction lacks source site") }
                if terminal(ins.op) != (i == b.code.len - 1) { return Bad("FIR_TERMINATOR misplaced or missing terminator") }
                for v in ins.uses {
                    if v < 0 || v >= types.len { return Bad("FIR_DOMINANCE use is not an earlier local definition") }
                    if types[v] == 0 { return Bad("FIR_TYPE unit value used") }
                }
                instruction(m, f, ins, types)?
                frame_words += words(m, ins.ty)
                if frame_words > 134217728 { return Bad("FIR_LAYOUT frame exceeds displacement range") }
                if ins.op == "call" || ins.op == "jump" || ins.op == "branch" || ins.op == "case" {
                    var staged: int = 0
                    for v in ins.uses {
                        staged += words(m, types[v])
                        if staged > 134217728 { return Bad("FIR_LAYOUT arguments exceed displacement range") }
                    }
                    if staged > scratch_words { scratch_words = staged }
                }
                if entry_op(ins.op) {
                    let mt = types[ins.uses[0]]
                    let staged = words(m, map_key(m, mt)) + words(m, map_value(m, mt))
                    if staged > scratch_words { scratch_words = staged }
                }
                (mut types).push(ins.ty)
                i += 1
            }
        }
        if frame_words + scratch_words > 268435454 { return Bad("FIR_LAYOUT complete frame exceeds displacement range") }
    }
}
