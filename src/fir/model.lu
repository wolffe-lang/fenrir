//! member: true

use sem

/// A positive source location, indexing the module file-blob table.
pub struct Site { file: int, line: int, column: int }
/// An aggregate of kind `struct` (fields at cached word offsets) or `enum`
/// (one earlier payload-struct type per variant, each at offset 1 after the
/// tag word), or a runtime container of kind `list` (one element type) or
/// `map` (a key type, then a value type), each one opaque handle word; with
/// its cached width.
pub struct Shape { kind: str, fields: List[int], offsets: List[int], words: int }
/// A typed instruction with separate immediate data and local SSA uses.
pub struct Inst { op: str, ty: int, site: int, data: List[int], uses: List[int] }
/// A sealed block: parameters, ordered definitions, then one terminator.
pub struct Block { params: List[int], code: List[Inst] }
/// A declared signature, typed stack slots and a nonempty ordered block list.
pub struct Function { result: int, params: List[int], slots: List[int], blocks: List[Block] }
/// Ordered dense tables forming one independently verifiable FIR module.
pub struct Module {
    blobs: List[str],
    sites: List[Site],
    shapes: List[Shape],
    functions: List[Function],
}

/// The first struct type id; ids below it are the fixed types.
pub fn first_struct() -> int { 10 }

/// The integer kind a type id names, as `sem` keys it, or "" for any other
/// type. These ids are the typed tree's ids for the same kinds.
pub fn kind(ty: int) -> str {
    if ty == 1 { return "int" }
    if ty == 5 { return "i32" }
    if ty == 6 { return "i64" }
    if ty == 7 { return "u8" }
    if ty == 8 { return "u64" }
    if ty == 9 { return "uint" }
    ""
}

/// Whether a type id names an integer kind.
pub fn integral(ty: int) -> bool { sem.integer_kind(kind(ty)) }

/// Return the word width of an already verified type.
pub fn words(m: Module, ty: int) -> int {
    if ty == 0 { return 0 }
    if ty == 3 { return 2 }
    if ty < first_struct() { return 1 }
    m.shapes[ty - first_struct()].words
}

/// Whether a type may be a struct field: any earlier non-unit value type.
/// The fixed `List[int]` handle is a field from edition 3 on; the reader of
/// editions 1 and 2 refuses it there as it always did.
pub fn field_type(ty: int, limit: int) -> bool {
    ty == 2 || ty == 3 || ty == 4 || integral(ty) || (ty >= first_struct() && ty < limit)
}

/// Whether a type names an aggregate of the requested verified kind.
fn shape_kind(m: Module, ty: int, wanted: str) -> bool {
    if ty < first_struct() || ty >= first_struct() + m.shapes.len { return false }
    m.shapes[ty - first_struct()].kind == wanted
}

/// The element type of a list type (the fixed `List[int]` or a `list`
/// shape), or -1 for any other type.
pub fn list_element(m: Module, ty: int) -> int {
    if ty == 4 { return 1 }
    if shape_kind(m, ty, "list") { return m.shapes[ty - first_struct()].fields[0] }
    -1
}

/// Whether a type names a `map` shape.
pub fn is_map(m: Module, ty: int) -> bool { shape_kind(m, ty, "map") }

/// A map type's key type; the caller has checked `is_map`.
pub fn map_key(m: Module, ty: int) -> int { m.shapes[ty - first_struct()].fields[0] }

/// A map type's value type; the caller has checked `is_map`.
pub fn map_value(m: Module, ty: int) -> int { m.shapes[ty - first_struct()].fields[1] }

/// Whether a map key type compares as the language defines key equality:
/// `str` by its bytes, `bool` and every integer kind by value.
pub fn key_type(ty: int) -> bool { ty == 2 || ty == 3 || integral(ty) }

/// Whether `ty` is the option of `inner` that the recoverable reads answer:
/// an enum whose variant 0 carries a one-field record of `inner` and whose
/// variant 1 carries an empty record.
pub fn option_of(m: Module, ty: int, inner: int) -> bool {
    if !shape_kind(m, ty, "enum") { return false }
    let at = ty - first_struct()
    if m.shapes[at].fields.len != 2 { return false }
    let some = m.shapes[at].fields[0] - first_struct()
    let none = m.shapes[at].fields[1] - first_struct()
    m.shapes[some].fields.len == 1 && m.shapes[some].fields[0] == inner && m.shapes[none].fields.len == 0
}

/// Whether `ty` is the list of `(key, value)` records a map's `pairs` answers.
pub fn pairs_of(m: Module, ty: int, map: int) -> bool {
    let record = list_element(m, ty)
    if record < 0 || !shape_kind(m, record, "struct") { return false }
    let at = record - first_struct()
    m.shapes[at].fields.len == 2 && m.shapes[at].fields[0] == map_key(m, map) && m.shapes[at].fields[1] == map_value(m, map)
}

/// The instructions edition 3 adds; a module that uses one prints as edition 3.
pub fn third_edition_op(op: str) -> bool {
    op == "set" || op == "pop" || op == "read" || op == "clear" || op == "slice" || op == "map" ||
        op == "lookup" || op == "insert" || op == "remove" || op == "pairs"
}

/// The edition a module needs: 3 for a list or map shape, a list of anything
/// but `int`, or an edition-3 instruction; 2 for an enum; otherwise 1.
pub fn edition(m: Module) -> int {
    var second = false
    for shape in m.shapes {
        if shape.kind == "list" || shape.kind == "map" { return 3 }
        if shape.kind == "enum" { second = true }
        if shape.kind == "struct" { for ty in shape.fields { if ty == 4 { return 3 } } }
    }
    for f in m.functions {
        for b in f.blocks { for ins in b.code { if third_edition_op(ins.op) { return 3 } } }
    }
    if second { return 2 }
    1
}

/// Validate an enum type and tag, returning its payload-record type.
fn payload_type(m: Module, ty: int, tag: int) -> int ! {Bad(str)} {
    if !shape_kind(m, ty, "enum") { return Bad("FIR_TYPE expected enum type") }
    let shape = ty - first_struct()
    if tag < 0 || tag >= m.shapes[shape].fields.len { return Bad("FIR_TYPE unknown enum variant") }
    m.shapes[shape].fields[tag]
}

/// A field path's type and word offset inside a value of type `ty`.
pub struct Place { ty: int, offset: int }

/// Resolve `path[start..]` as successive field indices from type `ty`;
/// Bad names a path through a non-struct or an unknown field.
pub fn place(m: Module, ty: int, path: List[int], start: int) -> Place ! {Bad(str)} {
    var at = ty
    var offset: int = 0
    var i = start
    while i < path.len {
        if at < first_struct() || at >= first_struct() + m.shapes.len { return Bad("FIR_TYPE field path through a non-struct") }
        let t = at - first_struct()
        if m.shapes[t].kind != "struct" { return Bad("FIR_TYPE field path through an enum") }
        let k = path[i]
        if k < 0 || k >= m.shapes[t].fields.len { return Bad("FIR_TYPE unknown field in path") }
        offset += m.shapes[t].offsets[k]
        at = m.shapes[t].fields[k]
        i += 1
    }
    Place { ty: at, offset: offset }
}

/// Append without repeatedly copying the accumulated prefix.
pub fn text(mut out: List[byte], s: str) {
    for b in s.bytes() { (mut out).push(b) }
}

/// Validate assembled UTF-8 bytes; Bad names an invalid encoding.
pub fn finish(out: List[byte]) -> str ! {Bad(str)} {
    str_from_utf8(out) else |_| { return Bad("FIR_SYNTAX invalid UTF-8") }
}

/// Identify the closed set of FIR terminators.
pub fn terminal(op: str) -> bool {
    op == "jump" || op == "branch" || op == "case" || op == "return" || op == "trap"
}

/// The trap kinds this edition implements, numbered as the runtime's trap
/// entry numbers them (docs/ABI.md): 1 overflow, 2 div-zero, 3 bounds, 4 assert.
pub fn trap_kind(kind: int) -> bool { kind >= 1 && kind <= 4 }
