//! member: true

use fir

struct Slots { offsets: List[int], types: List[int] }
struct Frame { blocks: List[Slots], slots: List[int], slot_types: List[int], size: int, scratch: int }

fn allocate(m: fir.Module, f: fir.Function) -> Frame ! {Bad(str)} {
    var next: int = 16 // saved result pointer, temporary string-builder handle
    var maximum: int = 0
    var blocks = List[Slots]()
    for b in f.blocks {
        var offsets = List[int]()
        var types = List[int]()
        for ty in b.params {
            next += fir.words(m, ty) * 8
            (mut offsets).push(-next); (mut types).push(ty)
        }
        for ins in b.code {
            var width: int = 0
            // Only calls and edges stage arguments. Count each operand once.
            if ins.op == "call" || ins.op == "jump" || ins.op == "branch" || ins.op == "case" {
                for v in ins.uses { width += fir.words(m, types[v]) }
                if width > maximum { maximum = width }
            }
            // A map instruction stages one entry, the key then the value.
            if fir.entry_op(ins.op) {
                let mt = types[ins.uses[0]]
                width = fir.words(m, fir.map_key(m, mt)) + fir.words(m, fir.map_value(m, mt))
                if width > maximum { maximum = width }
            }
            if ins.op == "text" && ins.data[0] == 13 && maximum < 5 { maximum = 5 }
            if ins.op == "text" && (ins.data[0] == 16 || ins.data[0] == 18 || ins.data[0] == 19) && maximum < 4 { maximum = 4 }
            next += fir.words(m, ins.ty) * 8
            (mut offsets).push(-next); (mut types).push(ins.ty)
        }
        if next > 1073741824 || maximum > 134217728 { return Bad("FIR_LAYOUT frame exceeds signed displacement limit") }
        (mut blocks).push(Slots { offsets: move offsets, types: move types })
    }
    // Stack slots follow every block's values; a slot's words are its own.
    var slots = List[int]()
    for ty in f.slots {
        next += fir.words(m, ty) * 8
        (mut slots).push(-next)
    }
    if next > 1073741824 { return Bad("FIR_LAYOUT frame exceeds signed displacement limit") }
    let scratch = -(next + maximum * 8)
    let size = ((-scratch + 15) / 16) * 16
    if size > 2147483632 { return Bad("FIR_LAYOUT frame exceeds signed displacement limit") }
    Frame { blocks: move blocks, slots: move slots, slot_types: copy f.slots, size: size, scratch: scratch }
}

/// The widest copy written as straight-line moves: two instructions a word, so at most 32 for
/// one copy. A wider copy is one counted loop of five instructions whatever its width, so the
/// text of a copy never grows with the value: the assembler's memory follows the text, and one
/// pair per word at every copy of a 401-word struct was a megabyte it could not hold.
fn straight_words() -> int { 16 }

/// Copy `words` words from `src`(%from) to `dst`(%to). A wide copy counts %rcx down to zero
/// under `label` (moves leave the flags of its `subq`). Clobbers %rax, and %rcx when wide.
fn move_words(mut out: List[byte], from: str, src: int, to: str, dst: int, words: int, label: str) {
    if words > straight_words() {
        fir.text(mut out, "movq ${words}, %rcx\n{label}:\nsubq $1, %rcx\nmovq {src}(%{from},%rcx,8), %rax\nmovq %rax, {dst}(%{to},%rcx,8)\njne {label}\n")
        return
    }
    var k: int = 0
    while k < words {
        let s = src + k * 8
        let d = dst + k * 8
        fir.text(mut out, "movq {s}(%{from}), %rax\nmovq %rax, {d}(%{to})\n")
        k += 1
    }
}

fn copy_words(mut out: List[byte], from: int, to: int, words: int, label: str) {
    move_words(mut out, "rbp", from, "rbp", to, words, label)
}

/// Store %rax (zero at every caller) into `words` words from `dst`(%rbp); wide as `move_words`.
fn fill_words(mut out: List[byte], dst: int, words: int, label: str) {
    if words > straight_words() {
        fir.text(mut out, "movq ${words}, %rcx\n{label}:\nsubq $1, %rcx\nmovq %rax, {dst}(%rbp,%rcx,8)\njne {label}\n")
        return
    }
    var k: int = 0
    while k < words { save(mut out, dst + k * 8, "rax"); k += 1 }
}

fn load(mut out: List[byte], slots: Slots, value: int, reg: str) {
    let off = slots.offsets[value]
    fir.text(mut out, "movq {off}(%rbp), %{reg}\n")
}

fn address(mut out: List[byte], slots: Slots, value: int, reg: str) {
    let off = slots.offsets[value]
    fir.text(mut out, "leaq {off}(%rbp), %{reg}\n")
}

fn save(mut out: List[byte], offset: int, reg: str) {
    fir.text(mut out, "movq %{reg}, {offset}(%rbp)\n")
}

fn trap(mut out: List[byte], m: fir.Module, site: int, kind: int) {
    let s = m.sites[site]
    let n = m.blobs[s.file].len
    fir.text(mut out, "movl ${kind}, %edi\nleaq .Lblob{s.file}(%rip), %rsi\nmovq ${n}, %rdx\n")
    fir.text(mut out, "movabsq ${s.line}, %rcx\nmovabsq ${s.column}, %r8\ncall __wolf_rt_trap_at\nud2\n")
}

// Labels: `label` is the instruction's; each wide copy in it adds its own suffix.
fn stage(mut out: List[byte], m: fir.Module, slots: Slots, ins: fir.Inst, start: int, count: int, scratch: int, label: str) {
    var at = scratch
    var k: int = 0
    while k < count {
        let v = ins.uses[start + k]
        let w = fir.words(m, slots.types[v])
        copy_words(mut out, slots.offsets[v], at, w, "{label}_s{start + k}")
        at += w * 8
        k += 1
    }
}

fn branch_edge(mut out: List[byte], m: fir.Module, frame: Frame, block: int, ins: fir.Inst, start: int, count: int, target: int, function: int, label: str) {
    stage(mut out, m, frame.blocks[block], ins, start, count, frame.scratch, label)
    var at = frame.scratch
    var k: int = 0
    while k < count {
        let w = fir.words(m, frame.blocks[target].types[k])
        copy_words(mut out, at, frame.blocks[target].offsets[k], w, "{label}_t{start + k}")
        at += w * 8
        k += 1
    }
    fir.text(mut out, "jmp .Lf{function}_b{target}\n")
}

// A matched `case`: stage the active payload (the words after the tag) and
// the explicit arguments, then write the target's parameters, payload first.
fn case_edge(mut out: List[byte], m: fir.Module, frame: Frame, block: int, ins: fir.Inst, function: int, label: str) {
    let target = ins.data[1]
    let n = ins.data[3]
    let width = fir.words(m, frame.blocks[target].types[0])
    copy_words(mut out, frame.blocks[block].offsets[ins.uses[0]] + 8, frame.scratch, width, "{label}_cp")
    var at = frame.scratch + width * 8
    var k: int = 0
    while k < n {
        let v = ins.uses[1 + k]
        let w = fir.words(m, frame.blocks[block].types[v])
        copy_words(mut out, frame.blocks[block].offsets[v], at, w, "{label}_s{1 + k}")
        at += w * 8
        k += 1
    }
    at = frame.scratch
    k = 0
    while k <= n {
        let w = fir.words(m, frame.blocks[target].types[k])
        copy_words(mut out, at, frame.blocks[target].offsets[k], w, "{label}_t{k}")
        at += w * 8
        k += 1
    }
    fir.text(mut out, "jmp .Lf{function}_b{target}\n")
}
