//! member: true

use fir

// Runtime byte/char cells are not FIR words. Byte windows are walked directly;
// the public native char-list entry is adapted from its documented 4-byte
// stride through list_read into a zeroed word, never by header inspection.
fn text_materialize_emit(mut out: List[byte], m: fir.Module, frame: Frame, slots: Slots, ins: fir.Inst, dest: int, label: str) {
    let scratch = frame.scratch
    let second = scratch + 8
    let third = scratch + 16
    let fourth = scratch + 24
    let fifth = scratch + 32
    let length = slots.offsets[ins.uses[0]] + 8
    load(mut out, slots, ins.uses[1], "rax")
    load(mut out, slots, ins.uses[2], "rcx")
    fir.text(mut out, "cmpq %rcx, %rax\nja {label}_material_bad\ncmpq {length}(%rbp), %rcx\nja {label}_material_bad\n")
    if ins.data[1] == 0 {
        save(mut out, second, "rax"); save(mut out, third, "rcx")
        fir.text(mut out, "movq $8, %rdi\ncall __wolf_rt_list_new\n")
        save(mut out, scratch, "rax")
        fir.text(mut out, "{label}_octets:\nmovq {second}(%rbp), %rcx\ncmpq {third}(%rbp), %rcx\njae {label}_octets_done\n")
        load(mut out, slots, ins.uses[0], "rax")
        fir.text(mut out, "addq %rcx, %rax\nmovzbq (%rax), %rax\n")
        save(mut out, fourth, "rax")
        fir.text(mut out, "movq {scratch}(%rbp), %rdi\nleaq {fourth}(%rbp), %rsi\ncall __wolf_rt_list_push\naddq $1, {second}(%rbp)\njmp {label}_octets\n{label}_octets_done:\nmovq {scratch}(%rbp), %rax\n")
    } else {
        string_pair(mut out, slots, ins.uses[0], "rdi", "rsi")
        load(mut out, slots, ins.uses[1], "rdx")
        load(mut out, slots, ins.uses[2], "rcx")
        fir.text(mut out, "leaq {scratch}(%rbp), %r8\ncall __wolf_rt_str_get\ncmpq $0, %rax\nje {label}_material_bad\nmovq {scratch}(%rbp), %rdi\nmovq {second}(%rbp), %rsi\ncall __wolf_rt_str_chars\n")
        save(mut out, scratch, "rax")
        fir.text(mut out, "movq $8, %rdi\ncall __wolf_rt_list_new\n")
        save(mut out, second, "rax")
        fir.text(mut out, "movq {scratch}(%rbp), %rdi\ncall __wolf_rt_list_len\n")
        save(mut out, third, "rax")
        fir.text(mut out, "movq $0, %rax\n")
        save(mut out, fourth, "rax")
        fir.text(mut out, "{label}_scalars:\nmovq {fourth}(%rbp), %rsi\ncmpq {third}(%rbp), %rsi\njae {label}_scalars_done\nmovq $0, %rax\n")
        save(mut out, fifth, "rax")
        fir.text(mut out, "movq {scratch}(%rbp), %rdi\nleaq {fifth}(%rbp), %rdx\ncall __wolf_rt_list_read\ncmpq $0, %rax\nje {label}_material_bad\nmovq {second}(%rbp), %rdi\nleaq {fifth}(%rbp), %rsi\ncall __wolf_rt_list_push\naddq $1, {fourth}(%rbp)\njmp {label}_scalars\n{label}_scalars_done:\nmovq {second}(%rbp), %rax\n")
    }
    save(mut out, dest, "rax")
    fir.text(mut out, "jmp {label}_material_end\n{label}_material_bad:\n")
    trap(mut out, m, ins.site, 3)
    fir.text(mut out, "{label}_material_end:\n")
}

// Operation 16 adapts the FIR word list to the runtime's one-byte list through
// the public list entries: each word is read into scratch and pushed, which
// copies its low byte. The entry returns 0 for valid UTF-8, having written the
// fresh str pair as the option's payload; anything else is the empty option.
fn text_construct_emit(mut out: List[byte], m: fir.Module, frame: Frame, slots: Slots, ins: fir.Inst, dest: int, label: str) {
    let bytes = frame.scratch
    let index = bytes + 8
    let count = bytes + 16
    let word = bytes + 24
    let payload = dest + 8
    fir.text(mut out, "movq $1, %rdi\ncall __wolf_rt_list_new\n")
    save(mut out, bytes, "rax")
    load(mut out, slots, ins.uses[0], "rdi")
    fir.text(mut out, "call __wolf_rt_list_len\n")
    save(mut out, count, "rax")
    fir.text(mut out, "movq $0, %rax\n")
    save(mut out, index, "rax")
    fir.text(mut out, "{label}_words:\nmovq {index}(%rbp), %rsi\ncmpq {count}(%rbp), %rsi\njae {label}_words_done\n")
    load(mut out, slots, ins.uses[0], "rdi")
    fir.text(mut out, "leaq {word}(%rbp), %rdx\ncall __wolf_rt_list_read\nmovq {bytes}(%rbp), %rdi\nleaq {word}(%rbp), %rsi\ncall __wolf_rt_list_push\naddq $1, {index}(%rbp)\njmp {label}_words\n")
    fir.text(mut out, "{label}_words_done:\nmovq {bytes}(%rbp), %rdi\nleaq {payload}(%rbp), %rsi\ncall __wolf_rt_str_from_utf8\n")
    fir.text(mut out, "cmpq $0, %rax\nsetne %al\nmovzbq %al, %rax\nxorq $1, %rax\n")
    option(mut out, m, ins, dest, label)
}

// Operation 17: `print_str` writes standard output without a newline;
// `write_str(2, …, 0)` writes standard error, then the shared newline for mode 1.
fn text_write_emit(mut out: List[byte], slots: Slots, ins: fir.Inst) {
    let mode = ins.data[1]
    if mode == 0 {
        string_pair(mut out, slots, ins.uses[0], "rdi", "rsi")
        fir.text(mut out, "call __wolf_rt_print_str\n")
        return
    }
    string_pair(mut out, slots, ins.uses[0], "rsi", "rdx")
    fir.text(mut out, "movq $2, %rdi\nmovq $0, %rcx\ncall __wolf_rt_write_str\n")
    if mode == 1 { fir.text(mut out, "leaq .Lnewline(%rip), %rsi\nmovq $1, %rdx\nmovq $2, %rdi\nmovq $0, %rcx\ncall __wolf_rt_write_str\n") }
}

// Operations 18 and 19 walk the word list through `list_read` into scratch and
// compare each word with the byte. A find whose start lies outside `0..len`
// (one unsigned compare) is the empty option without reading anything.
fn text_scan_emit(mut out: List[byte], m: fir.Module, frame: Frame, slots: Slots, ins: fir.Inst, dest: int, label: str) {
    let index = frame.scratch
    let count = index + 8
    let length = index + 16
    let word = index + 24
    let find = ins.data[0] == 18
    load(mut out, slots, ins.uses[0], "rdi")
    fir.text(mut out, "call __wolf_rt_list_len\n")
    save(mut out, length, "rax")
    fir.text(mut out, "movq $0, %rax\n")
    save(mut out, count, "rax")
    if find {
        load(mut out, slots, ins.uses[2], "rax")
        save(mut out, index, "rax")
        fir.text(mut out, "cmpq {length}(%rbp), %rax\nja {label}_scan_none\n")
    } else { save(mut out, index, "rax") }
    fir.text(mut out, "{label}_scan:\nmovq {index}(%rbp), %rsi\ncmpq {length}(%rbp), %rsi\njae {label}_scan_done\n")
    load(mut out, slots, ins.uses[0], "rdi")
    fir.text(mut out, "leaq {word}(%rbp), %rdx\ncall __wolf_rt_list_read\nmovq {word}(%rbp), %rax\n")
    load(mut out, slots, ins.uses[1], "rcx")
    if find {
        fir.text(mut out, "cmpq %rcx, %rax\nje {label}_scan_found\naddq $1, {index}(%rbp)\njmp {label}_scan\n")
        fir.text(mut out, "{label}_scan_found:\nmovq {index}(%rbp), %rax\n")
        save(mut out, dest + 8, "rax")
        fir.text(mut out, "movq $1, %rax\njmp {label}_scan_tag\n{label}_scan_done:\n{label}_scan_none:\nmovq $0, %rax\n{label}_scan_tag:\n")
        option(mut out, m, ins, dest, label)
        return
    }
    fir.text(mut out, "cmpq %rcx, %rax\njne {label}_scan_next\naddq $1, {count}(%rbp)\n{label}_scan_next:\naddq $1, {index}(%rbp)\njmp {label}_scan\n{label}_scan_done:\nmovq {count}(%rbp), %rax\n")
    save(mut out, dest, "rax")
}
