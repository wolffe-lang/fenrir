//! member: true

use fir
use sem

// All numeric domains use canonical word carriers. The source-domain table
// supplies widths and signs here and to the bounded interpreter; guards keep
// the instruction's source site. No numeric expression changes FIR blocks.
fn numeric_normalize(mut out: List[byte], kind: str) {
    let w = sem.width(kind)
    if w == 64 { return }
    if sem.signed(kind) {
        let shift = 64 - w
        fir.text(mut out, "shlq ${shift}, %rax\nsarq ${shift}, %rax\n")
    } else {
        let mask = sem.maximum(kind)
        fir.text(mut out, "movabsq ${mask}, %r8\nandq %r8, %rax\n")
    }
}

fn numeric_range(mut out: List[byte], kind: str, unsigned_source: bool, label: str) {
    let low = sem.minimum(kind)
    let high = sem.maximum(kind)
    if sem.signed(kind) {
        if !unsigned_source {
            fir.text(mut out, "movabsq ${low}, %r8\ncmpq %r8, %rax\njl {label}_overflow\n")
        }
        let above = if unsigned_source then "ja" else "jg"
        fir.text(mut out, "movabsq ${high}, %r8\ncmpq %r8, %rax\n{above} {label}_overflow\n")
    } else {
        if !unsigned_source { fir.text(mut out, "testq %rax, %rax\njs {label}_overflow\n") }
        if sem.width(kind) < 64 {
            fir.text(mut out, "movabsq ${high}, %r8\ncmpq %r8, %rax\nja {label}_overflow\n")
        }
    }
}

fn numeric_cast_emit(mut out: List[byte], from: str, target: str, label: str) {
    if sem.wrapping_kind(target) || target == "byte" {
        numeric_normalize(mut out, target)
        return
    }
    if target == "char" {
        fir.text(mut out, "cmpq $1114111, %rax\nja {label}_overflow\ncmpq $55296, %rax\njb {label}_cast_ok\ncmpq $57343, %rax\njbe {label}_overflow\n{label}_cast_ok:\n")
        return
    }
    numeric_range(mut out, target, !sem.signed(from), label)
}

fn numeric_shift_emit(mut out: List[byte], kind: str, mode: int, label: str) {
    let w = sem.width(kind)
    let right = if sem.signed(kind) then "sarq" else "shrq"
    if sem.wrapping_kind(kind) {
        let mask = w - 1
        fir.text(mut out, "andq ${mask}, %rcx\n")
    } else {
        if sem.signed(kind) { fir.text(mut out, "testq %rcx, %rcx\njs {label}_overflow\n") }
        fir.text(mut out, "cmpq ${w}, %rcx\njae {label}_large_count\n")
    }
    if mode == 10 { fir.text(mut out, "{right} %cl, %rax\n") }
    else {
        fir.text(mut out, "movq %rax, %r9\nshlq %cl, %rax\n")
        numeric_normalize(mut out, kind)
        if !sem.wrapping_kind(kind) {
            fir.text(mut out, "movq %rax, %r10\n{right} %cl, %rax\ncmpq %r9, %rax\njne {label}_overflow\nmovq %r10, %rax\n")
        }
    }
    if !sem.wrapping_kind(kind) {
        fir.text(mut out, "jmp {label}_shift_ok\n{label}_large_count:\n")
        if mode == 9 { fir.text(mut out, "testq %rax, %rax\njnz {label}_overflow\n") }
        else if sem.signed(kind) { fir.text(mut out, "sarq $63, %rax\njmp {label}_shift_ok\n") }
        fir.text(mut out, "xorq %rax, %rax\n{label}_shift_ok:\n")
    }
}

fn numeric_divide_emit(mut out: List[byte], kind: str, mode: int, label: str) {
    fir.text(mut out, "testq %rcx, %rcx\njz {label}_zero\n")
    if sem.signed(kind) {
        // The processor itself faults at signed 64-bit MIN/-1. Narrow
        // domains divide at full width, then normalize or check the result.
        let minimum_word = sem.minimum("int")
        fir.text(mut out, "cmpq $-1, %rcx\njne {label}_divide\nmovabsq ${minimum_word}, %r8\ncmpq %r8, %rax\njne {label}_divide\n")
        if sem.wrapping_kind(kind) {
            if mode == 5 { fir.text(mut out, "xorq %rax, %rax\n") }
            fir.text(mut out, "jmp {label}_divided\n")
        } else { fir.text(mut out, "jmp {label}_overflow\n") }
        fir.text(mut out, "{label}_divide:\ncqto\nidivq %rcx\n")
    } else { fir.text(mut out, "xorq %rdx, %rdx\ndivq %rcx\n") }
    if mode == 5 { fir.text(mut out, "movq %rdx, %rax\n") }
    fir.text(mut out, "{label}_divided:\n")
    if sem.wrapping_kind(kind) { numeric_normalize(mut out, kind) }
    else {
        // Checked remainder shares MIN/-1's overflow, even though the
        // remainder itself is zero. This includes every narrow signed type.
        if sem.signed(kind) && mode == 5 && sem.width(kind) < 64 {
            let low = sem.minimum(kind)
            fir.text(mut out, "cmpq $-1, %rcx\njne {label}_rem_ok\nmovabsq ${low}, %r8\ncmpq %r8, %r9\nje {label}_overflow\n{label}_rem_ok:\n")
        }
        numeric_range(mut out, kind, !sem.signed(kind), label)
    }
}

// Edition 6's float domain. Words stay in %rax and %rcx and cross to %xmm0 and
// %xmm1 by movq; only register forms of the scalar-double rows are emitted
// (docs/X86-FORMS.md). The constants are double bit patterns: 2^63, -2^63,
// 2^64 and -1.0.
fn float_emit(mut out: List[byte], from: str, kind: str, mode: int, label: str) {
    if mode == 11 { fir.text(mut out, "movabsq $-9223372036854775808, %r8\nxorq %r8, %rax\n"); return }
    if mode >= 1 && mode <= 4 {
        let op = if mode == 1 then "addsd" else if mode == 2 then "subsd" else if mode == 3 then "mulsd" else "divsd"
        fir.text(mut out, "movq %rax, %xmm0\nmovq %rcx, %xmm1\n{op} %xmm1, %xmm0\nmovq %xmm0, %rax\n")
        return
    }
    if mode >= 13 {
        fir.text(mut out, "movq %rax, %xmm0\nmovq %rcx, %xmm1\n")
        // Equality is ordered (ZF and not PF); inequality is its negation; each
        // ordering reads CF/ZF, which an unordered pair sets, so it is false.
        if mode == 13 { fir.text(mut out, "ucomisd %xmm1, %xmm0\nsete %al\nsetnp %r8b\nandb %r8b, %al\n") }
        else if mode == 14 { fir.text(mut out, "ucomisd %xmm1, %xmm0\nsetne %al\nsetp %r8b\norb %r8b, %al\n") }
        else if mode == 15 { fir.text(mut out, "ucomisd %xmm0, %xmm1\nseta %al\n") }
        else if mode == 16 { fir.text(mut out, "ucomisd %xmm0, %xmm1\nsetae %al\n") }
        else if mode == 17 { fir.text(mut out, "ucomisd %xmm1, %xmm0\nseta %al\n") }
        else { fir.text(mut out, "ucomisd %xmm1, %xmm0\nsetae %al\n") }
        fir.text(mut out, "movzbq %al, %rax\n")
        return
    }
    if from == kind { return }
    if kind == "f64" {
        if sem.width(from) == 64 && !sem.signed(from) {
            // An unsigned word at or above 2^63: halve it keeping the low bit as
            // sticky, convert, double. The rounding is the exact value's.
            fir.text(mut out, "testq %rax, %rax\njs {label}_fbig\ncvtsi2sdq %rax, %xmm0\njmp {label}_fdone\n{label}_fbig:\n")
            fir.text(mut out, "movq %rax, %r8\nshrq $1, %r8\nandq $1, %rax\norq %rax, %r8\ncvtsi2sdq %r8, %xmm0\naddsd %xmm0, %xmm0\n{label}_fdone:\n")
        } else { fir.text(mut out, "cvtsi2sdq %rax, %xmm0\n") }
        fir.text(mut out, "movq %xmm0, %rax\n")
        return
    }
    // To an integer: a NaN, an infinity or a truncated value out of range traps
    // `overflow` before cvttsd2si, whose out-of-range answer is never used.
    fir.text(mut out, "movq %rax, %xmm0\n")
    if sem.signed(kind) {
        fir.text(mut out, "movabsq $4890909195324358656, %r8\nmovq %r8, %xmm1\nucomisd %xmm1, %xmm0\njp {label}_overflow\njae {label}_overflow\n")
        fir.text(mut out, "movabsq $-4332462841530417152, %r8\nmovq %r8, %xmm1\nucomisd %xmm1, %xmm0\njb {label}_overflow\ncvttsd2si %xmm0, %rax\n")
        if sem.width(kind) < 64 { numeric_range(mut out, kind, false, label) }
        return
    }
    fir.text(mut out, "movabsq $4895412794951729152, %r8\nmovq %r8, %xmm1\nucomisd %xmm1, %xmm0\njp {label}_overflow\njae {label}_overflow\n")
    fir.text(mut out, "movabsq $-4616189618054758400, %r8\nmovq %r8, %xmm1\nucomisd %xmm1, %xmm0\njbe {label}_overflow\n")
    fir.text(mut out, "movabsq $4890909195324358656, %r8\nmovq %r8, %xmm1\nucomisd %xmm1, %xmm0\njae {label}_ubig\ncvttsd2si %xmm0, %rax\njmp {label}_udone\n")
    fir.text(mut out, "{label}_ubig:\nsubsd %xmm1, %xmm0\ncvttsd2si %xmm0, %rax\nmovabsq $-9223372036854775808, %r8\nxorq %r8, %rax\n{label}_udone:\n")
    if sem.width(kind) < 64 { numeric_range(mut out, kind, true, label) }
}

fn numeric_emit(mut out: List[byte], m: fir.Module, slots: Slots, ins: fir.Inst, dest: int, label: str) {
    let mode = ins.data[0]
    let from = sem.numeric_kind(ins.data[1])
    let kind = sem.numeric_kind(ins.data[2])
    load(mut out, slots, ins.uses[0], "rax")
    if ins.uses.len > 1 { load(mut out, slots, ins.uses[1], "rcx") }
    if mode >= 13 || from == "f64" || kind == "f64" { float_emit(mut out, from, kind, mode, label) }
    else if mode == 0 { numeric_cast_emit(mut out, from, kind, label) }
    else if mode == 9 || mode == 10 { numeric_shift_emit(mut out, kind, mode, label) }
    else if mode == 4 || mode == 5 {
        fir.text(mut out, "movq %rax, %r9\n")
        numeric_divide_emit(mut out, kind, mode, label)
    } else {
        if mode == 12 { fir.text(mut out, "notq %rax\n") }
        else if mode == 6 { fir.text(mut out, "andq %rcx, %rax\n") }
        else if mode == 7 { fir.text(mut out, "orq %rcx, %rax\n") }
        else if mode == 8 { fir.text(mut out, "xorq %rcx, %rax\n") }
        else if mode == 11 { fir.text(mut out, "negq %rax\n") }
        else if mode == 1 { fir.text(mut out, "addq %rcx, %rax\n") }
        else if mode == 2 { fir.text(mut out, "subq %rcx, %rax\n") }
        else if !sem.wrapping_kind(kind) && !sem.signed(kind) {
            fir.text(mut out, "mulq %rcx\ntestq %rdx, %rdx\njnz {label}_overflow\n")
        } else { fir.text(mut out, "imulq %rcx, %rax\n") }
        if !sem.wrapping_kind(kind) && mode <= 3 || !sem.wrapping_kind(kind) && mode == 11 {
            if sem.signed(kind) { fir.text(mut out, "jo {label}_overflow\n") }
            else if mode != 3 { fir.text(mut out, "jc {label}_overflow\n") }
            numeric_range(mut out, kind, !sem.signed(kind), label)
        } else { numeric_normalize(mut out, kind) }
    }
    save(mut out, dest, "rax")
    fir.text(mut out, "jmp {label}_numeric_done\n{label}_overflow:\n")
    trap(mut out, m, ins.site, 1)
    fir.text(mut out, "{label}_zero:\n")
    trap(mut out, m, ins.site, 2)
    fir.text(mut out, "{label}_numeric_done:\n")
}
