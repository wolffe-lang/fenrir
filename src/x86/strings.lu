//! member: true

use fir

fn text_emit(mut out: List[byte], m: fir.Module, frame: Frame, slots: Slots, ins: fir.Inst, dest: int, label: str) {
    let op = ins.data[0]
    if op == 13 { text_materialize_emit(mut out, m, frame, slots, ins, dest, label); return }
    if op >= 5 { text_operation_emit(mut out, m, slots, ins, dest, label); return }
    let value = ins.uses[0]
    if op == 4 {
        let flavor = ins.data[2]
        if flavor == 0 { copy_words(mut out, slots.offsets[value], dest, 2); return }
        fir.text(mut out, "call __wolf_rt_strbuf_new\nmovq %rax, -16(%rbp)\nmovq %rax, %rdi\n")
        load(mut out, slots, value, "rsi")
        let spec = if flavor == 2 then 16384 else 0
        fir.text(mut out, "movq ${spec}, %rdx\n")
        if flavor == 3 { fir.text(mut out, "call __wolf_rt_strbuf_bool\n") }
        else if flavor == 4 { fir.text(mut out, "call __wolf_rt_strbuf_char\n") }
        else { fir.text(mut out, "call __wolf_rt_strbuf_i64\n") }
        fir.text(mut out, "movq -16(%rbp), %rdi\nleaq {dest}(%rbp), %rsi\ncall __wolf_rt_strbuf_finish\n")
        return
    }
    let length = slots.offsets[value] + 8
    if op == 0 {
        fir.text(mut out, "movq {length}(%rbp), %rax\n")
        save(mut out, dest, "rax")
        return
    }
    if op == 3 {
        load(mut out, slots, ins.uses[1], "rcx")
        // An unsigned comparison rejects negative indices as well.
        fir.text(mut out, "cmpq {length}(%rbp), %rcx\njb {label}_byte\n")
        if ins.data[1] == 0 { trap(mut out, m, ins.site, 3) }
        else { absent(mut out, m, ins, dest); fir.text(mut out, "jmp {label}_byte_done\n") }
        fir.text(mut out, "{label}_byte:\n")
        load(mut out, slots, value, "rax")
        fir.text(mut out, "addq %rcx, %rax\nmovzbq (%rax), %rax\n")
        save(mut out, if ins.data[1] == 0 then dest else dest + 8, "rax")
        if ins.data[1] == 1 { fir.text(mut out, "movq $0, %rax\n"); save(mut out, dest, "rax") }
        fir.text(mut out, "{label}_byte_done:\n")
        return
    }
    load(mut out, slots, value, "rdi")
    fir.text(mut out, "movq {length}(%rbp), %rsi\n")
    load(mut out, slots, ins.uses[1], "rdx")
    load(mut out, slots, ins.uses[2], "rcx")
    let payload = if op == 1 then dest else dest + 8
    fir.text(mut out, "leaq {payload}(%rbp), %r8\ncall __wolf_rt_str_get\n")
    if op == 1 {
        fir.text(mut out, "cmpq $0, %rax\njne {label}_slice\n")
        trap(mut out, m, ins.site, 3)
        fir.text(mut out, "{label}_slice:\n")
    } else { option(mut out, m, ins, dest, label) }
}
