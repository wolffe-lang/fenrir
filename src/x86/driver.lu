//! member: true

use fir

/// Compile verified FIR to assembly, with refusal status 2 and ICE 70.
pub fn assemble(path: str, output: str) -> int {
    let bs = fs_read_bytes(path) else |_| { eprint("fenrir: cannot read {path}"); return 2 }
    let source = str_from_utf8(bs) else |_| { eprint("fenrir: FIR_SYNTAX input is not UTF-8"); return 2 }
    let m = fir.parse(source) else |e| match e { Bad(message) => { eprint("fenrir: {message}"); return 2 } }
    let rendered = emit(m) else |e| match e { Bad(message) => { eprint("fenrir: {message}"); return 70 } }
    fs_write_bytes(output, rendered.bytes()) else |_| { eprint("fenrir: cannot write {output}"); return 2 }
    0
}

/// Parse and normalize FIR, preserving the destination on refusal.
pub fn canonical(path: str, output: str) -> int {
    let bs = fs_read_bytes(path) else |_| { eprint("fenrir: cannot read {path}"); return 2 }
    let source = str_from_utf8(bs) else |_| { eprint("fenrir: FIR_SYNTAX input is not UTF-8"); return 2 }
    let m = fir.parse(source) else |e| match e { Bad(message) => { eprint("fenrir: {message}"); return 2 } }
    let rendered = fir.format(m) else |e| match e { Bad(message) => { eprint("fenrir: {message}"); return 70 } }
    fs_write_bytes(output, rendered.bytes()) else |_| { eprint("fenrir: cannot write {output}"); return 2 }
    0
}
