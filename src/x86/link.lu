//! member: true

// A tool's standard output goes to a staging file ([os.proc.fds]) and reaches
// fenrir's standard error only when the tool fails, so a successful build
// prints nothing and `fenrir run`'s streams carry only the program's bytes.
fn invoke(directory: str, argv: List[str]) -> bool {
    let log = "{directory}/tool.out"
    let fd = fs_create(log) else |_| { eprint("fenrir: FIR_LINK cannot create the staged tool output"); return false }
    defer fs_close(fd) else |_| {}
    let child = os_spawn_fds(argv[0], argv[1..], [1, fd]) else |_| { eprint("fenrir: FIR_LINK cannot start selected tool"); return false }
    let status = os_wait_status(child) else |_| { eprint("fenrir: FIR_LINK cannot reap selected tool"); return false }
    if status != 0 {
        let said = fs_read_text(log) else |_| { "" }
        if said.len > 0 { eprint_raw(said) }
        eprint("fenrir: FIR_LINK selected tool failed with status {status}")
        return false
    }
    true
}

fn cleanup(directory: str) {
    fs_remove("{directory}/tool.out") else |_| {}
    fs_remove("{directory}/program.s") else |_| {}
    fs_remove("{directory}/program.o") else |_| {}
    fs_remove("{directory}/program") else |_| {}
    fs_remove_dir(directory) else |_| {}
}

fn nonempty(path: str) -> bool {
    let n = fs_size(path) else |_| { return false }
    n > 0
}

fn elf_header(path: str) -> bool {
    let fd = fs_open(path) else |_| { return false }
    defer fs_close(fd) else |_| {}
    let h = fs_read_chunk(fd, 64) else |_| { return false }
    if h.len != 64 { return false }
    if h[0] != 127 as byte || h[1] != 69 as byte || h[2] != 76 as byte || h[3] != 70 as byte { return false }
    if h[4] != 2 as byte || h[5] != 1 as byte || h[6] != 1 as byte { return false }
    if h[16] != 2 as byte || h[17] != 0 as byte || h[18] != 62 as byte || h[19] != 0 as byte { return false }
    var entry: int = 0
    var i: int = 24
    while i < 32 { entry += h[i] as int; i += 1 }
    entry != 0
}

fn toolchain() -> str ! {Bad(str)} {
    let root = env_get("FENRIR_TOOLCHAIN") else |e| match e {
        missing => ".wolf-bin",
        utf8 => { return Bad("fenrir: FIR_LINK toolchain path is not UTF-8") },
    }
    if root.len == 0 { return Bad("fenrir: FIR_LINK empty toolchain path") }
    root
}

/// Link FIR through staged clef and ligature. Never fall back to another tool.
pub fn link(args: List[str]) -> int {
    if args.len != 3 || args[1] != "-o" || args[0].len == 0 || args[2].len == 0 || args[0] == args[2] {
        eprint("fenrir: FIR_LINK usage: fenrir link FILE.fir -o OUTPUT")
        return 2
    }
    let root = toolchain() else |e| match e { Bad(message) => { eprint(message); return 2 } }
    let output = args[2]
    let directory = "{output}.fenrir-build"
    fs_create_dir(directory) else |_| { eprint("fenrir: FIR_LINK cannot exclusively create staging directory"); return 2 }
    defer cleanup(directory)
    let status = assemble(args[0], "{directory}/program.s")
    if status != 0 { return status }
    finish(root, directory, output)
}

/// Link assembly that fenrir emitted from source: the same exclusive staging,
/// tools, checks and publication as `link`, and the same preserved output.
pub fn link_assembly(rendered: str, output: str) -> int {
    if output.len == 0 { eprint("fenrir: FIR_LINK empty output path"); return 2 }
    let root = toolchain() else |e| match e { Bad(message) => { eprint(message); return 2 } }
    let directory = "{output}.fenrir-build"
    fs_create_dir(directory) else |_| { eprint("fenrir: FIR_LINK cannot exclusively create staging directory"); return 2 }
    defer cleanup(directory)
    fs_write_bytes("{directory}/program.s", rendered.bytes()) else |_| { eprint("fenrir: FIR_LINK cannot write staged assembly"); return 2 }
    finish(root, directory, output)
}

fn finish(root: str, directory: str, output: str) -> int {
    let assembly = "{directory}/program.s"
    let object = "{directory}/program.o"
    let candidate = "{directory}/program"
    if !invoke(directory, ["{root}/bin/clef", "--64", "-o", object, assembly]) { return 2 }
    if !nonempty(object) { eprint("fenrir: FIR_LINK assembler produced no object"); return 2 }
    env_set("LIGATURE_SYSROOT", "{root}/bundle/sysroot") else |_| { eprint("fenrir: FIR_LINK invalid sysroot path"); return 2 }
    if !invoke(directory, ["{root}/bin/ligature", "-o", candidate, object, "{root}/musl/libwolf_rt.a", "-lpthread", "-ldl", "-lm", "-Wl,--gc-sections"]) { return 2 }
    if !elf_header(candidate) { eprint("fenrir: FIR_LINK linker produced no static x86-64 ELF"); return 2 }
    // Ligature verifies segment coverage, entry placement and provenance, beyond
    // the independently checked ELF class/machine/type header above.
    if !invoke(directory, ["{root}/bin/ligature", "verify", candidate]) { return 2 }
    fs_rename(candidate, output) else |_| { eprint("fenrir: FIR_LINK cannot publish linked output"); return 2 }
    0
}
