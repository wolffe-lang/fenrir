//! member: true

use fir
use sem

// Checked arithmetic in the operand kind's width and signedness, from `sem`.
// Each width keeps its canonical word: i32 sign-extended, u8 zero-extended.
fn arithmetic(mut out: List[byte], m: fir.Module, slots: Slots, ins: fir.Inst, dest: int, label: str) {
    let kind = fir.kind(ins.ty)
    load(mut out, slots, ins.uses[0], "rax")
    load(mut out, slots, ins.uses[1], "rcx")
    if sem.division(ins.op) {
        fir.text(mut out, "cmpq $0, %rcx\njne {label}_nonzero\n")
        trap(mut out, m, ins.site, 2)
        fir.text(mut out, "{label}_nonzero:\n")
        if sem.signed(kind) {
            // Operands are sign-extended, so the 64-bit divide is exact once the
            // kind's own MIN / -1 is excluded.
            let low = sem.minimum(kind)
            fir.text(mut out, "movabsq ${low}, %r10\ncmpq %r10, %rax\njne {label}_divide\ncmpq $-1, %rcx\njne {label}_divide\n")
            trap(mut out, m, ins.site, 1)
            fir.text(mut out, "{label}_divide:\ncqto\nidivq %rcx\n")
        } else {
            fir.text(mut out, "movq $0, %rdx\ndivq %rcx\n")
        }
        if ins.op == "rem" { save(mut out, dest, "rdx") } else { save(mut out, dest, "rax") }
        return
    }
    let width = sem.width(kind)
    if width == 64 && sem.signed(kind) {
        fir.text(mut out, "{sem.mnemonic(ins.op)} %rcx, %rax\njno {label}_ok\n")
    } else if width == 64 {
        // Unsigned: carry (add, sub) or a nonzero high product (mul) is overflow.
        if ins.op == "mul" { fir.text(mut out, "mulq %rcx\njno {label}_ok\n") }
        else { fir.text(mut out, "{sem.mnemonic(ins.op)} %rcx, %rax\njnc {label}_ok\n") }
    } else if width == 32 {
        fir.text(mut out, "{signed32(ins.op)} %ecx, %eax\njno {label}_ok\n")
    } else {
        if ins.op == "mul" { fir.text(mut out, "mulb %cl\njno {label}_ok\n") }
        else { fir.text(mut out, "{unsigned8(ins.op)} %cl, %al\njnc {label}_ok\n") }
    }
    trap(mut out, m, ins.site, 1)
    fir.text(mut out, "{label}_ok:\n")
    if width == 32 { fir.text(mut out, "movslq %eax, %rax\n") }
    if width == 8 { fir.text(mut out, "movzbq %al, %rax\n") }
    save(mut out, dest, "rax")
}

fn signed32(op: str) -> str {
    if op == "add" { return "addl" }
    if op == "sub" { return "subl" }
    "imull"
}

fn unsigned8(op: str) -> str {
    if op == "add" { return "addb" }
    "subb"
}

// Compare two loaded operands: str through the runtime, every other kind as a
// canonical word, unsigned kinds unsigned.
fn compare(mut out: List[byte], slots: Slots, ins: fir.Inst, dest: int) {
    let a = ins.uses[0]
    let b = ins.uses[1]
    let ty = slots.types[a]
    if ty == 3 {
        let al = slots.offsets[a] + 8
        let bl = slots.offsets[b] + 8
        load(mut out, slots, a, "rdi")
        fir.text(mut out, "movq {al}(%rbp), %rsi\n")
        load(mut out, slots, b, "rdx")
        fir.text(mut out, "movq {bl}(%rbp), %rcx\n")
        if ins.op == "eq" { fir.text(mut out, "call __wolf_rt_str_eq\ncmpq $0, %rax\nsetne %al\n") }
        else { fir.text(mut out, "call __wolf_rt_str_cmp\ncmpq $0, %rax\nsetl %al\n") }
    } else {
        load(mut out, slots, a, "rax"); load(mut out, slots, b, "rcx")
        fir.text(mut out, "cmpq %rcx, %rax\n")
        if ins.op == "eq" { fir.text(mut out, "sete %al\n") }
        else if sem.signed(fir.kind(ty)) { fir.text(mut out, "setl %al\n") }
        else { fir.text(mut out, "setb %al\n") }
    }
    fir.text(mut out, "movzbq %al, %rax\n"); save(mut out, dest, "rax")
}

// One runtime string buffer renders every part in order.
fn render(mut out: List[byte], slots: Slots, ins: fir.Inst, dest: int) {
    fir.text(mut out, "call __wolf_rt_strbuf_new\nmovq %rax, -16(%rbp)\n")
    for v in ins.uses {
        let ty = slots.types[v]
        let at = slots.offsets[v]
        fir.text(mut out, "movq -16(%rbp), %rdi\nmovq {at}(%rbp), %rsi\n")
        if ty == 3 {
            let len = at + 8
            fir.text(mut out, "movq {len}(%rbp), %rdx\nmovq $0, %rcx\ncall __wolf_rt_strbuf_str\n")
        } else if ty == 2 {
            fir.text(mut out, "movq $0, %rdx\ncall __wolf_rt_strbuf_bool\n")
        } else {
            let spec = sem.render_spec(fir.kind(ty))
            fir.text(mut out, "movq ${spec}, %rdx\ncall __wolf_rt_strbuf_i64\n")
        }
    }
    fir.text(mut out, "movq -16(%rbp), %rdi\nleaq {dest}(%rbp), %rsi\ncall __wolf_rt_strbuf_finish\n")
}

// The option after a runtime read that answered 1 (the element is written
// after the tag word) or 0: tag 0, or tag 1 and zero padding.
fn option(mut out: List[byte], m: fir.Module, ins: fir.Inst, dest: int, label: str) {
    fir.text(mut out, "cmpq $0, %rax\nje {label}_none\nmovabsq $0, %rax\n"); save(mut out, dest, "rax")
    fir.text(mut out, "jmp {label}_done\n{label}_none:\n")
    absent(mut out, m, ins, dest)
    fir.text(mut out, "{label}_done:\n")
}

// The empty variant: tag 1, then canonical zero padding.
fn absent(mut out: List[byte], m: fir.Module, ins: fir.Inst, dest: int) {
    fir.text(mut out, "movabsq $1, %rax\n"); save(mut out, dest, "rax")
    fir.text(mut out, "movabsq $0, %rax\n")
    var k: int = 1
    while k < fir.words(m, ins.ty) { save(mut out, dest + k * 8, "rax"); k += 1 }
}

fn emit_instruction(mut out: List[byte], m: fir.Module, frame: Frame, function: int, block: int, index: int, ins: fir.Inst, slots: Slots, params: int) {
    let dest = slots.offsets[params + index]
    let label = ".Lf{function}_b{block}_i{index}"
    let op = ins.op
    if op == "const" {
        let n = ins.data[0]
        fir.text(mut out, "movabsq ${n}, %rax\n"); save(mut out, dest, "rax")
    } else if op == "string" {
        let blob = ins.data[0]
        let n = m.blobs[blob].len
        fir.text(mut out, "leaq .Lblob{blob}(%rip), %rax\n"); save(mut out, dest, "rax")
        fir.text(mut out, "movq ${n}, %rax\n"); save(mut out, dest + 8, "rax")
    } else if sem.arithmetic(op) {
        arithmetic(mut out, m, slots, ins, dest, label)
    } else if op == "eq" || op == "lt" {
        compare(mut out, slots, ins, dest)
    } else if op == "not" {
        load(mut out, slots, ins.uses[0], "rax")
        if ins.ty == 2 { fir.text(mut out, "xorq $1, %rax\n") }
        else {
            // The complement of a canonical word is canonical except for u8,
            // whose upper bits are cleared again.
            fir.text(mut out, "notq %rax\n")
            if sem.width(fir.kind(ins.ty)) == 8 { fir.text(mut out, "movzbq %al, %rax\n") }
        }
        save(mut out, dest, "rax")
    } else if op == "struct" {
        var at = dest
        for v in ins.uses {
            let w = fir.words(m, slots.types[v])
            copy_words(mut out, slots.offsets[v], at, w)
            at += w * 8
        }
    } else if op == "enum" {
        // The tag, the active payload, then canonical zero padding.
        let tag = ins.data[0]
        fir.text(mut out, "movabsq ${tag}, %rax\n"); save(mut out, dest, "rax")
        let v = ins.uses[0]
        let w = fir.words(m, slots.types[v])
        copy_words(mut out, slots.offsets[v], dest + 8, w)
        var k = 1 + w
        if k < fir.words(m, ins.ty) { fir.text(mut out, "movabsq $0, %rax\n") }
        while k < fir.words(m, ins.ty) { save(mut out, dest + k * 8, "rax"); k += 1 }
    } else if op == "field" {
        let v = ins.uses[0]
        let at = slots.offsets[v] + m.shapes[slots.types[v] - fir.first_struct()].offsets[ins.data[0]] * 8
        copy_words(mut out, at, dest, fir.words(m, ins.ty))
    } else if op == "load" || op == "store" {
        // The verifier resolved this path; a failure here cannot occur.
        let at = fir.place(m, frame.slot_types[ins.data[0]], ins.data, 1) else |_| { return }
        let offset = frame.slots[ins.data[0]] + at.offset * 8
        if op == "load" { copy_words(mut out, offset, dest, fir.words(m, at.ty)) }
        else { copy_words(mut out, slots.offsets[ins.uses[0]], offset, fir.words(m, at.ty)) }
    } else if op == "call" {
        stage(mut out, m, slots, ins, 0, ins.uses.len, frame.scratch)
        let callee = ins.data[0]
        fir.text(mut out, "leaq {dest}(%rbp), %rdi\nleaq {frame.scratch}(%rbp), %rsi\ncall __fenrir_f{callee}\n")
    } else if op == "concat" {
        fir.text(mut out, "call __wolf_rt_strbuf_new\nmovq %rax, -16(%rbp)\n")
        for v in ins.uses {
            let at = slots.offsets[v]
            let len = at + 8
            fir.text(mut out, "movq -16(%rbp), %rdi\nmovq {at}(%rbp), %rsi\nmovq {len}(%rbp), %rdx\nmovq $0, %rcx\ncall __wolf_rt_strbuf_str\n")
        }
        fir.text(mut out, "movq -16(%rbp), %rdi\nleaq {dest}(%rbp), %rsi\ncall __wolf_rt_strbuf_finish\n")
    } else if op == "format" {
        render(mut out, slots, ins, dest)
    } else if op == "list" {
        // Elements are their words, flat: a str is its {pointer, length} pair.
        let size = fir.words(m, fir.list_element(m, ins.ty)) * 8
        fir.text(mut out, "movq ${size}, %rdi\ncall __wolf_rt_list_new\n"); save(mut out, dest, "rax")
    } else if op == "push" {
        load(mut out, slots, ins.uses[0], "rdi"); address(mut out, slots, ins.uses[1], "rsi")
        fir.text(mut out, "call __wolf_rt_list_push\n")
    } else if op == "get" {
        load(mut out, slots, ins.uses[0], "rdi"); load(mut out, slots, ins.uses[1], "rsi")
        fir.text(mut out, "leaq {dest}(%rbp), %rdx\ncall __wolf_rt_list_read\ncmpq $0, %rax\njne {label}_ok\n")
        trap(mut out, m, ins.site, 3)
        fir.text(mut out, "{label}_ok:\n")
    } else if op == "set" {
        load(mut out, slots, ins.uses[0], "rdi"); load(mut out, slots, ins.uses[1], "rsi"); address(mut out, slots, ins.uses[2], "rdx")
        fir.text(mut out, "call __wolf_rt_list_write\ncmpq $0, %rax\njne {label}_ok\n")
        trap(mut out, m, ins.site, 3)
        fir.text(mut out, "{label}_ok:\n")
    } else if op == "read" || op == "pop" {
        // The runtime writes the element after the option's tag word on a hit.
        let payload = dest + 8
        load(mut out, slots, ins.uses[0], "rdi")
        if op == "read" {
            load(mut out, slots, ins.uses[1], "rsi")
            fir.text(mut out, "leaq {payload}(%rbp), %rdx\ncall __wolf_rt_list_read\n")
        } else {
            fir.text(mut out, "leaq {payload}(%rbp), %rsi\ncall __wolf_rt_list_pop\n")
        }
        option(mut out, m, ins, dest, label)
    } else if op == "slice" {
        // 0 <= lo <= hi <= len as two unsigned compares, then one runtime copy.
        load(mut out, slots, ins.uses[0], "rdi")
        fir.text(mut out, "call __wolf_rt_list_len\n")
        load(mut out, slots, ins.uses[1], "rcx"); load(mut out, slots, ins.uses[2], "rdx")
        fir.text(mut out, "cmpq %rax, %rdx\nja {label}_bounds\ncmpq %rdx, %rcx\nja {label}_bounds\n")
        load(mut out, slots, ins.uses[0], "rdi"); load(mut out, slots, ins.uses[1], "rsi"); load(mut out, slots, ins.uses[2], "rdx")
        fir.text(mut out, "call __wolf_rt_list_slice\n"); save(mut out, dest, "rax")
        fir.text(mut out, "jmp {label}_ok\n{label}_bounds:\n")
        trap(mut out, m, ins.site, 3)
        fir.text(mut out, "{label}_ok:\n")
    } else if op == "len" {
        // A map's header begins with a list header, so its length is the
        // list header's (the runtime's map documentation).
        load(mut out, slots, ins.uses[0], "rdi")
        fir.text(mut out, "call __wolf_rt_list_len\n"); save(mut out, dest, "rax")
    } else if op == "clear" {
        load(mut out, slots, ins.uses[0], "rdi")
        if fir.is_map(m, slots.types[ins.uses[0]]) { fir.text(mut out, "call __wolf_rt_map_clear\n") }
        else { fir.text(mut out, "call __wolf_rt_list_clear\n") }
    } else if op == "map" {
        let key = fir.map_key(m, ins.ty)
        let kind = if key == 3 then 1 else 0
        let kb = fir.words(m, key) * 8
        let vb = fir.words(m, fir.map_value(m, ins.ty)) * 8
        let stride = kb + vb
        fir.text(mut out, "movq ${kind}, %rdi\nmovq ${kb}, %rsi\nmovq ${kb}, %rdx\nmovq ${vb}, %rcx\nmovq ${stride}, %r8\n")
        fir.text(mut out, "call __wolf_rt_map_new\n"); save(mut out, dest, "rax")
    } else if op == "insert" || op == "lookup" || op == "remove" {
        // One entry in the scratch area: the key, then (for insert) the value.
        let mt = slots.types[ins.uses[0]]
        let kw = fir.words(m, fir.map_key(m, mt))
        let vw = fir.words(m, fir.map_value(m, mt))
        copy_words(mut out, slots.offsets[ins.uses[1]], frame.scratch, kw)
        if op == "insert" { copy_words(mut out, slots.offsets[ins.uses[2]], frame.scratch + kw * 8, vw) }
        load(mut out, slots, ins.uses[0], "rdi")
        fir.text(mut out, "leaq {frame.scratch}(%rbp), %rsi\n")
        if op == "insert" { fir.text(mut out, "call __wolf_rt_map_set\n") }
        else {
            fir.text(mut out, if op == "lookup" then "call __wolf_rt_map_get\n" else "call __wolf_rt_map_remove\n")
            fir.text(mut out, "cmpq $0, %rax\nje {label}_none\n")
            copy_words(mut out, frame.scratch + kw * 8, dest + 8, vw)
            fir.text(mut out, "movabsq $0, %rax\n"); save(mut out, dest, "rax")
            fir.text(mut out, "jmp {label}_done\n{label}_none:\n")
            absent(mut out, m, ins, dest)
            fir.text(mut out, "{label}_done:\n")
        }
    } else if op == "pairs" {
        load(mut out, slots, ins.uses[0], "rdi")
        fir.text(mut out, "call __wolf_rt_map_pairs\n"); save(mut out, dest, "rax")
    } else if op == "print" {
        let v = ins.uses[0]
        load(mut out, slots, v, "rdi")
        if slots.types[v] == 1 { fir.text(mut out, "call __wolf_rt_print_i64\n") }
        else if slots.types[v] == 2 { fir.text(mut out, "call __wolf_rt_print_bool\n") }
        else {
            let len = slots.offsets[v] + 8
            fir.text(mut out, "movq {len}(%rbp), %rsi\ncall __wolf_rt_print_str\n")
        }
        fir.text(mut out, "leaq .Lnewline(%rip), %rdi\nmovq $1, %rsi\ncall __wolf_rt_print_str\n")
    } else if op == "jump" {
        branch_edge(mut out, m, frame, block, ins, 0, ins.uses.len, ins.data[0], function)
    } else if op == "branch" {
        load(mut out, slots, ins.uses[0], "rax")
        fir.text(mut out, "cmpq $0, %rax\nje {label}_false\n")
        let n = ins.data[2]
        branch_edge(mut out, m, frame, block, ins, 1, n, ins.data[0], function)
        fir.text(mut out, "{label}_false:\n")
        branch_edge(mut out, m, frame, block, ins, 1 + n, ins.uses.len - 1 - n, ins.data[1], function)
    } else if op == "case" {
        // Compare the tag first; only the matched edge copies payload words.
        let tag = ins.data[0]
        let n = ins.data[3]
        load(mut out, slots, ins.uses[0], "rax")
        fir.text(mut out, "movabsq ${tag}, %rcx\ncmpq %rcx, %rax\njne {label}_no\n")
        case_edge(mut out, m, frame, block, ins, function)
        fir.text(mut out, "{label}_no:\n")
        branch_edge(mut out, m, frame, block, ins, 1 + n, ins.uses.len - 1 - n, ins.data[2], function)
    } else if op == "return" {
        if ins.uses.len != 0 {
            let v = ins.uses[0]
            fir.text(mut out, "movq -8(%rbp), %rdi\n")
            var k: int = 0
            while k < fir.words(m, slots.types[v]) {
                let off = slots.offsets[v] + k * 8
                let to = k * 8
                fir.text(mut out, "movq {off}(%rbp), %rax\nmovq %rax, {to}(%rdi)\n")
                k += 1
            }
        }
        fir.text(mut out, "movq %rbp, %rsp\npopq %rbp\nret\n")
    } else if op == "trap" { trap(mut out, m, ins.site, ins.data[0]) }
}

/// Verify and emit deterministic SysV x86-64 assembly; Bad is an invariant failure.
pub fn emit(m: fir.Module) -> str ! {Bad(str)} {
    fir.verify(m)?
    var out = List[byte]()
    fir.text(mut out, ".text\n.globl main\n.type main, @function\nmain:\npushq %rbp\nmovq %rsp, %rbp\nsubq $16, %rsp\ncall __wolf_rt_main_start\nleaq -8(%rbp), %rdi\nleaq -16(%rbp), %rsi\ncall __fenrir_f0\nmovl -8(%rbp), %eax\nmovq %rbp, %rsp\npopq %rbp\nret\n.size main, .-main\n")
    var fid: int = 0
    for f in m.functions {
        let frame = allocate(m, f)?
        fir.text(mut out, ".globl __fenrir_f{fid}\n.type __fenrir_f{fid}, @function\n__fenrir_f{fid}:\npushq %rbp\nmovq %rsp, %rbp\nsubq ${frame.size}, %rsp\nmovq %rdi, -8(%rbp)\n")
        var at: int = 0
        var p: int = 0
        for ty in f.params {
            var k: int = 0
            while k < fir.words(m, ty) {
                let dest = frame.blocks[0].offsets[p] + k * 8
                fir.text(mut out, "movq {at}(%rsi), %rax\nmovq %rax, {dest}(%rbp)\n")
                at += 8; k += 1
            }
            p += 1
        }
        var bid: int = 0
        for b in f.blocks {
            fir.text(mut out, ".Lf{fid}_b{bid}:\n")
            var i: int = 0
            while i < b.code.len { emit_instruction(mut out, m, frame, fid, bid, i, b.code[i], frame.blocks[bid], b.params.len); i += 1 }
            bid += 1
        }
        fir.text(mut out, ".size __fenrir_f{fid}, .-__fenrir_f{fid}\n")
        fid += 1
    }
    fir.text(mut out, ".section .rodata\n.Lnewline:\n.byte 10\n")
    var blob: int = 0
    for s in m.blobs {
        fir.text(mut out, ".Lblob{blob}:\n")
        for b in s.bytes() { let n = b as int; fir.text(mut out, ".byte {n}\n") }
        blob += 1
    }
    fir.text(mut out, ".section .note.GNU-stack,\"\",@progbits\n")
    fir.finish(out)
}
