//! member: true

use fir
use sem

fn arithmetic(mut out: List[byte], m: fir.Module, slots: Slots, ins: fir.Inst, dest: int, label: str) {
    load(mut out, slots, ins.uses[0], "rax")
    load(mut out, slots, ins.uses[1], "rcx")
    if sem.division(ins.op) {
        fir.text(mut out, "cmpq $0, %rcx\njne {label}_nonzero\n")
        trap(mut out, m, ins.site, 2)
        fir.text(mut out, "{label}_nonzero:\nmovabsq $-9223372036854775808, %r10\ncmpq %r10, %rax\njne {label}_divide\ncmpq $-1, %rcx\njne {label}_divide\n")
        trap(mut out, m, ins.site, 1)
        fir.text(mut out, "{label}_divide:\nmovq %rax, %r11\nmovq %rax, %r10\nxorq %rcx, %r10\ntestq %rax, %rax\njns {label}_apos\nnegq %rax\n{label}_apos:\ntestq %rcx, %rcx\njns {label}_bpos\nnegq %rcx\n{label}_bpos:\nxorq %rdx, %rdx\ndivq %rcx\n")
        if ins.op == "rem" {
            fir.text(mut out, "testq %r11, %r11\njns {label}_signed\nnegq %rdx\n{label}_signed:\n")
        } else {
            fir.text(mut out, "testq %r10, %r10\njns {label}_signed\nnegq %rax\n{label}_signed:\n")
        }
        if ins.op == "rem" { save(mut out, dest, "rdx") } else { save(mut out, dest, "rax") }
    } else if ins.op == "mul" {
        // Unsigned magnitudes, bounded by the signed result's exact magnitude.
        fir.text(mut out, "movq %rax, %r11\nxorq %rcx, %r11\nmovabsq $9223372036854775807, %r10\ntestq %r11, %r11\njns {label}_limit\nmovabsq $-9223372036854775808, %r10\n{label}_limit:\ntestq %rax, %rax\njns {label}_apos\nnegq %rax\n{label}_apos:\ntestq %rcx, %rcx\njns {label}_bpos\nnegq %rcx\n{label}_bpos:\nxorq %rdx, %rdx\n{label}_loop:\ntestq %rcx, %rcx\nje {label}_done\ntestq $1, %rcx\nje {label}_shift\nmovq %r10, %r8\nsubq %rdx, %r8\ncmpq %r8, %rax\nja {label}_overflow\naddq %rax, %rdx\n{label}_shift:\nshrq $1, %rcx\nje {label}_done\nmovq %r10, %r8\nshrq $1, %r8\ncmpq %r8, %rax\nja {label}_overflow\nshlq $1, %rax\njmp {label}_loop\n{label}_overflow:\n")
        trap(mut out, m, ins.site, 1)
        fir.text(mut out, "{label}_done:\nmovq %rdx, %rax\ntestq %r11, %r11\njns {label}_signed\nnegq %rax\n{label}_signed:\n")
        save(mut out, dest, "rax")
    } else {
        let mnemonic = sem.mnemonic(ins.op)
        fir.text(mut out, "{mnemonic} %rcx, %rax\npushfq\npopq %r10\ntestq $2048, %r10\nje {label}_ok\n")
        trap(mut out, m, ins.site, 1)
        fir.text(mut out, "{label}_ok:\n")
        save(mut out, dest, "rax")
    }
}

fn emit_instruction(mut out: List[byte], m: fir.Module, frame: Frame, function: int, block: int, index: int, ins: fir.Inst, slots: Slots, params: int) {
    let dest = slots.offsets[params + index]
    let label = ".Lf{function}_b{block}_i{index}"
    let op = ins.op
    if op == "const" {
        let n = ins.data[0]
        fir.text(mut out, "movabsq ${n}, %rax\n"); save(mut out, dest, "rax")
    } else if op == "string" {
        let blob = ins.data[0]
        let n = m.blobs[blob].len
        fir.text(mut out, "leaq .Lblob{blob}(%rip), %rax\n"); save(mut out, dest, "rax")
        fir.text(mut out, "movq ${n}, %rax\n"); save(mut out, dest + 8, "rax")
    } else if sem.arithmetic(op) {
        arithmetic(mut out, m, slots, ins, dest, label)
    } else if op == "eq" || op == "lt" {
        load(mut out, slots, ins.uses[0], "rax"); load(mut out, slots, ins.uses[1], "rcx")
        fir.text(mut out, "movq $0, %r10\ncmpq %rax, %rcx\n")
        if op == "eq" { fir.text(mut out, "jne {label}_cmp\n") } else { fir.text(mut out, "jle {label}_cmp\n") }
        fir.text(mut out, "movq $1, %r10\n{label}_cmp:\n"); save(mut out, dest, "r10")
    } else if op == "not" {
        load(mut out, slots, ins.uses[0], "rax")
        fir.text(mut out, "xorq $1, %rax\n"); save(mut out, dest, "rax")
    } else if op == "struct" {
        var at = dest
        for v in ins.uses {
            let w = fir.words(m, slots.types[v])
            copy_words(mut out, slots.offsets[v], at, w)
            at += w * 8
        }
    } else if op == "field" {
        let v = ins.uses[0]
        let at = slots.offsets[v] + m.shapes[slots.types[v] - 5].offsets[ins.data[0]] * 8
        copy_words(mut out, at, dest, fir.words(m, ins.ty))
    } else if op == "call" {
        stage(mut out, m, slots, ins, 0, ins.uses.len, frame.scratch)
        let callee = ins.data[0]
        fir.text(mut out, "leaq {dest}(%rbp), %rdi\nleaq {frame.scratch}(%rbp), %rsi\ncall __fenrir_f{callee}\n")
    } else if op == "concat" {
        fir.text(mut out, "call __wolf_rt_strbuf_new\nmovq %rax, -16(%rbp)\n")
        for v in ins.uses {
            let at = slots.offsets[v]
            let len = at + 8
            fir.text(mut out, "movq -16(%rbp), %rdi\nmovq {at}(%rbp), %rsi\nmovq {len}(%rbp), %rdx\nmovq $0, %rcx\ncall __wolf_rt_strbuf_str\n")
        }
        fir.text(mut out, "movq -16(%rbp), %rdi\nleaq {dest}(%rbp), %rsi\ncall __wolf_rt_strbuf_finish\n")
    } else if op == "list" {
        fir.text(mut out, "movq $8, %rdi\ncall __wolf_rt_list_new\n"); save(mut out, dest, "rax")
    } else if op == "push" {
        load(mut out, slots, ins.uses[0], "rdi"); address(mut out, slots, ins.uses[1], "rsi")
        fir.text(mut out, "call __wolf_rt_list_push\n")
    } else if op == "get" {
        load(mut out, slots, ins.uses[0], "rdi"); load(mut out, slots, ins.uses[1], "rsi")
        fir.text(mut out, "leaq {dest}(%rbp), %rdx\ncall __wolf_rt_list_read\ncmpq $0, %rax\njne {label}_ok\n")
        trap(mut out, m, ins.site, 3)
        fir.text(mut out, "{label}_ok:\n")
    } else if op == "len" {
        load(mut out, slots, ins.uses[0], "rdi")
        fir.text(mut out, "call __wolf_rt_list_len\n"); save(mut out, dest, "rax")
    } else if op == "print" {
        let v = ins.uses[0]
        load(mut out, slots, v, "rdi")
        if slots.types[v] == 1 { fir.text(mut out, "call __wolf_rt_print_i64\n") }
        else if slots.types[v] == 2 { fir.text(mut out, "call __wolf_rt_print_bool\n") }
        else {
            let len = slots.offsets[v] + 8
            fir.text(mut out, "movq {len}(%rbp), %rsi\ncall __wolf_rt_print_str\n")
        }
        fir.text(mut out, "leaq .Lnewline(%rip), %rdi\nmovq $1, %rsi\ncall __wolf_rt_print_str\n")
    } else if op == "jump" {
        branch_edge(mut out, m, frame, block, ins, 0, ins.uses.len, ins.data[0], function)
    } else if op == "branch" {
        load(mut out, slots, ins.uses[0], "rax")
        fir.text(mut out, "cmpq $0, %rax\nje {label}_false\n")
        let n = ins.data[2]
        branch_edge(mut out, m, frame, block, ins, 1, n, ins.data[0], function)
        fir.text(mut out, "{label}_false:\n")
        branch_edge(mut out, m, frame, block, ins, 1 + n, ins.uses.len - 1 - n, ins.data[1], function)
    } else if op == "return" {
        if ins.uses.len != 0 {
            let v = ins.uses[0]
            fir.text(mut out, "movq -8(%rbp), %rdi\n")
            var k: int = 0
            while k < fir.words(m, slots.types[v]) {
                let off = slots.offsets[v] + k * 8
                let to = k * 8
                fir.text(mut out, "movq {off}(%rbp), %rax\nmovq %rax, {to}(%rdi)\n")
                k += 1
            }
        }
        fir.text(mut out, "movq %rbp, %rsp\npopq %rbp\nret\n")
    } else if op == "trap" { trap(mut out, m, ins.site, ins.data[0]) }
}

/// Verify and emit deterministic SysV x86-64 assembly; Bad is an invariant failure.
pub fn emit(m: fir.Module) -> str ! {Bad(str)} {
    fir.verify(m)?
    var out = List[byte]()
    fir.text(mut out, ".text\n.globl main\n.type main, @function\nmain:\npushq %rbp\nmovq %rsp, %rbp\nsubq $16, %rsp\ncall __wolf_rt_main_start\nleaq -8(%rbp), %rdi\nleaq -16(%rbp), %rsi\ncall __fenrir_f0\nmovl -8(%rbp), %eax\nmovq %rbp, %rsp\npopq %rbp\nret\n.size main, .-main\n")
    var fid: int = 0
    for f in m.functions {
        let frame = allocate(m, f)?
        fir.text(mut out, ".globl __fenrir_f{fid}\n.type __fenrir_f{fid}, @function\n__fenrir_f{fid}:\npushq %rbp\nmovq %rsp, %rbp\nsubq ${frame.size}, %rsp\nmovq %rdi, -8(%rbp)\n")
        var at: int = 0
        var p: int = 0
        for ty in f.params {
            var k: int = 0
            while k < fir.words(m, ty) {
                let dest = frame.blocks[0].offsets[p] + k * 8
                fir.text(mut out, "movq {at}(%rsi), %rax\nmovq %rax, {dest}(%rbp)\n")
                at += 8; k += 1
            }
            p += 1
        }
        var bid: int = 0
        for b in f.blocks {
            fir.text(mut out, ".Lf{fid}_b{bid}:\n")
            var i: int = 0
            while i < b.code.len { emit_instruction(mut out, m, frame, fid, bid, i, b.code[i], frame.blocks[bid], b.params.len); i += 1 }
            bid += 1
        }
        fir.text(mut out, ".size __fenrir_f{fid}, .-__fenrir_f{fid}\n")
        fid += 1
    }
    fir.text(mut out, ".section .rodata\n.Lnewline:\n.byte 10\n")
    var blob: int = 0
    for s in m.blobs {
        fir.text(mut out, ".Lblob{blob}:\n")
        for b in s.bytes() { let n = b as int; fir.text(mut out, ".byte {n}\n") }
        blob += 1
    }
    fir.text(mut out, ".section .note.GNU-stack,\"\",@progbits\n")
    fir.finish(out)
}
