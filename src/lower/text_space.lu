//! member: true

// Decode a valid source scalar using byte views. Return its UTF-8 width when
// it is frozen White_Space, and the negative width otherwise. No list exists.
fn text_space_body(mut l: Lowering, at: int) -> int {
    let source = new_slot(mut l, 3)
    let index = new_slot(mut l, 1)
    let lead = new_slot(mut l, 1)
    store(mut l, source, List[int](), 0, at)
    store(mut l, index, List[int](), 1, at)
    let first = put(mut l, "text", 1, at, [3, 0], [0, 1])
    store(mut l, lead, List[int](), first, at)
    let decoded = new_block(mut l, [1, 1])
    var width = 1
    for boundary in [128, 224, 240] {
        let value = load(mut l, lead, List[int](), 1, at)
        let end = constant(mut l, 1, boundary, at)
        let less = put(mut l, "lt", 2, at, List[int](), [value, end])
        let yes = new_block(mut l, List[int]())
        let no = new_block(mut l, List[int]())
        let _ = put(mut l, "branch", 0, at, [yes, no, 0], [less])
        start(mut l, yes)
        space_decode(mut l, source, index, lead, width, decoded, at)
        start(mut l, no)
        width += 1
    }
    space_decode(mut l, source, index, lead, 4, decoded, at)
    start(mut l, decoded)
    let scalar = new_slot(mut l, 1)
    let stride = new_slot(mut l, 1)
    store(mut l, scalar, List[int](), 0, at)
    store(mut l, stride, List[int](), 1, at)
    let found = new_block(mut l, List[int]())
    let done = new_block(mut l, [1])
    space_range(mut l, scalar, 8, 14, found, at)
    space_range(mut l, scalar, 8191, 8203, found, at)
    for code in [32, 133, 160, 5760, 8232, 8233, 8239, 8287, 12288] {
        let value = load(mut l, scalar, List[int](), 1, at)
        let expected = constant(mut l, 1, code, at)
        let equal = put(mut l, "eq", 2, at, List[int](), [value, expected])
        let next = new_block(mut l, List[int]())
        let _ = put(mut l, "branch", 0, at, [found, next, 0], [equal])
        start(mut l, next)
    }
    let zero = constant(mut l, 1, 0, at)
    let step = load(mut l, stride, List[int](), 1, at)
    let negative = put(mut l, "sub", 1, at, List[int](), [zero, step])
    jump(mut l, done, [negative], at)
    start(mut l, found)
    let positive = load(mut l, stride, List[int](), 1, at)
    jump(mut l, done, [positive], at)
    start(mut l, done)
    0
}

fn space_decode(mut l: Lowering, source: int, index: int, lead: int, width: int, join: int, at: int) {
    var scalar = load(mut l, lead, List[int](), 1, at)
    if width > 1 {
        let mask = constant(mut l, 1, if width == 2 then 32 else if width == 3 then 16 else 8, at)
        scalar = put(mut l, "rem", 1, at, List[int](), [scalar, mask])
        let base = load(mut l, source, List[int](), 3, at)
        let position = load(mut l, index, List[int](), 1, at)
        let sixty_four = constant(mut l, 1, 64, at)
        var i = 1
        while i < width {
            let delta = constant(mut l, 1, i, at)
            let cursor = put(mut l, "add", 1, at, List[int](), [position, delta])
            let octet = put(mut l, "text", 1, at, [3, 0], [base, cursor])
            let tail = put(mut l, "rem", 1, at, List[int](), [octet, sixty_four])
            let high = put(mut l, "mul", 1, at, List[int](), [scalar, sixty_four])
            scalar = put(mut l, "add", 1, at, List[int](), [high, tail])
            i += 1
        }
    }
    let stride = constant(mut l, 1, width, at)
    jump(mut l, join, [scalar, stride], at)
}

fn space_range(mut l: Lowering, scalar: int, low: int, high: int, found: int, at: int) {
    let x = load(mut l, scalar, List[int](), 1, at)
    let lo = constant(mut l, 1, low, at)
    let above = put(mut l, "lt", 2, at, List[int](), [lo, x])
    let upper = new_block(mut l, List[int]())
    let next = new_block(mut l, List[int]())
    let _ = put(mut l, "branch", 0, at, [upper, next, 0], [above])
    start(mut l, upper)
    let value = load(mut l, scalar, List[int](), 1, at)
    let hi = constant(mut l, 1, high, at)
    let below = put(mut l, "lt", 2, at, List[int](), [value, hi])
    let _ = put(mut l, "branch", 0, at, [found, next, 0], [below])
    start(mut l, next)
}
