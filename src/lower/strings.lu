//! member: true

use front
use types

fn text_operand(t: types.Typed, mut l: Lowering, value: int, typed: int, at: int) -> int {
    if t.types[typed].kind == "char" { return put(mut l, "text", 3, at, [4, 0, 4], [value]) }
    value
}

// The receiver and endpoints run once, left to right. A later endpoint may
// leave its block, so earlier values use the same spill discipline as calls.
fn string_slice(s: front.Syntax, t: types.Typed, mut l: Lowering, receiver: int, range: int, result: int, checked: bool, at: int) -> int {
    let xs = value(s, t, mut l, receiver)
    if l.current < 0 { return -1 }
    let split = splits(s, t, mut l, range)
    let h = hold(mut l, xs, 3, split, at)
    let first = first_of(s, range)
    let open_lo = kind_of(s, first) == "Operator"
    let op = if open_lo then first else next_of(s, first)
    let last = next_of(s, op)
    let lo = if open_lo then -1 else if kind_of(s, first) == "FromEnd" then last_of(s, first) else first
    let hi = if last < 0 then -1 else if kind_of(s, last) == "FromEnd" then last_of(s, last) else last
    let a = if lo < 0 then constant(mut l, 1, 0, at) else value(s, t, mut l, lo)
    if l.current < 0 { return -1 }
    let last_splits = hi >= 0 && splits(s, t, mut l, hi)
    let saved = hold(mut l, a, 1, last_splits, at)
    var b = if hi < 0 then -1 else value(s, t, mut l, hi)
    if l.current < 0 { return -1 }
    let base = back(mut l, h)
    let start_at = back(mut l, saved)
    if hi < 0 { b = put(mut l, "text", 1, at, [0, 0], [base]) }
    var mode = 0
    if !open_lo && kind_of(s, first) == "FromEnd" { mode += 1 }
    if last >= 0 && kind_of(s, last) == "FromEnd" { mode += 2 }
    if spell_of(s, op) == "..=" { mode += 4 }
    put(mut l, "text", result, at, [if checked then 1 else 2, mode], [base, start_at, b])
}

fn byte_view(s: front.Syntax, t: types.Typed, node: int) -> int {
    var n = node
    while kind_of(s, n) == "Group" { n = first_of(s, n) }
    if kind_of(s, n) != "Call" || t.node_value[n] != 118 { return -1 }
    let callee = first_of(s, n)
    var receiver = first_of(s, callee)
    if kind_of(s, receiver) == "Receiver" { receiver = last_of(s, receiver) }
    receiver
}

fn byte_view_index(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int, receiver: int) -> int {
    let at = site(s, t, mut l, n)
    let arg = last_of(s, first_of(s, next_of(s, first_of(s, n))))
    let xs = value(s, t, mut l, receiver)
    if l.current < 0 { return -1 }
    let split = splits(s, t, mut l, arg)
    let held = hold(mut l, xs, 3, split, at)
    if kind_of(s, arg) != "Range" {
        let index = value(s, t, mut l, arg)
        if l.current < 0 { return -1 }
        let base = back(mut l, held)
        return put(mut l, "text", 1, at, [3, 0], [base, index])
    }
    let lo = first_of(s, arg)
    let hi = last_of(s, arg)
    let a = value(s, t, mut l, lo)
    if l.current < 0 { return -1 }
    let tail_splits = splits(s, t, mut l, hi)
    let ha = hold(mut l, a, 1, tail_splits, at)
    var b = value(s, t, mut l, hi)
    if l.current < 0 { return -1 }
    if spell_of(s, next_of(s, lo)) == "..=" {
        let one = constant(mut l, 1, 1, at)
        b = put(mut l, "add", 1, at, List[int](), [b, one])
    }
    let base = back(mut l, held)
    let start_at = back(mut l, ha)
    put(mut l, "text", 4, at, [13, 0], [base, start_at, b])
}

fn byte_view_method(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int, receiver: int) -> int {
    let at = site(s, t, mut l, n)
    let code = t.node_value[n]
    let xs = value(s, t, mut l, receiver)
    if l.current < 0 { return -1 }
    if code == 3 {
        let arg = last_of(s, first_of(s, last_of(s, n)))
        let split = splits(s, t, mut l, arg)
        let h = hold(mut l, xs, 3, split, at)
        let index = value(s, t, mut l, arg)
        if l.current < 0 { return -1 }
        let base = back(mut l, h)
        let result = place(t, mut l, t.node_type[n])
        return put(mut l, "text", result, at, [3, 1], [base, index])
    }
    let length = put(mut l, "text", 1, at, [0, 0], [xs])
    if code == 7 { return length }
    let zero = constant(mut l, 1, 0, at)
    if code == 6 { return put(mut l, "eq", 2, at, List[int](), [length, zero]) }
    var index = zero
    if code == 5 {
        let one = constant(mut l, 1, 1, at)
        index = put(mut l, "sub", 1, at, List[int](), [length, one])
    }
    let result = place(t, mut l, t.node_type[n])
    put(mut l, "text", result, at, [3, 1], [xs, index])
}

fn string_method(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let at = site(s, t, mut l, n)
    let callee = first_of(s, n)
    var receiver = first_of(s, callee)
    if kind_of(s, receiver) == "Receiver" { receiver = last_of(s, receiver) }
    if t.node_value[n] == 101 {
        let range = last_of(s, first_of(s, last_of(s, n)))
        let result = place(t, mut l, t.node_type[n])
        return string_slice(s, t, mut l, receiver, range, result, false, at)
    }
    let code = t.node_value[n]
    var args = List[int]()
    for a in children(s, last_of(s, n)) { (mut args).push(last_of(s, a)) }
    var later = List[bool]()
    var any = false
    var i = args.len
    while i > 0 {
        i -= 1
        (mut later).push(any)
        if splits(s, t, mut l, args[i]) { any = true }
    }
    let xs = value(s, t, mut l, receiver)
    if l.current < 0 { return -1 }
    var held = List[Held]()
    (mut held).push(hold(mut l, xs, 3, any, at))
    i = 0
    while i < args.len {
        let argument = value(s, t, mut l, args[i])
        if l.current < 0 { return -1 }
        let ty = fir_type(l, t, args[i])
        (mut held).push(hold(mut l, argument, ty, later[args.len - 1 - i], at))
        i += 1
    }
    var uses = List[int]()
    for h in held { (mut uses).push(back(mut l, h)) }
    let result = place(t, mut l, t.node_type[n])
    if code == 100 { return put(mut l, "text", 1, at, [0, 0], uses) }
    if code == 118 || code == 119 {
        let zero = constant(mut l, 1, 0, at)
        let length = put(mut l, "text", 1, at, [0, 0], uses)
        return put(mut l, "text", 4, at, [13, code - 118], [uses[0], zero, length])
    }
    if code == 117 {
        let length = put(mut l, "text", 1, at, [0, 0], uses)
        let zero = constant(mut l, 1, 0, at)
        return put(mut l, "eq", 2, at, List[int](), [length, zero])
    }
    if code == 102 { return put(mut l, "text", result, at, [11, 0], uses) }
    if code == 103 || code == 104 { return put(mut l, "text", result, at, [5, code - 103], uses) }
    if code >= 105 && code <= 107 { return put(mut l, "text", 2, at, [6, code - 105], uses) }
    if code == 108 { return put(mut l, "text", 1, at, [7, 0], uses) }
    if code == 109 { return put(mut l, "text", 3, at, [8, 0], uses) }
    if code == 110 { return put(mut l, "text", 3, at, [9, 0], uses) }
    if code >= 111 && code <= 113 {
        if code != 111 { (mut uses).push(text_value(mut l, "", at)) }
        return put(mut l, "text", result, at, [10, code - 111], uses)
    }
    put(mut l, "text", 3, at, [12, code - 114], uses)
}
