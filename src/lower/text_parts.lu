//! member: true

fn text_part_body(mut l: Lowering, mode: int, record: int, at: int) -> int {
    let source = new_slot(mut l, 3)
    let separator = new_slot(mut l, 3)
    let cursor = new_slot(mut l, 1)
    let end = new_slot(mut l, 1)
    store(mut l, source, List[int](), 0, at)
    store(mut l, separator, List[int](), 1, at)
    store(mut l, cursor, List[int](), 2, at)
    let length = put(mut l, "text", 1, at, [0, 0], [0])
    store(mut l, end, List[int](), length, at)
    let join = new_block(mut l, [1, 1, 1, 2, 2])
    if mode == 1 { parts_words(mut l, source, cursor, end, join, at) }
    else { parts_search(mut l, mode, source, separator, cursor, end, join, at) }
    start(mut l, join)
    put(mut l, "struct", record, at, List[int](), [0, 1, 2, 3, 4])
}

fn part_none(mut l: Lowering, join: int, at: int) {
    let zero = constant(mut l, 1, 0, at)
    let no = constant(mut l, 2, 0, at)
    let yes = constant(mut l, 2, 1, at)
    jump(mut l, join, [zero, zero, zero, no, yes], at)
}

fn part_last(mut l: Lowering, from: int, end: int, join: int, at: int) {
    let lo = load(mut l, from, List[int](), 1, at)
    let hi = load(mut l, end, List[int](), 1, at)
    let yes = constant(mut l, 2, 1, at)
    jump(mut l, join, [lo, hi, hi, yes, yes], at)
}

fn parts_search(mut l: Lowering, mode: int, source: int, separator: int, cursor: int, end: int, join: int, at: int) {
    if mode == 2 {
        let from = load(mut l, cursor, List[int](), 1, at)
        let length = load(mut l, end, List[int](), 1, at)
        let more = put(mut l, "lt", 2, at, List[int](), [from, length])
        let scan = new_block(mut l, List[int]())
        let empty = new_block(mut l, List[int]())
        let _ = put(mut l, "branch", 0, at, [scan, empty, 0], [more])
        start(mut l, empty)
        part_none(mut l, join, at)
        start(mut l, scan)
    } else {
        let needle = load(mut l, separator, List[int](), 3, at)
        let size = put(mut l, "text", 1, at, [0, 0], [needle])
        let zero = constant(mut l, 1, 0, at)
        let empty = put(mut l, "eq", 2, at, List[int](), [size, zero])
        let whole = new_block(mut l, List[int]())
        let scan = new_block(mut l, List[int]())
        let _ = put(mut l, "branch", 0, at, [whole, scan, 0], [empty])
        start(mut l, whole)
        part_last(mut l, cursor, end, join, at)
        start(mut l, scan)
    }
    let base = load(mut l, source, List[int](), 3, at)
    let from = load(mut l, cursor, List[int](), 1, at)
    let length = load(mut l, end, List[int](), 1, at)
    let tail = put(mut l, "text", 3, at, [1, 0], [base, from, length])
    let needle = if mode == 2 then text_value(mut l, "\n", at) else load(mut l, separator, List[int](), 3, at)
    let ok = ok_record(mut l, 1)
    let empty = ok_record(mut l, 0)
    let option = add_shape(mut l, "enum", [ok, empty], [1, 1], 2)
    let found = put(mut l, "text", option, at, [5, 0], [tail, needle])
    let hit = new_block(mut l, [ok])
    let miss = new_block(mut l, List[int]())
    let _ = put(mut l, "case", 0, at, [0, hit, miss, 0], [found])
    start(mut l, miss)
    part_last(mut l, cursor, end, join, at)
    start(mut l, hit)
    let relative = put(mut l, "field", 1, at, [0], [0])
    let start_at = load(mut l, cursor, List[int](), 1, at)
    let hi = put(mut l, "add", 1, at, List[int](), [start_at, relative])
    if mode == 0 {
        let sep = load(mut l, separator, List[int](), 3, at)
        let count = put(mut l, "text", 1, at, [0, 0], [sep])
        let next = put(mut l, "add", 1, at, List[int](), [hi, count])
        let yes = constant(mut l, 2, 1, at)
        let no = constant(mut l, 2, 0, at)
        jump(mut l, join, [start_at, hi, next, yes, no], at)
        return
    }
    let hi_slot = new_slot(mut l, 1)
    let next_slot = new_slot(mut l, 1)
    store(mut l, hi_slot, List[int](), hi, at)
    let one = constant(mut l, 1, 1, at)
    let next = put(mut l, "add", 1, at, List[int](), [hi, one])
    store(mut l, next_slot, List[int](), next, at)
    let preceding = put(mut l, "lt", 2, at, List[int](), [start_at, hi])
    let check_cr = new_block(mut l, List[int]())
    let done = new_block(mut l, List[int]())
    let trim = new_block(mut l, List[int]())
    let _ = put(mut l, "branch", 0, at, [check_cr, done, 0], [preceding])
    start(mut l, check_cr)
    let stop = load(mut l, hi_slot, List[int](), 1, at)
    let single = constant(mut l, 1, 1, at)
    let previous = put(mut l, "sub", 1, at, List[int](), [stop, single])
    let text = load(mut l, source, List[int](), 3, at)
    let octet = put(mut l, "text", 1, at, [3, 0], [text, previous])
    let cr = constant(mut l, 1, 13, at)
    let is_cr = put(mut l, "eq", 2, at, List[int](), [octet, cr])
    let _ = put(mut l, "branch", 0, at, [trim, done, 0], [is_cr])
    start(mut l, trim)
    let old_hi = load(mut l, hi_slot, List[int](), 1, at)
    let delta = constant(mut l, 1, 1, at)
    let new_hi = put(mut l, "sub", 1, at, List[int](), [old_hi, delta])
    store(mut l, hi_slot, List[int](), new_hi, at)
    jump(mut l, done, List[int](), at)
    start(mut l, done)
    let lo = load(mut l, cursor, List[int](), 1, at)
    let last_byte = load(mut l, hi_slot, List[int](), 1, at)
    let following = load(mut l, next_slot, List[int](), 1, at)
    let limit = load(mut l, end, List[int](), 1, at)
    let last = put(mut l, "eq", 2, at, List[int](), [following, limit])
    let present = constant(mut l, 2, 1, at)
    jump(mut l, join, [lo, last_byte, following, present, last], at)
}

fn parts_words(mut l: Lowering, source: int, cursor: int, end: int, join: int, at: int) {
    let word_start = new_slot(mut l, 1)
    let stride = new_slot(mut l, 1)
    let skip = new_block(mut l, List[int]())
    let skip_check = new_block(mut l, List[int]())
    let skip_step = new_block(mut l, List[int]())
    let start_word = new_block(mut l, List[int]())
    let no_word = new_block(mut l, List[int]())
    let word = new_block(mut l, List[int]())
    let word_check = new_block(mut l, List[int]())
    let word_step = new_block(mut l, List[int]())
    let done_word = new_block(mut l, List[int]())
    jump(mut l, skip, List[int](), at)
    start(mut l, skip)
    let i = load(mut l, cursor, List[int](), 1, at)
    let limit = load(mut l, end, List[int](), 1, at)
    let more = put(mut l, "lt", 2, at, List[int](), [i, limit])
    let _ = put(mut l, "branch", 0, at, [skip_check, no_word, 0], [more])
    start(mut l, no_word)
    part_none(mut l, join, at)
    start(mut l, skip_check)
    let source0 = load(mut l, source, List[int](), 3, at)
    let index0 = load(mut l, cursor, List[int](), 1, at)
    let width0 = put(mut l, "text", 1, at, [14, 0], [source0, index0])
    store(mut l, stride, List[int](), width0, at)
    let zero0 = constant(mut l, 1, 0, at)
    let plain = put(mut l, "lt", 2, at, List[int](), [width0, zero0])
    let _ = put(mut l, "branch", 0, at, [start_word, skip_step, 0], [plain])
    start(mut l, skip_step)
    let current0 = load(mut l, cursor, List[int](), 1, at)
    let step0 = load(mut l, stride, List[int](), 1, at)
    let next0 = put(mut l, "add", 1, at, List[int](), [current0, step0])
    store(mut l, cursor, List[int](), next0, at)
    jump(mut l, skip, List[int](), at)
    start(mut l, start_word)
    let first = load(mut l, cursor, List[int](), 1, at)
    store(mut l, word_start, List[int](), first, at)
    let first_width = load(mut l, stride, List[int](), 1, at)
    let after_first = put(mut l, "sub", 1, at, List[int](), [first, first_width])
    store(mut l, cursor, List[int](), after_first, at)
    jump(mut l, word, List[int](), at)
    start(mut l, word)
    let j = load(mut l, cursor, List[int](), 1, at)
    let end1 = load(mut l, end, List[int](), 1, at)
    let remaining = put(mut l, "lt", 2, at, List[int](), [j, end1])
    let _ = put(mut l, "branch", 0, at, [word_check, done_word, 0], [remaining])
    start(mut l, word_check)
    let source1 = load(mut l, source, List[int](), 3, at)
    let index1 = load(mut l, cursor, List[int](), 1, at)
    let width1 = put(mut l, "text", 1, at, [14, 0], [source1, index1])
    store(mut l, stride, List[int](), width1, at)
    let zero1 = constant(mut l, 1, 0, at)
    let content = put(mut l, "lt", 2, at, List[int](), [width1, zero1])
    let _ = put(mut l, "branch", 0, at, [word_step, done_word, 0], [content])
    start(mut l, word_step)
    let current1 = load(mut l, cursor, List[int](), 1, at)
    let step1 = load(mut l, stride, List[int](), 1, at)
    let next1 = put(mut l, "sub", 1, at, List[int](), [current1, step1])
    store(mut l, cursor, List[int](), next1, at)
    jump(mut l, word, List[int](), at)
    start(mut l, done_word)
    let lo = load(mut l, word_start, List[int](), 1, at)
    let hi = load(mut l, cursor, List[int](), 1, at)
    let end2 = load(mut l, end, List[int](), 1, at)
    let last = put(mut l, "eq", 2, at, List[int](), [hi, end2])
    let present = constant(mut l, 2, 1, at)
    jump(mut l, join, [lo, hi, hi, present, last], at)
}
