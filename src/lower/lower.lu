//! member: true

// The typed tree to FIR (docs/LOWERING.md). One function at a time, each AST
// node lowered once; every table below is a dense array indexed by a node or
// declaration id, allocated once per module, so the pass is linear in nodes
// plus the words of the struct values it renders.

use front
use types
use fir
use sem
use resolve

/// A value held across a split: still in its block, or spilled to a slot.
struct Held { value: int, slot: int, ty: int, site: int }

/// One `while`'s targets for `break` and `continue`.
struct Loop { header: int, exit: int }

/// One block's deferred statements and its cleanup chain ([mem.model.order]).
/// `chain[i]` runs `defers[i]`, then `defers[i - 1]`, …, then reaches `end`,
/// which dispatches on the exit kind the chain was entered with. The chain is
/// emitted once, when the block ends: every exit jumps into it, so a block's
/// lowering is linear in its defers plus its exits.
struct Cleanup { defers: List[int], loops: int, chain: List[int], end: int, sel: int, err: int, used: int }
// [mem.region.intra.2], [mem.region.create.3]: a region the lowering leaves on every way out of a block, entered
// as a deferred entry of that block: `node` is the `Region`, `InRegion` or `Binder`, `home` and `prev` the slots of
// the region and of the ambient region it replaced (-1 for a value freed at its binding's end), `free` whether the
// exit frees the region.
struct RegionExit { node: int, home: int, prev: int, free: bool }

/// A list or map shape's component left for later: placing it now would re-enter a struct or
/// enum still being placed. `field` of shape index `shape` becomes the FIR type of typed `ty`.
struct Pending { shape: int, field: int, ty: int }

/// A part of a string under construction: literal text, or a held value.
struct Piece { text: str, held: Held, typed: int, spec: int }

struct Lowering {
    failure: str
    blobs: List[str]
    sites: List[fir.Site]
    shapes: List[fir.Shape]
    functions: List[fir.Function]
    type_map: List[int]
    struct_fir: List[int]
    field_map: List[int]
    payload_fir: List[int]
    payload_first: List[int]
    payload_map: List[int]
    fn_map: List[int]
    slot_of: List[int]
    site_of: List[int]
    splits: List[int]
    blocks: List[fir.Block]
    current: int
    slots: List[int]
    loops: List[Loop]
    result: int
    fsite: int
    full: int
    tag_fir: List[int]
    ok_types: List[int]
    ok_records: List[int]
    helpers: List[Helper]
    // Structs and enums being placed (their by-value members first), the components that wait
    // for them, and whether those components are being placed now.
    placing: int
    pending: List[Pending]
    draining: bool
    origin: List[bool]   // per node: whether its subscripts are 1-origin
    scopes: List[Cleanup]  // the open blocks, innermost last
    returned: int        // slot holding a return value while defers run, or -1
    // [mem.tier0.mode.mut], value-result (docs/MEMORY.md): per function decl, the FIR struct its
    // calls return ({result, each `mut` parameter's final value}), or -1; the current function's.
    vr_of: List[int]
    vr: int
    muts: List[int]
    mut_types: List[int]
    // The region exits entered so far, and the one the next block's scope takes as its first deferred entry.
    region_exits: List[RegionExit]
    region_pending: int
}

fn kind_of(s: front.Syntax, n: int) -> str { s.nodes[n].kind }
fn first_of(s: front.Syntax, n: int) -> int { s.nodes[n].first }
fn next_of(s: front.Syntax, n: int) -> int { s.nodes[n].next }
fn last_of(s: front.Syntax, n: int) -> int { s.nodes[n].last }
fn token_of(s: front.Syntax, n: int) -> str { s.tokens[s.nodes[n].token].kind }
fn spell_of(s: front.Syntax, n: int) -> str {
    let span = s.tokens[s.nodes[n].token].span
    s.text[span.start..span.end]
}

fn children(s: front.Syntax, n: int) -> List[int] {
    var out = List[int]()
    var c = first_of(s, n)
    while c >= 0 { (mut out).push(c); c = next_of(s, c) }
    out
}

fn fail(mut l: Lowering, message: str) {
    if l.failure == "" { l.failure = message }
}

// ---- types, sites and blobs ------------------------------------------------

fn fir_type(l: Lowering, t: types.Typed, n: int) -> int {
    let ty = t.node_type[n]
    if ty < 0 { return 0 }
    l.type_map[ty]
}

fn blob(mut l: Lowering, text: str) -> int {
    (mut l.blobs).push(text)
    l.blobs.len - 1
}

/// The trap site of node `n`: the start of its innermost Statement or Tail.
fn site(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let stmt = t.node_site[n]
    if stmt < 0 { return l.fsite }
    if l.site_of[stmt] < 0 {
        let span = s.nodes[stmt].span
        (mut l.sites).push(fir.Site { file: 0, line: span.line, column: span.col })
        l.site_of[stmt] = l.sites.len - 1
    }
    l.site_of[stmt]
}

fn node_site(s: front.Syntax, mut l: Lowering, n: int) -> int {
    let span = s.nodes[n].span
    (mut l.sites).push(fir.Site { file: 0, line: span.line, column: span.col })
    l.sites.len - 1
}

// ---- blocks and instructions -----------------------------------------------

fn new_block(mut l: Lowering, params: List[int]) -> int {
    (mut l.blocks).push(fir.Block { params: copy params, code: List[fir.Inst]() })
    l.blocks.len - 1
}

fn start(mut l: Lowering, b: int) { l.current = b }

fn new_slot(mut l: Lowering, ty: int) -> int {
    (mut l.slots).push(ty)
    l.slots.len - 1
}

/// Append an instruction to the current block and return its value number.
/// A terminator closes the block: nothing is reachable until the next start.
fn put(mut l: Lowering, op: str, ty: int, at: int, data: List[int], uses: List[int]) -> int {
    if l.current < 0 { fail(mut l, "an instruction was emitted with no current block"); return -1 }
    let b = l.current
    let v = l.blocks[b].params.len + l.blocks[b].code.len
    (mut l.blocks[b].code).push(fir.Inst { op: op, ty: ty, site: at, data: copy data, uses: copy uses })
    if fir.terminal(op) { l.current = -1 }
    v
}

fn constant(mut l: Lowering, ty: int, bits: int, at: int) -> int { put(mut l, "const", ty, at, [bits], List[int]()) }

fn text_value(mut l: Lowering, text: str, at: int) -> int {
    let b = blob(mut l, text)
    put(mut l, "string", 3, at, [b], List[int]())
}

fn load(mut l: Lowering, slot: int, path: List[int], ty: int, at: int) -> int {
    var data = [slot]
    for k in path { (mut data).push(k) }
    put(mut l, "load", ty, at, data, List[int]())
}

fn store(mut l: Lowering, slot: int, path: List[int], v: int, at: int) {
    var data = [slot]
    for k in path { (mut data).push(k) }
    let _ = put(mut l, "store", 0, at, data, [v])
}

fn jump(mut l: Lowering, target: int, args: List[int], at: int) { let _ = put(mut l, "jump", 0, at, [target], args) }

/// Keep `v` usable after an evaluation that may change the current block.
fn hold(mut l: Lowering, v: int, ty: int, spill: bool, at: int) -> Held {
    if !spill || v < 0 || ty == 0 { return Held { value: v, slot: -1, ty: ty, site: at } }
    let slot = new_slot(mut l, ty)
    store(mut l, slot, List[int](), v, at)
    Held { value: v, slot: slot, ty: ty, site: at }
}

fn back(mut l: Lowering, h: Held) -> int {
    if h.slot < 0 { return h.value }
    load(mut l, h.slot, List[int](), h.ty, h.site)
}

// ---- splits: whether lowering a node can leave its block --------------------

fn splits(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> bool {
    if n < 0 { return false }
    if l.splits[n] >= 0 { return l.splits[n] == 1 }
    let k = kind_of(s, n)
    var own = k == "If" || k == "Loop" || k == "Jump" || k == "Match" || k == "Propagate" || k == "Default"
    if k == "Binary" {
        let op = spell_of(s, next_of(s, first_of(s, n)))
        own = op == "&&" || op == "||"
    }
    // `assert` and `min` lower to branches.
    if k == "Call" && (t.node_decl[n] == 1 || t.node_decl[n] == 23) { own = true }
    var c = first_of(s, n)
    while c >= 0 {
        if splits(s, t, mut l, c) { own = true }
        c = next_of(s, c)
    }
    l.splits[n] = if own then 1 else 0
    own
}

// ---- expressions ------------------------------------------------------------

/// Lower an expression; return its value number in the current block, or -1
/// for a unit value. A `never` expression leaves no current block.
fn value(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    if l.current < 0 || l.failure != "" { return -1 }
    let k = kind_of(s, n)
    if k == "Literal" { return literal(s, t, mut l, n) }
    if k == "Group" { return value(s, t, mut l, first_of(s, n)) }
    if k == "Name" {
        if t.node_decl[n] < 0 && t.node_type[n] >= 0 && t.types[t.node_type[n]].kind == "result" { return raise(s, t, mut l, n) }
        return read_name(s, t, mut l, n)
    }
    if k == "List" { return list_literal(s, t, mut l, n) }
    if k == "Index" { return index_value(s, t, mut l, n) }
    if k == "Tuple" { return tuple_value(s, t, mut l, n) }
    if k == "Propagate" { return propagate(s, t, mut l, n) }
    if k == "Default" { return default_value(s, t, mut l, n) }
    if k == "Cast" { return cast_value(s, t, mut l, n) }
    if k == "Prefix" { return prefix(s, t, mut l, n) }
    if k == "Binary" { return binary(s, t, mut l, n) }
    if k == "String" { return string_value(s, t, mut l, n) }
    if k == "Call" { return call(s, t, mut l, n) }
    if k == "StructLiteral" { return struct_literal(s, t, mut l, n) }
    if k == "Member" {
        let d = t.node_decl[n]
        if d >= 0 && t.decls[d].kind == "variant" { return constructor(s, t, mut l, n, d, List[int]()) }
        let rt = t.node_type[first_of(s, n)]
        if rt >= 0 && t.types[rt].kind != "struct" { return container_member(s, t, mut l, n) }
        return member(s, t, mut l, n)
    }
    if k == "Match" { return match_value(s, t, mut l, n) }
    if k == "If" { return if_value(s, t, mut l, n) }
    if k == "Block" { return block(s, t, mut l, n) }
    if k == "Loop" {
        let word = spell_of(s, first_of(s, n))
        if word == "for" { for_loop(s, t, mut l, n) } else if word == "loop" { loop_value(s, t, mut l, n) } else { while_loop(s, t, mut l, n) }
        return -1
    }
    if k == "Jump" { jump_expression(s, t, mut l, n); return -1 }
    if k == "Region" || k == "InRegion" { return region_block(s, t, mut l, n) }
    if k == "RegionValue" { return region_value(s, t, mut l, n) }
    fail(mut l, "no lowering for a {k} expression")
    -1
}

// [mem.region.create.1], [mem.region.cap.2]: a fresh region, its budget set once when one is written.
fn region_value(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let at = node_site(s, mut l, n)
    var cap = -1
    var d = first_of(s, n)
    while d >= 0 { if kind_of(s, d) == "RegionCapacity" { cap = d }; d = next_of(s, d) }
    var budget = -1
    if cap >= 0 {
        budget = value(s, t, mut l, first_of(s, cap))
        if l.current < 0 { return -1 }
    }
    let h = put(mut l, "region", 6, at, [1], List[int]())
    if budget >= 0 { let _ = put(mut l, "region", 0, at, [2], [h, budget]) }
    h
}

// `region r(cap: e) { … }` and `in r { … }`: enter the region, run the block, and leave it on every way out
// (the block's end, a `return`, `?`, an error return, a `break` or `continue`), as the block's first deferred
// entry, so it runs after the block's own defers. The sugar block also frees its region there
// ([mem.region.intra.2]); `in r` only restores the ambient region it replaced ([mem.region.create.3]).
fn region_block(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let at = node_site(s, mut l, n)
    let sugar = kind_of(s, n) == "Region"
    var h = -1
    if sugar {
        h = region_value(s, t, mut l, n)
        let nm = first_of(s, n)
        if kind_of(s, nm) == "Name" && t.node_decl[nm] >= 0 {
            let named = new_slot(mut l, 6)
            l.slot_of[t.node_decl[nm]] = named
            store(mut l, named, List[int](), h, at)
        }
    } else { h = value(s, t, mut l, first_of(s, n)) }
    if l.current < 0 { return -1 }
    let home = new_slot(mut l, 6)
    store(mut l, home, List[int](), h, at)
    let entered = load(mut l, home, List[int](), 6, at)
    let prev = put(mut l, "region", 6, at, [3], [entered])
    let previous = new_slot(mut l, 6)
    store(mut l, previous, List[int](), prev, at)
    (mut l.region_exits).push(RegionExit { node: n, home: home, prev: previous, free: sugar })
    l.region_pending = n
    block(s, t, mut l, last_of(s, n))
}

// The region exit a deferred entry names, or -1 for an ordinary `defer`.
fn region_exit_of(l: Lowering, d: int) -> int {
    var i = l.region_exits.len - 1
    while i >= 0 { if l.region_exits[i].node == d { return i }; i -= 1 }
    -1
}

fn leave_region(mut l: Lowering, e: RegionExit, at: int) {
    if e.prev >= 0 {
        let prev = load(mut l, e.prev, List[int](), 6, at)
        let _ = put(mut l, "region", 0, at, [4], [prev])
    }
    if e.free {
        let h = load(mut l, e.home, List[int](), 6, at)
        let _ = put(mut l, "region", 0, at, [5], [h])
    }
}

fn literal(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let tk = token_of(s, n)
    let at = site(s, t, mut l, n)
    if tk == "int" || tk == "float" || tk == "true" || tk == "false" || tk == "char" { return constant(mut l, fir_type(l, t, n), t.node_value[n], at) }
    if tk == "raw" { return text_value(mut l, t.texts[t.node_value[n]], at) }
    fail(mut l, "no lowering for a {tk} literal")
    -1
}

fn read_name(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let ty = fir_type(l, t, n)
    let d = t.node_decl[n]
    if ty == 0 { return -1 }
    if d < 0 || l.slot_of[d] < 0 { fail(mut l, "a name reads no local"); return -1 }
    let at = site(s, t, mut l, n)
    load(mut l, l.slot_of[d], List[int](), ty, at)
}

fn prefix(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let op = spell_of(s, first_of(s, n))
    let operand = last_of(s, n)
    let ty = fir_type(l, t, n)
    let at = site(s, t, mut l, n)
    if op == "-" && kind_of(s, operand) == "Literal" && token_of(s, operand) == "int" {
        // A negative literal is one constant (docs/TYPED.md, item 10).
        return constant(mut l, ty, t.node_value[n], at)
    }
    let x = value(s, t, mut l, operand)
    if l.current < 0 { return -1 }
    // [mem.tier0.move.3]: `copy x` is deep by type, through the same helper a store uses; `move x` is
    // the value itself.
    if op == "move" { return x }
    if op == "copy" { return copied(t, mut l, x, t.node_type[operand], at) }
    let kind = t.types[t.node_type[n]].kind
    if kind != "bool" && numeric_needed(kind, 0) {
        return numeric_put(mut l, if op == "!" then 12 else 11, kind, kind, at, [x])
    }
    if op == "!" { return put(mut l, "not", ty, at, List[int](), [x]) }
    // `-x` is `0 - x` in its kind: a signed MIN and a nonzero unsigned trap.
    let zero = constant(mut l, ty, 0, at)
    put(mut l, "sub", ty, at, List[int](), [zero, x])
}

fn binary(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let left = first_of(s, n)
    let op = spell_of(s, next_of(s, left))
    let right = last_of(s, n)
    if op == "&&" || op == "||" { return logic(s, t, mut l, n, op == "&&") }
    let at = site(s, t, mut l, n)
    let ty = fir_type(l, t, left)
    let lv = value(s, t, mut l, left)
    if l.current < 0 { return -1 }
    let spill = splits(s, t, mut l, right)
    let held = hold(mut l, lv, ty, spill, at)
    let rv = value(s, t, mut l, right)
    if l.current < 0 { return -1 }
    let a = back(mut l, held)
    if op == "+" && fir_type(l, t, n) == 3 {
        let x = text_operand(t, mut l, a, t.node_type[left], at)
        let y = text_operand(t, mut l, rv, t.node_type[right], at)
        return put(mut l, "concat", 3, at, List[int](), [x, y])
    }
    let mode = numeric_mode(op)
    if mode >= 0 && numeric_needed(t.types[t.node_type[n]].kind, mode) {
        return numeric_binary(t, mut l, t.node_type[n], op, a, rv, at)
    }
    let arith = arithmetic(op)
    if arith != "" { return put(mut l, arith, ty, at, List[int](), [a, rv]) }
    if t.types[t.node_type[left]].kind == "f64" { return numeric_put(mut l, float_compare_mode(op), "f64", "f64", at, [a, rv]) }
    compare(mut l, op, a, rv, at)
}

fn arithmetic(op: str) -> str {
    if op == "+" || op == "+=" { return "add" }
    if op == "-" || op == "-=" { return "sub" }
    if op == "*" || op == "*=" { return "mul" }
    if op == "/" || op == "/=" { return "div" }
    if op == "%" || op == "%=" { return "rem" }
    ""
}

fn compare(mut l: Lowering, op: str, a: int, b: int, at: int) -> int {
    if op == "==" { return put(mut l, "eq", 2, at, List[int](), [a, b]) }
    if op == "<" { return put(mut l, "lt", 2, at, List[int](), [a, b]) }
    if op == ">" { return put(mut l, "lt", 2, at, List[int](), [b, a]) }
    var inner: int = 0
    if op == "!=" { inner = put(mut l, "eq", 2, at, List[int](), [a, b]) }
    else if op == "<=" { inner = put(mut l, "lt", 2, at, List[int](), [b, a]) }
    else if op == ">=" { inner = put(mut l, "lt", 2, at, List[int](), [a, b]) }
    else { fail(mut l, "no lowering for the operator {op}"); return -1 }
    put(mut l, "not", 2, at, List[int](), [inner])
}

/// `a && b` and `a || b`: the right operand runs only when the left does not
/// decide; the decided value reaches the join as its parameter.
fn logic(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int, both: bool) -> int {
    let at = site(s, t, mut l, n)
    let lv = value(s, t, mut l, first_of(s, n))
    if l.current < 0 { return -1 }
    let decided = constant(mut l, 2, if both then 0 else 1, at)
    let rhs = new_block(mut l, List[int]())
    let join = new_block(mut l, [2])
    if both { let _ = put(mut l, "branch", 0, at, [rhs, join, 0], [lv, decided]) }
    else { let _ = put(mut l, "branch", 0, at, [join, rhs, 1], [lv, decided]) }
    start(mut l, rhs)
    let rv = value(s, t, mut l, last_of(s, n))
    if l.current >= 0 { jump(mut l, join, [rv], at) }
    start(mut l, join)
    0
}

fn argument_expression(s: front.Syntax, a: int) -> int { last_of(s, a) }

fn call(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let callee = t.node_decl[n]
    let head = first_of(s, n)
    if kind_of(s, head) == "Index" { return constructor_call(s, t, mut l, n) }
    if kind_of(s, head) == "Member" && (callee < 0 || t.decls[callee].kind != "variant") { return method(s, t, mut l, n) }
    if kind_of(s, head) == "Name" && callee < 0 { return raise(s, t, mut l, n) }
    let at = site(s, t, mut l, n)
    var args = List[int]()
    var arg_nodes = List[int]()
    for a in children(s, last_of(s, n)) { (mut args).push(argument_expression(s, a)); (mut arg_nodes).push(a) }
    if callee >= 0 && t.decls[callee].kind == "variant" { return constructor(s, t, mut l, n, callee, args) }
    if callee == 0 {
        let v = value(s, t, mut l, args[0])
        if l.current < 0 { return -1 }
        let _ = put(mut l, "print", 0, at, List[int](), [v])
        return -1
    }
    if callee == 1 {
        if t.types[t.node_type[n]].kind == "never" { bottom_assertion(s, t, mut l, args, at); return -1 }
        assertion(s, t, mut l, args, at)
        return -1
    }
    if callee == 18 || callee == 19 || callee == 20 {
        // `print_raw`, `eprint`, `eprint_raw`: text operation 17, modes 0 to 2.
        let text = value(s, t, mut l, args[0])
        if l.current < 0 { return -1 }
        let _ = put(mut l, "text", 0, at, [17, callee - 18], [text])
        return -1
    }
    if callee == 21 || callee == 22 { return byte_scan(s, t, mut l, n, callee, args, at) }
    if callee == 23 { return min_value(s, t, mut l, n, args, at) }
    if callee == 26 {
        // [mem.region.account.1]: `region_bytes(r)`.
        let h = value(s, t, mut l, args[0])
        if l.current < 0 { return -1 }
        return put(mut l, "region", 1, at, [6], [h])
    }
    // [mem.region.account.2]: `live_region_bytes()`.
    if callee == 27 { return put(mut l, "region", 1, at, [7], List[int]()) }
    if callee == 17 {
        // `str_from_utf8`: text operation 16 over the byte list's words; its miss is `utf8`.
        let bytes = value(s, t, mut l, args[0])
        if l.current < 0 { return -1 }
        let built = place(t, mut l, t.node_type[n])
        return put(mut l, "text", built, at, [16, 0], [bytes])
    }
    let target = l.fn_map[callee]
    if target < 0 { fail(mut l, "a call names no lowered function"); return -1 }
    // Later splits decide which earlier arguments must be spilled. Each
    // argument meets its parameter's type right after it is evaluated.
    let ft = t.decls[callee].ty
    var later = List[bool]()
    var i = args.len
    var any = false
    while i > 0 {
        i -= 1
        (mut later).push(any)
        let want = t.type_params[t.types[ft].first + i]
        if splits(s, t, mut l, args[i]) || coerce_splits(t, t.node_type[args[i]], want) { any = true }
    }
    var held = List[Held]()
    var places = List[MutPlace]()
    i = 0
    while i < args.len {
        let want = t.type_params[t.types[ft].first + i]
        let ty = place(t, mut l, want)
        if mut_argument(s, arg_nodes[i]) {
            // [mem.tier0.mode.mut]: the place once, before the call; its value passes as it is.
            let mp = mut_place(s, t, mut l, args[i], at)
            if l.current < 0 || l.failure != "" { return -1 }
            let v = read_place(mut l, mp, at)
            if mp.ty > 0 { (mut places).push(mp) }
            (mut held).push(hold(mut l, v, ty, later[args.len - 1 - i], at))
        } else {
            let v = value(s, t, mut l, args[i])
            if l.current < 0 { return -1 }
            let met = coerce(t, mut l, v, t.node_type[args[i]], want, at)
            let c = copied(t, mut l, met, want, at)
            (mut held).push(hold(mut l, c, ty, later[args.len - 1 - i], at))
        }
        i += 1
    }
    var uses = List[int]()
    for h in held { if h.ty != 0 { (mut uses).push(back(mut l, h)) } }
    let ty = fir_type(l, t, n)
    let vr = l.vr_of[callee]
    if vr >= 0 {
        // Value-result: the result first (when there is one), then each `mut` value, written back in
        // parameter order to the places evaluated before the call.
        let whole = put(mut l, "call", vr, at, [target], uses)
        var k: int = if ty != 0 then 1 else 0
        for mp in places {
            let x = put(mut l, "field", mp.ty, at, [k], [whole])
            write_back(mut l, mp, x, at)
            k += 1
        }
        if ty == 0 { return -1 }
        return put(mut l, "field", ty, at, [0], [whole])
    }
    let r = put(mut l, "call", ty, at, [target], uses)
    if t.types[t.node_type[n]].kind == "never" {
        // A `-> never` callee does not return; were it to, the program stops
        // here (`assert`), never runs on with no value ([type.fn.never]).
        let _ = put(mut l, "trap", 0, at, [4], List[int]())
        l.current = -1
        return -1
    }
    if ty == 0 { return -1 }
    r
}

// `bytes_find(xs, b, from)` and `bytes_count(xs, b)`: the operands once, left to
// right, then text operation 18 or 19 ([mem.list.bytes]).
fn byte_scan(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int, callee: int, args: List[int], at: int) -> int {
    var later = List[bool]()
    var any = false
    var i = args.len
    while i > 0 { i -= 1; (mut later).push(any); if splits(s, t, mut l, args[i]) { any = true } }
    var held = List[Held]()
    i = 0
    while i < args.len {
        let v = value(s, t, mut l, args[i])
        if l.current < 0 { return -1 }
        (mut held).push(hold(mut l, v, if i == 0 then 4 else 1, later[args.len - 1 - i], at))
        i += 1
    }
    var uses = List[int]()
    for h in held { (mut uses).push(back(mut l, h)) }
    if callee == 22 { return put(mut l, "text", 1, at, [19, 0], uses) }
    let found = place(t, mut l, t.node_type[n])
    put(mut l, "text", found, at, [18, 0], uses)
}

// [type.min]: both operands once, left to right, then one compare and one
// select: `a` unless `b < a`, so equal operands answer `a`. It never traps.
fn min_value(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int, args: List[int], at: int) -> int {
    let ty = fir_type(l, t, n)
    let a0 = value(s, t, mut l, args[0])
    if l.current < 0 { return -1 }
    let a1 = coerce(t, mut l, a0, t.node_type[args[0]], t.node_type[n], at)
    let later = splits(s, t, mut l, args[1])
    let held = hold(mut l, a1, ty, later, at)
    let b0 = value(s, t, mut l, args[1])
    if l.current < 0 { return -1 }
    let b = coerce(t, mut l, b0, t.node_type[args[1]], t.node_type[n], at)
    let a = back(mut l, held)
    let smaller = put(mut l, "lt", 2, at, List[int](), [b, a])
    let join = new_block(mut l, [ty])
    let _ = put(mut l, "branch", 0, at, [join, join, 1], [smaller, b, a])
    start(mut l, join)
    0
}

/// `assert(cond)` and `assert(cond, msg)`: the message runs only on the
/// failing path, then the program traps `assert` at the call's site.
fn assertion(s: front.Syntax, t: types.Typed, mut l: Lowering, args: List[int], at: int) {
    let c = value(s, t, mut l, args[0])
    if l.current < 0 { return }
    let pass = new_block(mut l, List[int]())
    let failed = new_block(mut l, List[int]())
    let _ = put(mut l, "branch", 0, at, [pass, failed, 0], [c])
    start(mut l, failed)
    if args.len > 1 {
        let m = value(s, t, mut l, args[1])
        if l.current >= 0 { let _ = put(mut l, "trap", 0, at, [4], [m]) }
    } else {
        let _ = put(mut l, "trap", 0, at, [4], List[int]())
    }
    start(mut l, pass)
}

/// The literal `assert(false)` (and its message form) always traps: the
/// message runs, then `assert` at the call's site, and no block follows.
fn bottom_assertion(s: front.Syntax, t: types.Typed, mut l: Lowering, args: List[int], at: int) {
    if args.len > 1 {
        let m = value(s, t, mut l, args[1])
        if l.current >= 0 { let _ = put(mut l, "trap", 0, at, [4], [m]) }
    } else {
        let _ = put(mut l, "trap", 0, at, [4], List[int]())
    }
    l.current = -1
}

fn struct_literal(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let at = site(s, t, mut l, n)
    let ty = fir_type(l, t, n)
    let sd = t.node_decl[n]
    let count = t.decls[sd].count
    var inits = List[int]()
    var c = next_of(s, first_of(s, n))
    while c >= 0 { if kind_of(s, c) == "FieldInitializer" { (mut inits).push(c) }; c = next_of(s, c) }
    var later = List[bool]()
    var i = inits.len
    var any = false
    while i > 0 {
        i -= 1
        (mut later).push(any)
        if splits(s, t, mut l, inits[i]) { any = true }
    }
    var held = List[Held]()
    var order = List[int]()
    i = 0
    while i < count { (mut order).push(-1); i += 1 }
    i = 0
    while i < inits.len {
        let init = inits[i]
        let field = t.node_decl[init]
        let name = first_of(s, init)
        let expr = next_of(s, name)
        var v: int = -1
        var fty: int = 0
        if expr >= 0 {
            fty = fir_type(l, t, expr)
            v = value(s, t, mut l, expr)
        } else {
            fty = fir_type(l, t, name)
            v = read_name(s, t, mut l, name)
        }
        if l.current < 0 { return -1 }
        order[t.decls[field].index] = held.len
        (mut held).push(hold(mut l, v, fty, later[inits.len - 1 - i], at))
        i += 1
    }
    var uses = List[int]()
    i = 0
    while i < count {
        let h = copy held[order[i]]
        if l.field_map[sd + 1 + i] >= 0 { (mut uses).push(back(mut l, h)) }
        i += 1
    }
    put(mut l, "struct", ty, at, List[int](), uses)
}

/// The local and field path a place names, or root -1 when the place is not
/// a field path rooted at a local.
struct Path { root: int, fields: List[int], unit: bool }

/// The FIR field index member `at` names: a struct field's (-1 for a unit field), or a tuple position's
/// (`t.0`, by its typed value); -2 when it names neither.
fn member_index(s: front.Syntax, t: types.Typed, l: Lowering, at: int) -> int {
    let f = t.node_decl[at]
    if f >= 0 { return l.field_map[f] }
    let base = t.node_type[first_of(s, at)]
    if base >= 0 && t.types[base].kind == "tuple" { return t.node_value[at] }
    -2
}

fn place_path(s: front.Syntax, t: types.Typed, l: Lowering, n: int) -> Path {
    var fields = List[int]()
    var at = n
    var unit = false
    while kind_of(s, at) == "Member" {
        let index = member_index(s, t, l, at)
        if index < -1 { return Path { root: -1, fields: List[int](), unit: false } }
        if index < 0 { unit = true }
        (mut fields).push(index)
        at = first_of(s, at)
    }
    if kind_of(s, at) != "Name" { return Path { root: -1, fields: List[int](), unit: false } }
    let d = t.node_decl[at]
    if d < 0 { return Path { root: -1, fields: List[int](), unit: false } }
    var ordered = List[int]()
    var i = fields.len
    while i > 0 { i -= 1; (mut ordered).push(fields[i]) }
    Path { root: d, fields: move ordered, unit: unit }
}

fn member(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let at = site(s, t, mut l, n)
    let ty = fir_type(l, t, n)
    let p = place_path(s, t, l, n)
    if p.root >= 0 {
        if p.unit || ty == 0 { return -1 }
        if l.slot_of[p.root] < 0 { fail(mut l, "a field path reads no local"); return -1 }
        return load(mut l, l.slot_of[p.root], p.fields, ty, at)
    }
    // A field of a computed struct value: compute it, then copy the field.
    let base = value(s, t, mut l, first_of(s, n))
    if l.current < 0 { return -1 }
    let f = t.node_decl[n]
    if ty == 0 || l.field_map[f] < 0 { return -1 }
    put(mut l, "field", ty, at, [l.field_map[f]], [base])
}

fn if_value(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let at = site(s, t, mut l, n)
    let ty = fir_type(l, t, n)
    let cond = first_of(s, n)
    let then_part = next_of(s, cond)
    let else_part = next_of(s, then_part)
    let c = value(s, t, mut l, cond)
    if l.current < 0 { return -1 }
    let yes = new_block(mut l, List[int]())
    var join: int = -1
    var no: int = -1
    if else_part < 0 {
        join = new_block(mut l, List[int]())
        let _ = put(mut l, "branch", 0, at, [yes, join, 0], [c])
    } else {
        no = new_block(mut l, List[int]())
        let _ = put(mut l, "branch", 0, at, [yes, no, 0], [c])
    }
    var params = List[int]()
    if ty != 0 { (mut params).push(ty) }
    start(mut l, yes)
    let a0 = value(s, t, mut l, then_part)
    let a = coerce(t, mut l, a0, t.node_type[then_part], t.node_type[n], at)
    if l.current >= 0 {
        if join < 0 { join = new_block(mut l, params) }
        jump(mut l, join, if ty != 0 then [a] else List[int](), at)
    }
    if no >= 0 {
        start(mut l, no)
        let b0 = value(s, t, mut l, else_part)
        let b = coerce(t, mut l, b0, t.node_type[else_part], t.node_type[n], at)
        if l.current >= 0 {
            if join < 0 { join = new_block(mut l, params) }
            jump(mut l, join, if ty != 0 then [b] else List[int](), at)
        }
    }
    if join < 0 { return -1 }
    start(mut l, join)
    if ty != 0 { return 0 }
    -1
}

fn block(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    (mut l.scopes).push(Cleanup { defers: List[int](), loops: l.loops.len, chain: List[int](), end: -1, sel: -1, err: -1, used: 0 })
    if l.region_pending >= 0 {
        let open = l.scopes.len - 1
        (mut l.scopes[open].defers).push(l.region_pending)
        l.region_pending = -1
    }
    var v: int = -1
    var c = first_of(s, n)
    while c >= 0 && l.current >= 0 {
        let k = kind_of(s, c)
        let d = deferred(s, c)
        if d >= 0 {
            let open = l.scopes.len - 1
            (mut l.scopes[open].defers).push(d)
        }
        else if k == "Statement" { statement(s, t, mut l, c) }
        else if k == "Tail" { v = value(s, t, mut l, last_of(s, c)) }
        c = next_of(s, c)
    }
    let ty = fir_type(l, t, n)
    let top = l.scopes.len - 1
    if l.scopes[top].defers.len == 0 {
        let _ = (mut l.scopes).pop()
        if ty == 0 { return -1 }
        return v
    }
    // The block's own end: its value is formed, then its defers run; it left
    // on the error path when that value is an error.
    var held = -1
    let fell = l.current >= 0
    if fell {
        let at = node_site(s, mut l, n)
        if ty != 0 && v >= 0 {
            held = new_slot(mut l, ty)
            store(mut l, held, List[int](), v, at)
        }
        let flag = error_flag(t, mut l, held, t.node_type[n], at)
        enter_chain(mut l, top, 1, flag, at)
    }
    let after = if fell then new_block(mut l, List[int]()) else -1
    emit_chain(s, t, mut l, top, after)
    let _ = (mut l.scopes).pop()
    if !fell { l.current = -1; return -1 }
    start(mut l, after)
    if ty == 0 || held < 0 { return -1 }
    let at = node_site(s, mut l, n)
    load(mut l, held, List[int](), ty, at)
}

// A statement that is `defer e` or `errdefer e`: the `Defer` node, else -1.
fn deferred(s: front.Syntax, st: int) -> int {
    if kind_of(s, st) != "Statement" { return -1 }
    var c = first_of(s, st)
    while c >= 0 && kind_of(s, c) == "Attribute" { c = next_of(s, c) }
    if c >= 0 && kind_of(s, c) == "Defer" { return c }
    -1
}

// Whether the value in `held` (typed `ty`) is an error: false for a value of
// no result type; otherwise its variant decides. The answer is a bool in the
// current block.
fn error_flag(t: types.Typed, mut l: Lowering, held: int, ty: int, at: int) -> int {
    if held < 0 || ty < 0 || t.types[ty].kind != "result" { return constant(mut l, 2, 0, at) }
    let failed = new_block(mut l, List[int]())
    let join = new_block(mut l, [2])
    let _ = ok_case(t, mut l, held, ty, failed, at)
    let no = constant(mut l, 2, 0, at)
    jump(mut l, join, [no], at)
    start(mut l, failed)
    let yes = constant(mut l, 2, 1, at)
    jump(mut l, join, [yes], at)
    start(mut l, join)
    0
}

// Exit kinds a chain is entered with: 1 the block's own end, 2 a return (a
// `return`, an error `?`), 4 a `break`, 8 a `continue`.
fn enter_chain(mut l: Lowering, si: int, kind: int, flag: int, at: int) {
    if l.scopes[si].sel < 0 {
        let sel = new_slot(mut l, 1)
        let err = new_slot(mut l, 2)
        l.scopes[si].sel = sel
        l.scopes[si].err = err
    }
    let k = constant(mut l, 1, kind, at)
    let sel_slot = l.scopes[si].sel
    let err_slot = l.scopes[si].err
    store(mut l, sel_slot, List[int](), k, at)
    store(mut l, err_slot, List[int](), flag, at)
    l.scopes[si].used = l.scopes[si].used | kind
    let reached = l.scopes[si].defers.len
    let target = chain_block(mut l, si, reached - 1)
    jump(mut l, target, List[int](), at)
}

fn chain_block(mut l: Lowering, si: int, i: int) -> int {
    while l.scopes[si].chain.len <= i { (mut l.scopes[si].chain).push(-1) }
    if l.scopes[si].chain[i] < 0 {
        let b = new_block(mut l, List[int]())
        l.scopes[si].chain[i] = b
    }
    l.scopes[si].chain[i]
}

// The innermost open block, at or outside `below`, with defers that an exit of
// `kind` leaves: any block for a return, a block inside the innermost loop for
// a `break` or `continue`. -1 if the exit passes no deferred statement.
fn exited_scope(l: Lowering, below: int, kind: int) -> int {
    var i = below
    while i >= 0 {
        if kind > 2 && l.scopes[i].loops < l.loops.len { return -1 }
        if l.scopes[i].defers.len > 0 { return i }
        i -= 1
    }
    -1
}

// Run a return whose value is already in `l.returned` (or unit): through every
// open block's defers, innermost first, then `return`.
fn leave_function(mut l: Lowering, flag: int, at: int) {
    let si = exited_scope(l, l.scopes.len - 1, 2)
    if si >= 0 { enter_chain(mut l, si, 2, flag, at); return }
    final_return(mut l, at)
}

// Keep a return value in the function's return slot while defers run.
fn hold_return(mut l: Lowering, v: int, at: int) {
    if l.result == 0 || v < 0 { return }
    if l.returned < 0 {
        let ty = l.result
        l.returned = new_slot(mut l, ty)
    }
    let slot = l.returned
    store(mut l, slot, List[int](), v, at)
}

fn final_return(mut l: Lowering, at: int) {
    if l.result == 0 || l.returned < 0 { emit_return(mut l, List[int](), at); return }
    let slot = l.returned
    let ty = l.result
    let r = load(mut l, slot, List[int](), ty, at)
    emit_return(mut l, [r], at)
}

// Emit block `si`'s chain once its body is lowered: every deferred statement an
// exit reached, newest first (an `errdefer` only on the error path), then the
// dispatch to each exit kind's next stop: the block's own continuation
// `after`, the next enclosing chain, the loop's target, or the return.
fn emit_chain(s: front.Syntax, t: types.Typed, mut l: Lowering, si: int, after: int) {
    let reached = l.scopes[si].chain.len
    if reached == 0 { return }
    let at = l.fsite
    let end = new_block(mut l, List[int]())
    l.scopes[si].end = end
    let err_slot = l.scopes[si].err
    let sel_slot = l.scopes[si].sel
    var i = reached - 1
    while i >= 0 && l.failure == "" {
        let here = chain_block(mut l, si, i)
        let next = if i == 0 then end else chain_block(mut l, si, i - 1)
        start(mut l, here)
        let d = l.scopes[si].defers[i]
        let site_of = node_site(s, mut l, d)
        let exit = region_exit_of(l, d)
        if exit >= 0 {
            let e = copy l.region_exits[exit]
            leave_region(mut l, e, site_of)
            if l.current >= 0 { jump(mut l, next, List[int](), site_of) }
            i -= 1
            continue
        }
        if spell_of(s, d) == "errdefer" {
            let run = new_block(mut l, List[int]())
            let flag = load(mut l, err_slot, List[int](), 2, site_of)
            let _ = put(mut l, "branch", 0, site_of, [run, next, 0], [flag])
            start(mut l, run)
        }
        let _ = value(s, t, mut l, last_of(s, d))
        if l.current >= 0 { jump(mut l, next, List[int](), site_of) }
        i -= 1
    }
    start(mut l, end)
    var kinds = List[int]()
    for kind in [1, 2, 4, 8] { if (l.scopes[si].used & kind) != 0 { (mut kinds).push(kind) } }
    var k: int = 0
    while k < kinds.len {
        var go = l.current
        if k + 1 < kinds.len {
            go = new_block(mut l, List[int]())
            let other = new_block(mut l, List[int]())
            let sel = load(mut l, sel_slot, List[int](), 1, at)
            let want = constant(mut l, 1, kinds[k], at)
            let same = put(mut l, "eq", 2, at, List[int](), [sel, want])
            let _ = put(mut l, "branch", 0, at, [go, other, 0], [same])
            start(mut l, go)
            leave_scope(mut l, si, kinds[k], after, at)
            start(mut l, other)
        } else { leave_scope(mut l, si, kinds[k], after, at) }
        k += 1
    }
}

fn leave_scope(mut l: Lowering, si: int, kind: int, after: int, at: int) {
    if kind == 1 { jump(mut l, after, List[int](), at); return }
    let err_slot = l.scopes[si].err
    let flag = load(mut l, err_slot, List[int](), 2, at)
    let outer = exited_scope(l, si - 1, kind)
    if outer >= 0 { enter_chain(mut l, outer, kind, flag, at); return }
    if kind == 2 { final_return(mut l, at); return }
    let top = copy l.loops[l.loops.len - 1]
    jump(mut l, if kind == 4 then top.exit else top.header, List[int](), at)
}

fn while_loop(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) {
    let at = site(s, t, mut l, n)
    let header_expr = next_of(s, first_of(s, n))
    let body = last_of(s, n)
    let header = new_block(mut l, List[int]())
    jump(mut l, header, List[int](), at)
    start(mut l, header)
    let c = value(s, t, mut l, header_expr)
    if l.current < 0 { return }
    let inside = new_block(mut l, List[int]())
    let exit = new_block(mut l, List[int]())
    let _ = put(mut l, "branch", 0, at, [inside, exit, 0], [c])
    start(mut l, inside)
    (mut l.loops).push(Loop { header: header, exit: exit })
    let _ = value(s, t, mut l, body)
    (mut l.loops).pop() else Loop { header: -1, exit: -1 }
    if l.current >= 0 { jump(mut l, header, List[int](), at) }
    start(mut l, exit)
}

// `loop { … }`: the body again and again; only a `break` reaches the exit,
// so a loop without one leaves no current block (it is `never`).
fn loop_value(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) {
    let at = site(s, t, mut l, n)
    let body = last_of(s, n)
    let header = new_block(mut l, List[int]())
    jump(mut l, header, List[int](), at)
    start(mut l, header)
    let bottom = t.types[t.node_type[n]].kind == "never"
    let exit = if bottom then -1 else new_block(mut l, List[int]())
    (mut l.loops).push(Loop { header: header, exit: exit })
    let _ = value(s, t, mut l, body)
    (mut l.loops).pop() else Loop { header: -1, exit: -1 }
    if l.current >= 0 { jump(mut l, header, List[int](), at) }
    if bottom { l.current = -1 } else { start(mut l, exit) }
}

fn jump_expression(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) {
    let at = site(s, t, mut l, n)
    let word = spell_of(s, first_of(s, n))
    let operand = next_of(s, first_of(s, n))
    if word == "return" {
        var uses = List[int]()
        var v: int = -1
        if operand >= 0 {
            let v0 = value(s, t, mut l, operand)
            if l.current < 0 { return }
            v = coerce(t, mut l, v0, t.node_type[operand], l.full, at)
            if l.result != 0 && v >= 0 { (mut uses).push(v) }
        }
        if exited_scope(l, l.scopes.len - 1, 2) >= 0 {
            // The value is formed; the open blocks' defers run; then it returns.
            hold_return(mut l, v, at)
            let flag = error_flag(t, mut l, l.returned, if uses.len > 0 then l.full else -1, at)
            leave_function(mut l, flag, at)
            return
        }
        emit_return(mut l, uses, at)
        return
    }
    if l.loops.len == 0 { fail(mut l, "a {word} outside any loop"); return }
    let kind = if word == "break" then 4 else 8
    let si = exited_scope(l, l.scopes.len - 1, kind)
    if si >= 0 {
        let no = constant(mut l, 2, 0, at)
        enter_chain(mut l, si, kind, no, at)
        return
    }
    let top = copy l.loops[l.loops.len - 1]
    if word == "break" { jump(mut l, top.exit, List[int](), at) } else { jump(mut l, top.header, List[int](), at) }
}

// ---- strings ----------------------------------------------------------------

fn string_value(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) -> int {
    let at = site(s, t, mut l, n)
    let parts = children(s, n)
    var holes = List[int]()
    for p in parts { if kind_of(s, p) == "Interpolation" { (mut holes).push(p) } }
    if holes.len == 0 {
        var text = ""
        for p in parts { text = text + t.texts[t.node_value[p]] }
        return text_value(mut l, text, at)
    }
    // Every hole runs left to right before any rendering; a hole after a split
    // finds the earlier ones in slots.
    var later = List[bool]()
    var i = holes.len
    var any = false
    while i > 0 { i -= 1; (mut later).push(any); if splits(s, t, mut l, holes[i]) { any = true } }
    var pieces = List[Piece]()
    var h: int = 0
    for p in parts {
        if kind_of(s, p) == "Text" {
            (mut pieces).push(Piece { text: t.texts[t.node_value[p]], held: Held { value: -1, slot: -1, ty: 0, site: at }, typed: -1, spec: -1 })
        } else {
            let e = first_of(s, p)
            let ty = fir_type(l, t, e)
            let v = value(s, t, mut l, e)
            if l.current < 0 { return -1 }
            let spec = if next_of(s, e) >= 0 then t.node_value[p] else -1
            (mut pieces).push(Piece { text: "", held: hold(mut l, v, ty, later[holes.len - 1 - h], at), typed: t.node_type[e], spec: spec })
            h += 1
        }
    }
    var uses = List[int]()
    var pending = ""
    for piece in pieces {
        if piece.typed < 0 { pending = pending + piece.text }
        else {
            let v = back(mut l, piece.held)
            if piece.spec >= 0 {
                if pending != "" { (mut uses).push(text_value(mut l, pending, at)); pending = "" }
                let kind = t.types[piece.typed].kind
                let flavor = if kind == "str" then 0 else if kind == "char" then 4 else if kind == "bool" then 3 else if kind == "f64" then 5 else if kind == "byte" || sem.integer_kind(kind) && !sem.signed(kind) then 2 else 1
                (mut uses).push(put(mut l, "text", 3, at, [4, piece.spec, flavor], [v]))
            } else { pending = render(t, mut l, mut uses, pending, v, piece.typed, at) }
        }
    }
    if uses.len == 0 { return text_value(mut l, pending, at) }
    if pending != "" { (mut uses).push(text_value(mut l, pending, at)) }
    if uses.len == 1 && fir_type_of(l, t, uses, pieces) == 3 { return uses[0] }
    put(mut l, "format", 3, at, List[int](), uses)
}

// A single str part is already the string; any other single part is rendered.
fn fir_type_of(l: Lowering, t: types.Typed, uses: List[int], pieces: List[Piece]) -> int {
    var n: int = 0
    var only: int = -1
    for piece in pieces { if piece.typed >= 0 { n += 1; only = piece.typed } }
    if n != 1 || only < 0 { return -1 }
    let ty = l.type_map[only]
    if ty == 3 { return 3 }
    -1
}

/// Render value `v` of typed type `typed` as format parts, returning the
/// literal text still pending after it (`[type.interp.value]`, `.agg`).
fn render(t: types.Typed, mut l: Lowering, mut uses: List[int], pending: str, v: int, typed: int, at: int) -> str {
    let kind = t.types[typed].kind
    // An adapter renders as its base value (D28: the same layout).
    if kind == "adapter" { return render(t, mut l, mut uses, pending, v, t.types[typed].inner, at) }
    if kind == "unit" { return pending + "()" }
    if kind == "char" || kind == "f64" {
        if pending != "" { (mut uses).push(text_value(mut l, pending, at)) }
        (mut uses).push(text_operand(t, mut l, v, typed, at))
        return ""
    }
    if kind == "struct" {
        let sd = t.types[typed].decl
        var text = pending + t.decls[sd].name + r" {"
        var i: int = 0
        while i < t.decls[sd].count {
            let f = sd + 1 + i
            if i > 0 { text = text + "," }
            text = text + " " + t.decls[f].name + ": "
            let k = l.field_map[f]
            let fty = t.decls[f].ty
            if k < 0 { text = text + "()" }
            else {
                let fv = put(mut l, "field", l.type_map[fty], at, [k], [v])
                text = render(t, mut l, mut uses, text, fv, fty, at)
            }
            i += 1
        }
        return text + r" }"
    }
    if kind == "tuple" {
        var text = pending + "("
        var i: int = 0
        while i < t.types[typed].count {
            if i > 0 { text = text + ", " }
            let it = t.type_params[t.types[typed].first + i]
            let iv = put(mut l, "field", l.type_map[it], at, [i], [v])
            text = render(t, mut l, mut uses, text, iv, it, at)
            i += 1
        }
        return text + ")"
    }
    if kind == "enum" || kind == "list" || kind == "result" || kind == "row" {
        if pending != "" { (mut uses).push(text_value(mut l, pending, at)) }
        let f = helper(t, mut l, "render", typed)
        (mut uses).push(put(mut l, "call", 3, at, [f], [v]))
        return ""
    }
    if pending != "" { (mut uses).push(text_value(mut l, pending, at)) }
    (mut uses).push(v)
    ""
}

// ---- statements --------------------------------------------------------------

fn statement(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) {
    var c = first_of(s, n)
    while c >= 0 && kind_of(s, c) == "Attribute" { c = next_of(s, c) }
    if c < 0 { return }
    let k = kind_of(s, c)
    if k == "Item" {
        let b = last_of(s, c)
        if kind_of(s, b) == "Bindings" { bindings(s, t, mut l, b); return }
        // A nested `fn` is lowered as a function of its own (lower() walks t.functions).
        if kind_of(s, b) == "Function" { return }
        fail(mut l, "no lowering for a nested {kind_of(s, b)}")
        return
    }
    if k == "Assignment" { assignment(s, t, mut l, c); return }
    let _ = value(s, t, mut l, c)
}

fn bindings(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) {
    var b = next_of(s, first_of(s, n))
    while b >= 0 && l.current >= 0 {
        let d = t.node_decl[b]
        let init = last_of(s, b)
        let ty = fir_type(l, t, b)
        let at = site(s, t, mut l, b)
        let v0 = value(s, t, mut l, init)
        if l.current < 0 { return }
        let v = coerce(t, mut l, v0, t.node_type[init], t.node_type[b], at)
        let pat = first_of(s, b)
        if kind_of(s, pat) == "TuplePattern" || kind_of(s, pat) == "StructPattern" { bind_value(s, t, mut l, pat, v, t.node_type[b], at) }
        else if d >= 0 && ty != 0 {
            let slot = new_slot(mut l, ty)
            l.slot_of[d] = slot
            store(mut l, slot, List[int](), v, at)
        }
        b = next_of(s, b)
    }
}

fn assignment(s: front.Syntax, t: types.Typed, mut l: Lowering, n: int) {
    let at = site(s, t, mut l, n)
    let target = first_of(s, n)
    let op = spell_of(s, next_of(s, target))
    let rhs = last_of(s, n)
    if kind_of(s, target) == "Index" { index_store(s, t, mut l, n); return }
    let ty = fir_type(l, t, target)
    let p = place_path(s, t, l, target)
    if p.root < 0 { element_field_store(s, t, mut l, n); return }
    let slot = l.slot_of[p.root]
    let unit = p.unit || ty == 0 || slot < 0
    if op == "=" {
        let v0 = value(s, t, mut l, rhs)
        if l.current < 0 || unit { return }
        let met = coerce(t, mut l, v0, t.node_type[rhs], t.node_type[target], at)
        let v = copied(t, mut l, met, t.node_type[target], at)
        store(mut l, slot, p.fields, v, at)
        return
    }
    if unit { fail(mut l, "a compound assignment to a unit place"); return }
    // `x op= e` is `x = x op e`: the place is read first.
    let old = load(mut l, slot, p.fields, ty, at)
    let spill = splits(s, t, mut l, rhs)
    let held = hold(mut l, old, ty, spill, at)
    let r = value(s, t, mut l, rhs)
    if l.current < 0 { return }
    let a = back(mut l, held)
    let v = compound(t, mut l, op, a, r, ty, t.node_type[target], t.node_type[rhs], at)
    if v < 0 { return }
    store(mut l, slot, p.fields, v, at)
}

/// `a op r` for a compound assignment `op=` on a place of FIR type `ty` and typed type `typed`.
fn compound(t: types.Typed, mut l: Lowering, op: str, a: int, r: int, ty: int, typed: int, rtyped: int, at: int) -> int {
    if op == "+=" && ty == 3 {
        let text = text_operand(t, mut l, r, rtyped, at)
        return put(mut l, "concat", 3, at, List[int](), [a, text])
    }
    if numeric_mode(op) >= 0 && numeric_needed(t.types[typed].kind, numeric_mode(op)) {
        return numeric_binary(t, mut l, typed, op, a, r, at)
    }
    let arith = arithmetic(op)
    if arith == "" { fail(mut l, "no lowering for the assignment {op}"); return -1 }
    put(mut l, arith, ty, at, List[int](), [a, r])
}

// ---- functions and the module -----------------------------------------------

fn result_type(l: Lowering, t: types.Typed, fn_type: int) -> int {
    let r = t.types[fn_type].inner
    if r < 0 { return 0 }
    l.type_map[r]
}

fn full_type(t: types.Typed, fn_type: int) -> int { t.types[fn_type].inner }

fn lower_function(s: front.Syntax, t: types.Typed, mut l: Lowering, d: int) {
    let node = t.decls[d].node
    let ft = t.decls[d].ty
    l.blocks = List[fir.Block]()
    l.slots = List[int]()
    l.loops = List[Loop]()
    l.scopes = List[Cleanup]()
    l.returned = -1
    l.result = result_type(l, t, ft)
    l.vr = l.vr_of[d]
    l.muts = List[int]()
    l.mut_types = List[int]()
    var m: int = 0
    while m < t.decls[d].count {
        let p = d + 1 + m
        let mty = l.type_map[t.decls[p].ty]
        if t.param_mode[p] == "mut" && mty != 0 { (mut l.muts).push(p); (mut l.mut_types).push(mty) }
        m += 1
    }
    l.full = full_type(t, ft)
    l.fsite = node_site(s, mut l, node)
    var params = List[int]()
    var i: int = 0
    while i < t.decls[d].count {
        let ty = l.type_map[t.decls[d + 1 + i].ty]
        if ty != 0 { (mut params).push(ty) }
        i += 1
    }
    let entry = new_block(mut l, params)
    start(mut l, entry)
    var k: int = 0
    i = 0
    while i < t.decls[d].count {
        let p = d + 1 + i
        let ty = l.type_map[t.decls[p].ty]
        if ty != 0 {
            let slot = new_slot(mut l, ty)
            l.slot_of[p] = slot
            store(mut l, slot, List[int](), k, l.fsite)
            k += 1
        }
        i += 1
    }
    let body = last_of(s, node)
    if kind_of(s, body) != "Block" { fail(mut l, "a function has no body"); return }
    let v0 = value(s, t, mut l, body)
    let tail_site = body_site(s, t, mut l, body)
    let v = coerce(t, mut l, v0, t.node_type[body], l.full, tail_site)
    if l.current >= 0 {
        if l.result == 0 || v < 0 { emit_return(mut l, List[int](), l.fsite) }
        else { emit_return(mut l, [v], l.fsite) }
    }
    let declared = if l.vr >= 0 then l.vr else l.result
    l.functions[l.fn_map[d]] = fir.Function { result: declared, params: move params, slots: move l.slots, blocks: move l.blocks }
    l.vr = -1
    l.slots = List[int]()
    l.blocks = List[fir.Block]()
}

// The site of a body's tail, where a conversion of its value would trap.
fn body_site(s: front.Syntax, t: types.Typed, mut l: Lowering, body: int) -> int {
    let tail = last_of(s, body)
    if tail >= 0 && kind_of(s, tail) == "Tail" { return site(s, t, mut l, last_of(s, tail)) }
    l.fsite
}

/// Give each struct its FIR id after the structs its fields name.
fn place_struct(t: types.Typed, mut l: Lowering, sd: int) {
    if l.struct_fir[sd] >= 0 { return }
    l.placing += 1
    var i: int = 0
    while i < t.decls[sd].count {
        let fty = t.decls[sd + 1 + i].ty
        if nominal(t, fty) { place_aggregate(t, mut l, t.types[fty].decl) }
        i += 1
    }
    var fields = List[int]()
    var offsets = List[int]()
    var words: int = 0
    i = 0
    while i < t.decls[sd].count {
        let f = sd + 1 + i
        let fty = t.decls[f].ty
        let ty = placed_type(t, mut l, fty)
        if ty == 0 { l.field_map[f] = -1 }
        else {
            l.field_map[f] = fields.len
            (mut fields).push(ty)
            (mut offsets).push(words)
            words += if ty == 3 then 2 else if ty >= fir.first_struct() then l.shapes[ty - fir.first_struct()].words else 1
        }
        i += 1
    }
    l.struct_fir[sd] = fir.first_struct() + l.shapes.len
    (mut l.shapes).push(fir.Shape { kind: "struct", fields: move fields, offsets: move offsets, words: words })
    placed(t, mut l)
}

fn fixed_type(kind: str) -> int {
    if kind == "unit" || kind == "never" { return 0 }
    if kind == "int" { return 1 }
    if kind == "bool" { return 2 }
    if kind == "str" { return 3 }
    if kind == "char" || kind == "byte" { return 1 }
    if kind == "i32" { return 5 }
    if kind == "i64" { return 6 }
    if kind == "u8" { return 7 }
    if kind == "u64" { return 8 }
    if kind == "uint" { return 9 }
    // A region value is the runtime's handle, one word (FIR edition 7).
    if kind == "region" { return 6 }
    let code = sem.numeric_code(kind)
    if code >= 0 { return fir.numeric_carrier(code) }
    -1
}

fn filled(n: int, v: int) -> List[int] {
    var out = List[int]()
    (mut out).reserve(n)
    var i: int = 0
    while i < n { (mut out).push(v); i += 1 }
    out
}

// `main`'s result: its ok value (or 0) is the status; an error prints
// `error: TAG` on stdout and exits 1, as the runtime's `main_err` documents.
fn main_error(t: types.Typed, mut l: Lowering, r: int, full: int) {
    let at = l.fsite
    let rf = place(t, mut l, full)
    let slot = new_slot(mut l, rf)
    store(mut l, slot, List[int](), r, at)
    let variants = copy l.shapes[rf - fir.first_struct()].fields
    var k: int = 0
    while k < variants.len {
        let v = load(mut l, slot, List[int](), rf, at)
        let matched = new_block(mut l, [variants[k]])
        let next = new_block(mut l, List[int]())
        let _ = put(mut l, "case", 0, at, [k, matched, next, 0], [v])
        start(mut l, matched)
        if k == 0 {
            let ok = l.type_map[t.types[full].inner]
            if ok == 0 { let zero = constant(mut l, 1, 0, at); let _ = put(mut l, "return", 0, at, List[int](), [zero]) }
            else { let x = put(mut l, "field", ok, at, [0], [0]); let _ = put(mut l, "return", 0, at, List[int](), [x]) }
        } else {
            let tag = t.row_tags[t.types[full].first + k - 1]
            let text = text_value(mut l, "error: " + t.tags[tag].name, at)
            let _ = put(mut l, "print", 0, at, List[int](), [text])
            let one = constant(mut l, 1, 1, at)
            let _ = put(mut l, "return", 0, at, List[int](), [one])
        }
        start(mut l, next)
        k += 1
    }
    let _ = put(mut l, "trap", 0, at, [4], List[int]())
}

/// Lower a checked unit to a verified FIR module. Bad is an internal error:
/// the typed tree broke an invariant the lowering relies on, or the module it
/// built does not verify.
pub fn lower(s: front.Syntax, t: types.Typed) -> fir.Module ! {Bad(str)} {
    if t.main < 0 { return Bad("lowering needs a main function") }
    var l = Lowering { failure: "", blobs: [s.file], sites: List[fir.Site](), shapes: List[fir.Shape](),
        functions: List[fir.Function](), type_map: List[int](), struct_fir: filled(t.decls.len, -1),
        field_map: filled(t.decls.len, -1), payload_fir: filled(t.decls.len, -1), payload_first: filled(t.decls.len, -1),
        payload_map: List[int](), fn_map: filled(t.decls.len, -1), slot_of: filled(t.decls.len, -1),
        site_of: filled(s.nodes.len, -1), splits: filled(s.nodes.len, -1), blocks: List[fir.Block](),
        current: -1, slots: List[int](), loops: List[Loop](), result: 0, fsite: 0, full: -1,
        tag_fir: filled(t.tags.len, -1), ok_types: List[int](), ok_records: List[int](), helpers: List[Helper](),
        placing: 0, pending: List[Pending](), draining: false, origin: resolve.origins(s), scopes: List[Cleanup](), returned: -1,
        vr_of: filled(t.decls.len, -1), vr: -1, muts: List[int](), mut_types: List[int](),
        region_exits: List[RegionExit](), region_pending: -1 }
    for ty in t.types { (mut l.type_map).push(-1) }
    for sd in t.structs { place_struct(t, mut l, sd) }
    for ed in t.enums { place_enum(t, mut l, ed) }
    var i: int = 0
    while i < t.types.len { let _ = place(t, mut l, i); i += 1 }
    let empty = fir.Function { result: 0, params: List[int](), slots: List[int](), blocks: List[fir.Block]() }
    (mut l.functions).push(copy empty)
    i = 0
    while i < t.functions.len {
        l.fn_map[t.functions[i]] = i + 1
        (mut l.functions).push(copy empty)
        i += 1
    }
    for d in t.functions { value_result_shape(t, mut l, d) }
    for d in t.functions {
        lower_function(s, t, mut l, d)
        if l.failure != "" { return Bad(l.failure) }
    }
    // Function 0 calls main and hands its int, or 0, to the process.
    l.blocks = List[fir.Block]()
    l.fsite = node_site(s, mut l, t.decls[t.main].node)
    let entry = new_block(mut l, List[int]())
    start(mut l, entry)
    let main_result = result_type(l, t, t.decls[t.main].ty)
    let r = put(mut l, "call", main_result, l.fsite, [l.fn_map[t.main]], List[int]())
    let full = full_type(t, t.decls[t.main].ty)
    if t.types[full].kind == "result" {
        main_error(t, mut l, r, full)
    } else if main_result == 0 {
        let zero = constant(mut l, 1, 0, l.fsite)
        let _ = put(mut l, "return", 0, l.fsite, List[int](), [zero])
    } else {
        let _ = put(mut l, "return", 0, l.fsite, List[int](), [r])
    }
    l.functions[0] = fir.Function { result: 1, params: List[int](), slots: move l.slots, blocks: move l.blocks }
    l.slots = List[int]()
    l.blocks = List[fir.Block]()
    generate_helpers(s, t, mut l)
    if l.failure != "" { return Bad(l.failure) }
    let m = fir.Module { blobs: move l.blobs, sites: move l.sites, shapes: move l.shapes, functions: move l.functions }
    // The verifier runs after the lowering, always.
    fir.verify(m)?
    m
}
