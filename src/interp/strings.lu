//! member: true

use fir
use sem

fn text_step(m: fir.Module, mut s: State, mut cursor: Cursor, ins: fir.Inst, dest: int, left: int, right: int) -> bool ! {Internal(str)} {
    let op = ins.data[0]
    if op == 13 { return text_materialize(m, mut s, mut cursor, ins, dest, left, right)? }
    if op >= 5 { return text_operation(m, mut s, mut cursor, ins, dest, left, right)? }
    if op == 0 { s.stack[dest] = s.stack[left + 1]; return true }
    if op == 4 {
        let flavor = ins.data[2]
        let bits = ins.data[1]
        if bits != 0 {
            var bound = if flavor == 0 then s.stack[left + 1] else if flavor == 4 then 4 else if flavor == 3 then 5 else 65
            if (bits / 8192) % 2 == 1 {
                let precision = (bits / 4294967296) % 65536
                if precision < bound { bound = precision }
            }
            let width = sem.format_width(bits)
            if width > bound { bound = width }
            let capacity = text_capacity(mut s)
            if capacity < 0 { return false }
            if bound > capacity { s.memory = true; return false }
            if !charge(mut s, bound * 4) { return false }
            var rendered = ""
            if flavor == 0 { rendered = sem.format_text(string_value(m, s, left), bits, false) }
            else if flavor == 3 { rendered = sem.format_text(if s.stack[left] == 0 then "false" else "true", bits, false) }
            else if flavor == 4 {
                let scalar = sem.scalar_text(s.stack[left]) else |_| { return Internal("FIR_INTERNAL invalid scalar encoding") }
                rendered = sem.format_text(scalar, bits, false)
            } else { rendered = sem.format_integer(s.stack[left], bits, flavor == 2) }
            store_string(mut s, rendered, dest)
            return true
        }
        if flavor == 0 {
            if !charge(mut s, 128) { return false }
            let view = string_value(m, s, left)
            store_string(mut s, view, dest)
            return true
        }
        // Integer and scalar encodings have bounded output size; charge their
        // temporary builders and the retained descriptor before construction.
        if !charge(mut s, 256) { return false }
        var rendered = ""
        if flavor == 3 { rendered = if s.stack[left] == 0 then "false" else "true" }
        else if flavor == 4 { rendered = sem.scalar_text(s.stack[left]) else |_| { return Internal("FIR_INTERNAL invalid scalar encoding") } }
        else { rendered = sem.decimal(if flavor == 2 then "uint" else "int", s.stack[left]) }
        store_string(mut s, rendered, dest)
        return true
    }
    let value = string_value(m, s, left)
    if op == 3 {
        let index = s.stack[right]
        if index < 0 || index >= value.len {
            if ins.data[1] == 0 { return trapped(mut cursor, 3, ins.site) }
            s.stack[dest] = 1; s.stack[dest + 1] = 0
            return true
        }
        // Indexing the byte view does not materialize a List[byte].
        let octet = value.bytes()[index] as int
        if ins.data[1] == 0 { s.stack[dest] = octet }
        else { s.stack[dest] = 0; s.stack[dest + 1] = octet }
        return true
    }
    let hi = s.stack[cursor.base + s.plans[cursor.function].blocks[cursor.block].offsets[ins.uses[2]]]
    let sliced = sem.text_window(value, s.stack[right], hi, ins.data[1]) else |_| {
        if op == 1 { return trapped(mut cursor, 3, ins.site) }
        s.stack[dest] = 1
        s.stack[dest + 1] = 0
        s.stack[dest + 2] = 0
        return true
    }
    // The view shares bytes; only its retained descriptor/table growth is
    // charged. No charge proportional to the receiver's bytes is invented.
    if !charge(mut s, 128) { return false }
    if op == 1 { store_string(mut s, sliced, dest) }
    else { s.stack[dest] = 0; store_string(mut s, sliced, dest + 1) }
    true
}
