//! member: true

use fir
use sem

struct Cursor { function: int, block: int, pc: int, base: int, kind: str, status: int, trap: int, site: int }

fn trapped(mut cursor: Cursor, kind: int, site: int) -> bool {
    cursor.kind = "trap"; cursor.status = 134; cursor.trap = kind; cursor.site = site
    false
}

// The instruction is a read parameter: do not deep-copy its operand vectors
// on each dispatch, or a nonallocating program would retain uncharged storage.
fn step(m: fir.Module, mut s: State, mut cursor: Cursor, ins: fir.Inst) -> bool ! {Bad(str), Internal(str)} {
    let function = cursor.function
    let block = cursor.block
    let pc = cursor.pc
    let base = cursor.base
    var probe: int = 0
    while probe < m.functions[function].blocks[block].code.len {
        if m.functions[function].blocks[block].code[probe].site < 0 {
            return Internal("FIR_INTERNAL negative instruction site")
        }
        probe += 128
    }
    let dest = base + s.plans[function].blocks[block].offsets[m.functions[function].blocks[block].params.len + pc]
    let op = ins.op
    var left: int = 0
    var right: int = 0
    if ins.uses.len > 0 { left = base + s.plans[function].blocks[block].offsets[ins.uses[0]] }
    if ins.uses.len > 1 { right = base + s.plans[function].blocks[block].offsets[ins.uses[1]] }
    if op == "const" {
        s.stack[dest] = ins.data[0]
    } else if op == "string" {
        s.stack[dest] = 0 - ins.data[0] - 1
        s.stack[dest + 1] = m.blobs[ins.data[0]].len
    } else if sem.arithmetic(op) {
        let checked = sem.evaluate(op, fir.kind(ins.ty), s.stack[left], s.stack[right])
        if checked.trap != 0 { return trapped(mut cursor, checked.trap, ins.site) }
        s.stack[dest] = checked.value
    } else if op == "eq" || op == "lt" {
        let ty = s.plans[function].blocks[block].types[ins.uses[0]]
        var yes = false
        if ty == 3 {
            let a = string_value(m, s, left)
            let b = string_value(m, s, right)
            yes = if op == "eq" then a == b else a < b
        } else if op == "eq" { yes = s.stack[left] == s.stack[right] }
        else { yes = sem.less(fir.kind(ty), s.stack[left], s.stack[right]) }
        s.stack[dest] = if yes then 1 else 0
    } else if op == "not" {
        if ins.ty == 2 { s.stack[dest] = if s.stack[left] == 0 then 1 else 0 }
        else { s.stack[dest] = sem.complement(fir.kind(ins.ty), s.stack[left]) }
    } else if op == "struct" {
        var at = dest
        for v in ins.uses {
            let from = base + s.plans[function].blocks[block].offsets[v]
            let width = fir.words(m, s.plans[function].blocks[block].types[v])
            copy_words(mut s, from, at, width)
            at += width
        }
    } else if op == "field" {
        let ty = s.plans[function].blocks[block].types[ins.uses[0]]
        let from = left + m.shapes[ty - fir.first_struct()].offsets[ins.data[0]]
        copy_words(mut s, from, dest, fir.words(m, ins.ty))
    } else if op == "load" || op == "store" {
        let slot = ins.data[0]
        let place = fir.place(m, m.functions[function].slots[slot], ins.data, 1) else |_| { return Internal("FIR_INTERNAL invalid verified field path") }
        let at = base + s.plans[function].slots[slot] + place.offset
        let width = fir.words(m, place.ty)
        var i: int = 0
        if op == "load" {
            while i < width {
                if !s.initialized[at + i] { return Bad("FIR_STATE load before store") }
                i += 1
            }
            copy_words(mut s, at, dest, width)
        } else {
            copy_words(mut s, left, at, width)
            while i < width { s.initialized[at + i] = true; i += 1 }
        }
    } else if op == "call" {
        let callee = ins.data[0]
        let child = base + s.plans[function].words
        let needed = child + s.plans[callee].words
        if !grow_stack(mut s, needed) { return false }
        s.stack[child] = function
        s.stack[child + 1] = block
        s.stack[child + 2] = pc + 1
        s.stack[child + 3] = base
        s.stack[child + 4] = dest
        reset_slots(m, mut s, callee, child)
        var i: int = 0
        while i < ins.uses.len {
            let from = base + s.plans[function].blocks[block].offsets[ins.uses[i]]
            let to = child + s.plans[callee].blocks[0].offsets[i]
            copy_words(mut s, from, to, fir.words(m, m.functions[callee].params[i]))
            i += 1
        }
        cursor.function = callee; cursor.block = 0; cursor.pc = 0; cursor.base = child
        return true
    } else if op == "concat" || op == "format" {
        if !render(m, mut s, function, block, base, ins, dest)? { return false }
    } else if op == "list" {
        if !charge(mut s, 128) { return false }
        s.stack[dest] = s.lists.len
        (mut s.lists).push(IntList { values: List[int](), capacity: 0 })
    } else if op == "push" {
        let id = s.stack[left]
        let value = s.stack[right]
        if !list_push(mut s, id, value) { return false }
    } else if op == "get" {
        let id = s.stack[left]
        let index = s.stack[right]
        if index < 0 || index >= s.lists[id].values.len { return trapped(mut cursor, 3, ins.site) }
        s.stack[dest] = s.lists[id].values[index]
    } else if op == "len" {
        s.stack[dest] = s.lists[s.stack[left]].values.len
    } else if op == "print" {
        let ty = s.plans[function].blocks[block].types[ins.uses[0]]
        if !print_value(m, mut s, ty, left) { return false }
    } else if op == "jump" {
        edge(m, mut s, function, block, base, ins, ins.data[0], 0, ins.uses.len)
        cursor.block = ins.data[0]; cursor.pc = 0
        return true
    } else if op == "branch" {
        let n = ins.data[2]
        let yes = s.stack[left] != 0
        let target = if yes then ins.data[0] else ins.data[1]
        let start = if yes then 1 else 1 + n
        let count = if yes then n else ins.uses.len - 1 - n
        edge(m, mut s, function, block, base, ins, target, start, count)
        cursor.block = target; cursor.pc = 0
        return true
    } else if op == "return" {
        if base == 0 {
            var status = s.stack[left] % 256
            if status < 0 { status += 256 }
            cursor.kind = "exit"; cursor.status = status
            return false
        }
        if ins.uses.len != 0 {
            copy_words(mut s, left, s.stack[base + 4], fir.words(m, m.functions[function].result))
        }
        cursor.function = s.stack[base]
        cursor.block = s.stack[base + 1]
        cursor.pc = s.stack[base + 2]
        cursor.base = s.stack[base + 3]
        return true
    } else if op == "trap" {
        return trapped(mut cursor, ins.data[0], ins.site)
    } else { return Internal("FIR_INTERNAL unimplemented verified instruction") }
    cursor.pc += 1
    true
}
