//! member: true

use fir

/// Execute verified FIR with explicit frames and cumulative allocation bounds.
/// Every instruction is dispatched once in program order; no optimizer exists.
/// Bad rejects input; Internal reports an execution invariant failure.
pub fn run(m: fir.Module, max_steps: int, max_bytes: int) -> Outcome ! Failure {
    if max_steps < 0 || max_bytes < 0 { return Bad("FIR_LIMIT budgets must be nonnegative") }
    fir.verify(m)?
    if max_bytes < 256 {
        return Outcome { kind: "refused", status: 4, code: "FIR_MEMORY_BUDGET", trap: 0, site: -1, steps: 0, bytes: 0 }
    }
    var s = State { plans: List[Plan](), stack: List[int](), initialized: List[bool](), capacity: 0,
        strings: List[str](), lists: List[IntList](), spent: 256, limit: max_bytes, steps: 0, memory: false }
    if !prepare(m, mut s) { return refused(s) }
    if !grow_stack(mut s, s.plans[0].words) { return refused(s) }
    var cursor = Cursor { function: 0, block: 0, pc: 0, base: 0, kind: "", status: 0, trap: 0, site: -1 }
    while true {
        if s.steps >= max_steps { return refused(s) }
        s.steps += 1
        let function = cursor.function
        let block = cursor.block
        let pc = cursor.pc
        let more = step(m, mut s, mut cursor, m.functions[function].blocks[block].code[pc])?
        if !more {
            if s.memory { return refused(s) }
            return outcome(s, cursor.kind, cursor.status, "", cursor.trap, cursor.site)
        }
    }
    return Internal("FIR_INTERNAL execution left its dispatch loop")
}
