//! member: true

use fir
use sem

// Format parts once, with every temporary charged before construction. Four
// bytes per output byte cover the byte builder, its growth and UTF-8 publication.
fn render(m: fir.Module, mut s: State, function: int, block: int, base: int, ins: fir.Inst, dest: int) -> bool ! {Internal(str)} {
    if ins.uses.len > (s.limit - s.spent) / 64 { s.memory = true; return false }
    if !charge(mut s, 128 + ins.uses.len * 64) { return false }
    var pieces = List[str]()
    (mut pieces).reserve(ins.uses.len)
    var length: int = 0
    for v in ins.uses {
        let ty = s.plans[function].blocks[block].types[v]
        let at = base + s.plans[function].blocks[block].offsets[v]
        var piece = ""
        if ty == 3 { piece = string_value(m, s, at) }
        else if ty == 2 { piece = if s.stack[at] == 0 then "false" else "true" }
        else {
            if !charge(mut s, 128) { return false }
            piece = sem.decimal(fir.kind(ty), s.stack[at])
        }
        let available = (s.limit - s.spent) / 4
        if length > available || piece.len > available - length { s.memory = true; return false }
        length += piece.len
        (mut pieces).push(piece)
    }
    if !charge(mut s, 128) { return false }
    if length > (s.limit - s.spent) / 4 { s.memory = true; return false }
    if !charge(mut s, length * 4) { return false }
    var bytes = List[byte]()
    (mut bytes).reserve(length)
    for piece in pieces { fir.text(mut bytes, piece) }
    let text = str_from_utf8(bytes) else |_| { return Internal("FIR_INTERNAL invalid rendered UTF-8") }
    store_string(mut s, text, dest)
    true
}

fn print_value(m: fir.Module, mut s: State, ty: int, at: int) -> bool {
    if ty == 3 { print(string_value(m, s, at)); return true }
    if ty == 2 { print(if s.stack[at] == 0 then "false" else "true"); return true }
    if !charge(mut s, 128) { return false }
    print(sem.decimal(fir.kind(ty), s.stack[at]))
    true
}

// Grow a list's storage to hold one more element, geometrically, charging the
// new capacity's words before it exists. Reuse is never charged again.
fn list_grow(mut s: State, id: int, wanted: int) -> bool {
    if wanted <= s.lists[id].capacity { return true }
    let width = if s.lists[id].width == 0 then 1 else s.lists[id].width
    var capacity = s.lists[id].capacity
    if capacity == 0 { capacity = 4 }
    while capacity < wanted {
        if capacity > (s.limit - s.spent) / (16 * width) { s.memory = true; return false }
        capacity *= 2
    }
    if capacity > (s.limit - s.spent) / (8 * width) { s.memory = true; return false }
    if !charge(mut s, capacity * width * 8) { return false }
    (mut s.lists[id].values).reserve(capacity * s.lists[id].width)
    s.lists[id].capacity = capacity
    true
}

// A fresh list of `width`-word elements; its header is charged.
fn list_new(mut s: State, width: int) -> int {
    if !charge(mut s, 128) { return -1 }
    (mut s.lists).push(ListState { values: List[int](), width: width, length: 0, capacity: 0 })
    s.lists.len - 1
}

// Append the element at stack word `from`.
fn list_push(mut s: State, id: int, from: int) -> bool {
    if !list_grow(mut s, id, s.lists[id].length + 1) { return false }
    var k: int = 0
    while k < s.lists[id].width {
        let word = s.stack[from + k]
        (mut s.lists[id].values).push(word)
        k += 1
    }
    s.lists[id].length += 1
    true
}

// Copy element `index`, already bounds-checked, to stack word `dest`.
fn list_read(mut s: State, id: int, index: int, dest: int) {
    let width = s.lists[id].width
    var k: int = 0
    while k < width {
        s.stack[dest + k] = s.lists[id].values[index * width + k]
        k += 1
    }
}

// Overwrite element `index`, already bounds-checked, from stack word `from`.
fn list_write(mut s: State, id: int, index: int, from: int) {
    let width = s.lists[id].width
    var k: int = 0
    while k < width {
        let word = s.stack[from + k]
        s.lists[id].values[index * width + k] = word
        k += 1
    }
}

// Remove the last element; the storage stays the list's.
fn list_drop_last(mut s: State, id: int) {
    var k: int = 0
    while k < s.lists[id].width {
        let _ = (mut s.lists[id].values).pop() else 0
        k += 1
    }
    s.lists[id].length -= 1
}

// Empty a list and keep its capacity.
fn list_clear(mut s: State, id: int) {
    while s.lists[id].length > 0 { list_drop_last(mut s, id) }
}

// A fresh list of elements lo..hi, at exact capacity.
fn list_slice(mut s: State, id: int, lo: int, hi: int) -> int {
    let width = s.lists[id].width
    let fresh = list_new(mut s, width)
    if fresh < 0 { return -1 }
    if hi > lo && !list_grow(mut s, fresh, hi - lo) { return -1 }
    var i = lo * width
    while i < hi * width {
        let word = s.lists[id].values[i]
        (mut s.lists[fresh].values).push(word)
        i += 1
    }
    s.lists[fresh].length = hi - lo
    fresh
}

// ---- maps ---------------------------------------------------------------------

// A key's hash, from its bytes for `str` and its word otherwise.
fn key_hash(m: fir.Module, s: State, string: bool, at: int) -> int {
    let p = 1000000007
    if string {
        var h: int = 7
        for b in string_value(m, s, at).bytes() { h = (h * 31 + b as int) % p }
        return h
    }
    var h = s.stack[at] % p
    if h < 0 { h += p }
    h
}

// Whether entry `e` of map `id` holds the key at stack word `at`.
fn key_equal(m: fir.Module, s: State, id: int, e: int, at: int) -> bool {
    let base = e * s.maps[id].words
    if s.maps[id].string {
        let a = s.maps[id].entries[base]
        let stored = if a < 0 then m.blobs[0 - a - 1] else s.strings[a]
        return stored == string_value(m, s, at)
    }
    s.maps[id].entries[base] == s.stack[at]
}

// The entry holding the key at stack word `at`, or -1.
fn map_find(m: fir.Module, s: State, id: int, at: int) -> int {
    let size = s.maps[id].index.len
    if size == 0 { return -1 }
    var slot = key_hash(m, s, s.maps[id].string, at) % size
    while true {
        let e = s.maps[id].index[slot]
        if e == 0 { return -1 }
        if key_equal(m, s, id, e - 1, at) { return e - 1 }
        slot = (slot + 1) % size
    }
    -1
}

// Rebuild the open-addressed index over every entry, at `size` slots.
fn map_index(m: fir.Module, mut s: State, id: int, size: int) {
    var table = List[int]()
    (mut table).reserve(size)
    var i: int = 0
    while i < size { (mut table).push(0); i += 1 }
    var e: int = 0
    while e < s.maps[id].count {
        let base = e * s.maps[id].words
        var h: int = 0
        if s.maps[id].string {
            let a = s.maps[id].entries[base]
            let text = if a < 0 then m.blobs[0 - a - 1] else s.strings[a]
            h = 7
            for b in text.bytes() { h = (h * 31 + b as int) % 1000000007 }
        } else {
            h = s.maps[id].entries[base] % 1000000007
            if h < 0 { h += 1000000007 }
        }
        var slot = h % size
        while table[slot] != 0 { slot = (slot + 1) % size }
        table[slot] = e + 1
        e += 1
    }
    s.maps[id].index = table
}

// A fresh map of `key`-word keys and `words`-word entries; its header is charged.
fn map_new(mut s: State, key: int, words: int, string: bool) -> int {
    if !charge(mut s, 128) { return -1 }
    (mut s.maps).push(MapState { entries: List[int](), key: key, words: words, string: string, count: 0, capacity: 0, index: List[int]() })
    s.maps.len - 1
}

// Bind the key at `at` to the value at `value`: replace a bound entry's value
// in place, or append an entry, keeping insertion order.
fn map_insert(m: fir.Module, mut s: State, id: int, at: int, value: int) -> bool {
    let key = s.maps[id].key
    let words = s.maps[id].words
    let found = map_find(m, s, id, at)
    if found >= 0 {
        var k: int = 0
        while k < words - key {
            let word = s.stack[value + k]
            s.maps[id].entries[found * words + key + k] = word
            k += 1
        }
        return true
    }
    let count = s.maps[id].count
    if count == s.maps[id].capacity {
        let width = if words == 0 then 1 else words
        if count > (s.limit - s.spent) / (16 * width) { s.memory = true; return false }
        let capacity = if count == 0 then 4 else count * 2
        if !charge(mut s, capacity * width * 8) { return false }
        (mut s.maps[id].entries).reserve(capacity * words)
        s.maps[id].capacity = capacity
    }
    var k: int = 0
    while k < key { let word = s.stack[at + k]; (mut s.maps[id].entries).push(word); k += 1 }
    k = 0
    while k < words - key { let word = s.stack[value + k]; (mut s.maps[id].entries).push(word); k += 1 }
    s.maps[id].count = count + 1
    let size = s.maps[id].index.len
    if (count + 1) * 2 > size {
        var grown = if size == 0 then 8 else size * 2
        while (count + 1) * 2 > grown { grown *= 2 }
        if grown > (s.limit - s.spent) / 8 { s.memory = true; return false }
        if !charge(mut s, grown * 8) { return false }
        map_index(m, mut s, id, grown)
        return true
    }
    var slot = key_hash(m, s, s.maps[id].string, at) % size
    while s.maps[id].index[slot] != 0 { slot = (slot + 1) % size }
    s.maps[id].index[slot] = count + 1
    true
}

// Copy entry `e`'s value to stack word `dest`.
fn map_value_at(mut s: State, id: int, e: int, dest: int) {
    let key = s.maps[id].key
    let words = s.maps[id].words
    var k: int = 0
    while k < words - key {
        s.stack[dest + k] = s.maps[id].entries[e * words + key + k]
        k += 1
    }
}

// Erase entry `e`: later entries shift down, so insertion order survives,
// and the index is rebuilt in its own storage.
fn map_erase(m: fir.Module, mut s: State, id: int, e: int) {
    let words = s.maps[id].words
    var i = e * words
    let end = (s.maps[id].count - 1) * words
    while i < end {
        s.maps[id].entries[i] = s.maps[id].entries[i + words]
        i += 1
    }
    var k: int = 0
    while k < words { let _ = (mut s.maps[id].entries).pop() else 0; k += 1 }
    s.maps[id].count -= 1
    map_index(m, mut s, id, s.maps[id].index.len)
}

// Drop every entry and keep the storage.
fn map_clear(m: fir.Module, mut s: State, id: int) {
    while s.maps[id].count > 0 {
        var k: int = 0
        while k < s.maps[id].words { let _ = (mut s.maps[id].entries).pop() else 0; k += 1 }
        s.maps[id].count -= 1
    }
    map_index(m, mut s, id, s.maps[id].index.len)
}

// A fresh list of every entry as a (key, value) record, in insertion order.
fn map_pairs(mut s: State, id: int) -> int {
    let words = s.maps[id].words
    let fresh = list_new(mut s, words)
    if fresh < 0 { return -1 }
    let count = s.maps[id].count
    if count > 0 && !list_grow(mut s, fresh, count) { return -1 }
    var i: int = 0
    while i < count * words {
        let word = s.maps[id].entries[i]
        (mut s.lists[fresh].values).push(word)
        i += 1
    }
    s.lists[fresh].length = count
    fresh
}
