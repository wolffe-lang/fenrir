//! member: true

use fir

/// Bad rejects input; Internal reports an interpreter invariant failure.
pub error Failure = {Bad(str), Internal(str)}

/// Program completion and tool refusal remain distinct even at exit status 4.
pub struct Outcome {
    pub kind: str
    pub status: int
    pub code: str
    pub trap: int
    pub site: int
    pub steps: int
    pub bytes: int
}

struct BlockPlan { offsets: List[int], types: List[int] }
struct Plan { blocks: List[BlockPlan], slots: List[int], scratch: int, words: int }
// A list's elements, `width` words each, flat; `capacity` counts elements. `home` is the region ambient where
// it was made (0 the root) and `elem` its element's bytes in the region ledger.
struct ListState { values: List[int], width: int, length: int, capacity: int, home: int, elem: int }
// A map's entries in insertion order, each its key's words then its value's,
// flat; `index` is an open-addressed table of entry number + 1 (0 is empty),
// rebuilt when it fills past half or an entry is removed.
struct MapState { entries: List[int], key: int, words: int, string: bool, count: int, capacity: int, index: List[int], home: int }
// A region made by `region` new: its ledger, its budget (-1 for none) and whether it is freed.
struct RegionState { bytes: int, cap: int, freed: bool }
struct State {
    plans: List[Plan]
    stack: List[int]
    initialized: List[bool]
    capacity: int
    strings: List[str]
    // Each string's region: the ambient where it was made, or its source's for a view (0 the root).
    string_homes: List[int]
    lists: List[ListState]
    maps: List[MapState]
    spent: int
    limit: int
    steps: int
    memory: bool
    // The regions made so far (a handle is an index + 1), the ambient one (0 the root), and whether an
    // allocation passed its region's budget (the trap `alloc-contract`).
    regions: List[RegionState]
    ambient: int
    breach: bool
}

// Charges include capacity overhead, not merely a logical element count. The
// cumulative ledger never refunds storage, even if the host runtime frees it.
fn charge(mut s: State, bytes: int) -> bool {
    if bytes < 0 || bytes > s.limit - s.spent { s.memory = true; return false }
    s.spent += bytes
    true
}

fn outcome(s: State, kind: str, status: int, code: str, trap: int, site: int) -> Outcome {
    Outcome { kind: kind, status: status, code: code, trap: trap, site: site, steps: s.steps, bytes: s.spent }
}

fn refused(s: State) -> Outcome {
    if s.memory { return outcome(s, "refused", 4, "FIR_MEMORY_BUDGET", 0, -1) }
    outcome(s, "refused", 4, "FIR_STEP_BUDGET", 0, -1)
}

// Preallocate a geometric high-water stack. Returns reuse its words without
// allocations. Five header words save the caller and its result destination.
fn grow_stack(mut s: State, needed: int) -> bool {
    if needed <= s.capacity { return true }
    var capacity = s.capacity
    if capacity == 0 { capacity = 64 }
    while capacity < needed {
        if capacity > (s.limit - s.spent) / 32 { s.memory = true; return false }
        capacity *= 2
    }
    if capacity > (s.limit - s.spent) / 16 { s.memory = true; return false }
    if !charge(mut s, capacity * 16) { return false }
    (mut s.stack).reserve(capacity)
    (mut s.initialized).reserve(capacity)
    while s.stack.len < capacity {
        (mut s.stack).push(0)
        (mut s.initialized).push(false)
    }
    s.capacity = capacity
    true
}

fn copy_words(mut s: State, from: int, to: int, count: int) {
    var i: int = 0
    while i < count { s.stack[to + i] = s.stack[from + i]; i += 1 }
}

fn string_value(m: fir.Module, s: State, at: int) -> str {
    let id = s.stack[at]
    if id < 0 { return m.blobs[0 - id - 1] }
    s.strings[id]
}

// [mem.region.account.1], [mem.region.cap.1]: the program's region ledger, in the interpreter's own units (only
// relations are compared): a list charges its element bytes at each new capacity (u8 and bool 1, i32 4, else 8 a
// word), every growth kept; a made str charges its bytes. The root is not ledgered. A charge past the budget is
// the breach.
fn ledger(mut s: State, home: int, bytes: int) -> bool {
    if home <= 0 || bytes <= 0 { return true }
    let r = home - 1
    if s.regions[r].cap >= 0 && s.regions[r].bytes + bytes > s.regions[r].cap { s.breach = true; return false }
    s.regions[r].bytes += bytes
    true
}

// A str a producer made (rendering, repeat, replace, case mapping, construction): charged to the ambient region.
fn made(mut s: State, value: str, dest: int) -> bool {
    if !ledger(mut s, s.ambient, value.len) { return false }
    store_string(mut s, value, dest, s.ambient)
    true
}

// The region of the string at stack word `at`: a literal's bytes and storage made outside every region are the
// root's (0), never poisoned.
fn string_home(s: State, at: int) -> int {
    let id = s.stack[at]
    if id < 0 || id >= s.string_homes.len { return 0 }
    s.string_homes[id]
}

// [mem.region.escape]: storage whose region is freed is poisoned; reading it is the fenrir-internal trap
// `region-fault`, which no correct program reaches.
fn poisoned(s: State, home: int) -> bool { home > 0 && s.regions[home - 1].freed }

// The ledger bytes of one element of FIR type `ty`.
fn element_bytes(m: fir.Module, ty: int) -> int {
    if ty == 7 || ty == 2 { return 1 }
    if ty == 5 { return 4 }
    fir.words(m, ty) * 8
}

fn store_string(mut s: State, value: str, dest: int, home: int) {
    s.stack[dest] = s.strings.len
    s.stack[dest + 1] = value.len
    (mut s.strings).push(value)
    (mut s.string_homes).push(home)
}

fn reset_slots(m: fir.Module, mut s: State, function: int, base: int) {
    var i: int = 0
    while i < m.functions[function].slots.len {
        let at = base + s.plans[function].slots[i]
        let count = fir.words(m, m.functions[function].slots[i])
        var k: int = 0
        while k < count { s.initialized[at + k] = false; k += 1 }
        i += 1
    }
}
