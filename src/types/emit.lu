//! member: true

use front

fn escaped(text: str) -> str {
    text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t").replace("\0", "\\0")
}

fn report(code: str, message: str, span: front.Span) {
    eprint("{span.file}:{span.line}:{span.col}: error[{code}]: {message} (bytes {span.start}..{span.end})")
}

fn valued(s: front.Syntax, n: int) -> bool {
    let k = kind_of(s, n)
    if k == "Text" { return true }
    if k == "Literal" {
        let t = token_of(s, n)
        return t == "int" || t == "true" || t == "false" || t == "raw"
    }
    negative_literal(s, n)
}

/// Print the stable text form of a successful check (docs/TYPED.md).
fn dump(s: front.Syntax, t: Typed) {
    print("typed/1 \"{escaped(s.file)}\" root={s.root} nodes={s.nodes.len}")
    var i: int = 0
    while i < t.types.len {
        let ty = copy t.types[i]
        var line = "type {i} {ty.kind} {ty.decl} {ty.inner} {ty.count}"
        var k: int = 0
        let rowed = ty.kind == "result" || ty.kind == "row"
        while k < ty.count {
            let item = if rowed then t.row_tags[ty.first + k] else t.type_params[ty.first + k]
            line = line + " {item}"
            k += 1
        }
        print(line)
        i += 1
    }
    i = 0
    while i < t.tags.len {
        let tag = copy t.tags[i]
        var line = "tag {i} \"{escaped(tag.name)}\" {tag.count}"
        var k: int = 0
        while k < tag.count { line = line + " {t.type_params[tag.first + k]}"; k += 1 }
        print(line)
        i += 1
    }
    i = 0
    while i < t.decls.len {
        let d = copy t.decls[i]
        print("decl {i} {d.kind} \"{escaped(d.name)}\" {d.node} {d.ty} {d.owner} {d.index} {d.count}")
        i += 1
    }
    i = 0
    while i < t.texts.len {
        print("text {i} \"{escaped(t.texts[i])}\"")
        i += 1
    }
    i = 0
    while i < s.nodes.len {
        let value = if valued(s, i) then "{t.node_value[i]}" else "-"
        print("node {i} {s.nodes[i].kind} {t.node_type[i]} {t.node_decl[i]} {t.node_site[i]} {value}")
        i += 1
    }
}

/// `fenrir --emit=analysis FILE`: each checked function's pattern-coverage
/// counters (docs/TYPED.md), printed even when checking refuses; the status
/// is the typed view's.
pub fn analysis(path: str) -> int {
    let source = load(path)
    print("analysis/1 \"{escaped(path)}\"")
    for a in source.typed.analysis {
        print("function {a.function} \"{escaped(a.name)}\" {a.cells} {a.bytes} \"{a.cap}\"")
    }
    source.status
}

/// `fenrir --emit=typed FILE`: 0 typed, 2 rejected or unreadable, 4 outside
/// the core (F0001), past the nesting rail (F0002) or past the pattern
/// analysis budget (F0004), 70 internal.
pub fn emit(path: str) -> int {
    let source = load(path)
    if source.status != 0 { return source.status }
    dump(source.syntax, source.typed)
    0
}
