//! member: true

use front
use resolve
use sem

/// One interned type; see docs/TYPED.md.
pub struct Type {
    pub kind: str
    pub decl: int
    pub inner: int
    pub first: int
    pub count: int
}

/// The resolved, typed tree: side tables keyed by AST node id.
pub struct Typed {
    pub code: str
    pub message: str
    pub error: front.Span
    pub types: List[Type]
    pub type_params: List[int]
    pub decls: List[resolve.Decl]
    pub param_mode: List[str]   // per decl: a parameter's mode, `mut` or `take`, else ""
    pub texts: List[str]
    pub node_type: List[int]
    pub node_decl: List[int]
    pub node_site: List[int]
    pub node_value: List[int]
    pub functions: List[int]
    pub structs: List[int]
    pub enums: List[int]
    pub warnings: List[Warning]
    pub analysis: List[Analysis]
    pub tags: List[Tag]
    pub row_tags: List[int]
    pub main: int
}

/// A diagnostic that never changes a successful status by itself.
pub struct Warning {
    pub code: str
    pub message: str
    pub node: int
}

/// One function's pattern-coverage counters; `cap` names an exhausted limit.
pub struct Analysis {
    pub function: int
    pub name: str
    pub cells: int
    pub bytes: int
    pub cap: str
}

struct Checker {
    code: str
    message: str
    at: int
    types: List[Type]
    type_params: List[int]
    keys: resolve.Names
    key_type: List[int]
    decl_type: List[int]
    term: List[int]
    value: List[int]
    texts: List[str]
    bound_literal: List[bool]
    parent: List[int]
    bound: List[int]
    literals: List[int]
    visited: List[int]
    locals: List[int]
    result: int
    function: str
    known_tags: resolve.Names
    matches: List[int]
    redirect: List[int]
    settle: List[int]
    in_pattern: List[bool]
    alternatives: int
    pattern_undo: List[PatternUndo]
    pattern_binds: List[PatternBinding]
    warnings: List[Warning]
    analysis: List[Analysis]
    tags: List[Tag]
    row_tags: List[int]
    open: List[bool]
    full: int
    dotted: List[bool]
    dotted_self: bool
    // `f64`, interned on first use; -1 before (a float-free program keeps its type table).
    float_id: int
    // `region`, interned on first use like `f64`.
    region_id: int
    // Per literal variable: 0 an `{integer}` literal, 1 a `{float}` literal, 3 an integer
    // value a binding named, which never adopts a float ([type.numlit.value]).
    var_kind: List[int]
    floats: List[int]
}

fn unit_type() -> int { 0 }
fn int_type() -> int { 1 }
fn bool_type() -> int { 2 }
fn str_type() -> int { 3 }
fn never_type() -> int { 4 }
fn i32_type() -> int { 5 }
fn char_type() -> int { 10 }
fn byte_type() -> int { 11 }

fn kind_of(s: front.Syntax, n: int) -> str { s.nodes[n].kind }
fn first_of(s: front.Syntax, n: int) -> int { s.nodes[n].first }
fn next_of(s: front.Syntax, n: int) -> int { s.nodes[n].next }
fn last_of(s: front.Syntax, n: int) -> int { s.nodes[n].last }
fn token_of(s: front.Syntax, n: int) -> str { s.tokens[s.nodes[n].token].kind }
fn spell_of(s: front.Syntax, n: int) -> str {
    let t = s.nodes[n].token
    s.text[s.tokens[t].span.start..s.tokens[t].span.end]
}
fn source_of(s: front.Syntax, n: int) -> str { s.text[s.nodes[n].span.start..s.nodes[n].span.end] }

fn fail(mut c: Checker, code: str, message: str, node: int) {
    if c.code == "" { c.code = code; c.message = message; c.at = node }
}

fn ordinal(i: int) -> str {
    if i == 0 { return "1st" }
    if i == 1 { return "2nd" }
    if i == 2 { return "3rd" }
    "{i + 1}th"
}

fn builtin(mut c: Checker, kind: str) {
    (mut c.types).push(Type { kind: kind, decl: -1, inner: -1, first: -1, count: 0 })
    (mut c.open).push(false)
}

/// The id of a function or result type, interning it on first use.
fn compound(mut c: Checker, kind: str, inner: int, params: List[int]) -> int {
    var key = "{kind} {inner}"
    for p in params { key = key + " {p}" }
    let k = resolve.intern(mut c.keys, key)
    if k < c.key_type.len { return c.key_type[k] }
    let id = c.types.len
    let first = c.type_params.len
    for p in params { (mut c.type_params).push(p) }
    (mut c.types).push(Type { kind: kind, decl: -1, inner: inner, first: if kind == "fn" then first else -1, count: params.len })
    (mut c.open).push(false)
    (mut c.key_type).push(id)
    id
}

fn type_name(c: Checker, decls: List[resolve.Decl], t: int) -> str {
    if t < 0 { return if floating(c, t) then "{{float}}" else "{{integer}}" }
    let ty = copy c.types[t]
    if ty.kind == "unit" { return "()" }
    if ty.kind == "struct" || ty.kind == "enum" || ty.kind == "adapter" { return decls[ty.decl].name }
    if ty.kind == "result" {
        if ty.count == 0 { return "!" + type_name(c, decls, ty.inner) }
        return type_name(c, decls, ty.inner) + " ! " + row_text(c, decls, row_of(c, t))
    }
    if ty.kind == "row" { return row_text(c, decls, row_of(c, t)) }
    if ty.kind == "list" { return "List[" + type_name(c, decls, ty.inner) + "]" }
    if ty.kind == "map" { return "Map[" + type_name(c, decls, param(c, t, 0)) + ", " + type_name(c, decls, param(c, t, 1)) + "]" }
    if ty.kind == "tuple" {
        var text = "("
        var i: int = 0
        while i < ty.count {
            if i > 0 { text = text + ", " }
            text = text + type_name(c, decls, param(c, t, i))
            i += 1
        }
        return text + ")"
    }
    if ty.kind == "fn" {
        var text = "fn("
        var i: int = 0
        while i < ty.count {
            if i > 0 { text = text + ", " }
            text = text + type_name(c, decls, c.type_params[ty.first + i])
            i += 1
        }
        return text + ") -> " + type_name(c, decls, ty.inner)
    }
    ty.kind
}

// Union-find over integer-kind variables. A term >= 0 is a type id; a term
// v < 0 is the variable -1 - v, which only an integer type may bind.
fn fresh(mut c: Checker) -> int {
    let v = c.parent.len
    (mut c.parent).push(v)
    (mut c.bound).push(-1)
    (mut c.var_kind).push(0)
    -1 - v
}

/// A type declaration's type; the prelude's `f64` interns `f64` on first use.
fn named_type(r: resolve.Resolved, mut c: Checker, d: int) -> int {
    if d >= 0 && c.decl_type[d] < 0 && r.decls[d].kind == "prelude-type" && r.decls[d].name == "f64" {
        let f = float_type(mut c)
        c.decl_type[d] = f
    }
    c.decl_type[d]
}

/// `f64`'s type id, interned the first time a program names or infers it.
fn float_type(mut c: Checker) -> int {
    if c.float_id < 0 {
        c.float_id = c.types.len
        builtin(mut c, "f64")
    }
    c.float_id
}

/// `region`'s type id ([mem.region.create.4]: a static fact; a value is the runtime's handle), interned the
/// first time a program names or makes one.
fn region_type(mut c: Checker) -> int {
    if c.region_id < 0 {
        c.region_id = c.types.len
        builtin(mut c, "region")
    }
    c.region_id
}

// A literal variable's root, read without path compression.
fn root_of(c: Checker, v: int) -> int {
    var root = v
    while c.parent[root] != root { root = c.parent[root] }
    root
}

/// Whether `t` is `f64`, or an unsolved literal variable a float literal reached.
fn floating(c: Checker, t: int) -> bool {
    if t < 0 { return c.var_kind[root_of(c, -1 - t)] == 1 }
    c.types[t].kind == "f64"
}

// Two literal variables' joined kind, or -1 when an integer meets a float: one term cannot be
// both, whatever reaches it later ([type.numlit.ambig]); a value keeps its integer kind.
fn joined_kind(a: int, b: int) -> int {
    if a == b { return a }
    if (a == 0 || a == 3) && (b == 0 || b == 3) { return 3 }
    -1
}

fn find(mut c: Checker, v: int) -> int {
    var root = v
    while c.parent[root] != root { root = c.parent[root] }
    var x = v
    while c.parent[x] != root {
        let up = c.parent[x]
        c.parent[x] = root
        x = up
    }
    root
}

fn solved(mut c: Checker, t: int) -> int {
    if t >= 0 { return deep(mut c, t) }
    let root = find(mut c, -1 - t)
    if c.bound[root] >= 0 { return c.bound[root] }
    -1 - root
}

fn integer(c: Checker, t: int) -> bool {
    if t < 0 { return c.var_kind[root_of(c, -1 - t)] == 0 || c.var_kind[root_of(c, -1 - t)] == 3 }
    sem.integer_kind(c.types[t].kind)
}

fn mismatch(mut c: Checker, decls: List[resolve.Decl], actual: int, context: str, expected: int, node: int) {
    let a = type_name(c, decls, actual)
    let e = type_name(c, decls, expected)
    fail(mut c, "E0401", "this is `{a}`, but {context} `{e}`", node)
}

/// Make `actual` (at `node`) agree with `expected`. `never` agrees with every
/// type and yields the other; the result is the agreed term.
fn unify(mut c: Checker, decls: List[resolve.Decl], actual: int, expected: int, node: int, context: str) -> int {
    let x = solved(mut c, actual)
    let y = solved(mut c, expected)
    if x == never_type() { return y }
    if y == never_type() { return x }
    if x >= 0 && y >= 0 {
        if x != y {
            if !unify_compound(mut c, decls, x, y, node, context) { mismatch(mut c, decls, x, context, y, node) }
            return solved(mut c, y)
        }
        return y
    }
    if x < 0 && y < 0 {
        let a = -1 - x
        let b = -1 - y
        if a != b {
            let joined = joined_kind(c.var_kind[a], c.var_kind[b])
            if joined < 0 { mismatch(mut c, decls, x, context, y, node); return y }
            c.var_kind[b] = joined
            c.parent[a] = b
        }
        return y
    }
    if x < 0 {
        if !literal_fits(c, -1 - x, y) { mismatch(mut c, decls, x, context, y, node); return y }
        c.bound[-1 - x] = y
        return y
    }
    if !literal_fits(c, -1 - y, x) { mismatch(mut c, decls, x, context, y, node); return x }
    c.bound[-1 - y] = x
    x
}

// An `{integer}` literal satisfies an integer or a float expectation; a `{float}` literal
// only a float one ([type.numlit.adopt]).
fn literal_fits(c: Checker, v: int, t: int) -> bool {
    if c.var_kind[v] == 0 { return sem.integer_kind(c.types[t].kind) || c.types[t].kind == "f64" }
    if c.var_kind[v] == 3 { return sem.integer_kind(c.types[t].kind) }
    c.types[t].kind == "f64"
}

fn set(mut c: Checker, n: int, t: int) -> int {
    c.term[n] = t
    (mut c.visited).push(n)
    t
}

// Written types. A `!T` has an empty row here; a function's own `!T` result
// gains its inferred row in `signatures`.
fn written(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let k = kind_of(s, n)
    var t = unit_type()
    if k == "NamedType" {
        let path = first_of(s, n)
        let arguments = next_of(s, path)
        if arguments >= 0 { t = container(s, mut r, mut c, spell_of(s, first_of(s, path)), arguments, n) }
        else { t = named_type(r, mut c, r.node_decl[n]) }
    } else if k == "PrefixType" {
        let inner = written(s, mut r, mut c, first_of(s, n))
        t = result_type(mut c, inner, List[int]())
    } else if k == "ErrorType" {
        t = error_type(s, mut r, mut c, n)
    } else if k == "TupleType" {
        if first_of(s, n) >= 0 {
            var items = List[int]()
            var e = first_of(s, n)
            while e >= 0 { (mut items).push(written(s, mut r, mut c, e)); e = next_of(s, e) }
            t = tuple_type(mut c, items)
        }
    } else if k == "Name" || k == "Index" || k == "Tuple" {
        t = written_argument(s, mut r, mut c, n)
    } else if k == "BuiltinType" {
        // The core admits only `region` here.
        t = region_type(mut c)
    }
    c.term[n] = t
    t
}

fn negative_literal(s: front.Syntax, n: int) -> bool {
    if kind_of(s, n) != "Prefix" { return false }
    let op = first_of(s, n)
    let operand = next_of(s, op)
    spell_of(s, op) == "-" && kind_of(s, operand) == "Literal" && token_of(s, operand) == "int"
}

fn literal(mut c: Checker, n: int) -> int {
    (mut c.literals).push(n)
    let v = fresh(mut c)
    set(mut c, n, v)
}

// A term made only of integer literals and arithmetic: its literals have no
// context of their own when it initializes an unannotated binding.
fn literal_only(s: front.Syntax, n: int) -> bool {
    let k = kind_of(s, n)
    if k == "Literal" { return token_of(s, n) == "int" }
    if k == "Group" { return literal_only(s, first_of(s, n)) }
    if k == "Prefix" {
        let op = first_of(s, n)
        return spell_of(s, op) == "-" && literal_only(s, next_of(s, op))
    }
    if k == "Binary" {
        let left = first_of(s, n)
        let op = spell_of(s, next_of(s, left))
        let arithmetic = op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
        return arithmetic && literal_only(s, left) && literal_only(s, next_of(s, next_of(s, left)))
    }
    false
}

fn mark_bound_literals(s: front.Syntax, mut c: Checker, n: int) {
    c.bound_literal[n] = true
    var d = first_of(s, n)
    while d >= 0 {
        mark_bound_literals(s, mut c, d)
        d = next_of(s, d)
    }
}

fn check_text(s: front.Syntax, mut c: Checker, n: int, multi: bool) {
    let raw = source_of(s, n)
    var text = ""
    if multi { text = sem.multiline(raw) else |_| { fail(mut c, "internal", "undecodable string text", n); return } }
    else { text = sem.decode(raw) else |_| { fail(mut c, "internal", "undecodable string text", n); return } }
    c.value[n] = c.texts.len
    (mut c.texts).push(text)
    let _ = set(mut c, n, str_type())
}

fn check_string(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let multi = token_of(s, n) == "multi-open"
    var d = first_of(s, n)
    while d >= 0 && c.code == "" {
        if kind_of(s, d) == "Text" { check_text(s, mut c, d, multi) }
        else {
            let ty = expr(s, mut r, mut c, first_of(s, d))
            if c.code == "" { check_format(s, mut c, d, ty) }
            let _ = set(mut c, d, str_type())
        }
        d = next_of(s, d)
    }
    set(mut c, n, str_type())
}

fn nominal(c: Checker, t: int) -> bool { c.types[t].kind == "struct" || c.types[t].kind == "enum" }

// D28, [mem.tier0.move.3]: `type X = distinct T` is a nominal type with `T`'s layout; its base is
// the type's `inner`. The core holds adapters of a `Copy` scalar: an integer kind (a wrapping
// domain included), `f64`, `bool`, `char` or `byte`; another base is refused by name.
fn adapters(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker) {
    var d: int = 0
    while d < r.decls.len && c.code == "" {
        if r.decls[d].kind == "adapter" {
            let base = first_of(s, last_of(s, r.decls[d].node))
            let b = written(s, mut r, mut c, base)
            if c.code == "" && !copy_scalar(c, b) {
                fail(mut c, "F0001", "not yet in fenrir: an adapter of `{type_name(c, r.decls, b)}`", base)
            }
            c.types[c.decl_type[d]].inner = b
        }
        d += 1
    }
}

fn copy_scalar(c: Checker, t: int) -> bool {
    integer(c, t) || t == bool_type() || t == char_type() || t == byte_type() || c.types[t].kind == "f64"
}

/// The base of an adapter type, or `t` itself.
fn adapter_base(c: Checker, t: int) -> int {
    if t >= 0 && c.types[t].kind == "adapter" { return c.types[t].inner }
    t
}

fn operator_type(c: Checker, op: str, t: int) -> str {
    // "" when `op` applies to `t`; otherwise the refusal code.
    if t == never_type() || integer(c, t) { return "" }
    // An adapter has its own empty impl set (D28): an arithmetic or comparison operator needs a
    // trait it does not implement (E0301); a bit operator does not apply (E0409).
    if t >= 0 && c.types[t].kind == "adapter" {
        if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" { return "E0409" }
        return "E0301"
    }
    if floating(c, t) {
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return "" }
        return if op == "%" then "F0001" else "E0409"
    }
    if op == "==" || op == "!=" {
        if t == bool_type() || t == str_type() || t == char_type() || t == byte_type() { return "" }
        if nominal(c, t) { return "E0301" }
        return "E0409"
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if t == str_type() || t == char_type() || t == byte_type() { return "" }
        if nominal(c, t) { return "E0301" }
        return "E0409"
    }
    "E0409"
}

/// The trait an operator needs of its operand's type.
fn trait_named(op: str) -> str {
    if op == "==" || op == "!=" { return "Eq" }
    if op == "+" { return "Add" }
    if op == "-" { return "Sub" }
    if op == "*" { return "Mul" }
    if op == "/" { return "Div" }
    if op == "%" { return "Rem" }
    "Ord"
}

fn operator_refusal(mut c: Checker, decls: List[resolve.Decl], code: str, op: str, t: int, node: int) {
    let name = type_name(c, decls, t)
    if code == "F0001" {
        fail(mut c, "F0001", "not yet in fenrir: float remainder", node)
    } else if code == "E0301" {
        let needed = trait_named(op)
        fail(mut c, "E0301", "`{op}` on `{name}` needs the trait `{needed}`, and no `{needed}` is in scope or reachable from this file", node)
    } else {
        fail(mut c, "E0409", "`{op}` cannot be applied to `{name}`", node)
    }
}

fn logical(mut c: Checker, decls: List[resolve.Decl], op: str, t: int, node: int) {
    let ts = solved(mut c, t)
    if ts != bool_type() && ts != never_type() {
        fail(mut c, "E0409", "`{op}` cannot be applied to `{type_name(c, decls, ts)}`", node)
    }
}

fn check_binary(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let left = first_of(s, n)
    let opn = next_of(s, left)
    let right = next_of(s, opn)
    let op = spell_of(s, opn)
    var a = expr(s, mut r, mut c, left)
    var b = expr(s, mut r, mut c, right)
    let comparison = op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="
    if !comparison && op != "&&" && op != "||" {
        if solved(mut c, a) == byte_type() { a = int_type(); c.term[left] = a }
        if solved(mut c, b) == byte_type() { b = int_type(); c.term[right] = b }
    }
    if c.code != "" { return set(mut c, n, unit_type()) }
    for side in [left, right] {
        let st = solved(mut c, c.term[side])
        if kind_is(c, st, "result") && c.code == "" {
            fail(mut c, "E0409", "`{op}` cannot be applied to `{type_name(c, r.decls, st)}`", side)
            return set(mut c, n, unit_type())
        }
    }
    if op == "&&" || op == "||" {
        logical(mut c, r.decls, op, a, left)
        logical(mut c, r.decls, op, b, right)
        return set(mut c, n, bool_type())
    }
    let x = solved(mut c, a)
    let y = solved(mut c, b)
    if op == "+" && (x == str_type() || y == str_type()) {
        let text_char = (x == str_type() && y == char_type()) || (x == char_type() && y == str_type())
        if x != y && !text_char {
            let other = if x == str_type() then right else left
            let ta = type_name(c, r.decls, x)
            let tb = type_name(c, r.decls, y)
            fail(mut c, "E0409", "`+` cannot join `{ta}` and `{tb}`", other)
        }
        return set(mut c, n, str_type())
    }
    // A bit operator does not apply to an adapter (D28), whatever the other side is.
    let bit = op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"
    if bit && x >= 0 && c.types[x].kind == "adapter" {
        operator_refusal(mut c, r.decls, "E0409", op, x, left)
        return set(mut c, n, unit_type())
    }
    let t = unify(mut c, r.decls, b, a, right, "the other side of `{op}` makes it")
    if c.code != "" { return set(mut c, n, unit_type()) }
    let ts = solved(mut c, t)
    let code = operator_type(c, op, ts)
    if code != "" { operator_refusal(mut c, r.decls, code, op, ts, left) }
    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return set(mut c, n, bool_type()) }
    set(mut c, n, t)
}

fn check_cast(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let operand = first_of(s, n)
    let target = written(s, mut r, mut c, last_of(s, n))
    let source = expr(s, mut r, mut c, operand)
    let from = solved(mut c, source)
    if adapter_base(c, target) != target || from >= 0 && adapter_base(c, from) != from {
        return adapter_cast(r, mut c, n, from, target)
    }
    let into_integer = integer(c, target)
    let into_float = target >= 0 && c.types[target].kind == "f64"
    // `[type.numlit.cast.widen]` and `.trunc`: an integer to `f64`, and `f64` to a plain integer kind.
    let float_cast = (integer(c, from) || floating(c, from)) && into_float ||
        floating(c, from) && into_integer && !sem.wrapping_kind(c.types[target].kind)
    let scalar_bridge = float_cast || from == target && (from == char_type() || from == byte_type()) ||
        (from == int_type() || from < 0 && integer(c, from)) && (target == char_type() || target == byte_type()) ||
        (from == char_type() || from == byte_type()) && target == int_type()
    if c.code == "" && !(integer(c, from) && into_integer) && !scalar_bridge {
        fail(mut c, "E0805", "cannot cast `{type_name(c, r.decls, from)}` to `{type_name(c, r.decls, target)}`", n)
    }
    set(mut c, n, target)
}

// D28: a cast between an adapter and its base is free and goes both ways; a literal cast to an
// adapter of a numeric kind adopts the base ([type.numlit.adopt]): `300 as Small` for
// `type Small = distinct u8` is E0415 at the literal. Any other cast to or from an adapter is refused,
// as the reference refuses `Col as int` for `type Col = distinct u32`.
fn adapter_cast(r: resolve.Resolved, mut c: Checker, n: int, from: int, target: int) -> int {
    let base = adapter_base(c, target)
    if from < 0 && base != target && (integer(c, base) && integer(c, from) || floating(c, base) && floating(c, from)) {
        let _ = unify(mut c, r.decls, from, base, n, "the adapter's base is")
        return set(mut c, n, target)
    }
    let free = from >= 0 && (adapter_base(c, from) == target || base == from)
    if c.code == "" && !free {
        fail(mut c, "E0805", "cannot cast `{type_name(c, r.decls, from)}` to `{type_name(c, r.decls, target)}`", n)
    }
    set(mut c, n, target)
}

fn check_prefix(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let opn = first_of(s, n)
    let operand = next_of(s, opn)
    let op = spell_of(s, opn)
    if negative_literal(s, n) {
        let t = literal(mut c, n)
        let _ = set(mut c, operand, t)
        return t
    }
    // [mem.tier0.move]: `move x` transfers the value and `copy x` is an independent copy of it; both
    // have the operand's type (a moved place has no run-time trace, docs/MEMORY.md).
    if op == "move" || op == "copy" {
        let held = expr(s, mut r, mut c, operand)
        return set(mut c, n, held)
    }
    var t = expr(s, mut r, mut c, operand)
    if solved(mut c, t) == byte_type() { t = int_type(); c.term[operand] = t }
    let ts = solved(mut c, t)
    if c.code == "" && op == "-" && ts >= 0 && c.types[ts].kind == "adapter" {
        let name = type_name(c, r.decls, ts)
        fail(mut c, "E0301", "`-` on `{name}` needs the trait `Neg`, and no `Neg` is in scope or reachable from this file", operand)
    }
    if c.code == "" && !integer(c, ts) && ts != never_type() && !(op == "!" && ts == bool_type()) && !(op == "-" && floating(c, ts)) {
        fail(mut c, "E0409", "`{op}` cannot be applied to `{type_name(c, r.decls, ts)}`", operand)
    }
    set(mut c, n, t)
}

fn check_call(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let callee = first_of(s, n)
    let args = next_of(s, callee)
    let d = r.node_decl[callee]
    if kind_of(s, callee) == "Member" {
        if d >= 0 && r.decls[d].kind == "variant" { return check_variant_call(s, mut r, mut c, n) }
        return check_method(s, mut r, mut c, n)
    }
    if kind_of(s, callee) == "Index" { return check_constructor_call(s, mut r, mut c, n) }
    if r.tag[callee] {
        unresolved_tag(s, mut c, callee)
        return set(mut c, n, unit_type())
    }
    let name = spell_of(s, callee)
    var passed: int = 0
    var a = first_of(s, args)
    while a >= 0 { passed += 1; a = next_of(s, a) }
    var params = List[int]()
    var result = unit_type()
    let dk = r.decls[d].kind
    if d == 23 { return check_min(s, mut r, mut c, n, passed) }
    if d == 0 || d == 18 || d == 19 || d == 20 { (mut params).push(str_type()) }
    else if d == 26 {
        // [mem.region.account.1]: `region_bytes(region) -> int`.
        let rt = region_type(mut c)
        (mut params).push(rt)
        result = int_type()
    } else if d == 27 {
        // [mem.region.account.2]: `live_region_bytes() -> int`.
        result = int_type()
    }
    else if d == 21 || d == 22 {
        // [mem.list.bytes]: `bytes_find(List[byte], byte, int) -> int ! {none}`, `bytes_count(List[byte], byte) -> int`.
        (mut params).push(list_type(mut c, byte_type()))
        (mut params).push(byte_type())
        if d == 21 {
            (mut params).push(int_type())
            let none = none_tag(mut c)
            result = result_type(mut c, int_type(), [none])
        } else { result = int_type() }
    } else if d == 17 {
        // [os.host.sigs]: `str_from_utf8(List[byte]) -> str ! {utf8}`.
        (mut params).push(list_type(mut c, byte_type()))
        let invalid = tag_id(mut c, "utf8", List[int]())
        result = result_type(mut c, str_type(), [invalid])
    } else if d == 1 {
        (mut params).push(bool_type())
        if passed == 2 { (mut params).push(str_type()) }
        // The literal `assert(false)` is bottom ([type.fn.never]).
        if passed >= 1 {
            let cond = last_of(s, first_of(s, args))
            if kind_of(s, cond) == "Literal" && token_of(s, cond) == "false" { result = never_type() }
        }
    } else if dk == "function" {
        let ft = c.decl_type[d]
        result = c.types[ft].inner
        var i: int = 0
        while i < c.types[ft].count { (mut params).push(c.type_params[c.types[ft].first + i]); i += 1 }
    } else {
        let t = solved(mut c, c.decl_type[d])
        fail(mut c, "E0401", "this is `{type_name(c, r.decls, t)}`, but a call needs a function", callee)
        return set(mut c, n, unit_type())
    }
    if passed != params.len {
        let wanted = if params.len == 1 then "1 argument" else "{params.len} arguments"
        fail(mut c, "E0402", "`{name}` takes {wanted}, but this call passes {passed}", n)
        return set(mut c, n, result)
    }
    var i: int = 0
    a = first_of(s, args)
    while a >= 0 && c.code == "" {
        var value = first_of(s, a)
        var mode = ""
        if kind_of(s, value) == "Mode" { mode = spell_of(s, value); value = next_of(s, value) }
        let pd = if dk == "function" then parameter_decl(s, r, d, i) else -1
        call_mode(s, r, mut c, name, pd, mode, value)
        if c.code != "" { return set(mut c, n, result) }
        let t = expr_with(s, mut r, mut c, value, params[i])
        let _ = accept(mut c, r.decls, t, params[i], value, "`{name}` needs its {ordinal(i)} argument to be")
        i += 1
        a = next_of(s, a)
    }
    set(mut c, n, result)
}

/// The declaration of function `f`'s parameter `i`, or -1.
fn parameter_decl(s: front.Syntax, r: resolve.Resolved, f: int, i: int) -> int {
    var part = first_of(s, r.decls[f].node)
    while part >= 0 && kind_of(s, part) != "Parameters" { part = next_of(s, part) }
    if part < 0 { return -1 }
    var p = first_of(s, part)
    var k: int = 0
    while p >= 0 && k < i { p = next_of(s, p); k += 1 }
    if p < 0 { return -1 } else { return r.node_decl[p] }
}

// [mem.tier0.mode]: an argument spells its parameter's mode, `mut` or `take`, or none for a `read`
// parameter (E1007 at the argument otherwise). A `mut` argument names a place: a local, a `mut` or
// `take` parameter, or a field or element path from one (E1009 otherwise); a `read` parameter is
// never lent `mut` (E1014), nor a `let` binding or its field path (E0410, [gram.item.let]), though
// an element a `let` reaches through an index is. A pattern binding lent `mut` stays outside the core.
fn call_mode(s: front.Syntax, r: resolve.Resolved, mut c: Checker, name: str, pd: int, mode: str, value: int) {
    let want = if pd >= 0 then r.param_mode[pd] else ""
    let pname = if pd >= 0 then r.decls[pd].name else "it"
    if mode != want {
        if want == "" { fail(mut c, "E1007", "`{name}` takes `{pname}` as plain `read` — no mode is written for it", value) }
        else if mode == "" { fail(mut c, "E1007", "`{name}` declares `{pname}` as `{want}`, but the call site does not say so", value) }
        else { fail(mut c, "E1007", "`{name}` declares `{pname}` as `{want}`, but the call site says `{mode}`", value) }
        return
    }
    if mode != "mut" { return }
    var root = value
    var indexed = false
    while kind_of(s, root) == "Member" || kind_of(s, root) == "Index" {
        if kind_of(s, root) == "Index" { indexed = true }
        root = first_of(s, root)
    }
    let d = if kind_of(s, root) == "Name" then r.node_decl[root] else -1
    if d < 0 {
        fail(mut c, "E1009", "a `mut` argument must name a place — a variable or a field path", value)
        return
    }
    let dk = r.decls[d].kind
    if dk == "param" && r.param_mode[d] == "" {
        fail(mut c, "E1014", "`{r.decls[d].name}` is `read` for the whole call, so it cannot be lent `mut`", value)
    } else if dk == "candidate" || dk == "bind" || r.loop_bound[d] {
        fail(mut c, "F0001", "not yet in fenrir: a pattern or loop binding lent `mut`", value)
    } else if dk == "let" && !indexed {
        // [gram.item.let]: a `let` binding and its fields are its one value, which a `mut` lend would
        // write; an element reached through an index is a different question, as for a store.
        fail(mut c, "E0410", "`{r.decls[d].name}` is bound with `let`, so it cannot be lent `mut`", value)
    } else if dk != "var" && dk != "let" && dk != "param" {
        fail(mut c, "E1009", "a `mut` argument must name a place — a variable or a field path", value)
    }
}

// [type.min]: two operands of one integer type, a literal taking the other's
// type as beside `<`; another count is E0402 at the call, an operand outside
// the integers or a second integer type E0401 at that operand.
fn check_min(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int, passed: int) -> int {
    if passed != 2 {
        fail(mut c, "E0402", "`min` takes 2 arguments, but this call passes {passed}", n)
        return set(mut c, n, unit_type())
    }
    let first = first_of(s, next_of(s, first_of(s, n)))
    let a_node = last_of(s, first)
    let b_node = last_of(s, next_of(s, first))
    let a = expr(s, mut r, mut c, a_node)
    let b = expr(s, mut r, mut c, b_node)
    if c.code != "" { return set(mut c, n, unit_type()) }
    for side in [a_node, b_node] {
        let st = solved(mut c, c.term[side])
        if !integer(c, st) && c.code == "" {
            fail(mut c, "E0401", "`min` takes integers, but this is `{type_name(c, r.decls, st)}`", side)
            return set(mut c, n, unit_type())
        }
    }
    let t = unify(mut c, r.decls, b, a, b_node, "the other operand of `min` makes it")
    if c.code != "" { return set(mut c, n, unit_type()) }
    set(mut c, n, t)
}

fn check_struct_literal(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let st = r.node_decl[n]
    var f = next_of(s, first_of(s, n))
    while f >= 0 && c.code == "" {
        let field = r.node_decl[f]
        let fname = first_of(s, f)
        var value = next_of(s, fname)
        if value < 0 { value = fname }
        if kind_of(s, value) == "List" && first_of(s, value) < 0 {
            // `[]` takes its type from a `List`-typed field ([type.list.lit.empty] in this one place).
            let ft = c.decl_type[field]
            if c.types[ft].kind != "list" {
                fail(mut c, "E0401", "this is a list literal, but the field `{r.decls[field].name}` is `{type_name(c, r.decls, ft)}`", value)
            }
            let _ = set(mut c, value, ft)
            f = next_of(s, f)
            continue
        }
        let t = expr(s, mut r, mut c, value)
        let _ = unify(mut c, r.decls, t, c.decl_type[field], value, "`{r.decls[st].name}.{r.decls[field].name}` is declared as")
        f = next_of(s, f)
    }
    set(mut c, n, c.decl_type[st])
}

fn check_member(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let receiver = first_of(s, n)
    let member = next_of(s, receiver)
    let rt = expr(s, mut r, mut c, receiver)
    let t = solved(mut c, rt)
    if c.code != "" { return set(mut c, n, unit_type()) }
    let text = spell_of(s, member)
    if t >= 0 && c.types[t].kind != "struct" { return check_container_member(s, r, mut c, n, t) }
    if t < 0 || c.types[t].kind != "struct" {
        fail(mut c, "F0001", "not yet in fenrir: member `{text}` of `{type_name(c, r.decls, t)}`", member)
        return set(mut c, n, unit_type())
    }
    let st = c.types[t].decl
    let field = resolve.paired(r.fields, st * r.names.text.len + r.node_name[member])
    if field < 0 {
        fail(mut c, "E0403", "`{r.decls[st].name}` has no field named `{text}`", member)
        return set(mut c, n, unit_type())
    }
    r.node_decl[n] = field
    r.node_decl[member] = field
    set(mut c, n, c.decl_type[field])
}

fn check_branch(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int, unit: str) -> int {
    check_branch_expected(s, mut r, mut c, n, unit, -1)
}

fn check_branch_expected(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int, unit: str, expected: int) -> int {
    if kind_of(s, n) == "Block" { return check_block(s, mut r, mut c, n, unit, expected) }
    let t = expr_with(s, mut r, mut c, n, expected)
    if unit != "" { return unit_tail(mut c, r.decls, t, n, unit) }
    t
}

// Where a branch's value is reported: a block's tail expression, if any.
fn value_site(s: front.Syntax, n: int) -> int {
    if kind_of(s, n) != "Block" { return n }
    var last = first_of(s, n)
    while last >= 0 && next_of(s, last) >= 0 { last = next_of(s, last) }
    if last < 0 || kind_of(s, last) != "Tail" { return n }
    var e = first_of(s, last)
    while kind_of(s, e) == "Attribute" { e = next_of(s, e) }
    e
}

fn check_if(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    check_if_expected(s, mut r, mut c, n, -1)
}

fn check_if_expected(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int, expected: int) -> int {
    let cond = first_of(s, n)
    let yes = next_of(s, cond)
    let other = next_of(s, yes)
    let t = expr(s, mut r, mut c, cond)
    let _ = unify(mut c, r.decls, t, bool_type(), cond, "an `if` condition must be")
    if other < 0 {
        let _ = check_branch(s, mut r, mut c, yes, "an `if` without `else` produces")
        return set(mut c, n, unit_type())
    }
    let a = check_branch_expected(s, mut r, mut c, yes, "", expected)
    let b = check_branch_expected(s, mut r, mut c, other, "", expected)
    if c.code != "" { return set(mut c, n, unit_type()) }
    // One branch a result and the other its ok type: the `if` is the result,
    // and the lowering wraps the plain branch's value.
    let bs = solved(mut c, b)
    let ats = solved(mut c, a)
    var joined: int = 0
    if kind_is(c, bs, "result") && !kind_is(c, ats, "result") { joined = accept(mut c, r.decls, a, b, value_site(s, yes), "the other branch of this `if` is") }
    else { joined = accept(mut c, r.decls, b, a, value_site(s, other), "the other branch of this `if` is") }
    set(mut c, n, joined)
}

fn unit_tail(mut c: Checker, decls: List[resolve.Decl], t: int, node: int, context: str) -> int {
    let ts = solved(mut c, t)
    // A `!T` tail in a unit context is a discard ([type.unit.discard]).
    if ts != unit_type() && ts != never_type() && c.code == "" && !kind_is(c, ts, "result") {
        fail(mut c, "E0401", "this is `{type_name(c, decls, ts)}`, but {context} `()`", node)
    }
    unit_type()
}

fn check_block(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int, unit: str, expected: int) -> int {
    var t = unit_type()
    var tail = false
    var ends = false
    var st = first_of(s, n)
    while st >= 0 && c.code == "" {
        let _ = set(mut c, st, unit_type())
        var d = first_of(s, st)
        while d >= 0 && kind_of(s, d) == "Attribute" { d = next_of(s, d) }
        if kind_of(s, st) == "Tail" {
            tail = true
            if unit != "" && kind_of(s, d) == "Match" { t = check_match_in(s, mut r, mut c, d, unit) }
            else { t = expr_with(s, mut r, mut c, d, expected) }
            c.term[st] = t
            if unit != "" { t = unit_tail(mut c, r.decls, t, d, unit) }
        } else if kind_of(s, d) == "Item" {
            // A nested `fn` is typed as its own function (r.functions holds it).
            if kind_of(s, first_of(s, d)) != "Function" { check_bindings(s, mut r, mut c, first_of(s, d)) }
            ends = false
        } else if kind_of(s, d) == "Assignment" {
            check_assignment(s, mut r, mut c, d)
            ends = false
        } else if kind_of(s, d) == "Defer" {
            check_defer(s, mut r, mut c, d)
            ends = false
        } else {
            let et = expr(s, mut r, mut c, d)
            ends = solved(mut c, et) == never_type()
        }
        st = next_of(s, st)
    }
    if !tail && ends { t = never_type() }
    set(mut c, n, t)
}

// [mem.model.order]: `defer e` and `errdefer e` run `e` at their scope's exit;
// its value is dropped. A `?` anywhere in `e` is E0611 at the `?`
// ([type.row.defer]); an `errdefer` in a function with no error row is E0607.
fn check_defer(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) {
    if spell_of(s, n) == "errdefer" && !kind_is(c, solved(mut c, c.full), "result") {
        fail(mut c, "E0607", "`errdefer` runs only on the error path, and `{c.function}` cannot fail", n)
        return
    }
    let e = last_of(s, n)
    let qmark = deferred_propagate(s, e)
    if qmark >= 0 {
        fail(mut c, "E0611", "a `?` inside a deferred expression has no function to leave; handle the row with `else`", qmark)
        return
    }
    let _ = expr(s, mut r, mut c, e)
    let _ = set(mut c, n, unit_type())
}

fn deferred_propagate(s: front.Syntax, n: int) -> int {
    if kind_of(s, n) == "Propagate" { return n }
    var child = first_of(s, n)
    while child >= 0 {
        let found = deferred_propagate(s, child)
        if found >= 0 { return found }
        child = next_of(s, child)
    }
    -1
}

fn check_bindings(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) {
    var b = next_of(s, first_of(s, n))
    while b >= 0 && c.code == "" {
        let pat = first_of(s, b)
        let second = next_of(s, pat)
        var init = second
        var t = unit_type()
        if next_of(s, second) >= 0 {
            init = next_of(s, second)
            let declared = written(s, mut r, mut c, second)
            let v = expr_with(s, mut r, mut c, init, declared)
            var who = "the annotation is"
            if kind_of(s, pat) == "NamePattern" { who = "`{spell_of(s, first_of(s, first_of(s, pat)))}` is declared as" }
            let _ = accept(mut c, r.decls, v, declared, init, who)
            t = declared
        } else {
            t = expr(s, mut r, mut c, init)
            if literal_only(s, init) { mark_bound_literals(s, mut c, init) }
            // A binding fixes a literal's type ([type.numlit.value]): a float literal's is `f64`
            // at once; an integer literal's is decided later, but never as a float.
            let ts = solved(mut c, t)
            if ts < 0 && c.var_kind[root_of(c, -1 - ts)] == 1 {
                let f = float_type(mut c)
                t = unify(mut c, r.decls, t, f, init, "this binding is")
            }
            else if ts < 0 { c.var_kind[root_of(c, -1 - ts)] = 3 }
        }
        let _ = set(mut c, b, t)
        let d = r.node_decl[b]
        if d >= 0 {
            c.decl_type[d] = t
            (mut c.locals).push(d)
        } else if kind_of(s, pat) == "TuplePattern" || kind_of(s, pat) == "StructPattern" {
            bind_pattern(s, mut r, mut c, pat, t)
        }
        b = next_of(s, b)
    }
}

fn check_assignment(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) {
    let place = first_of(s, n)
    let opn = next_of(s, place)
    let rhs = next_of(s, opn)
    let op = spell_of(s, opn)
    var root = place
    while kind_of(s, root) == "Member" || kind_of(s, root) == "Index" { root = first_of(s, root) }
    let named = if kind_of(s, root) == "Name" then r.node_decl[root] else -1
    if named >= 0 && r.decls[named].kind == "candidate" {
        if c.settle[named] == 1 {
            let text = copy r.decls[named].name
            fail(mut c, "E0410", "pattern binding `{text}` is immutable; shadow it with `var` before assigning it or its fields", place)
            return
        }
        // A nullary test binds nothing. Follow the name it did not shadow,
        // including a root reached through field or index assignment.
        var d = named
        while c.redirect[d] >= 0 { d = c.redirect[d] }
        let text = source_of(s, root)
        if d != named && (r.decls[d].kind == "let" || (r.decls[d].kind == "candidate" && c.settle[d] == 1)) {
            fail(mut c, "E0410", "`{text}` is immutable, so it and its fields cannot be assigned", place)
            return
        }
        if d != named && r.decls[d].kind == "param" {
            fail(mut c, "E1014", "`{text}` is `read` for the whole call, so it cannot be assigned", place)
            return
        }
    }
    if kind_of(s, place) == "Index" { check_index_store(s, mut r, mut c, n); return }
    let p = expr(s, mut r, mut c, place)
    let v = expr(s, mut r, mut c, rhs)
    let _ = set(mut c, n, unit_type())
    if c.code != "" { return }
    let ps = solved(mut c, p)
    let who = "`{source_of(s, place)}` is"
    if op == "=" { let _ = unify(mut c, r.decls, v, p, rhs, who); return }
    if ps == str_type() {
        let vs = solved(mut c, v)
        if op != "+=" { fail(mut c, "E0409", "`{op}` cannot be applied to `str`", place); return }
        if vs != str_type() && vs != char_type() { fail(mut c, "E0409", "`+=` cannot join `str` and `{type_name(c, r.decls, vs)}`", rhs) }
        return
    }
    if ps >= 0 && c.types[ps].kind == "adapter" {
        fail(mut c, "E0409", "`{op}` cannot be applied to `{type_name(c, r.decls, ps)}`", place)
        return
    }
    let agreed = unify(mut c, r.decls, v, p, rhs, who)
    let t = solved(mut c, agreed)
    if c.code == "" && floating(c, t) {
        if op == "%=" { fail(mut c, "F0001", "not yet in fenrir: float remainder", place) }
        else if op != "+=" && op != "-=" && op != "*=" && op != "/=" { fail(mut c, "E0409", "`{op}` cannot be applied to `{type_name(c, r.decls, t)}`", place) }
        return
    }
    if c.code == "" && !integer(c, t) { fail(mut c, "E0409", "`{op}` cannot be applied to `{type_name(c, r.decls, t)}`", place) }
}

// A returned value (a `return` operand or the body's tail): the ok type, or a
// result whose row is within the function's, which the lowering converts.
fn returned(mut c: Checker, decls: List[resolve.Decl], t: int, node: int) {
    let ts = solved(mut c, t)
    // Returning a result from a unit function discards it ([type.unit.discard]).
    if kind_is(c, ts, "result") && c.full == unit_type() { return }
    if kind_is(c, ts, "result") && kind_is(c, c.full, "result") {
        let escape = missing(c, row_of(c, ts), row_of(c, c.full))
        if escape >= 0 { escapes(mut c, escape, node); return }
        let _ = unify(mut c, decls, c.types[ts].inner, c.result, node, "`{c.function}` must return")
        return
    }
    let _ = unify(mut c, decls, t, c.result, node, "`{c.function}` must return")
}

fn check_jump(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let jk = first_of(s, n)
    let operand = next_of(s, jk)
    if spell_of(s, jk) == "return" {
        if c.result == never_type() {
            fail(mut c, "E0401", "`{c.function}` is declared `-> never`, so it cannot return", n)
            return set(mut c, n, never_type())
        }
        if operand >= 0 {
            let t = expr_with(s, mut r, mut c, operand, c.full)
            open_flow(s, r, mut c, operand)
            returned(mut c, r.decls, t, operand)
        } else if c.result != unit_type() {
            mismatch(mut c, r.decls, unit_type(), "`{c.function}` must return", c.result, n)
        }
    }
    set(mut c, n, never_type())
}

/// Type one expression; the result is its term.
fn expr(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    if c.code != "" { return unit_type() }
    let k = kind_of(s, n)
    if k == "Name" {
        if r.tag[n] {
            if r.item_tag[n] >= 0 { fail(mut c, "F0001", resolve.item_value_refusal(r, r.item_tag[n]), n) }
            else { unresolved_tag(s, mut c, n) }
            return set(mut c, n, unit_type())
        }
        return check_name(s, mut r, mut c, n)
    }
    if k == "List" { return check_list_literal(s, mut r, mut c, n) }
    if k == "Index" { return check_index(s, mut r, mut c, n) }
    if k == "Tuple" { return check_tuple(s, mut r, mut c, n) }
    if k == "Propagate" { return check_propagate(s, mut r, mut c, n) }
    if k == "Default" { return check_default(s, mut r, mut c, n) }
    if k == "Literal" {
        let tk = token_of(s, n)
        if tk == "int" { return literal(mut c, n) }
        if tk == "float" {
            (mut c.floats).push(n)
            let v = fresh(mut c)
            c.var_kind[-1 - v] = 1
            return set(mut c, n, v)
        }
        if tk == "raw" {
            c.value[n] = c.texts.len
            (mut c.texts).push(sem.raw_content(spell_of(s, n)))
            return set(mut c, n, str_type())
        }
        if tk == "char" {
            let raw = spell_of(s, n)
            let decoded = sem.decode(raw[1..raw.len - 1]) else |_| { fail(mut c, "internal", "undecodable character literal", n); return unit_type() }
            c.value[n] = decoded.chars()[0] as int
            return set(mut c, n, char_type())
        }
        if tk == "true" { c.value[n] = 1 }
        return set(mut c, n, bool_type())
    }
    if k == "String" { return check_string(s, mut r, mut c, n) }
    if k == "Group" {
        let inner = expr(s, mut r, mut c, first_of(s, n))
        return set(mut c, n, inner)
    }
    if k == "Cast" { return check_cast(s, mut r, mut c, n) }
    if k == "Prefix" { return check_prefix(s, mut r, mut c, n) }
    if k == "Binary" { return check_binary(s, mut r, mut c, n) }
    if k == "Call" { return check_call(s, mut r, mut c, n) }
    if k == "StructLiteral" { return check_struct_literal(s, mut r, mut c, n) }
    if k == "Member" {
        let d = r.node_decl[n]
        if d >= 0 && r.decls[d].kind == "variant" { return check_variant_value(s, r, mut c, n) }
        return check_member(s, mut r, mut c, n)
    }
    if k == "Match" { return check_match(s, mut r, mut c, n) }
    if k == "If" { return check_if(s, mut r, mut c, n) }
    if k == "Block" { return check_block(s, mut r, mut c, n, "", -1) }
    if k == "Loop" && spell_of(s, first_of(s, n)) == "for" { return check_for(s, mut r, mut c, n) }
    if k == "Loop" && spell_of(s, first_of(s, n)) == "loop" {
        // `loop` is bottom unless a `break` leaves it ([type.fn.never]).
        let body = next_of(s, first_of(s, n))
        let _ = check_block(s, mut r, mut c, body, "a loop body produces", -1)
        return set(mut c, n, if breaks(s, body) then unit_type() else never_type())
    }
    if k == "Loop" {
        let header = next_of(s, first_of(s, n))
        let t = expr(s, mut r, mut c, header)
        let _ = unify(mut c, r.decls, t, bool_type(), header, "a `while` condition must be")
        let _ = check_block(s, mut r, mut c, next_of(s, header), "a loop body produces", -1)
        return set(mut c, n, unit_type())
    }
    if k == "Jump" { return check_jump(s, mut r, mut c, n) }
    if k == "Region" || k == "RegionValue" || k == "InRegion" { return check_region(s, mut r, mut c, n) }
    fail(mut c, "internal", "unexpected {k} in the core", n)
    unit_type()
}

// [mem.region.create.1], [mem.region.create.3], [mem.region.cap.2]: `region r(cap: e) { … }` binds `r` for its
// block and is the block's value; `region(cap: e)` is a region value; `in r { … }` needs a region and is its
// block's value. A budget is an `int`. Escape, edges and openness are F6's (named differences).
fn check_region(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) -> int {
    let k = kind_of(s, n)
    let rt = region_type(mut c)
    if k == "InRegion" {
        let value = first_of(s, n)
        let vt = expr(s, mut r, mut c, value)
        let _ = unify(mut c, r.decls, vt, rt, value, "`in` needs")
        let t = check_block(s, mut r, mut c, last_of(s, n), "", -1)
        return set(mut c, n, t)
    }
    var body = -1
    var d = first_of(s, n)
    while d >= 0 && c.code == "" {
        let dk = kind_of(s, d)
        if dk == "Name" {
            c.decl_type[r.node_decl[d]] = rt
            let _ = set(mut c, d, rt)
        } else if dk == "RegionCapacity" {
            let e = first_of(s, d)
            let et = expr_with(s, mut r, mut c, e, int_type())
            let _ = unify(mut c, r.decls, et, int_type(), e, "a region's `cap:` must be")
            let _ = set(mut c, d, int_type())
        } else if dk == "Block" { body = d }
        d = next_of(s, d)
    }
    if k == "RegionValue" { return set(mut c, n, rt) }
    let t = check_block(s, mut r, mut c, body, "", -1)
    set(mut c, n, t)
}

// Whether a `break` inside `n` leaves the loop whose body `n` is: one not
// nested in an inner loop.
fn breaks(s: front.Syntax, n: int) -> bool {
    let k = kind_of(s, n)
    if k == "Jump" && spell_of(s, first_of(s, n)) == "break" { return true }
    if k == "Loop" { return false }
    var c = first_of(s, n)
    while c >= 0 {
        if breaks(s, c) { return true }
        c = next_of(s, c)
    }
    false
}

fn finish_function(s: front.Syntax, mut c: Checker) {
    var i: int = 0
    while i < c.floats.len {
        let t = solved(mut c, c.term[c.floats[i]])
        if t < 0 {
            let root = root_of(c, -1 - t)
            let f = float_type(mut c)
            c.bound[root] = f
        }
        i += 1
    }
    i = 0
    while i < c.literals.len {
        let t = solved(mut c, c.term[c.literals[i]])
        if t < 0 { c.bound[-1 - t] = i32_type() }
        i += 1
    }
    i = 0
    while i < c.literals.len && c.code == "" {
        let n = c.literals[i]
        let t = solved(mut c, c.term[n])
        let negative = kind_of(s, n) == "Prefix"
        var digits = n
        if negative { digits = next_of(s, first_of(s, n)) }
        let spelling = spell_of(s, digits)
        let m = sem.magnitude(spelling)
        let kind = c.types[t].kind
        let shown = if negative then "-" + spelling else spelling
        if kind == "f64" {
            // An integer literal adopting `f64` denotes its exact value, rounded once.
            let magnitude = sem.integer_float(m, spelling)
            c.value[n] = if negative then sem.float_negate(magnitude) else magnitude
            if negative { c.value[digits] = c.value[n] }
        } else if !sem.fits(kind, m, negative) {
            fail(mut c, "E0415", "`{shown}` does not fit `{kind}` ({sem.range_text(kind)})", n)
        } else if c.bound_literal[n] && !sem.fits("i32", m, negative) {
            fail(mut c, "E0415", "`{shown}` does not fit `i32`: a literal binding takes `i32` before any later use", n)
        } else {
            let bits = sem.bits(m, negative)
            c.value[n] = bits
            if negative { c.value[digits] = bits }
        }
        i += 1
    }
    i = 0
    while i < c.visited.len {
        let n = c.visited[i]
        c.term[n] = solved(mut c, c.term[n])
        i += 1
    }
    i = 0
    while i < c.locals.len {
        let d = c.locals[i]
        c.decl_type[d] = solved(mut c, c.decl_type[d])
        i += 1
    }
    i = 0
    while i < c.floats.len {
        let n = c.floats[i]
        c.value[n] = sem.float_literal(spell_of(s, n))
        i += 1
    }
    c.literals = List[int]()
    c.floats = List[int]()
    c.visited = List[int]()
    c.locals = List[int]()
}

fn check_function(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, f: int) {
    let ft = c.decl_type[f]
    var ok = c.types[ft].inner
    c.full = ok
    if c.types[ok].kind == "result" { ok = c.types[ok].inner }
    c.result = ok
    c.function = copy r.decls[f].name
    c.known_tags = function_tags(s, r, r.decls[f].node)
    c.dotted_self = c.dotted[f]
    var body = first_of(s, r.decls[f].node)
    while kind_of(s, body) != "Block" { body = next_of(s, body) }
    let expected = if c.full != ok then c.full else -1
    if ok == unit_type() && expected < 0 {
        let _ = check_block(s, mut r, mut c, body, "`{c.function}` must return", -1)
    } else if ok == never_type() {
        // [type.fn.never]: the body itself is bottom, or E0401 at its tail.
        let t = check_block(s, mut r, mut c, body, "", -1)
        if c.code == "" && solved(mut c, t) != never_type() {
            var site = body
            let tail = last_of(s, body)
            if tail >= 0 && kind_of(s, tail) == "Tail" {
                site = first_of(s, tail)
                while kind_of(s, site) == "Attribute" { site = next_of(s, site) }
            }
            fail(mut c, "E0401", "`{c.function}` is declared `-> never`, but its body can reach its end", site)
        }
    } else if ok == unit_type() {
        // `!()`: a unit tail, a raised tag, or a result value of a narrower row.
        let t = check_block(s, mut r, mut c, body, "", expected)
        let ts = solved(mut c, t)
        let tail = last_of(s, body)
        if tail >= 0 && kind_of(s, tail) == "Tail" { open_flow(s, r, mut c, last_of(s, tail)) }
        if kind_is(c, ts, "result") { returned(mut c, r.decls, t, body) }
        else { let _ = unit_tail(mut c, r.decls, t, body, "`{c.function}` must return") }
    } else {
        let t = check_block(s, mut r, mut c, body, "", expected)
        var site = body
        var last = first_of(s, body)
        while last >= 0 && next_of(s, last) >= 0 { last = next_of(s, last) }
        if last >= 0 && kind_of(s, last) == "Tail" {
            site = first_of(s, last)
            while kind_of(s, site) == "Attribute" { site = next_of(s, site) }
            open_flow(s, r, mut c, site)
        }
        returned(mut c, r.decls, t, site)
    }
    finish_function(s, mut c)
    cover_function(s, r, mut c, f)
    c.matches = List[int]()
}

fn struct_cycle(c: Checker, r: resolve.Resolved) -> int {
    // Iterative depth-first search over by-value struct fields; returns a
    // struct declaration on a cycle, or -1.
    var state = List[int]()
    var i: int = 0
    while i < r.decls.len { (mut state).push(0); i += 1 }
    for root in r.structs {
        if state[root] != 0 { continue }
        var stack = List[int]()
        var at = List[int]()
        (mut stack).push(root)
        (mut at).push(0)
        state[root] = 1
        while stack.len > 0 {
            let top = stack.len - 1
            let st = stack[top]
            let k = at[top]
            if k >= r.decls[st].count {
                state[st] = 2
                let _ = (mut stack).pop() else -1
                let _ = (mut at).pop() else -1
                continue
            }
            at[top] = k + 1
            let ft = c.decl_type[st + 1 + k]
            if c.types[ft].kind == "struct" {
                let child = c.types[ft].decl
                if state[child] == 1 { return child }
                if state[child] == 0 {
                    state[child] = 1
                    (mut stack).push(child)
                    (mut at).push(0)
                }
            }
        }
    }
    -1
}

// By-value children of every struct and enum, flattened per declaration.
fn aggregate_cycle(c: Checker, r: resolve.Resolved) -> int {
    var first = List[int]()
    var kids = List[int]()
    var i: int = 0
    while i < r.decls.len {
        (mut first).push(kids.len)
        let k = r.decls[i].kind
        if k == "struct" {
            var f: int = 0
            while f < r.decls[i].count { (mut kids).push(c.decl_type[i + 1 + f]); f += 1 }
        } else if k == "enum" {
            var v: int = 0
            while v < r.decls[i].count {
                let vt = c.decl_type[i + 1 + v]
                var p: int = 0
                while p < c.types[vt].count { (mut kids).push(c.type_params[c.types[vt].first + p]); p += 1 }
                v += 1
            }
        }
        i += 1
    }
    (mut first).push(kids.len)
    var state = List[int]()
    i = 0
    while i < r.decls.len { (mut state).push(0); i += 1 }
    for root in r.enums {
        if state[root] != 0 { continue }
        var stack = List[int]()
        var at = List[int]()
        (mut stack).push(root)
        (mut at).push(first[root])
        state[root] = 1
        while stack.len > 0 {
            let top = stack.len - 1
            let a = stack[top]
            let k = at[top]
            if k >= first[a + 1] {
                state[a] = 2
                let _ = (mut stack).pop() else -1
                let _ = (mut at).pop() else -1
                continue
            }
            at[top] = k + 1
            let ft = kids[k]
            if nominal(c, ft) {
                let child = c.types[ft].decl
                if state[child] == 1 { return child }
                if state[child] == 0 {
                    state[child] = 1
                    (mut stack).push(child)
                    (mut at).push(first[child])
                }
            }
        }
    }
    -1
}

fn signatures(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker) {
    let print_params = [str_type()]
    c.decl_type[0] = compound(mut c, "fn", unit_type(), print_params)
    adapters(s, mut r, mut c)
    if c.code != "" { return }
    var si: int = 0
    while si < r.structs.len {
        let st = r.structs[si]
        si += 1
        var k: int = 0
        while k < r.decls[st].count {
            let field = st + 1 + k
            let fnode = r.decls[field].node
            var tn = first_of(s, fnode)
            while kind_of(s, tn) == "Visibility" || kind_of(s, tn) == "Name" || kind_of(s, tn) == "Attribute" { tn = next_of(s, tn) }
            c.decl_type[field] = written(s, mut r, mut c, tn)
            c.term[fnode] = c.decl_type[field]
            k += 1
        }
    }
    var ei: int = 0
    while ei < r.enums.len {
        let en = r.enums[ei]
        ei += 1
        var k: int = 0
        while k < r.decls[en].count {
            let v = en + 1 + k
            var payload = List[int]()
            var tn = next_of(s, first_of(s, r.decls[v].node))
            while tn >= 0 {
                (mut payload).push(written(s, mut r, mut c, tn))
                tn = next_of(s, tn)
            }
            c.decl_type[v] = compound(mut c, "fn", c.decl_type[en], payload)
            c.term[r.decls[v].node] = c.decl_type[v]
            k += 1
        }
    }
    if c.code != "" { return }
    let cycle = inline_cycle(s, c, r)
    if cycle.node >= 0 {
        fail(mut c, "E0404", "this would be an infinite by-value type: {cycle.text}; recurse through non-inline storage", cycle.node)
        return
    }
    alias_cycles(s, r, mut c)
    if c.code != "" { return }
    // An alias's declared type is the row of the tags it names.
    var ai: int = 0
    while ai < r.aliases.len {
        let a = r.aliases[ai]
        var tags = List[int]()
        var nodes = List[int]()
        var own = List[bool]()
        row_tags(s, mut r, mut c, last_of(s, r.decls[a].node), 0, false, mut tags, mut nodes, mut own)
        c.decl_type[a] = row_type(mut c, tags)
        ai += 1
    }
    var results = List[int]()
    var open = List[bool]()
    var fi: int = 0
    while fi < r.functions.len {
        let f = r.functions[fi]
        fi += 1
        var params = List[int]()
        var result = unit_type()
        var opened = false
        var d = first_of(s, r.decls[f].node)
        while d >= 0 {
            let k = kind_of(s, d)
            if k == "Parameters" {
                var p = first_of(s, d)
                while p >= 0 {
                    var tn = first_of(s, p)
                    while kind_of(s, tn) == "Name" || kind_of(s, tn) == "Mode" { tn = next_of(s, tn) }
                    let t = written(s, mut r, mut c, tn)
                    c.decl_type[r.node_decl[p]] = t
                    c.term[p] = t
                    (mut params).push(t)
                    p = next_of(s, p)
                }
            } else if k == "ReturnType" {
                result = written(s, mut r, mut c, first_of(s, d))
                opened = open_result(s, first_of(s, d))
                c.dotted[f] = dotted_result(s, first_of(s, d))
                c.term[d] = result
            }
            d = next_of(s, d)
        }
        (mut results).push(result)
        (mut open).push(opened)
        c.decl_type[f] = compound(mut c, "fn", result, params)
    }
    if c.code == "" { infer_rows(s, r, mut c, mut results, open) }
    if c.code == "" { exported_rows(s, mut c) }
    if r.main >= 0 && c.code == "" {
        let ft = c.decl_type[r.main]
        let result = c.types[ft].inner
        var shown = result
        if c.types[result].kind == "result" { shown = c.types[result].inner }
        let fine = shown == unit_type() || shown == int_type()
        var site = r.decls[r.main].node
        var d = first_of(s, site)
        while d >= 0 { if kind_of(s, d) == "ReturnType" { site = d }; d = next_of(s, d) }
        if !fine {
            fail(mut c, "E0414", "`main` returns `{type_name(c, r.decls, result)}`, which is not a type the process can be handed", site)
        } else if c.types[ft].count > 0 {
            fail(mut c, "E0414", "`main` takes no parameters; read arguments from the environment", r.decls[r.main].node)
        }
    }
}

// `!T` and an open row take the tags their body raises and propagates, to a
// fixpoint over the calls under `?` (docs/TYPED.md, "Inferred rows").
fn infer_rows(s: front.Syntax, r: resolve.Resolved, mut c: Checker, mut results: List[int], open: List[bool]) {
    var grows = List[Grows]()
    var index = List[int]()
    var i: int = 0
    while i < r.decls.len { (mut index).push(-1); i += 1 }
    i = 0
    while i < r.functions.len {
        index[r.functions[i]] = i
        let declared = if kind_is(c, results[i], "result") then row_of(c, results[i]) else List[int]()
        var g = Grows { tags: List[int](), callees: List[int](), refused: -1, declared: declared }
        if open[i] {
            let node = r.decls[r.functions[i]].node
            let body = last_of(s, node)
            grows_of(s, r, mut c, body, mut g)
            let tail = last_of(s, body)
            if tail >= 0 && kind_of(s, tail) == "Tail" { raised(s, r, mut c, last_of(s, tail), mut g) }
            if g.refused >= 0 {
                fail(mut c, "F0001", "not yet in fenrir: a payload tag raised into an inferred row", g.refused)
                return
            }
        }
        (mut grows).push(g)
        i += 1
    }
    var changed = true
    while changed {
        changed = false
        i = 0
        while i < r.functions.len {
            if open[i] {
                var tags = row_of(c, results[i])
                let before = tags.len
                for t in grows[i].tags { (mut tags).push(t) }
                for callee in grows[i].callees {
                    let j = index[callee]
                    if kind_is(c, results[j], "result") { for t in row_of(c, results[j]) { (mut tags).push(t) } }
                }
                let next = result_type(mut c, c.types[results[i]].inner, tags)
                if next != results[i] && row_of(c, next).len != before { changed = true }
                results[i] = next
            }
            i += 1
        }
    }
    i = 0
    while i < r.functions.len {
        if open[i] {
            let f = r.functions[i]
            let ft = c.decl_type[f]
            var params = List[int]()
            var k: int = 0
            while k < c.types[ft].count { (mut params).push(c.type_params[c.types[ft].first + k]); k += 1 }
            c.decl_type[f] = compound(mut c, "fn", results[i], params)
        }
        i += 1
    }
}

// Final declaration ids: a candidate that proved a nullary constructor is
// dropped (its uses were redirected while typing), a binding becomes `bind`,
// and every id-valued column is renumbered densely in source order.
fn compact(mut r: resolve.Resolved, mut c: Checker) {
    var dropped = false
    for d in r.decls { if d.kind == "candidate" { dropped = true } }
    if !dropped { return }
    var map = List[int]()
    (mut map).reserve(r.decls.len)
    var next: int = 0
    var i: int = 0
    while i < r.decls.len {
        if r.decls[i].kind == "candidate" && c.settle[i] == 2 { (mut map).push(-1) }
        else { (mut map).push(next); next += 1 }
        i += 1
    }
    i = 0
    while i < r.decls.len {
        if map[i] < 0 && r.previous[i] >= 0 { map[i] = map[r.previous[i]] }
        i += 1
    }
    var decls = List[resolve.Decl]()
    (mut decls).reserve(next)
    i = 0
    while i < r.decls.len {
        if !(r.decls[i].kind == "candidate" && c.settle[i] == 2) {
            var d = copy r.decls[i]
            if d.kind == "candidate" { d.kind = "bind" }
            if d.owner >= 0 { d.owner = map[d.owner] }
            (mut decls).push(d)
        }
        i += 1
    }
    r.decls = decls
    i = 0
    while i < r.node_decl.len {
        if r.node_decl[i] >= 0 { r.node_decl[i] = map[r.node_decl[i]] }
        i += 1
    }
    i = 0
    while i < c.types.len {
        if c.types[i].decl >= 0 { c.types[i].decl = map[c.types[i].decl] }
        i += 1
    }
    i = 0
    while i < r.functions.len { r.functions[i] = map[r.functions[i]]; i += 1 }
    i = 0
    while i < r.structs.len { r.structs[i] = map[r.structs[i]]; i += 1 }
    i = 0
    while i < r.enums.len { r.enums[i] = map[r.enums[i]]; i += 1 }
    i = 0
    while i < c.analysis.len { c.analysis[i].function = map[c.analysis[i].function]; i += 1 }
    if r.main >= 0 { r.main = map[r.main] }
}

/// Drop the open types: a list, map, tuple or result interned while one of
/// its integer variables was unsolved. By now every node, declaration and
/// closed type names the solved type instead, so the table a consumer reads
/// holds closed types only, still in the order they were first built.
fn compact_types(mut r: resolve.Resolved, mut c: Checker) {
    var dropped = false
    for o in c.open { if o { dropped = true } }
    if !dropped { return }
    var map = List[int]()
    (mut map).reserve(c.types.len)
    var next: int = 0
    var i: int = 0
    while i < c.types.len {
        if c.open[i] { (mut map).push(-1) } else { (mut map).push(next); next += 1 }
        i += 1
    }
    var types = List[Type]()
    (mut types).reserve(next)
    i = 0
    while i < c.types.len && c.code == "" {
        if !c.open[i] {
            var ty = copy c.types[i]
            if ty.inner >= 0 { ty.inner = renumbered(mut c, map, ty.inner) }
            if ty.kind != "result" && ty.kind != "row" && ty.count > 0 {
                var k: int = 0
                while k < ty.count {
                    let at = ty.first + k
                    let item = renumbered(mut c, map, c.type_params[at])
                    c.type_params[at] = item
                    k += 1
                }
            }
            (mut types).push(ty)
        }
        i += 1
    }
    i = 0
    while i < c.tags.len {
        let first = c.tags[i].first
        var k: int = 0
        while k < c.tags[i].count {
            let item = renumbered(mut c, map, c.type_params[first + k])
            c.type_params[first + k] = item
            k += 1
        }
        i += 1
    }
    i = 0
    while i < r.decls.len {
        if r.decls[i].ty >= 0 { r.decls[i].ty = renumbered(mut c, map, r.decls[i].ty) }
        i += 1
    }
    i = 0
    while i < c.term.len {
        if c.term[i] >= 0 { let t = renumbered(mut c, map, c.term[i]); c.term[i] = t }
        i += 1
    }
    c.types = types
    var open = List[bool]()
    i = 0
    while i < next { (mut open).push(false); i += 1 }
    c.open = open
}

fn renumbered(mut c: Checker, map: List[int], t: int) -> int {
    if map[t] < 0 { fail(mut c, "internal", "an open type survived its function", 0) }
    map[t]
}

// `#[allow(code)]` on an item silences that code's warnings inside the item,
// body included ([diag.level.attr]); nothing else about the program changes.
fn allowed_warnings(s: front.Syntax, warnings: List[Warning]) -> List[Warning] {
    var kept = List[Warning]()
    for w in warnings {
        var silenced = false
        var item = first_of(s, s.root)
        while item >= 0 && !silenced {
            let span = copy s.nodes[item].span
            let at = s.nodes[w.node].span.start
            if kind_of(s, item) == "Item" && at >= span.start && at < span.end && resolve.allows(s, item, w.code) { silenced = true }
            item = next_of(s, item)
        }
        if !silenced { (mut kept).push(copy w) }
    }
    kept
}

/// Resolve and type one parsed unit; see docs/TYPED.md.
pub fn check(s: front.Syntax) -> Typed {
    var r = resolve.resolve(s)
    var c = Checker { code: r.code, message: r.message, at: r.at, types: List[Type](), type_params: List[int](),
        keys: resolve.names(), key_type: List[int](), decl_type: List[int](), term: List[int](), value: List[int](),
        texts: List[str](), bound_literal: List[bool](), parent: List[int](), bound: List[int](),
        literals: List[int](), visited: List[int](), locals: List[int](), result: 0, function: "", known_tags: resolve.names(),
        matches: List[int](), redirect: List[int](), settle: List[int](), in_pattern: List[bool](), alternatives: 0,
        pattern_undo: List[PatternUndo](), pattern_binds: List[PatternBinding](),
        warnings: List[Warning](), analysis: List[Analysis](), tags: List[Tag](), row_tags: List[int](),
        open: List[bool](), full: 0, dotted: List[bool](), dotted_self: false,
        float_id: -1, region_id: -1, var_kind: List[int](), floats: List[int]() }
    for kind in ["unit", "int", "bool", "str", "never", "i32", "i64", "u8", "u64", "uint", "char", "byte", "i8", "i16", "u16", "u32"] { builtin(mut c, kind) }
    var i: int = 0
    while i < s.nodes.len {
        (mut c.term).push(-1)
        (mut c.value).push(0)
        (mut c.bound_literal).push(false)
        (mut c.in_pattern).push(false)
        i += 1
    }
    i = 0
    while i < r.decls.len {
        (mut c.decl_type).push(-1)
        (mut c.redirect).push(-1)
        (mut c.settle).push(0)
        (mut c.dotted).push(false)
        i += 1
    }
    let fixed: List[int] = [-1, -1, 2, 3, 1, 9, 5, 6, 7, 8, 10, 11, 12, 13, 14, 15, -1, -1, -1, -1, -1, -1, -1, -1, never_type()]
    i = 0
    while i < fixed.len && i < r.decls.len { c.decl_type[i] = fixed[i]; i += 1 }
    // Struct, enum and adapter nominal types share one table, in declaration order.
    i = 0
    while i < r.decls.len {
        let k = r.decls[i].kind
        if k == "struct" || k == "enum" || k == "adapter" {
            c.decl_type[i] = c.types.len
            (mut c.types).push(Type { kind: k, decl: i, inner: -1, first: -1, count: 0 })
            (mut c.open).push(false)
        }
        i += 1
    }
    if c.code == "" { signatures(s, mut r, mut c) }
    i = 0
    while i < r.functions.len && c.code == "" {
        let f = r.functions[i]
        check_function(s, mut r, mut c, f)
        i += 1
    }
    var error = copy s.nodes[s.root].span
    if c.code != "" && c.at >= 0 { error = copy s.nodes[c.at].span }
    i = 0
    while i < r.decls.len { r.decls[i].ty = c.decl_type[i]; i += 1 }
    if c.code == "" { compact(mut r, mut c) }
    if c.code == "" { compact_types(mut r, mut c) }
    var node_type = List[int]()
    (mut node_type).reserve(s.nodes.len)
    for t in c.term { (mut node_type).push(if t >= 0 then t else -1) }
    let warnings = allowed_warnings(s, c.warnings)
    Typed { code: c.code, message: c.message, error: error, types: move c.types, type_params: move c.type_params,
        decls: move r.decls, param_mode: move r.param_mode, texts: move c.texts, node_type: move node_type, node_decl: move r.node_decl,
        node_site: move r.node_site, node_value: move c.value, functions: move r.functions,
        structs: move r.structs, enums: move r.enums, warnings: move warnings, analysis: move c.analysis,
        tags: move c.tags, row_tags: move c.row_tags, main: r.main }
}
