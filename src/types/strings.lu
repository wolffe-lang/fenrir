//! member: true

use front
use resolve

// The string range is a pair of byte offsets, not character indices.
fn check_string_range(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int) {
    let lo = first_of(s, n)
    let op = next_of(s, lo)
    if spell_of(s, op) != ".." {
        fail(mut c, "F0001", "not yet in fenrir: an inclusive string slice", op)
        return
    }
    for endpoint in [lo, last_of(s, n)] {
        let t = expr(s, mut r, mut c, endpoint)
        let _ = unify(mut c, r.decls, t, int_type(), endpoint, "a string byte offset must be")
    }
    let _ = set(mut c, n, str_type())
}

fn check_string_index(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int, args: List[int]) -> int {
    if args.len != 1 { fail(mut c, "E0402", "a string slice takes one range", n); return set(mut c, n, unit_type()) }
    if kind_of(s, args[0]) != "Range" {
        fail(mut c, "E0411", "`str` has no character indexing; use a byte-offset slice or a byte view", n)
        return set(mut c, n, unit_type())
    }
    check_string_range(s, mut r, mut c, args[0])
    set(mut c, n, str_type())
}

// Codes 100 and above belong to strings; collection method codes stay fixed.
fn check_string_method(s: front.Syntax, mut r: resolve.Resolved, mut c: Checker, n: int, member: int) -> int {
    let name = spell_of(s, member)
    let callee = first_of(s, n)
    var args = List[int]()
    var a = first_of(s, next_of(s, callee))
    while a >= 0 { (mut args).push(last_of(s, a)); a = next_of(s, a) }
    if name == "len" {
        if args.len != 0 { fail(mut c, "E0402", "`len` takes no arguments", n) }
        c.value[n] = 100
        return set(mut c, n, int_type())
    }
    if name == "get" {
        if args.len != 1 { fail(mut c, "E0402", "`get` takes one byte-offset range", n); return set(mut c, n, unit_type()) }
        if kind_of(s, args[0]) != "Range" {
            fail(mut c, "F0001", "not yet in fenrir: string get without a range", args[0])
            return set(mut c, n, unit_type())
        }
        check_string_range(s, mut r, mut c, args[0])
        c.value[n] = 101
        let none = none_tag(mut c)
        let result = result_type(mut c, str_type(), [none])
        return set(mut c, n, result)
    }
    let code = string_method_code(name)
    if code < 0 {
        fail(mut c, "F0001", "not yet in fenrir: string method `{name}`", member)
        return set(mut c, n, unit_type())
    }
    c.value[n] = code
    var params = List[int]()
    var result = str_type()
    if code == 102 {
        let parse = tag_id(mut c, "parse", List[int]())
        result = result_type(mut c, int_type(), [parse])
    } else if code == 103 || code == 104 {
        (mut params).push(str_type())
        let none = none_tag(mut c)
        result = result_type(mut c, int_type(), [none])
    } else if code >= 105 && code <= 108 {
        (mut params).push(str_type())
        result = if code == 108 then int_type() else bool_type()
    } else if code == 109 { (mut params).push(int_type()) }
    else if code == 110 { (mut params).push(str_type()); (mut params).push(str_type()) }
    else if code >= 111 && code <= 113 {
        if code == 111 { (mut params).push(str_type()) }
        result = list_type(mut c, str_type())
    } else if code == 117 { result = bool_type() }
    if args.len != params.len {
        fail(mut c, "E0402", "`{name}` takes {params.len} arguments, but this call passes {args.len}", n)
        return set(mut c, n, result)
    }
    var i: int = 0
    while i < args.len && c.code == "" {
        let actual = expr(s, mut r, mut c, args[i])
        let _ = unify(mut c, r.decls, actual, params[i], args[i], "`{name}` needs its {ordinal(i)} argument to be")
        i += 1
    }
    set(mut c, n, result)
}

fn string_method_code(name: str) -> int {
    if name == "to_int" { return 102 }
    if name == "find" { return 103 }
    if name == "rfind" { return 104 }
    if name == "starts_with" { return 105 }
    if name == "ends_with" { return 106 }
    if name == "contains" { return 107 }
    if name == "count" { return 108 }
    if name == "repeat" { return 109 }
    if name == "replace" { return 110 }
    if name == "split" { return 111 }
    if name == "words" { return 112 }
    if name == "lines" { return 113 }
    if name == "trim" { return 114 }
    if name == "trim_start" { return 115 }
    if name == "trim_end" { return 116 }
    if name == "is_empty" { return 117 }
    -1
}
