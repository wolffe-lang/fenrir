//! member: true

/// Parse the constant primitive format grammar into the public runtime bit plan.
/// Negative means malformed. No source expression or runtime parsing is involved.
pub fn format_parse(raw: str) -> int {
    if raw.len == 0 || raw.bytes()[0] as int != 58 { return -1 }
    var i = 1
    var bits = 0
    var align = 0
    if i + 1 < raw.len && format_align(raw.bytes()[i + 1] as int) > 0 {
        let fill = raw.bytes()[i] as int
        if fill >= 128 { return -1 }
        align = format_align(raw.bytes()[i + 1] as int)
        bits = fill
        i += 2
    } else if i < raw.len {
        align = format_align(raw.bytes()[i] as int)
        if align > 0 { i += 1 }
    }
    bits += align * 256
    if i < raw.len && raw.bytes()[i] as int == 43 { bits += 1024; i += 1 }
    if i < raw.len && raw.bytes()[i] as int == 48 {
        if align != 0 { return -1 }
        bits += 2048; i += 1
    }
    let start = i
    var width = 0
    while i < raw.len && format_digit(raw.bytes()[i] as int) {
        width = width * 10 + (raw.bytes()[i] as int) - 48
        if width > 65535 { return -1 }
        i += 1
    }
    if i > start { bits += 4096 + width * 65536 }
    if i < raw.len && raw.bytes()[i] as int == 46 {
        i += 1
        let first = i
        var precision = 0
        while i < raw.len && format_digit(raw.bytes()[i] as int) {
            precision = precision * 10 + (raw.bytes()[i] as int) - 48
            if precision > 65535 { return -1 }
            i += 1
        }
        if i == first { return -1 }
        bits += 8192 + precision * 4294967296
    }
    if i < raw.len {
        let b = raw.bytes()[i] as int
        let kind = if b == 98 then 1 else if b == 111 then 2 else if b == 120 then 3 else if b == 88 then 4 else if b == 101 then 5 else if b == 69 then 6 else if b == 102 then 7 else -1
        if kind < 0 { return -1 }
        bits += kind * 281474976710656
        i += 1
    }
    if i == raw.len then bits else -1
}

fn format_align(b: int) -> int { if b == 60 then 1 else if b == 94 then 2 else if b == 62 then 3 else 0 }
fn format_digit(b: int) -> bool { b >= 48 && b <= 57 }

/// Validate a packed non-floating spec and its scalar rendering flavor.
pub fn format_valid(bits: int, flavor: int) -> bool {
    if bits < 0 || flavor < 0 || flavor > 4 { return false }
    let radix = bits / 281474976710656
    if radix > 4 || bits % 256 >= 128 || (bits / 16384) % 4 != 0 { return false }
    let width = (bits / 65536) % 65536
    let precision = (bits / 4294967296) % 65536
    let has_width = (bits / 4096) % 2 == 1
    let has_precision = (bits / 8192) % 2 == 1
    let plus = (bits / 1024) % 2 == 1
    let zero = (bits / 2048) % 2 == 1
    let align = (bits / 256) % 4
    if (!has_width && width != 0) || (!has_precision && precision != 0) { return false }
    if zero && align != 0 { return false }
    if flavor == 1 || flavor == 2 { return !has_precision }
    if plus || zero || radix != 0 { return false }
    if flavor == 3 && has_precision { return false }
    true
}

/// Minimum output bound for padding; used before retaining rendered storage.
pub fn format_width(bits: int) -> int { if (bits / 4096) % 2 == 1 then (bits / 65536) % 65536 else 0 }

/// Apply the string surface's byte precision and padding to a scalar's text.
pub fn format_text(value: str, bits: int, numeric: bool) -> str {
    var text = value
    if (bits / 8192) % 2 == 1 {
        let cap = (bits / 4294967296) % 65536
        if cap < text.len {
            var end = cap
            while end > 0 && (text.bytes()[end] as int) >= 128 && (text.bytes()[end] as int) < 192 { end -= 1 }
            text = text[0..end]
        }
    }
    let width = format_width(bits)
    if width <= text.len { return text }
    let count = width - text.len
    var fill = bits % 256
    if fill == 0 { fill = 32 }
    let ch = scalar_text(fill) else " "
    if numeric && (bits / 2048) % 2 == 1 {
        let zeroes = "0".repeat(count)
        if text.len > 0 && (text.bytes()[0] as int == 43 || text.bytes()[0] as int == 45) { return text[0..1] + zeroes + text[1..text.len] }
        return zeroes + text
    }
    let padding = ch.repeat(count)
    var align = (bits / 256) % 4
    if align == 0 { align = if numeric then 3 else 1 }
    if align == 1 { return text + padding }
    if align == 3 { return padding + text }
    let left = count / 2
    padding[0..left] + text + padding[left..padding.len]
}

/// Render an integer's value, never its signed machine representation.
pub fn format_integer(value: int, bits: int, unsigned: bool) -> str {
    let code = bits / 281474976710656
    let radix = if code == 1 then 2 else if code == 2 then 8 else if code == 3 || code == 4 then 16 else 10
    let digits = if code == 4 then "0123456789ABCDEF" else "0123456789abcdef"
    var n = value as u64
    let negative = !unsigned && value < 0
    if negative { n = (-(value + 1)) as u64 + 1 }
    var text = ""
    if n == 0 { text = "0" }
    while n != 0 {
        let digit = (n % (radix as u64)) as int
        text = digits[digit..digit + 1] + text
        n /= radix as u64
    }
    if negative { text = "-" + text }
    else if (bits / 1024) % 2 == 1 { text = "+" + text }
    format_text(text, bits, true)
}
