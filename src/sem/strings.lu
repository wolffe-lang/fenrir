//! member: true

/// The total recoverable byte-offset slice from `[mem.str.get]`. Its miss
/// domain is also the checked slice's `bounds` domain, including UTF-8 splits.
pub fn text_slice(value: str, lo: int, hi: int) -> str ! {none} {
    value.get(lo..hi)
}

/// Normalize end-relative and inclusive endpoints without overflowing. Invalid
/// endpoint normalization is the same miss as any other invalid slice domain.
pub fn text_window(value: str, lo: int, hi: int, mode: int) -> str ! {none} {
    var a = lo
    var b = hi
    if mode % 2 == 1 {
        if a < 0 || a > value.len { return none }
        a = value.len - a
    }
    if (mode / 2) % 2 == 1 {
        if b < 0 || b > value.len { return none }
        b = value.len - b
    }
    if mode >= 4 {
        if b < 0 || b >= value.len { return none }
        b += 1
    }
    text_slice(value, a, b)
}

/// Encode one scalar word as the runtime's character entry does. Invalid FIR
/// scalar words use U+FFFD; source-language characters are valid by construction.
pub fn scalar_text(value: int) -> str ! {Bad(str)} {
    var scalar = value
    if scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343) { scalar = 65533 }
    var bytes = List[byte]()
    (mut bytes).reserve(4)
    utf8(mut bytes, scalar)
    str_from_utf8(bytes) else |_| { return Bad("invalid scalar encoding") }
}
