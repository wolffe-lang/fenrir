// Recursive descent around a precedence-climbing expression parser.
fn precedence(k: str) -> int {
    if k == "else" { return 1 }
    if k == ".." || k == "..=" { return 2 }
    if k == "||" { return 3 }
    if k == "&&" { return 4 }
    if k == "==" || k == "!=" || k == "<" || k == ">" || k == "<=" || k == ">=" || k == "<=>" { return 5 }
    if k == "|" { return 6 }
    if k == "^" { return 7 }
    if k == "&" { return 8 }
    if k == "<<" || k == ">>" { return 9 }
    if k == "+" || k == "-" { return 10 }
    if k == "*" || k == "/" || k == "%" { return 11 }
    if k == "as" { return 12 }
    0
}
fn assignment(k: str) -> bool {
    k == "=" || k == "+=" || k == "-=" || k == "*=" || k == "/=" || k == "%=" || k == "&=" || k == "|=" || k == "^=" || k == "<<=" || k == ">>="
}
fn operand_start(k: str) -> bool {
    is_literal(k) || k == "ident" || k == "(" || k == "[" || k == r"{" || k == "!" || k == "-" || k == "&" || k == "*" || k == "move" || k == "copy" || k == "shared" || k == "freeze" || k == "^" || k == "if" || k == "match" || k == "for" || k == "while" || k == "loop" || k == "fn" || k == "region" || k == "in" || k == "scope" || k == "spawn" || k == "select" || k == "when" || k == "unsafe" || k == "asm" || k == "borrow" || k == "return" || k == "break" || k == "continue" || k == ".." || k == "..="
}
fn expression(mut p: Syntax, structures: bool, defaults: bool) -> int {
    climb(mut p, if defaults then 1 else 2, structures)
}
fn climb(mut p: Syntax, minimum: int, structures: bool) -> int {
    if !enter(mut p) { return -1 }
    let start = p.pos
    var left = operand(mut p, structures)
    var comparison = false
    var ranged = false
    while p.code == "" {
        let op = current(p)
        let level = precedence(op)
        if level == 0 || level < minimum { break }
        if level == 5 && comparison { refuse(mut p, "E0003", "comparisons do not chain; combine comparisons with &&"); break }
        if level == 2 && ranged { refuse(mut p, "E0201", "ranges do not chain"); break }
        let n = node(mut p, if level == 1 then "Default" else if level == 2 then "Range" else if level == 12 then "Cast" else "Binary", start)
        child(mut p, n, left)
        child(mut p, n, leaf(mut p, "Operator"))
        if level == 12 { child(mut p, n, parse_type(mut p)) }
        else if level == 1 {
            if eat(mut p, "|") {
                let handler = node(mut p, "Handler", p.pos - 1)
                child(mut p, handler, parse_pattern(mut p, false)); expect(mut p, "|")
                child(mut p, handler, expression(mut p, structures, true))
                child(mut p, n, end_node(mut p, handler))
            }
            else { child(mut p, n, climb(mut p, level, structures)) }
        }
        else if level != 2 || operand_start(current(p)) { child(mut p, n, climb(mut p, level + 1, structures)) }
        if level == 5 { comparison = true }
        if level == 2 { ranged = true }
        left = end_node(mut p, n)
    }
    leave(mut p)
    left
}
fn operand(mut p: Syntax, structures: bool) -> int {
    let start = p.pos
    let k = current(p)
    if k == "!" || k == "-" || k == "&" || k == "*" || k == "move" || k == "copy" || k == "shared" || k == "freeze" || k == "^" {
        let n = node(mut p, if k == "^" then "FromEnd" else "Prefix", start)
        child(mut p, n, leaf(mut p, "Operator"))
        if k == "&" && current(p) == "mut" { child(mut p, n, leaf(mut p, "Mode")) }
        child(mut p, n, climb(mut p, 13, structures))
        return end_node(mut p, n)
    }
    if k == ".." || k == "..=" {
        let n = node(mut p, "Range", start)
        child(mut p, n, leaf(mut p, "Operator"))
        child(mut p, n, climb(mut p, 3, structures))
        return end_node(mut p, n)
    }
    if k == "return" || k == "break" || k == "continue" {
        let n = node(mut p, "Jump", start)
        child(mut p, n, leaf(mut p, "JumpKind"))
        if k != "continue" && operand_start(current(p)) { child(mut p, n, expression(mut p, structures, true)) }
        return end_node(mut p, n)
    }
    var left = primary(mut p, structures)
    while p.code == "" {
        let post = current(p)
        if post == "(" || post == "[" {
            let n = node(mut p, if post == "(" then "Call" else "Index", start)
            child(mut p, n, left)
            child(mut p, n, arguments(mut p, post == "["))
            left = end_node(mut p, n)
        }
        else if post == "." {
            let n = node(mut p, "Member", start)
            child(mut p, n, left); advance(mut p)
            if current(p) == "ident" || current(p) == "int" || keyword(current(p)) {
                child(mut p, n, leaf(mut p, "MemberName"))
            }
            else { refuse(mut p, "E0201", "expected a member name after '.'") }
            left = end_node(mut p, n)
        }
        else if post == "?" {
            let n = node(mut p, "Propagate", start)
            child(mut p, n, left); advance(mut p)
            left = end_node(mut p, n)
        }
        else if post == r"{" && structures && left >= 0 && (p.nodes[left].kind == "Name" || p.nodes[left].kind == "Member") {
            let n = node(mut p, "StructLiteral", start)
            child(mut p, n, left); advance(mut p)
            while p.code == "" && current(p) != r"}" && current(p) != "eof" {
                let f = node(mut p, "FieldInitializer", p.pos)
                child(mut p, f, name(mut p))
                if eat(mut p, ":") { child(mut p, f, expression(mut p, true, true)) }
                child(mut p, n, end_node(mut p, f))
                if !eat(mut p, ",") { break }
                terms(mut p)
            }
            terms(mut p); expect(mut p, r"}")
            left = end_node(mut p, n)
        }
        else { break }
    }
    left
}
fn arguments(mut p: Syntax, index: bool) -> int {
    let n = node(mut p, if index then "IndexArguments" else "CallArguments", p.pos)
    advance(mut p)
    let close = if index then "]" else ")"
    while p.code == "" && current(p) != close && current(p) != "eof" {
        let arg = node(mut p, "Argument", p.pos)
        if current(p) == "mut" || current(p) == "take" { child(mut p, arg, leaf(mut p, "Mode")) }
        if index && (prefix_type(current(p)) || (current(p) == "region" && (look(p, 1) == "," || look(p, 1) == "]"))) {
            child(mut p, arg, parse_type(mut p))
        }
        else { child(mut p, arg, expression(mut p, true, true)) }
        child(mut p, n, end_node(mut p, arg))
        if !eat(mut p, ",") { break }
    }
    expect(mut p, close)
    end_node(mut p, n)
}

fn primary(mut p: Syntax, structures: bool) -> int {
    let start = p.pos
    let k = current(p)
    if is_literal(k) { return literal(mut p) }
    if k == "ident" { return name(mut p) }
    if k == r"{" { return block(mut p) }
    if k == "(" {
        advance(mut p)
        let moded = current(p) == "mut" || current(p) == "take"
        let n = node(mut p, if moded then "Receiver" else "Group", start)
        if moded { child(mut p, n, leaf(mut p, "Mode")) }
        child(mut p, n, expression(mut p, true, true))
        if eat(mut p, ",") {
            p.nodes[n].kind = "Tuple"
            while p.code == "" && current(p) != ")" && current(p) != "eof" {
                child(mut p, n, expression(mut p, true, true))
                if !eat(mut p, ",") { break }
            }
        }
        expect(mut p, ")")
        if moded && current(p) != "." {
            refuse(mut p, "E0210", "a parenthesized moded receiver must be followed by a member")
            if p.code == "E0210" { p.error = copy p.tokens[start].span; p.error.end = p.tokens[max(start, p.pos - 1)].span.end }
        }
        return end_node(mut p, n)
    }
    if k == "[" {
        let n = node(mut p, "List", start)
        advance(mut p)
        while p.code == "" && current(p) != "]" && current(p) != "eof" {
            child(mut p, n, expression(mut p, true, true))
            if !eat(mut p, ",") { break }
        }
        expect(mut p, "]")
        return end_node(mut p, n)
    }
    if k == "if" { return if_expression(mut p) }
    if k == "match" || k == "select" { return match_expression(mut p, k == "select") }
    if k == "for" || k == "while" || k == "loop" {
        let n = node(mut p, "Loop", start)
        child(mut p, n, leaf(mut p, "LoopKind"))
        if k == "for" { child(mut p, n, parse_pattern(mut p, true)); expect(mut p, "in") }
        if k != "loop" { child(mut p, n, expression(mut p, false, true)) }
        child(mut p, n, block(mut p))
        return end_node(mut p, n)
    }
    if k == "fn" {
        let n = node(mut p, "Closure", start)
        advance(mut p); child(mut p, n, parameters(mut p, true))
        child(mut p, n, expression(mut p, true, true))
        return end_node(mut p, n)
    }
    if k == "region" || k == "in" { return region_expression(mut p) }
    if k == "scope" {
        let n = node(mut p, "Scope", start)
        advance(mut p)
        if current(p) == "ident" { child(mut p, n, name(mut p)) }
        child(mut p, n, block(mut p))
        return end_node(mut p, n)
    }
    if k == "spawn" {
        let n = node(mut p, "Spawn", start)
        advance(mut p); expect(mut p, "proc")
        child(mut p, n, parse_path(mut p)); child(mut p, n, arguments(mut p, false))
        return end_node(mut p, n)
    }
    if k == "when" {
        let n = node(mut p, "When", start)
        advance(mut p); expect(mut p, "(")
        child(mut p, n, expression(mut p, true, true)); expect(mut p, ",")
        child(mut p, n, expression(mut p, true, true))
        while eat(mut p, ",") && p.code == "" && current(p) != ")" { child(mut p, n, expression(mut p, true, true)) }
        expect(mut p, ")"); child(mut p, n, block(mut p))
        return end_node(mut p, n)
    }
    if k == "unsafe" { return unsafe_expression(mut p) }
    if k == "asm" { return asm_expression(mut p) }
    if k == "borrow" {
        let n = node(mut p, "Borrow", start)
        advance(mut p); child(mut p, n, expression(mut p, structures, true))
        if word(p) != "from" { refuse(mut p, "E0201", "borrow requires 'from'") }
        advance(mut p); child(mut p, n, expression(mut p, structures, true))
        return end_node(mut p, n)
    }
    refuse(mut p, if k == ";" then "E0002" else if k == "#![" then "E0211" else "E0201", "expected an expression")
    -1
}

fn if_expression(mut p: Syntax) -> int {
    let n = node(mut p, "If", p.pos)
    expect(mut p, "if")
    child(mut p, n, expression(mut p, false, false))
    let then_word = current(p) == "ident" && word(p) == "then"
    if then_word { advance(mut p) }
    let braced = current(p) == r"{"
    if !braced && !then_word { refuse(mut p, "E0201", "if condition must be followed by a block or 'then' expression") }
    child(mut p, n, if braced then block(mut p) else expression(mut p, true, false))
    if current(p) == "else" && (!braced || look(p, 1) == "if" || look(p, 1) == r"{") {
        advance(mut p)
        if current(p) == "if" { child(mut p, n, if_expression(mut p)) }
        else if braced { child(mut p, n, block(mut p)) }
        else {
            if current(p) == r"{" { refuse(mut p, "E0201", "both branches of a bare if must be expressions, not blocks") }
            child(mut p, n, expression(mut p, true, false))
        }
    }
    end_node(mut p, n)
}

fn match_expression(mut p: Syntax, select: bool) -> int {
    let n = node(mut p, if select then "Select" else "Match", p.pos)
    advance(mut p)
    if !select { child(mut p, n, expression(mut p, false, true)) }
    expect(mut p, r"{"); terms(mut p)
    var count = 0
    while p.code == "" && current(p) != r"}" && current(p) != "eof" {
        let arm = node(mut p, "Arm", p.pos)
        if select && word(p) == "timeout" && look(p, 1) == "(" {
            child(mut p, arm, leaf(mut p, "Timeout")); expect(mut p, "(")
            child(mut p, arm, expression(mut p, true, true)); expect(mut p, ")")
        }
        else {
            child(mut p, arm, parse_pattern(mut p, true))
            if select {
                if word(p) != "from" { refuse(mut p, "E0201", "select pattern must be followed by 'from'") }
                advance(mut p); child(mut p, arm, expression(mut p, true, true))
            }
            else if eat(mut p, "if") {
                let guard = node(mut p, "Guard", p.pos - 1)
                child(mut p, guard, expression(mut p, true, true)); child(mut p, arm, end_node(mut p, guard))
            }
        }
        expect(mut p, "=>")
        let braced = current(p) == r"{"
        child(mut p, arm, expression(mut p, true, true))
        child(mut p, n, end_node(mut p, arm))
        count += 1
        if eat(mut p, ",") { terms(mut p) }
        else if current(p) == "term" {
            terms(mut p)
            if !braced && current(p) != r"}" { refuse(mut p, "E0201", "expression-bodied arms require a separating comma") }
        }
        else if current(p) != r"}" && !braced { refuse(mut p, "E0201", "expression-bodied arms require a separating comma") }
    }
    if select && count == 0 { refuse(mut p, "E0201", "select requires at least one arm") }
    expect(mut p, r"}")
    end_node(mut p, n)
}

fn strategy(mut p: Syntax) -> int {
    let n = node(mut p, "RegionStrategy", p.pos)
    let s = word(p)
    if current(p) != "ident" || (s != "rc" && s != "pool") { refuse(mut p, "E0201", "region strategy must be rc or pool(type)") }
    child(mut p, n, name(mut p))
    if s == "pool" { expect(mut p, "("); child(mut p, n, parse_type(mut p)); expect(mut p, ")") }
    end_node(mut p, n)
}
fn region_cap(mut p: Syntax) -> int {
    let n = node(mut p, "RegionCapacity", p.pos)
    if word(p) != "cap" { refuse(mut p, "E0201", "region capacity must be spelled cap: expression") }
    advance(mut p); expect(mut p, ":")
    child(mut p, n, expression(mut p, true, true))
    end_node(mut p, n)
}
fn region_expression(mut p: Syntax) -> int {
    let n = node(mut p, "Region", p.pos)
    let into = current(p) == "in"
    advance(mut p)
    if into {
        p.nodes[n].kind = "InRegion"
        child(mut p, n, expression(mut p, false, true)); child(mut p, n, block(mut p))
        return end_node(mut p, n)
    }
    if eat(mut p, "(") {
        p.nodes[n].kind = "RegionValue"
        if current(p) != ")" {
            if word(p) == "cap" { child(mut p, n, region_cap(mut p)) }
            else {
                child(mut p, n, strategy(mut p))
                if eat(mut p, ",") { child(mut p, n, region_cap(mut p)) }
            }
        }
        expect(mut p, ")")
        return end_node(mut p, n)
    }
    if current(p) == "ident" {
        child(mut p, n, name(mut p))
        if eat(mut p, "(") { child(mut p, n, region_cap(mut p)); expect(mut p, ")") }
    }
    if eat(mut p, ":") { child(mut p, n, strategy(mut p)) }
    child(mut p, n, block(mut p))
    end_node(mut p, n)
}

fn unsafe_expression(mut p: Syntax) -> int {
    let n = node(mut p, "Unsafe", p.pos)
    expect(mut p, "unsafe")
    if current(p) == "ident" && word(p) == "c" {
        p.nodes[n].kind = "InlineC"
        advance(mut p)
        if eat(mut p, "[") {
            let captures = node(mut p, "Captures", p.pos - 1)
            child(mut p, captures, name(mut p))
            while eat(mut p, ",") && p.code == "" && current(p) != "]" { child(mut p, captures, name(mut p)) }
            expect(mut p, "]"); child(mut p, n, end_node(mut p, captures))
        }
        // Inline C bodies are a dedicated opaque lexer token, not wolf syntax.
        if current(p) == "c-body" { child(mut p, n, leaf(mut p, "CBody")) }
        else { refuse(mut p, "E0201", "expected inline C body") }
    }
    else { child(mut p, n, block(mut p)) }
    end_node(mut p, n)
}
fn asm_expression(mut p: Syntax) -> int {
    let n = node(mut p, "Asm", p.pos)
    expect(mut p, "asm"); expect(mut p, r"{")
    child(mut p, n, literal(mut p))
    while eat(mut p, ",") && p.code == "" {
        terms(mut p)
        if current(p) == r"}" { break }
        let arg = node(mut p, "AsmOperand", p.pos)
        if current(p) == "ident" && look(p, 1) == "=" { child(mut p, arg, name(mut p)); expect(mut p, "=") }
        if word(p) != "in" && word(p) != "out" && word(p) != "inout" && word(p) != "lateout" { refuse(mut p, "E0201", "expected an asm operand direction") }
        child(mut p, arg, leaf(mut p, "AsmDirection")); expect(mut p, "(")
        child(mut p, arg, name(mut p)); expect(mut p, ")")
        child(mut p, arg, expression(mut p, true, true))
        child(mut p, n, end_node(mut p, arg))
    }
    terms(mut p); expect(mut p, r"}")
    end_node(mut p, n)
}

fn block(mut p: Syntax) -> int {
    if !enter(mut p) { return -1 }
    let n = node(mut p, "Block", p.pos)
    expect(mut p, r"{"); terms(mut p)
    while p.code == "" && current(p) != r"}" && current(p) != "eof" {
        let start = p.pos
        let s = node(mut p, "Statement", start)
        parse_attributes(mut p, s, false)
        let k = current(p)
        if k == ";" { refuse(mut p, "E0002", "empty statements are not allowed") }
        else if k == "fn" && look(p, 1) == "(" {
            child(mut p, s, expression(mut p, true, true)); term(mut p)
        }
        else if item_start(p) { child(mut p, s, parse_item(mut p)) }
        else if k == "defer" || k == "errdefer" {
            let d = node(mut p, "Defer", p.pos)
            child(mut p, d, leaf(mut p, "DeferKind")); child(mut p, d, expression(mut p, true, true))
            term(mut p); child(mut p, s, end_node(mut p, d))
        }
        else if k == "assume" {
            let a = node(mut p, "Assume", p.pos)
            advance(mut p)
            if word(p) != "noalias" { refuse(mut p, "E0201", "assume requires noalias") }
            advance(mut p); child(mut p, a, expression(mut p, true, true)); expect(mut p, ",")
            child(mut p, a, expression(mut p, true, true))
            while eat(mut p, ",") && p.code == "" { child(mut p, a, expression(mut p, true, true)) }
            term(mut p); child(mut p, s, end_node(mut p, a))
        }
        else {
            let left = expression(mut p, true, true)
            if assignment(current(p)) {
                let a = node(mut p, "Assignment", start)
                child(mut p, a, left)
                let op = current(p)
                child(mut p, a, leaf(mut p, "Operator"))
                if current(p) == "take" {
                    if op != "=" || left < 0 || p.nodes[left].kind != "Index" { refuse(mut p, "E0201", "take assignment is only allowed for a plain container-element store") }
                    child(mut p, a, leaf(mut p, "Mode"))
                }
                child(mut p, a, expression(mut p, true, true)); term(mut p)
                child(mut p, s, end_node(mut p, a))
            }
            else {
                if current(p) == r"}" { p.nodes[s].kind = "Tail" }
                else { term(mut p) }
                child(mut p, s, left)
            }
        }
        child(mut p, n, end_node(mut p, s)); terms(mut p)
        if p.pos == start && p.code == "" { refuse(mut p, "E0201", "expected a statement") }
    }
    expect(mut p, r"}")
    leave(mut p)
    end_node(mut p, n)
}

/// Parse one UTF-8 unit, stopping at the first syntax error without recovery.
pub fn parse(file: str, text: str) -> Syntax {
    var l = lex(file, text)
    var p = Syntax { file: file, text: text, tokens: move l.tokens, nodes: List[Node](),
        root: -1, pos: 0, depth: 0, string_depth: 0, code: l.code,
        message: l.message, error: copy l.error }
    if p.code != "" { return p }
    let root = node(mut p, "Unit", 0)
    p.root = root
    parse_attributes(mut p, root, true); terms(mut p)
    while p.code == "" && current(p) != "eof" {
        let before = p.pos
        child(mut p, root, parse_item(mut p)); terms(mut p)
        if p.pos == before && p.code == "" { refuse(mut p, "E0201", "expected a declaration") }
    }
    end_node(mut p, root)
    p
}
