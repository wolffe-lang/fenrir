// Inline C is opaque: only comments, quotes and balanced braces are scanned.
fn inline_c_start(l: Lexer) -> bool {
    var i = l.tokens.len - 1
    while i >= 0 && l.tokens[i].kind == "newline" { i -= 1 }
    if i >= 0 && l.tokens[i].kind == "]" {
        i -= 1
        while i >= 0 && l.tokens[i].kind != "[" { i -= 1 }
        i -= 1
    }
    if i < 1 || l.tokens[i].kind != "ident" { return false }
    let s = l.tokens[i].span
    if l.text[s.start..s.end] != "c" { return false }
    l.tokens[i - 1].kind == "unsafe"
}

fn lex_c_body(mut l: Lexer) {
    let start = site(l)
    var depth = 0
    var quote = 0
    var line_comment = false
    var block_comment = false
    while l.pos < l.bytes.len {
        let b = at(l, 0)
        if line_comment {
            step(mut l)
            if b == 10 { line_comment = false }
        }
        else if block_comment {
            if b == 42 && at(l, 1) == 47 { step(mut l); step(mut l); block_comment = false }
            else { scalar_step(mut l) }
        }
        else if quote != 0 {
            step(mut l)
            if b == 92 && l.pos < l.bytes.len { scalar_step(mut l) }
            else if b == quote { quote = 0 }
        }
        else if b == 47 && at(l, 1) == 47 { line_comment = true; step(mut l); step(mut l) }
        else if b == 47 && at(l, 1) == 42 { block_comment = true; step(mut l); step(mut l) }
        else if b == 34 || b == 39 { quote = b; step(mut l) }
        else {
            if b == 123 { depth += 1 }
            if b == 125 { depth -= 1 }
            scalar_step(mut l)
            if depth == 0 { token(mut l, "c-body", start); return }
        }
    }
    lex_error(mut l, "E0202", "unclosed inline C body", start)
}
