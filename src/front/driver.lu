fn escaped(text: str) -> str {
    text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t").replace("\0", "\\0")
}
fn report(code: str, message: str, span: Span) {
    eprint("{span.file}:{span.line}:{span.col}: error[{code}]: {message} (bytes {span.start}..{span.end})")
}
/// 4 for fenrir's own nesting rail (a refusal, [conf.exit.refused]), else 2.
pub fn status(code: str) -> int { if code == "F0002" then 4 else 2 }
fn dump_tokens(tokens: List[Token], text: str) {
    var i = 0
    while i < tokens.len {
        let t = copy tokens[i]
        let s = t.span
        let raw = escaped(text[s.start..s.end])
        print("token {i} {t.kind} {s.start} {s.end} {s.line} {s.col} {s.end_line} {s.end_col} \"{raw}\"")
        i += 1
    }
}

/// Emit deterministic tokens or an AST; return 2 for source or I/O rejection.
pub fn emit(path: str, mode: str) -> int {
    let text = fs_read_text(path) else |reason| {
        match reason {
            utf8 => { return invalid_utf8(path) },
            _ => { eprint("{path}:1:1: error[E0200]: cannot read source file"); return 2 },
        }
    }
    if mode == "tokens" {
        let l = lex(path, text)
        if l.code != "" { report(l.code, l.message, l.error); return 2 }
        print("tokens/1 \"{escaped(path)}\"")
        dump_tokens(l.tokens, text)
        return 0
    }
    if mode != "ast" {
        eprint("{path}:1:1: error[E0200]: unknown front-end emission mode")
        return 2
    }
    let p = parse(path, text)
    if p.code != "" { report(p.code, p.message, p.error); return status(p.code) }
    print("ast/1 \"{escaped(path)}\" root={p.root}")
    dump_tokens(p.tokens, text)
    var i = 0
    while i < p.nodes.len {
        let n = copy p.nodes[i]
        let s = n.span
        print("node {i} {n.kind} {n.token} {n.first} {n.last} {n.next} {s.start} {s.end} {s.line} {s.col} {s.end_line} {s.end_col}")
        i += 1
    }
    0
}

fn invalid_utf8(path: str) -> int {
    let bytes = fs_read_bytes(path) else {
        eprint("{path}:1:1: error[E0200]: cannot read source file")
        return 2
    }
    var l = Lexer { file: path, text: "", bytes: bytes, starts: List[int](),
        continues: List[int](), pos: 0, line: 1, col: 1, tokens: List[Token](),
        code: "", message: "", error: Span { file: path, start: 0, end: 0,
        line: 1, col: 1, end_line: 1, end_col: 1 }, string_depth: 0, mode_depth: 0 }
    if at(l, 0) == 239 && at(l, 1) == 187 && at(l, 2) == 191 { l.pos = 3 }
    while l.pos < l.bytes.len {
        if scalar(l, l.pos) < 0 {
            let start = site(l)
            step(mut l)
            report("E0107", "source is not valid UTF-8", finish(l, start))
            return 2
        }
        scalar_step(mut l)
    }
    eprint("{path}:1:1: error[E0200]: source changed while reading")
    2
}
