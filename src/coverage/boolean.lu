//! member: true

// 1 = complement, 2 = conjunction, 3 = disjunction. Commutative arguments
// are normalized in push, so memo keys do not depend on operand spelling.
fn trivial(op: int, a: int, b: int) -> int {
    if op == 1 {
        if a < 2 { return 1 - a }
        return -1
    }
    if a == b { return a }
    if op == 2 {
        if a == 0 { return 0 }
        if a == 1 { return b }
    } else {
        if a == 0 { return b }
        if a == 1 { return 1 }
    }
    -1
}

fn variable(s: State, root: int) -> int {
    if root < 2 { return 9223372036854775807 }
    s.nodes[root - 2].variable
}

fn edge(s: State, root: int, at: int, high: bool) -> int {
    if root < 2 || s.nodes[root - 2].variable != at { return root }
    if high { return s.nodes[root - 2].high }
    s.nodes[root - 2].low
}

fn apply(mut s: State, op: int, a: int, b: int) -> int ! Failure {
    charge(mut s, 0, 0)?
    if !valid(s, a) || !valid(s, b) { return Internal("invalid coverage root") }
    if s.depth != 0 { return Internal("coverage worklist is not empty") }
    push(mut s, op, a, b)?
    var result: int = 0
    while s.depth > 0 {
        charge(mut s, 1, 0)?
        let index = s.depth - 1
        let f = s.work[index]
        if f.stage == 0 {
            result = trivial(op, f.a, f.b)
            if result >= 0 { s.depth -= 1; continue }
            result = recalled(mut s, op, f.a, f.b)?
            if result >= 0 { s.depth -= 1; continue }
            var at = variable(s, f.a)
            let other = variable(s, f.b)
            if other < at { at = other }
            s.work[index].variable = at
            s.work[index].stage = 1
            let low_a = edge(s, f.a, at, false)
            let low_b = edge(s, f.b, at, false)
            push(mut s, op, low_a, low_b)?
        } else if f.stage == 1 {
            s.work[index].low = result
            s.work[index].stage = 2
            let high_a = edge(s, f.a, f.variable, true)
            let high_b = edge(s, f.b, f.variable, true)
            push(mut s, op, high_a, high_b)?
        } else {
            result = node(mut s, f.variable, f.low, result)?
            remember(mut s, op, f.a, f.b, result)?
            s.depth -= 1
        }
    }
    result
}

/// The conjunction of two existing predicates.
pub fn both(mut s: State, a: int, b: int) -> int ! Failure { apply(mut s, 2, a, b)? }

/// The disjunction of two existing predicates.
pub fn either(mut s: State, a: int, b: int) -> int ! Failure { apply(mut s, 3, a, b)? }

/// Complement a predicate without recursion in the host language.
pub fn invert(mut s: State, root: int) -> int ! Failure { apply(mut s, 1, root, 0)? }

/// Values in the first predicate but not in the second.
pub fn difference(mut s: State, a: int, b: int) -> int ! Failure {
    charge(mut s, 0, 0)?
    if !valid(s, a) || !valid(s, b) { return Internal("invalid coverage root") }
    let inverse = invert(mut s, b)?
    both(mut s, a, inverse)?
}

/// A single variable's value.
pub fn literal(mut s: State, variable: int, value: bool) -> int ! Failure {
    charge(mut s, 0, 0)?
    if variable < 0 { return Internal("negative coverage variable") }
    if value { return node(mut s, variable, 0, 1)? }
    node(mut s, variable, 1, 0)?
}

fn bits_valid(first: int, width: int) -> bool {
    if first < 0 || width < 0 || width > 64 { return false }
    width == 0 || first <= 9223372036854775807 - (width - 1)
}

/// Equality of a most-significant-bit-first unsigned vector and a constant.
pub fn equal_bits(mut s: State, first: int, width: int, value: u64) -> int ! Failure {
    charge(mut s, 1, 0)?
    if !bits_valid(first, width) { return Internal("invalid coverage bit vector") }
    if width < 64 && value >> (width as u64) != 0 { return 0 }
    var root: int = 1
    var i = width
    var remaining = value
    while i > 0 {
        i -= 1
        if (remaining & 1) == 0 { root = node(mut s, first + i, root, 0)? }
        else { root = node(mut s, first + i, 0, root)? }
        remaining >>= 1
    }
    root
}

/// Unsigned less-than over a most-significant-bit-first vector.
pub fn less_bits(mut s: State, first: int, width: int, value: u64) -> int ! Failure {
    charge(mut s, 1, 0)?
    if !bits_valid(first, width) { return Internal("invalid coverage bit vector") }
    if width < 64 && value >> (width as u64) != 0 { return 1 }
    var root: int = 0
    var i = width
    var remaining = value
    while i > 0 {
        i -= 1
        if (remaining & 1) == 0 { root = node(mut s, first + i, root, 0)? }
        else { root = node(mut s, first + i, 1, root)? }
        remaining >>= 1
    }
    root
}

/// A deterministic low-edge-first witness; unconstrained variables are -1.
pub fn witness(mut s: State, root: int, variables: int) -> List[int] ! Failure {
    charge(mut s, 0, 0)?
    if !valid(s, root) || root == 0 || variables < 0 {
        return Internal("invalid coverage witness request")
    }
    // Validate indices before allocating the output. The path is repeated,
    // not stored: both passes charge each node visit and use constant space.
    var at = root
    while at > 1 {
        charge(mut s, 1, 0)?
        let n = s.nodes[at - 2]
        if n.variable >= variables { return Internal("witness omits a variable") }
        at = if n.low != 0 then n.low else n.high
    }
    // Saturating the request to cap+1 avoids arithmetic overflow while still
    // giving the cell cap precedence when both charges would fail.
    let cells = if variables > 1000000 then 1000001 else variables
    let bytes = if variables > 8388604 then 67108865 else 32 + variables * 8
    charge(mut s, cells, bytes)?
    var out = List[int]()
    (mut out).reserve(variables)
    var i: int = 0
    while i < variables { (mut out).push(-1); i += 1 }
    at = root
    while at > 1 {
        charge(mut s, 1, 0)?
        let n = s.nodes[at - 2]
        if n.low != 0 { out[n.variable] = 0; at = n.low }
        else { out[n.variable] = 1; at = n.high }
    }
    out
}
