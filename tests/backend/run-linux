#!/usr/bin/env bash
# The Linux gate: `run-linux` runs every step; `run-linux PART` runs the shared
# fetch and builds, then one part, so CI can run the parts as parallel jobs:
# proof (the backend's rows, scaling and the linked-program proof; CI runs it as
# two jobs, proof-1 with the linked-program proof, the backend rows and scaling,
# and proof-2 with the generated mode and string case tables), lower (the
# lowering rows), tranches (the string predictions, the frozen tranche rows, the
# interpreter's whole-core table and the delta), corpus-1 to corpus-3 (the
# census-driven native corpus differential, each core row in exactly one shard),
# or preflight (the complete cheap fixture validity checks, one linked
# lowering smoke and the region-scaling smoke).
# With FENRIR_RUN_LINUX_LIST=1 it runs nothing and prints `STEP NAME` for each
# step the part would run, in order (tests/backend/run_linux_parts.py reads it).
# With FENRIR_RUN_LINUX_ONLY="NAME..." and part all it runs the preflight part's steps,
# then exactly the named steps, each by its own line here, and exits 2 for a name no
# part runs: a record's chain calls a gate step this way, never a copy of its line.
set -euo pipefail
part=${1:-all}
shards=3
case $part in
    all|preflight|proof|proof-1|proof-2|lower|tranches) ;;
    corpus-[1-9]) (( ${part#corpus-} <= shards )) || part=unknown ;;
    *) part=unknown ;;
esac
if [[ $part == unknown ]]; then
    echo "run-linux: unknown part '$1' (all, preflight, proof, proof-1, proof-2, lower, tranches, corpus-1 to corpus-$shards)" >&2
    exit 2
fi
want() { [[ $part == all || $part == "$1" ]]; }
# A proof step's half: `proof` runs both halves, `proof-N` only its own.
in_proof() { [[ $part == all || $part == proof || $part == "proof-$1" ]]; }
root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$root"
export TMPDIR="$root/target/tmp"
listing=${FENRIR_RUN_LINUX_LIST:-}
only=${FENRIR_RUN_LINUX_ONLY:-}
preflight_steps=" fetch build build-tools linux-readiness lower-native-smoke region-scaling-smoke "
ran=" "
[[ -n $listing ]] || mkdir -p "$TMPDIR" "$root/target/backend-record"
step() {
    local name=$1
    shift
    if [[ -n $only && " $only " != *" $name "* && $preflight_steps != *" $name "* ]]; then return 0; fi
    ran+="$name "
    if [[ -n $listing ]]; then
        echo "STEP $name"
        return 0
    fi
    local started=$SECONDS
    echo "START $name"
    local rc=0
    "$@" > "$root/target/backend-record/$name.log" 2>&1 || rc=$?
    if [[ $rc -eq 0 ]]; then
        tools/check-skips --strict --log "$root/target/backend-record/$name.log" > "$root/target/backend-record/$name.strict" 2>&1 || rc=$?
        cat "$root/target/backend-record/$name.strict" >> "$root/target/backend-record/$name.log"
    fi
    sed '/^FAIL /!s/^/  /' "$root/target/backend-record/$name.log"
    echo "END $name exit=$rc secs=$((SECONDS-started))"
    return "$rc"
}
step fetch tools/fetch-toolchain
export WOLF_STD="$root/.wolf-bin/std"
export WOLF_RT_LIB="$root/.wolf-bin/libwolf_rt.a"
export FENRIR_TOOLCHAIN="$root/.wolf-bin"
# Every network fetch first, so a dead or reset pinned URL costs seconds, not the proof.
if in_proof 1; then step fetch-gas python3 -I tests/backend/fetch-gas.py --clef-source .wolf-bin/clef --out target/backend-gas; fi
if in_proof 1; then step native-source-twins python3 -I tests/frame.py Gates.test_every_native_assembly_fixture_has_a_source_twin; fi
if in_proof 1; then step comparator python3 -I tests/backend/comparator.py --root . --scratch target/backend-comparator; fi
step build tools/build
if in_proof 1; then step driver python3 -I tests/driver.py; fi
step build-tools tools/build-tools
step linux-readiness python3 -I tests/backend/linux_readiness.py --root . --out target/linux-readiness
step lower-native-smoke python3 -I tests/lower/check.py --mode linux --root . --out target/lower-native-smoke --only match-loop-statement
# The region-scaling measurement's own path, small: its small parent, both compilers and one row, seconds here.
step region-scaling-smoke python3 -I tests/memory/region_scaling.py target/fenrir --out target/region-scaling-smoke --smoke
if [[ $part == preflight ]]; then exit 0; fi
if in_proof 1 || in_proof 2; then
if in_proof 1; then step fir python3 -I tests/backend/fir.py target/fenrir --scratch target/backend-fir; fi
if in_proof 1; then step assembly python3 -I tests/backend/assembly.py target/fenrir --out target/backend-assembly; fi
if in_proof 1; then step link-boundary python3 -I tests/backend/link.py target/fenrir --scratch target/backend-link; fi
if in_proof 1; then step link-budget python3 -I tests/backend/link_budget.py --root . --out target/backend-link-budget; fi
if in_proof 1; then step interpreter-bounded python3 -I tests/backend/interpreter.py target/fenrir --out target/interpreter-bounded --mode linux; fi
if in_proof 1; then step numeric-fir-native python3 -I tests/numeric/fir.py --compiler target/fenrir --out target/backend-linux/numeric-fir --native; fi
if in_proof 1; then step float-fir-native python3 -I tests/numeric/float_fir.py --compiler target/fenrir --out target/backend-linux/float-fir --native; fi
if in_proof 2; then step mode-cases-native python3 -I tests/memory/mode_cases.py check --compiler target/fenrir --engine native --out target/backend-linux/mode-cases; fi
if in_proof 2; then step region-cases-native python3 -I tests/memory/region_cases.py check --compiler target/fenrir --engine native --out target/backend-linux/region-cases; fi
if in_proof 2; then step outer-write-native python3 -I tests/memory/outer_write.py check --compiler target/fenrir --engine native --out target/backend-linux/outer-write; fi
if in_proof 1; then step enum-native python3 -I tests/backend/enums.py --out target/backend-enums --compiler target/fenrir --native; fi
if in_proof 1; then step collections-native python3 -I tests/backend/collections.py target/fenrir --out target/backend-collections --native; fi
if in_proof 1; then step recursive-native python3 -I tests/backend/recursive.py target/fenrir --out target/backend-linux/recursive --native; fi
if in_proof 1; then step copy-width-native python3 -I tests/backend/copy_width.py cases target/fenrir --out target/backend-linux/copy-width --native; fi
if in_proof 2; then step string-native python3 -I tests/backend/strings.py target/fenrir --out target/backend-linux/strings --native; fi
if in_proof 2; then step string-formats-native python3 -I tests/strings/format.py target/fenrir --out target/backend-linux/string-formats --native --reference; fi
if in_proof 1; then step value-rendering-native python3 -I tests/strings/render.py target/fenrir --out target/backend-linux/value-rendering --native --reference; fi
if in_proof 2; then step text-iteration-native python3 -I tests/strings/iteration.py target/fenrir --out target/backend-linux/text-iteration --native --reference; fi
if in_proof 2; then step source-traps-native python3 -I tests/strings/traps.py target/fenrir --out target/backend-linux/source-traps --native --reference; fi
if in_proof 2; then step binding-alternatives-native python3 -I tests/strings/patterns.py target/fenrir --out target/backend-linux/binding-alternatives --native --reference; fi
if in_proof 1; then step map-tier-unit python3 -I tests/strings/map_refusals_unit.py; fi
if in_proof 1; then step map-refusals python3 -I tests/strings/map_refusals.py target/fenrir --out target/backend-linux/map-refusals --reference; fi
if in_proof 1; then step interpreter-scaling python3 -I tests/backend/interpreter_scaling.py target/fenrir --out target/interpreter-scaling; fi
if in_proof 1; then step scaling python3 -I tests/backend/scaling.py target/fenrir --out target/backend-scaling; fi
if in_proof 1; then step lower-scaling python3 -I tests/lower/scaling.py target/fenrir --out target/lower-scaling; fi
if in_proof 1; then step copy-scaling python3 -I tests/memory/copy_scaling.py target/fenrir --out target/copy-scaling; fi
if in_proof 1; then step region-scaling python3 -I tests/memory/region_scaling.py target/fenrir --out target/region-scaling; fi
if in_proof 1 && [[ -n ${FENRIR_BEFORE_CLEF:-} ]]; then
    step before-form-census python3 -I tests/backend/x86_forms.py --clef "$FENRIR_BEFORE_CLEF" --pin "$FENRIR_BEFORE_CLEF_REV" --out target/backend-forms-before --doc target/backend-forms-before.md
fi
if in_proof 1; then step form-differential python3 -I tests/backend/forms-linux.py --root . --gas-config target/backend-gas/gas.json --out target/backend-forms-after; fi
if in_proof 1; then step linux-proof python3 -I tests/backend/linux.py --root . --gas-config target/backend-gas/gas.json --out target/backend-linux; fi
fi
if want lower; then step lower-linux python3 -I tests/lower/check.py --mode linux --root . --out target/lower-linux; fi
if want tranches; then
step string-prediction-native python3 -I tests/strings/corpus.py --compiler target/fenrir --mode native --out target/lower-corpus/string-prediction-native
step string-prediction-interpreter python3 -I tests/strings/corpus.py --compiler target/fenrir --mode interpreter --out target/interpreter-core/string-prediction
step text-typed python3 -I tests/types/tranche_corpus.py --tranche text --mode typed --compiler target/fenrir --out target/tranche/text-typed
step text-lower python3 -I tests/types/tranche_corpus.py --tranche text --mode lower --compiler target/fenrir --out target/tranche/text-lower
step text-interpreter python3 -I tests/types/tranche_corpus.py --tranche text --mode interpreter --compiler target/fenrir --out target/tranche/text-interpreter
step aggregate-typed python3 -I tests/types/tranche_corpus.py --tranche aggregate --mode typed --compiler target/fenrir --out target/tranche/aggregate-typed
step aggregate-lower python3 -I tests/types/tranche_corpus.py --tranche aggregate --mode lower --compiler target/fenrir --out target/tranche/aggregate-lower
step aggregate-interpreter python3 -I tests/types/tranche_corpus.py --tranche aggregate --mode interpreter --compiler target/fenrir --out target/tranche/aggregate-interpreter
step attributes-typed python3 -I tests/types/tranche_corpus.py --tranche attributes --mode typed --compiler target/fenrir --out target/tranche/attributes-typed
step attributes-lower python3 -I tests/types/tranche_corpus.py --tranche attributes --mode lower --compiler target/fenrir --out target/tranche/attributes-lower
step attributes-interpreter python3 -I tests/types/tranche_corpus.py --tranche attributes --mode interpreter --compiler target/fenrir --out target/tranche/attributes-interpreter
step control-typed python3 -I tests/types/tranche_corpus.py --tranche control --mode typed --compiler target/fenrir --out target/tranche/control-typed
step control-lower python3 -I tests/types/tranche_corpus.py --tranche control --mode lower --compiler target/fenrir --out target/tranche/control-lower
step control-interpreter python3 -I tests/types/tranche_corpus.py --tranche control --mode interpreter --compiler target/fenrir --out target/tranche/control-interpreter
step float-typed python3 -I tests/types/tranche_corpus.py --tranche float --mode typed --compiler target/fenrir --out target/tranche/float-typed
step float-lower python3 -I tests/types/tranche_corpus.py --tranche float --mode lower --compiler target/fenrir --out target/tranche/float-lower
step float-interpreter python3 -I tests/types/tranche_corpus.py --tranche float --mode interpreter --compiler target/fenrir --out target/tranche/float-interpreter
step modes-typed python3 -I tests/types/tranche_corpus.py --tranche modes --mode typed --compiler target/fenrir --out target/tranche/modes-typed
step modes-lower python3 -I tests/types/tranche_corpus.py --tranche modes --mode lower --compiler target/fenrir --out target/tranche/modes-lower
step modes-interpreter python3 -I tests/types/tranche_corpus.py --tranche modes --mode interpreter --compiler target/fenrir --out target/tranche/modes-interpreter
step regions-typed python3 -I tests/types/tranche_corpus.py --tranche regions --mode typed --compiler target/fenrir --out target/tranche/regions-typed
step regions-lower python3 -I tests/types/tranche_corpus.py --tranche regions --mode lower --compiler target/fenrir --out target/tranche/regions-lower
step regions-interpreter python3 -I tests/types/tranche_corpus.py --tranche regions --mode interpreter --compiler target/fenrir --out target/tranche/regions-interpreter
step float-cases-interpreter python3 -I tests/numeric/float_cases.py check --compiler target/fenrir --engine interpreter --out "$root/target/float-cases/interpreter"
step float-cases-native python3 -I tests/numeric/float_cases.py check --compiler target/fenrir --engine native --out "$root/target/float-cases/native"
step interpreter-core python3 -I tests/lower/corpus.py --fenrir target/fenrir --select tests/types/census.json --out target/interpreter-core --expect tests/lower/core-verdicts.json --interpreter
step fn09-delta python3 -I tests/types/fn09_delta.py --self-test
step fn09b-delta python3 -I tests/types/fn09b_delta.py --self-test
step f3b-delta python3 -I tests/types/f3b_delta.py --self-test
step f3c-delta python3 -I tests/types/f3c_delta.py --self-test
fi
for ((shard = 1; shard <= shards; shard++)); do
    if want corpus-$shard; then
        step corpus-core-$shard python3 -I tests/lower/corpus.py --fenrir target/fenrir --select tests/types/census.json --shard $shard/$shards --out target/lower-corpus/shard-$shard --expect tests/lower/core-verdicts.json
    fi
done
if [[ -n $only ]]; then
    for name in $only; do
        [[ $ran == *" $name "* ]] || { echo "run-linux: FENRIR_RUN_LINUX_ONLY names $name, which part $part does not run" >&2; exit 2; }
    done
fi
