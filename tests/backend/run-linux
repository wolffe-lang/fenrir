#!/usr/bin/env bash
# The Linux gate: `run-linux` runs every step; `run-linux PART` runs the shared
# fetch and builds, then one part, so CI can run the parts as parallel jobs:
# proof (the backend's rows, scaling and the linked-program proof), lower (the
# lowering rows), tranches (the string predictions, the frozen tranche rows, the
# interpreter's whole-core table and the delta), corpus-1 to corpus-3 (the
# census-driven native corpus differential, each core row in exactly one shard),
# or preflight (the complete cheap fixture validity checks plus one linked
# lowering smoke).
# With FENRIR_RUN_LINUX_LIST=1 it runs nothing and prints `STEP NAME` for each
# step the part would run, in order (tests/backend/run_linux_parts.py reads it).
set -euo pipefail
part=${1:-all}
shards=3
case $part in
    all|preflight|proof|lower|tranches) ;;
    corpus-[1-9]) (( ${part#corpus-} <= shards )) || part=unknown ;;
    *) part=unknown ;;
esac
if [[ $part == unknown ]]; then
    echo "run-linux: unknown part '$1' (all, preflight, proof, lower, tranches, corpus-1 to corpus-$shards)" >&2
    exit 2
fi
want() { [[ $part == all || $part == "$1" ]]; }
root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$root"
export TMPDIR="$root/target/tmp"
listing=${FENRIR_RUN_LINUX_LIST:-}
[[ -n $listing ]] || mkdir -p "$TMPDIR" "$root/target/backend-record"
step() {
    local name=$1
    shift
    if [[ -n $listing ]]; then
        echo "STEP $name"
        return 0
    fi
    local started=$SECONDS
    echo "START $name"
    local rc=0
    "$@" > "$root/target/backend-record/$name.log" 2>&1 || rc=$?
    if [[ $rc -eq 0 ]]; then
        tools/check-skips --strict --log "$root/target/backend-record/$name.log" > "$root/target/backend-record/$name.strict" 2>&1 || rc=$?
        cat "$root/target/backend-record/$name.strict" >> "$root/target/backend-record/$name.log"
    fi
    sed 's/^/  /' "$root/target/backend-record/$name.log"
    echo "END $name exit=$rc secs=$((SECONDS-started))"
    return "$rc"
}
step fetch tools/fetch-toolchain
export WOLF_STD="$root/.wolf-bin/std"
export WOLF_RT_LIB="$root/.wolf-bin/libwolf_rt.a"
export FENRIR_TOOLCHAIN="$root/.wolf-bin"
if want proof; then step native-source-twins python3 -I tests/frame.py Gates.test_every_native_assembly_fixture_has_a_source_twin; fi
if want proof; then step comparator python3 -I tests/backend/comparator.py --root . --scratch target/backend-comparator; fi
step build tools/build
if want proof; then step driver python3 -I tests/driver.py; fi
step build-tools tools/build-tools
step linux-readiness python3 -I tests/backend/linux_readiness.py --root . --out target/linux-readiness
step lower-native-smoke python3 -I tests/lower/check.py --mode linux --root . --out target/lower-native-smoke --only match-loop-statement
if [[ $part == preflight ]]; then exit 0; fi
if want proof; then
step fir python3 -I tests/backend/fir.py target/fenrir --scratch target/backend-fir
step assembly python3 -I tests/backend/assembly.py target/fenrir --out target/backend-assembly
step link-boundary python3 -I tests/backend/link.py target/fenrir --scratch target/backend-link
step link-budget python3 -I tests/backend/link_budget.py --root . --out target/backend-link-budget
step interpreter-bounded python3 -I tests/backend/interpreter.py target/fenrir --out target/interpreter-bounded --mode linux
step numeric-fir-native python3 -I tests/numeric/fir.py --compiler target/fenrir --out target/backend-linux/numeric-fir --native
step float-fir-native python3 -I tests/numeric/float_fir.py --compiler target/fenrir --out target/backend-linux/float-fir --native
step mode-cases-native python3 -I tests/memory/mode_cases.py check --compiler target/fenrir --engine native --out target/backend-linux/mode-cases
step enum-native python3 -I tests/backend/enums.py --out target/backend-enums --compiler target/fenrir --native
step collections-native python3 -I tests/backend/collections.py target/fenrir --out target/backend-collections --native
step recursive-native python3 -I tests/backend/recursive.py target/fenrir --out target/backend-linux/recursive --native
step string-native python3 -I tests/backend/strings.py target/fenrir --out target/backend-linux/strings --native
step string-formats-native python3 -I tests/strings/format.py target/fenrir --out target/backend-linux/string-formats --native --reference
step value-rendering-native python3 -I tests/strings/render.py target/fenrir --out target/backend-linux/value-rendering --native --reference
step text-iteration-native python3 -I tests/strings/iteration.py target/fenrir --out target/backend-linux/text-iteration --native --reference
step source-traps-native python3 -I tests/strings/traps.py target/fenrir --out target/backend-linux/source-traps --native --reference
step binding-alternatives-native python3 -I tests/strings/patterns.py target/fenrir --out target/backend-linux/binding-alternatives --native --reference
step map-tier-unit python3 -I tests/strings/map_refusals_unit.py
step map-refusals python3 -I tests/strings/map_refusals.py target/fenrir --out target/backend-linux/map-refusals --reference
step interpreter-scaling python3 -I tests/backend/interpreter_scaling.py target/fenrir --out target/interpreter-scaling
step scaling python3 -I tests/backend/scaling.py target/fenrir --out target/backend-scaling
step lower-scaling python3 -I tests/lower/scaling.py target/fenrir --out target/lower-scaling
step copy-scaling python3 -I tests/memory/copy_scaling.py target/fenrir --out target/copy-scaling
step fetch-gas python3 -I tests/backend/fetch-gas.py --clef-source .wolf-bin/clef --out target/backend-gas
if [[ -n ${FENRIR_BEFORE_CLEF:-} ]]; then
    step before-form-census python3 -I tests/backend/x86_forms.py --clef "$FENRIR_BEFORE_CLEF" --pin "$FENRIR_BEFORE_CLEF_REV" --out target/backend-forms-before --doc target/backend-forms-before.md
fi
step form-differential python3 -I tests/backend/forms-linux.py --root . --gas-config target/backend-gas/gas.json --out target/backend-forms-after
step linux-proof python3 -I tests/backend/linux.py --root . --gas-config target/backend-gas/gas.json --out target/backend-linux
fi
if want lower; then step lower-linux python3 -I tests/lower/check.py --mode linux --root . --out target/lower-linux; fi
if want tranches; then
step string-prediction-native python3 -I tests/strings/corpus.py --compiler target/fenrir --mode native --out target/lower-corpus/string-prediction-native
step string-prediction-interpreter python3 -I tests/strings/corpus.py --compiler target/fenrir --mode interpreter --out target/interpreter-core/string-prediction
step text-typed python3 -I tests/types/tranche_corpus.py --tranche text --mode typed --compiler target/fenrir --out target/tranche/text-typed
step text-lower python3 -I tests/types/tranche_corpus.py --tranche text --mode lower --compiler target/fenrir --out target/tranche/text-lower
step text-interpreter python3 -I tests/types/tranche_corpus.py --tranche text --mode interpreter --compiler target/fenrir --out target/tranche/text-interpreter
step text-native python3 -I tests/types/tranche_corpus.py --tranche text --mode native --compiler target/fenrir --out target/tranche/text-native
step aggregate-typed python3 -I tests/types/tranche_corpus.py --tranche aggregate --mode typed --compiler target/fenrir --out target/tranche/aggregate-typed
step aggregate-lower python3 -I tests/types/tranche_corpus.py --tranche aggregate --mode lower --compiler target/fenrir --out target/tranche/aggregate-lower
step aggregate-interpreter python3 -I tests/types/tranche_corpus.py --tranche aggregate --mode interpreter --compiler target/fenrir --out target/tranche/aggregate-interpreter
step aggregate-native python3 -I tests/types/tranche_corpus.py --tranche aggregate --mode native --compiler target/fenrir --out target/tranche/aggregate-native
step attributes-typed python3 -I tests/types/tranche_corpus.py --tranche attributes --mode typed --compiler target/fenrir --out target/tranche/attributes-typed
step attributes-lower python3 -I tests/types/tranche_corpus.py --tranche attributes --mode lower --compiler target/fenrir --out target/tranche/attributes-lower
step attributes-interpreter python3 -I tests/types/tranche_corpus.py --tranche attributes --mode interpreter --compiler target/fenrir --out target/tranche/attributes-interpreter
step attributes-native python3 -I tests/types/tranche_corpus.py --tranche attributes --mode native --compiler target/fenrir --out target/tranche/attributes-native
step control-typed python3 -I tests/types/tranche_corpus.py --tranche control --mode typed --compiler target/fenrir --out target/tranche/control-typed
step control-lower python3 -I tests/types/tranche_corpus.py --tranche control --mode lower --compiler target/fenrir --out target/tranche/control-lower
step control-interpreter python3 -I tests/types/tranche_corpus.py --tranche control --mode interpreter --compiler target/fenrir --out target/tranche/control-interpreter
step control-native python3 -I tests/types/tranche_corpus.py --tranche control --mode native --compiler target/fenrir --out target/tranche/control-native
step float-typed python3 -I tests/types/tranche_corpus.py --tranche float --mode typed --compiler target/fenrir --out target/tranche/float-typed
step float-lower python3 -I tests/types/tranche_corpus.py --tranche float --mode lower --compiler target/fenrir --out target/tranche/float-lower
step float-interpreter python3 -I tests/types/tranche_corpus.py --tranche float --mode interpreter --compiler target/fenrir --out target/tranche/float-interpreter
step float-native python3 -I tests/types/tranche_corpus.py --tranche float --mode native --compiler target/fenrir --out target/tranche/float-native
step modes-typed python3 -I tests/types/tranche_corpus.py --tranche modes --mode typed --compiler target/fenrir --out target/tranche/modes-typed
step modes-lower python3 -I tests/types/tranche_corpus.py --tranche modes --mode lower --compiler target/fenrir --out target/tranche/modes-lower
step modes-interpreter python3 -I tests/types/tranche_corpus.py --tranche modes --mode interpreter --compiler target/fenrir --out target/tranche/modes-interpreter
step modes-native python3 -I tests/types/tranche_corpus.py --tranche modes --mode native --compiler target/fenrir --out target/tranche/modes-native
step float-cases-interpreter python3 -I tests/numeric/float_cases.py check --compiler target/fenrir --engine interpreter --out "$root/target/float-cases/interpreter"
step float-cases-native python3 -I tests/numeric/float_cases.py check --compiler target/fenrir --engine native --out "$root/target/float-cases/native"
step interpreter-core python3 -I tests/lower/corpus.py --fenrir target/fenrir --select tests/types/census.json --out target/interpreter-core --expect tests/lower/core-verdicts.json --interpreter
step fn09-delta python3 -I tests/types/fn09_delta.py --self-test
step fn09b-delta python3 -I tests/types/fn09b_delta.py --self-test
step f3b-delta python3 -I tests/types/f3b_delta.py --self-test
fi
for ((shard = 1; shard <= shards; shard++)); do
    if want corpus-$shard; then
        step corpus-core-$shard python3 -I tests/lower/corpus.py --fenrir target/fenrir --select tests/types/census.json --shard $shard/$shards --out target/lower-corpus/shard-$shard --expect tests/lower/core-verdicts.json
    fi
done
