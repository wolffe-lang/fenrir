#!/usr/bin/env bash
# The Linux gate: `run-linux` runs every step; `run-linux PART` runs the shared
# fetch and builds, then one part, so CI can run the parts as parallel jobs:
# proof (the backend's rows, scaling and the linked-program proof), lower (the
# lowering rows), corpus (the census-driven corpus differential).
set -euo pipefail
part=${1:-all}
case $part in
    all|proof|lower|corpus) ;;
    *) echo "run-linux: unknown part '$part' (all, proof, lower, corpus)" >&2; exit 2 ;;
esac
want() { [[ $part == all || $part == "$1" ]]; }
root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$root"
export TMPDIR="$root/target/tmp"
mkdir -p "$TMPDIR" "$root/target/backend-record"
step() {
    local name=$1
    shift
    local started=$SECONDS
    echo "START $name"
    local rc=0
    "$@" > "$root/target/backend-record/$name.log" 2>&1 || rc=$?
    if [[ $rc -eq 0 ]]; then
        tools/check-skips --strict --log "$root/target/backend-record/$name.log" > "$root/target/backend-record/$name.strict" 2>&1 || rc=$?
        cat "$root/target/backend-record/$name.strict" >> "$root/target/backend-record/$name.log"
    fi
    sed 's/^/  /' "$root/target/backend-record/$name.log"
    echo "END $name exit=$rc secs=$((SECONDS-started))"
    return "$rc"
}
step fetch tools/fetch-toolchain
export WOLF_STD="$root/.wolf-bin/std"
export WOLF_RT_LIB="$root/.wolf-bin/libwolf_rt.a"
export FENRIR_TOOLCHAIN="$root/.wolf-bin"
if want proof; then step comparator python3 -I tests/backend/comparator.py --root . --scratch target/backend-comparator; fi
step build tools/build
if want proof; then step driver python3 -I tests/driver.py; fi
step build-tools tools/build-tools
if want proof; then
step fir python3 -I tests/backend/fir.py target/fenrir --scratch target/backend-fir
step assembly python3 -I tests/backend/assembly.py target/fenrir --out target/backend-assembly
step link-boundary python3 -I tests/backend/link.py target/fenrir --scratch target/backend-link
step link-budget python3 -I tests/backend/link_budget.py --root . --out target/backend-link-budget
step interpreter-bounded python3 -I tests/backend/interpreter.py target/fenrir --out target/interpreter-bounded --mode linux
step enum-native python3 -I tests/backend/enums.py --out target/backend-enums --compiler target/fenrir --native
step interpreter-scaling python3 -I tests/backend/interpreter_scaling.py target/fenrir --out target/interpreter-scaling
step scaling python3 -I tests/backend/scaling.py target/fenrir --out target/backend-scaling
step lower-scaling python3 -I tests/lower/scaling.py target/fenrir --out target/lower-scaling
step fetch-gas python3 -I tests/backend/fetch-gas.py --clef-source .wolf-bin/clef --out target/backend-gas
if [[ -n ${FENRIR_BEFORE_CLEF:-} ]]; then
    step before-form-census python3 -I tests/backend/x86_forms.py --clef "$FENRIR_BEFORE_CLEF" --pin "$FENRIR_BEFORE_CLEF_REV" --out target/backend-forms-before --doc target/backend-forms-before.md
fi
step form-differential python3 -I tests/backend/forms-linux.py --root . --gas-config target/backend-gas/gas.json --out target/backend-forms-after
step linux-proof python3 -I tests/backend/linux.py --root . --gas-config target/backend-gas/gas.json --out target/backend-linux
fi
if want lower; then step lower-linux python3 -I tests/lower/check.py --mode linux --root . --out target/lower-linux; fi
if want corpus; then
step corpus-core python3 -I tests/lower/corpus.py --fenrir target/fenrir --select tests/types/census.json --out target/lower-corpus --expect tests/lower/core-verdicts.json
step interpreter-core python3 -I tests/lower/corpus.py --fenrir target/fenrir --select tests/types/census.json --out target/interpreter-core --expect tests/lower/core-verdicts.json --interpreter
fi
