#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$root"
export TMPDIR="$root/target/tmp"
mkdir -p "$TMPDIR" "$root/target/backend-record"
step() {
    local name=$1
    shift
    local started=$SECONDS
    echo "START $name"
    local rc=0
    "$@" > "$root/target/backend-record/$name.log" 2>&1 || rc=$?
    if [[ $rc -eq 0 ]]; then
        tools/check-skips --strict --log "$root/target/backend-record/$name.log" > "$root/target/backend-record/$name.strict" 2>&1 || rc=$?
        cat "$root/target/backend-record/$name.strict" >> "$root/target/backend-record/$name.log"
    fi
    sed 's/^/  /' "$root/target/backend-record/$name.log"
    echo "END $name exit=$rc secs=$((SECONDS-started))"
    return "$rc"
}
step fetch tools/fetch-toolchain
export WOLF_STD="$root/.wolf-bin/std"
export WOLF_RT_LIB="$root/.wolf-bin/libwolf_rt.a"
export FENRIR_TOOLCHAIN="$root/.wolf-bin"
step comparator python3 -I tests/backend/comparator.py --root . --scratch target/backend-comparator
step build tools/build
step build-tools tools/build-tools
step fir python3 -I tests/backend/fir.py target/fenrir --scratch target/backend-fir
step assembly python3 -I tests/backend/assembly.py target/fenrir --out target/backend-assembly
step link-boundary python3 -I tests/backend/link.py target/fenrir --scratch target/backend-link
step scaling python3 -I tests/backend/scaling.py target/fenrir --out target/backend-scaling
step fetch-gas python3 -I tests/backend/fetch-gas.py --clef-source .wolf-bin/clef --out target/backend-gas
if [[ -n ${FENRIR_BEFORE_CLEF:-} ]]; then
    step before-form-census python3 -I tests/backend/x86_forms.py --clef "$FENRIR_BEFORE_CLEF" --pin "$FENRIR_BEFORE_CLEF_REV" --out target/backend-forms-before --doc target/backend-forms-before.md
fi
step form-differential python3 -I tests/backend/forms-linux.py --root . --gas-config target/backend-gas/gas.json --out target/backend-forms-after
step linux-proof python3 -I tests/backend/linux.py --root . --gas-config target/backend-gas/gas.json --out target/backend-linux
