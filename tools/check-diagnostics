#!/usr/bin/env -S python3 -I
"""Check diagnostic-looking string codes against the catalog in both directions."""
import argparse
from pathlib import Path
import re
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from frame import ROOT
from importlib.machinery import SourceFileLoader
subset = SourceFileLoader('subset', str(ROOT / 'tools/check-subset')).load_module()
CODE = re.compile(r'\b(?:[EWIF][0-9]{4}|FIR_[A-Z][A-Z0-9_]*)\b')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=Path, default=ROOT / 'src')
    parser.add_argument('--catalog', type=Path, default=ROOT / 'docs/DIAGNOSTICS.md')
    args = parser.parse_args()
    listed = set(CODE.findall(args.catalog.read_text()))
    emitted = set()
    for path in args.source.rglob('*.lu'):
        for token in subset.tokens(path.read_text()):
            if token.startswith('"'):
                emitted.update(CODE.findall(token))
    if emitted != listed:
        print('FAIL diagnostics: uncatalogued=' + ','.join(sorted(emitted - listed)) +
              ' unused=' + ','.join(sorted(listed - emitted)))
        return 1
    print(f'diagnostics: {len(listed)} codes, catalog equals source string literals')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
