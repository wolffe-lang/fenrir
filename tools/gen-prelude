#!/usr/bin/env -S python3 -I
"""Generate src/resolve/prelude.lu from the pinned spec/prelude.json, or check it."""
import argparse
import hashlib
import json
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from frame import ROOT

SOURCE = ROOT / '.wolf-bin/reference/spec/prelude.json'
TARGET = ROOT / 'src/resolve/prelude.lu'


def render(data, digest):
    names = data['names']
    if data.get('schema') != 'wolf-prelude/0' or len({n['name'] for n in names}) != len(names):
        raise SystemExit('FAIL prelude: unexpected schema or duplicate names')
    lines = ['//! member: true', '',
             '// Generated by tools/gen-prelude from the pinned spec/prelude.json; do not edit.',
             f'// SHA-256: {digest}', '',
             '/// Every ambient name, in the pinned prelude\'s order.',
             'fn prelude_names() -> List[str] {', '    [']
    lines += [f'        "{n["name"]}",' for n in names]
    lines += ['    ]', '}', '',
              '/// Each ambient name\'s kind, parallel to `prelude_names`.',
              'fn prelude_kinds() -> List[str] {', '    [']
    lines += [f'        "{n["kind"]}",' for n in names]
    lines += ['    ]', '}', '']
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    raw = SOURCE.read_bytes()
    text = render(json.loads(raw), hashlib.sha256(raw).hexdigest())
    if args.check:
        if TARGET.read_text() != text:
            print('FAIL prelude: src/resolve/prelude.lu differs from the pinned prelude')
            return 1
        print(f'prelude: {TARGET.relative_to(ROOT)} matches the pinned prelude')
        return 0
    TARGET.write_text(text)
    print(f'prelude: wrote {TARGET.relative_to(ROOT)}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
