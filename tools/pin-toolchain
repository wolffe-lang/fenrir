#!/usr/bin/env -S python3 -I
"""Generate public toolchain pins from immutable releases and commit archives."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import re
import tomllib
sys.path.insert(0, str(Path(__file__).resolve().parent))
from frame import ROOT, STAGE, download, extract, twice

PLATFORMS = ('aarch64-apple-darwin', 'x86_64-unknown-linux-gnu')


def api(path):
    return json.loads(subprocess.check_output(['gh', 'api', path], text=True))


def stable(path):
    a, b = api(path), api(path)
    if a != b:
        raise ValueError(f'API changed between reads: {path}')
    return a


def runtime_digest(archive, expected=None):
    with tempfile.TemporaryDirectory(prefix='pin-runtime-', dir=STAGE) as work:
        extract(archive, work)
        return twice(Path(work) / 'libwolf_rt.a', expected)


def generate():
    entries = []
    for tool, repo, version in (('wolf', 'wolf-lang', '0.2.36'), ('lupin', 'wolf-interp', '0.1.58')):
        release = stable(f'repos/wolffe-lang/{repo}/releases/tags/v{version}')
        for platform in PLATFORMS:
            name = f'{tool}-{version}-{platform}.tar.gz'
            asset = next(a for a in release['assets'] if a['name'] == name)
            path = download(asset['browser_download_url'], STAGE / 'downloads' / name)
            digest = twice(path, asset['digest'].removeprefix('sha256:'))
            entries.append(dict(name=f'{tool}-{platform}', kind='tool', tool=tool,
                                platform=platform, version=version, url=asset['browser_download_url'], sha256=digest))
    for tool in ('reference', 'clef', 'ligature'):
        repo = 'wolf-lang' if tool == 'reference' else tool
        rev = '5f1f1c949582f53121e4047bc83c86f23ff72240' if tool == 'reference' else stable(f'repos/wolffe-lang/{repo}/commits/trunk')['sha']
        url = f'https://codeload.github.com/wolffe-lang/{repo}/tar.gz/{rev}'
        archive = download(url, STAGE / 'downloads' / f'{tool}-{rev}.tar.gz')
        entries.append(dict(name=tool, kind='source', rev=rev, url=url, sha256=twice(archive)))
    release = stable('repos/wolffe-lang/ligature/releases/tags/link-bundle-wolf-0.2.36')
    asset = next(a for a in release['assets'] if a['name'].endswith('.tar.gz'))
    archive = download(asset['browser_download_url'], STAGE / 'downloads' / asset['name'])
    entries.append(dict(name='bundle', kind='bundle', version='link-bundle-wolf-0.2.36',
                        url=asset['browser_download_url'], sha256=twice(archive, asset['digest'].removeprefix('sha256:'))))
    release = stable('repos/wolffe-lang/wolf-lang/releases/tags/v0.2.36')
    asset = next(a for a in release['assets'] if a['name'].startswith('wolf-rt-'))
    archive = download(asset['browser_download_url'], STAGE / 'downloads' / asset['name'])
    entries.append(dict(name='runtime', kind='runtime', version='0.2.36',
                        url=asset['browser_download_url'], sha256=twice(archive, asset['digest'].removeprefix('sha256:')),
                        libwolf_rt=runtime_digest(archive)))
    return render(entries)


def render(entries):
    text = '# Generated by tools/pin-toolchain; do not edit. Every archive read twice.\nformat = 1\n'
    for entry in entries:
        text += '\n[[artifact]]\n' + ''.join(f'{key} = {json.dumps(value)}\n' for key, value in entry.items())
    return text


def repin_source(text, name, revision):
    """Move one backend source without changing the oracle or other tools."""
    if name not in ('clef', 'ligature'):
        raise ValueError('select clef or ligature for a targeted source update')
    data = tomllib.loads(text)
    entries = data['artifact']
    selected = [entry for entry in entries if entry['name'] == name and entry['kind'] == 'source']
    if data['format'] != 1 or len(selected) != 1:
        raise ValueError('expected exactly one source pin in format 1')
    rev = stable(f'repos/wolffe-lang/{name}/commits/{revision}')['sha']
    if not re.fullmatch(r'[0-9a-f]{40}', rev):
        raise ValueError('source revision did not resolve to an immutable commit')
    url = f'https://codeload.github.com/wolffe-lang/{name}/tar.gz/{rev}'
    archive = download(url, STAGE / 'downloads' / f'{name}-{rev}.tar.gz')
    selected[0].update(rev=rev, url=url, sha256=twice(archive))
    return render(entries)


def release_asset(release, name):
    matches = [asset for asset in release['assets'] if asset['name'] == name]
    if len(matches) != 1:
        raise ValueError('expected exactly one release asset: ' + name)
    asset = matches[0]
    digest = asset.get('digest') or ''
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', digest):
        raise ValueError('release asset has no SHA-256 digest: ' + name)
    archive = download(asset['browser_download_url'], STAGE / 'downloads' / name)
    return asset['browser_download_url'], archive, twice(archive, digest.removeprefix('sha256:'))


def repin_reference(text, wolf_version, lupin_version):
    """Update the sealed language inputs while preserving every backend pin.

    Resolve only tag objects, never commit-detail responses (which include
    compiler source patches). Reference extraction remains spec/corpus-only.
    """
    if any(not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', v) for v in (wolf_version, lupin_version)):
        raise ValueError('reference updates require explicit release versions')
    data = tomllib.loads(text)
    entries = data['artifact']
    required = ['reference', 'runtime'] + [f'{tool}-{p}' for tool in ('wolf', 'lupin') for p in PLATFORMS]
    if data['format'] != 1 or any(sum(e['name'] == name for e in entries) != 1 for name in required):
        raise ValueError('expected exactly one of every reference input in format 1')
    selected = {entry['name']: entry for entry in entries if entry['name'] in required}
    obj = stable(f'repos/wolffe-lang/wolf-lang/git/ref/tags/v{wolf_version}')['object']
    if obj['type'] == 'tag':
        obj = stable('repos/wolffe-lang/wolf-lang/git/tags/' + obj['sha'])['object']
    if obj['type'] != 'commit' or not re.fullmatch(r'[0-9a-f]{40}', obj['sha']):
        raise ValueError('release tag did not resolve to an immutable commit')
    rev = obj['sha']
    for tool, repo, version in (('wolf', 'wolf-lang', wolf_version), ('lupin', 'wolf-interp', lupin_version)):
        release = stable(f'repos/wolffe-lang/{repo}/releases/tags/v{version}')
        for platform in PLATFORMS:
            url, _, digest = release_asset(release, f'{tool}-{version}-{platform}.tar.gz')
            selected[f'{tool}-{platform}'].update(version=version, url=url, sha256=digest)
        if tool == 'wolf':
            url, archive, digest = release_asset(release, f'wolf-rt-{version}-x86_64-unknown-linux-musl.tar.gz')
            selected['runtime'].update(version=version, url=url, sha256=digest, libwolf_rt=runtime_digest(archive))
    url = f'https://codeload.github.com/wolffe-lang/wolf-lang/tar.gz/{rev}'
    archive = download(url, STAGE / 'downloads' / f'reference-{rev}.tar.gz')
    selected['reference'].update(rev=rev, url=url, sha256=twice(archive))
    return render(entries)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true', help='verify all recorded archives without moving any pin')
    mode.add_argument('--source', metavar='NAME=REV', help='move only clef or ligature to an explicit revision')
    mode.add_argument('--reference', metavar='WOLF=LUPIN', help='move only reference releases, their spec/corpus and musl runtime')
    args = parser.parse_args()
    dest = ROOT / 'wolf-toolchain.toml'
    if args.check:
        for p in tomllib.loads(dest.read_text())['artifact']:
            archive = download(p['url'], STAGE / 'downloads' / (p['sha256'] + '.tar.gz'))
            twice(archive, p['sha256'])
            if p['kind'] == 'runtime':
                runtime_digest(archive, p['libwolf_rt'])
            print(f'{p["name"]}: digest verified twice', flush=True)
    elif args.source:
        name, separator, revision = args.source.partition('=')
        if not separator or not revision:
            parser.error('--source requires NAME=REV')
        dest.write_text(repin_source(dest.read_text(), name, revision))
        print(f'{name} pin generated; archive digest checked twice; other pins unchanged')
    elif args.reference:
        wolf, separator, lupin = args.reference.partition('=')
        if not separator or not wolf or not lupin:
            parser.error('--reference requires WOLF=LUPIN release versions')
        dest.write_text(repin_reference(dest.read_text(), wolf, lupin))
        print('reference release pins generated; archives checked twice; backend pins unchanged')
    else:
        dest.write_text(generate())
        print('wolf-toolchain.toml generated; all digests checked twice')


if __name__ == '__main__':
    main()
