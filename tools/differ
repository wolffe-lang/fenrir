#!/usr/bin/env -S python3 -I
"""Record black-box oracles, check table freshness, or compare fenrir verdicts."""
import argparse
import base64
import hashlib
from concurrent.futures import ThreadPoolExecutor
import json
import os
from pathlib import Path
import platform
import shutil
import sys
import tempfile
import tomllib
sys.path.insert(0, str(Path(__file__).resolve().parent))
from frame import ROOT, STAGE, atomic_json, oracle_identity, pins, sha
from differlib import (BUILD_ADDRESS_SPACE, comparison, corpus_rows, derive_row, execute, freeze_package, isolated_context,
                       lupin_observation, native_observation, observe_native, oracle_relation,
                       observation_signature, package_guard, reconcile, remove_owned_scratch)


def identity():
    return oracle_identity(pins())


def capture_manifest(data, text):
    digest = hashlib.sha256(text.encode()).hexdigest()
    captured = data.get('capture_identity', data['identity'])
    manifest_identity = oracle_identity(tomllib.loads(text))
    if 'pins_sha256' in captured:
        if captured['pins_sha256'] != digest or captured['reference_rev'] != manifest_identity['reference_rev']:
            raise ValueError('capture manifest does not match the recorded identity')
    elif captured != manifest_identity:
        raise ValueError('capture manifest has different oracle inputs')
    if manifest_identity != identity():
        raise ValueError('oracle inputs changed since capture')
    data.update(identity=manifest_identity, capture_identity=captured,
                capture_pin_manifest=text, capture_pin_manifest_sha256=digest)
    return data


def oracle(args):
    if platform.system() != 'Linux' or platform.machine() != 'x86_64':
        raise SystemExit('oracle recording requires Linux x86-64 (not a skip)')
    if not os.environ.get('FENRIR_ORACLE_SANDBOX'):
        raise SystemExit('oracle recording requires an isolated container; set FENRIR_ORACLE_SANDBOX=1 inside it')
    rows = corpus_rows(STAGE / 'reference/corpus')
    if args.file:
        selected = set(args.file)
        rows = [row for row in rows if row['file'] in selected]
        if len(rows) != len(selected):
            raise ValueError('unknown selected corpus row')
    if args.limit:
        rows = rows[:args.limit]
    out = args.output.resolve()
    (ROOT / 'target').mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='oracle-', dir=ROOT / 'target') as temp:
        work = Path(temp)
        def observe(item):
            index, row = item
            if row['member']:
                row.update(wolf={'verdict': 'module-member'}, lupin={'verdict': 'module-member'}, relation='module-member')
                return row
            scratch = work / str(index)
            scratch.mkdir()
            # Preserve the entry's package, not the whole corpus per row. Nested
            # module directories are part of that package; unrelated entries are not.
            reference = scratch / 'reference'
            source = reference / row['file']
            original = STAGE / 'reference' / row['file']
            shutil.copytree(original.parent, source.parent)
            freeze_package(source.parent)
            env = dict(os.environ, WOLF_STD=str(STAGE / 'std'), WOLF_RT_LIB=str(STAGE / 'libwolf_rt.a'))
            roots = [(scratch, '<scratch>'), (STAGE, '<toolchain>')]
            native_cwd, native_env = isolated_context(scratch, 'native-run', env)
            classification = isolated_context(scratch, 'native-classification', env)
            guarded = package_guard(source.parent)
            native = observe_native(STAGE / 'wolf', source, native_cwd, native_env, args.timeout, roots,
                                    runner=guarded, classification_context=classification)
            phase = row['phase']
            declared = {}
            for name in ('wolf', 'lupin'):
                command = [STAGE / name, 'conform-run', source, '--json', f'--phase={phase}']
                if name == 'wolf':
                    command.append('--native')
                cwd, invocation_env = isolated_context(scratch, 'declared-' + name, env)
                observation = lupin_observation(guarded(command, cwd, invocation_env, args.timeout), source, roots)
                observation['argv'] = [str(arg).replace(str(scratch), '<scratch>').replace(str(STAGE), '<toolchain>') for arg in command]
                declared[name] = observation
            declared.update(phase=phase, relation=oracle_relation(declared['wolf'], declared['lupin'], row))
            if (row['expected'] or '').startswith('run('):
                cwd, invocation_env = isolated_context(scratch, 'dynamic-lupin', env)
                dynamic_command = [STAGE / 'lupin', 'conform-run', source, '--json']
                lupus = lupin_observation(guarded(dynamic_command, cwd, invocation_env, args.timeout), source, roots)
                lupus['argv'] = [str(arg).replace(str(scratch), '<scratch>').replace(str(STAGE), '<toolchain>') for arg in dynamic_command]
                wolf, lupin = native, lupus
            else:
                wolf, lupin = declared['wolf'], declared['lupin']
            row.update(wolf=wolf, lupin=lupin, native_run=native, declared_phase=declared,
                       package_before=guarded.digest, package_after=guarded.after_digest,
                       checked_invocations=guarded.invocations,
                       relation=oracle_relation(wolf, lupin, row))
            remove_owned_scratch(scratch)
            print(f'oracle {index + 1}/{len(rows)} {row["file"]}: {wolf["verdict"]} / {lupin["verdict"]}', file=sys.stderr, flush=True)
            return row
        with ThreadPoolExecutor(max_workers=args.jobs) as pool:
            observed = list(pool.map(observe, enumerate(rows)))
    counts = {name: sum(row['relation'] == name for row in observed) for name in
              ('same-observed', 'differs', 'scope-gap', 'not-dynamically-comparable', 'oracle-error', 'module-member')}
    data = dict(format=4, identity=identity(), rows=observed, counts=counts,
                disagreements=[row['file'] for row in observed if row['relation'] in ('differs', 'oracle-error')],
                complete=not bool(args.limit or args.file), host='x86_64-unknown-linux-gnu')
    capture_manifest(data, (ROOT / 'wolf-toolchain.toml').read_text())
    atomic_json(out, data)
    print(json.dumps(counts), flush=True)
    # Errors remain named evidence, never quietly excluded rows. F0 table records
    # the oracle's limitations as data rather than turning them into fenrir passes.
    return 0


def check(args):
    data = json.loads(args.input.read_text())
    if data.get('format') != 4 or data['identity'] != identity() or not data['complete'] or data.get('recordings') != 2:
        raise ValueError('stale, incomplete or unrepeated oracle identity')
    capture_text = data['capture_pin_manifest']
    if hashlib.sha256(capture_text.encode()).hexdigest() != data['capture_pin_manifest_sha256']:
        raise ValueError('corrupt capture manifest')
    capture_manifest(data, capture_text)
    sources = corpus_rows(STAGE / 'reference/corpus')
    if len(sources) != len(data['rows']):
        raise ValueError('oracle row census differs')
    for source, row in zip(sources, data['rows']):
        if any(source[key] != row[key] for key in source):
            raise ValueError('stale corpus row: ' + source['file'])
        derived = derive_row(row)
        repeated_capture = dict(row, wolf=row['repeat_wolf'], lupin=row['repeat_lupin'],
                                native_run=row['repeat_native_run'], declared_phase=row['repeat_declared_phase'])
        repeated_derived = derive_row(repeated_capture)
        for field in ('wolf', 'lupin', 'native_run', 'declared_phase', 'relation'):
            if row.get(field) != derived.get(field) or row.get('repeat_' + field) != repeated_derived.get(field):
                raise ValueError('stale derivation from raw capture: ' + row['file'] + ': ' + field)
        if not row['member']:
            for prefix in ('', 'repeat_'):
                before, after = row[prefix + 'package_before'], row[prefix + 'package_after']
                if not before or before != after or row[prefix + 'checked_invocations'] < 3:
                    raise ValueError('missing package isolation proof: ' + row['file'])
                raw = row[prefix + 'native_run']
                expected_argv = ['<toolchain>/wolf', 'run', '--no-cache', '-o',
                                 '<scratch>/native-run/cwd/native-program', '<scratch>/reference/' + row['file']]
                if raw.get('argv') != expected_argv:
                    raise ValueError('stale native argv: ' + row['file'])
                declared = row[prefix + 'declared_phase']
                if declared['phase'] != row['phase'] or declared['relation'] != oracle_relation(declared['wolf'], declared['lupin'], row):
                    raise ValueError('stale declared-phase observation: ' + row['file'])
                for name in ('wolf', 'lupin'):
                    command = ['<toolchain>/' + name, 'conform-run', '<scratch>/reference/' + row['file'], '--json', '--phase=' + row['phase']]
                    if name == 'wolf':
                        command.append('--native')
                    if declared[name].get('argv') != command:
                        raise ValueError('stale declared-phase argv: ' + row['file'])
                observations = [raw, row[prefix + 'wolf'], row[prefix + 'lupin'], declared['wolf'], declared['lupin']]
                for observation in observations:
                    if 'stdout_base64' in observation:
                        payload = base64.b64decode(observation['stdout_base64'], validate=True)
                        if hashlib.sha256(payload).hexdigest() != observation['stdout_sha256'] or payload.decode(errors='replace') != observation['stdout']:
                            raise ValueError('corrupt raw output: ' + row['file'])
                    record = observation.get('record') or {}
                    if record.get('stdout_inline') is not None and record.get('stdout_sha256') is not None:
                        if hashlib.sha256(record['stdout_inline'].encode()).hexdigest() != record['stdout_sha256']:
                            raise ValueError('corrupt protocol output: ' + row['file'])
        if row['relation'] != oracle_relation(row['wolf'], row['lupin'], row):
            raise ValueError('stale oracle relation: ' + source['file'])
        if row['repeat_relation'] != oracle_relation(row['repeat_wolf'], row['repeat_lupin'], row):
            raise ValueError('stale repeated oracle relation: ' + source['file'])
        repeated = dict(wolf=row['repeat_wolf'], lupin=row['repeat_lupin'],
                        native_run=row['repeat_native_run'], declared_phase=row['repeat_declared_phase'])
        stable = observation_signature(row) == observation_signature(repeated)
        if stable != row['repeat_stable']:
            raise ValueError('stale repeat stability: ' + source['file'])
    changes = [row['file'] for row in data['rows'] if not row['repeat_stable']]
    if changes != data['repeat_changes']:
        raise ValueError('stale repeat-change list')
    counts = {name: sum(row['relation'] == name for row in data['rows']) for name in data['counts']}
    disagreements = [row['file'] for row in data['rows'] if row['relation'] in ('differs', 'oracle-error')]
    if counts != data['counts'] or disagreements != data['disagreements']:
        raise ValueError('stale oracle summary')
    print(f'oracle freshness: {len(sources)} source rows; exact pin, header, byte digest and summary checks')
    return 0


def selected_rows(data, path):
    """Keep the rows a selection file names: a JSON list of corpus files, or an
    object whose `core` list names them. Every named file must be a row."""
    chosen = json.loads(path.read_text())
    if isinstance(chosen, dict):
        chosen = chosen['core']
    names = set(chosen)
    rows = [row for row in data['rows'] if row['file'] in names]
    if len(rows) != len(names) or any(row.get('member') for row in rows):
        raise ValueError('selection names an unknown corpus row or a module member')
    return dict(data, rows=rows)


def compare(args):
    data = json.loads(args.input.read_text())
    if args.select:
        data = selected_rows(data, args.select)
    if args.fenrir:
        if platform.system() != 'Linux':
            raise ValueError('live differential requires Linux sandbox')
        if not os.environ.get('FENRIR_ORACLE_SANDBOX'):
            raise ValueError('live differential requires isolated container')
        with tempfile.TemporaryDirectory(prefix='candidate-', dir=ROOT / 'target') as temp:
            scratch = Path(temp)
            env = dict(os.environ, WOLF_STD=str(STAGE / 'std'))
            for index, row in enumerate(data['rows']):
                if row.get('member'):
                    continue
                private = scratch / str(index)
                source = private / 'reference' / row['file']
                original = STAGE / 'reference' / row['file']
                shutil.copytree(original.parent, source.parent)
                freeze_package(source.parent)
                output = private / 'program'
                build_cwd, build_env = isolated_context(private, 'build', env)
                run_cwd, run_env = isolated_context(private, 'run', env)
                code, out, err, timedout = execute([args.fenrir.resolve(), 'build', source, '-o', output], build_cwd, build_env,
                                                   args.build_timeout, address_space=BUILD_ADDRESS_SPACE)
                if code == 0 and not timedout and output.is_file():
                    candidate = native_observation(execute([output], run_cwd, run_env, args.timeout), source,
                                                   [(private, '<scratch>'), (STAGE, '<toolchain>')])
                else:
                    candidate = dict(verdict='refused' if code in (2, 4) and not timedout else 'crash', exit=code,
                                     stdout=out.decode(errors='replace'), stderr=err.decode(errors='replace'))
                candidate['build_exit'] = code
                row['fenrir'] = candidate
                print(f'candidate {index + 1}/{len(data["rows"])} {row["file"]}: build {code}, {candidate["verdict"]}', file=sys.stderr, flush=True)
                remove_owned_scratch(private)
    result = comparison(data)
    if args.output:
        atomic_json(args.output, result)
    if args.table:
        # The compact verdict table: one verdict per compared row, its counts and
        # the run-row coverage, every number derived from the rows above.
        table = {'identity': data['identity'], 'counts': result['counts'], 'coverage': result['coverage'],
                 'rows': [{'file': row['file'], 'verdict': row['verdict'], 'expected': row.get('expected')} for row in result['rows']]}
        atomic_json(args.table, table)
    print(json.dumps(result, sort_keys=True))
    return 1 if any(row['verdict'] != 'same' for row in result['rows']) else 0


def merge_recordings(args):
    first, second = json.loads(args.first.read_text()), json.loads(args.second.read_text())
    text = args.capture_pins.read_text() if args.capture_pins else first['capture_pin_manifest']
    capture_manifest(first, text)
    capture_manifest(second, text)
    result = reconcile(first, second)
    atomic_json(args.output, result)
    print(f'oracle repeats: {len(result["rows"])} rows; {len(result["repeat_changes"])} changing rows')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    record = sub.add_parser('oracle')
    record.add_argument('--output', type=Path, default=ROOT / 'tests/oracle.json')
    record.add_argument('--jobs', type=int, choices=range(1, 7), default=3)
    record.add_argument('--timeout', type=int, default=30)
    record.add_argument('--limit', type=int)
    record.add_argument('--file', action='append', help='sample named rows; makes the recording incomplete')
    merged = sub.add_parser('reconcile')
    merged.add_argument('--first', type=Path, required=True)
    merged.add_argument('--second', type=Path, required=True)
    merged.add_argument('--output', type=Path, default=ROOT / 'tests/oracle.json')
    merged.add_argument('--capture-pins', type=Path, help='original manifest for captures using the earlier whole-manifest identity')
    fresh = sub.add_parser('check')
    fresh.add_argument('--input', type=Path, default=ROOT / 'tests/oracle.json')
    diff = sub.add_parser('compare')
    diff.add_argument('--input', type=Path, default=ROOT / 'tests/oracle.json')
    diff.add_argument('--fenrir', type=Path)
    diff.add_argument('--output', type=Path)
    diff.add_argument('--table', type=Path, help='write the compact verdict table: file, verdict and counts')
    diff.add_argument('--timeout', type=int, default=30)
    diff.add_argument('--build-timeout', type=int, default=180, help='seconds for one fenrir build, which links')
    diff.add_argument('--select', type=Path, help='compare only the rows this JSON file names (a list, or an object with `core`)')
    args = parser.parse_args()
    return {'oracle': oracle, 'reconcile': merge_recordings, 'check': check, 'compare': compare}[args.command](args)


if __name__ == '__main__':
    raise SystemExit(main())
